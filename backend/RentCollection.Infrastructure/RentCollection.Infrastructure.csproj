<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RentCollection.Core\RentCollection.Core.csproj" />
    <ProjectReference Include="..\RentCollection.Application\RentCollection.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.10" />
    <PackageReference Include="QuestPDF" Version="2024.10.3" />
    <!-- Needed for [DisableConcurrentExecution] on the recurring jobs (same version Web uses). -->
    <PackageReference Include="Hangfire.Core" Version="1.8.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internals to the test assembly so unit tests can poke at
         helpers like LeaseAuditInterceptor.BuildDiff without forcing them
         public on the production surface. -->
    <InternalsVisibleTo Include="RentCollection.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cairo (Google Fonts, OFL) embedded so the invoice PDF uses one clean
         typeface for BOTH Latin and Arabic, rendering identically on any host
         with no installed fonts. -->
    <EmbeddedResource Include="Services\Pdf\Fonts\Cairo.ttf" />
  </ItemGroup>

</Project>
