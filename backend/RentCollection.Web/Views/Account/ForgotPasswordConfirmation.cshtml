@{
    ViewData["Title"] = "Password Reset Requested";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rent Collection System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="confirmation-body">

<div class="confirmation-container">
    <div class="confirmation-card">
        <div class="confirmation-icon success">
            <i class="fas fa-check-circle"></i>
        </div>
        <h2>@L["Check Your Email"]</h2>
        <p>
            @L["If an account with that email exists, we've sent you a password reset code. Please check your email and use the code to reset your password."]
        </p>
        <div class="confirmation-note">
            <i class="fas fa-info-circle"></i>
            <span>@L["The reset code expires in 24 hours. If you don't see the email, check your spam folder."]</span>
        </div>
        <div class="confirmation-actions">
            <a asp-action="Login" class="btn btn-primary">
                <i class="fas fa-arrow-left"></i> @L["Back to Login"]
            </a>
        </div>
    </div>
</div>

<style>
    .confirmation-body {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .confirmation-container {
        width: 100%;
        max-width: 500px;
        padding: 20px;
    }

    .confirmation-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        padding: 3rem 2rem;
        text-align: center;
        animation: slideUp 0.5s ease-out;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .confirmation-icon {
        font-size: 4rem;
        margin-bottom: 1.5rem;
    }

    .confirmation-icon.success {
        color: #10b981;
    }

    .confirmation-card h2 {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 1rem;
    }

    .confirmation-card p {
        font-size: 1rem;
        color: #6b7280;
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    .confirmation-note {
        background: #fef3c7;
        border: 1px solid #fcd34d;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 2rem;
        display: flex;
        gap: 0.75rem;
        text-align: left;
    }

    .confirmation-note i {
        color: #f59e0b;
        font-size: 1.25rem;
        flex-shrink: 0;
        margin-top: 0.125rem;
    }

    .confirmation-note span {
        font-size: 0.875rem;
        color: #92400e;
    }

    .confirmation-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
    }

    .btn-primary {
        padding: 0.875rem 2rem;
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(240, 147, 251, 0.4);
        color: white;
        text-decoration: none;
    }

    .btn-primary i {
        margin-right: 0.5rem;
    }
</style>

</body>
</html>
