@model RentCollection.Core.Entities.User
@{
    ViewData["Title"] = "My Profile";
}

<div class="page-container">
    @await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData)
    {
        ["Title"] = L["My Profile"].Value,
        ["Subtitle"] = L["Your account details and password"].Value,
        ["Crumbs"] = new (string label, string? href)[]
        {
            (L["Admin"].Value, "/Dashboard"),
            (L["My profile"].Value, null),
        }
    })

    @await Html.PartialAsync("_AlertMessages")

    <div class="profile-grid">

        <div class="profile-card">
            <div class="profile-card-head">
                <h2><i class="fas fa-user-circle"></i> @L["Account details"]</h2>
            </div>
            <div class="profile-card-body">
                <div class="profile-row">
                    <span class="profile-label">@L["Email"] <small>@L["(login)"]</small></span>
                    <span class="profile-value">
                        @Model.Email
                        <span class="profile-badge profile-badge-locked" title="@(L["Email change requires admin re-verification"].Value)">
                            <i class="fas fa-lock"></i> @L["read-only"]
                        </span>
                    </span>
                </div>
                <div class="profile-row">
                    <span class="profile-label">@L["Role"]</span>
                    <span class="profile-value">
                        <span class="profile-role-badge">@Model.Role</span>
                        <span class="profile-badge profile-badge-locked" title="@(L["Only an Admin can change your role"].Value)">
                            <i class="fas fa-lock"></i> @L["admin-only"]
                        </span>
                    </span>
                </div>
                <div class="profile-row">
                    <span class="profile-label">@L["Account created"]</span>
                    <span class="profile-value">@Model.CreatedDate.ToString("dd MMM yyyy")</span>
                </div>
                <div class="profile-row">
                    <span class="profile-label">@L["Last login"]</span>
                    <span class="profile-value">
                        @(Model.LastLogin.HasValue
                            ? Model.LastLogin.Value.ToString("dd MMM yyyy HH:mm")
                            : L["Never"].Value)
                    </span>
                </div>
            </div>
        </div>

        <div class="profile-card">
            <div class="profile-card-head">
                <h2><i class="fas fa-id-badge"></i> @L["Editable info"]</h2>
            </div>
            <form method="post" asp-action="Profile" class="profile-card-body">
                @Html.AntiForgeryToken()
                <div class="profile-field">
                    <label for="firstName">@L["First name"]</label>
                    <input id="firstName" name="firstName" type="text" required maxlength="50" value="@Model.FirstName" />
                </div>
                <div class="profile-field">
                    <label for="lastName">@L["Last name"]</label>
                    <input id="lastName" name="lastName" type="text" required maxlength="50" value="@Model.LastName" />
                </div>
                <div class="profile-field">
                    <label for="phoneNumber">@L["Phone number"]</label>
                    <input id="phoneNumber" name="phoneNumber" type="tel" maxlength="20" value="@(Model.PhoneNumber ?? "")" placeholder="@(L["Optional"].Value)" />
                </div>
                <div class="profile-actions">
                    <button type="submit" class="btn-primary">
                        <i class="fas fa-save"></i> @L["Save changes"]
                    </button>
                </div>
            </form>
        </div>

        <div class="profile-card profile-card-full">
            <div class="profile-card-head">
                <h2><i class="fas fa-key"></i> @L["Change password"]</h2>
            </div>
            <form method="post" asp-action="ChangeOwnPassword" class="profile-card-body">
                @Html.AntiForgeryToken()
                <div class="profile-field-row">
                    <div class="profile-field">
                        <label for="currentPassword">@L["Current password"]</label>
                        <input id="currentPassword" name="currentPassword" type="password" required autocomplete="current-password" />
                    </div>
                    <div class="profile-field">
                        <label for="newPassword">@L["New password"] <small>@L["(min 8)"]</small></label>
                        <input id="newPassword" name="newPassword" type="password" required minlength="8" autocomplete="new-password" />
                    </div>
                    <div class="profile-field">
                        <label for="confirmNewPassword">@L["Confirm new password"]</label>
                        <input id="confirmNewPassword" name="confirmNewPassword" type="password" required minlength="8" autocomplete="new-password" />
                    </div>
                </div>
                <div class="profile-actions">
                    <button type="submit" class="btn-primary">
                        <i class="fas fa-key"></i> @L["Update password"]
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>

<style>
    .page-container { padding: 2rem; max-width: 1000px; margin: 0 auto; }
    .profile-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;
    }
    .profile-card-full { grid-column: 1 / -1; }
    .profile-card {
        background: white; border: 1px solid #e2e8f0; border-radius: 12px;
        box-shadow: 0 1px 3px rgba(15,23,42,0.06); overflow: hidden;
    }
    .profile-card-head {
        background: linear-gradient(135deg, rgba(138, 109, 31,0.04), rgba(184, 134, 11,0.04));
        padding: 0.9rem 1.25rem; border-bottom: 1px solid #f1f5f9;
    }
    .profile-card-head h2 {
        margin: 0; font-size: 1rem; color: #334155; display: flex; align-items: center; gap: 0.5rem;
    }
    .profile-card-head h2 i { color: #8a6d1f; }
    .profile-card-body { padding: 1.25rem; }
    .profile-row {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.5rem 0; border-bottom: 1px dashed #f1f5f9;
        font-size: 0.92rem;
    }
    .profile-row:last-child { border-bottom: 0; }
    .profile-label { color: #64748b; font-weight: 500; }
    .profile-label small { color: #94a3b8; font-weight: 400; }
    .profile-value { color: #0f172a; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; }
    .profile-badge {
        display: inline-flex; align-items: center; gap: 0.3rem;
        padding: 0.15rem 0.5rem; border-radius: 999px;
        font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;
    }
    .profile-badge-locked { background: #f1f5f9; color: #64748b; }
    .profile-role-badge {
        background: #dbeafe; color: #1e40af;
        padding: 0.2rem 0.6rem; border-radius: 999px;
        font-weight: 700; font-size: 0.78rem;
    }
    .profile-field { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 0.85rem; }
    .profile-field label { font-size: 0.85rem; font-weight: 600; color: #334155; }
    .profile-field label small { color: #94a3b8; font-weight: 400; }
    .profile-field input {
        padding: 0.55rem 0.75rem;
        border: 1px solid #e2e8f0; border-radius: 6px;
        background: white; font-size: 0.92rem;
    }
    .profile-field input:focus {
        outline: none; border-color: #8a6d1f;
        box-shadow: 0 0 0 3px rgba(138, 109, 31,0.1);
    }
    .profile-field-row {
        display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.85rem;
    }
    .profile-actions { display: flex; justify-content: flex-end; margin-top: 0.5rem; }
    .btn-primary {
        display: inline-flex; align-items: center; gap: 0.45rem;
        padding: 0.6rem 1.15rem;
        background: linear-gradient(135deg, #8a6d1f, #b8860b);
        color: white; border: 0; border-radius: 8px;
        font-weight: 600; cursor: pointer;
    }
    .btn-primary:hover { box-shadow: 0 4px 12px rgba(138, 109, 31,0.3); }
    @@media (max-width: 800px) {
        .profile-grid { grid-template-columns: 1fr; }
        .profile-field-row { grid-template-columns: 1fr; }
    }
</style>
