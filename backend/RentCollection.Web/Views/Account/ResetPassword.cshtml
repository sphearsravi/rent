@model RentCollection.Web.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rent Collection System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="reset-password-body">

<div class="reset-password-container">
    <div class="reset-password-card">
        <div class="reset-password-header">
            <i class="fas fa-lock"></i>
            <h2>@L["Reset Your Password"]</h2>
            <p>@L["Enter your new password"]</p>
        </div>

        <form asp-action="ResetPassword" method="post" class="reset-password-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Code" />

            <div class="form-group">
                <label asp-for="Email">
                    <i class="fas fa-envelope"></i> @L["Email"] <span class="text-danger">*</span>
                </label>
                <input asp-for="Email" class="form-control" placeholder="@(L["Enter your email"].Value)" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">
                    <i class="fas fa-key"></i> @L["New Password"] <span class="text-danger">*</span>
                </label>
                <input asp-for="Password" class="form-control" placeholder="@(L["Enter new password"].Value)" required />
                <span asp-validation-for="Password" class="text-danger"></span>
                <small class="form-text text-muted">
                    @L["Must contain: 8+ characters, uppercase, lowercase, number, special character"]
                </small>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">
                    <i class="fas fa-key"></i> @L["Confirm Password"] <span class="text-danger">*</span>
                </label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="@(L["Confirm new password"].Value)" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                <i class="fas fa-check"></i> @L["Reset Password"]
            </button>

            <div class="reset-password-links">
                <a asp-action="Login"><i class="fas fa-arrow-left"></i> @L["Back to Login"]</a>
            </div>
        </form>
    </div>
</div>

<style>
    .reset-password-body {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px 0;
    }

    .reset-password-container {
        width: 100%;
        max-width: 500px;
        padding: 20px;
    }

    .reset-password-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        overflow: hidden;
        animation: slideUp 0.5s ease-out;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .reset-password-header {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
        padding: 2.5rem 2rem;
        text-align: center;
    }

    .reset-password-header i {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    .reset-password-header h2 {
        margin: 0.5rem 0;
        font-size: 1.75rem;
        font-weight: 700;
    }

    .reset-password-header p {
        margin: 0;
        opacity: 0.9;
        font-size: 0.95rem;
    }

    .reset-password-form {
        padding: 2rem;
    }

    .form-group {
        margin-bottom: 1.25rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: #374151;
        font-size: 0.9rem;
    }

    .form-group label i {
        margin-right: 0.5rem;
        color: #4facfe;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: #4facfe;
        box-shadow: 0 0 0 3px rgba(79, 172, 254, 0.1);
    }

    .btn-primary {
        width: 100%;
        padding: 0.875rem;
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 1rem;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(79, 172, 254, 0.4);
    }

    .btn-primary i {
        margin-right: 0.5rem;
    }

    .reset-password-links {
        text-align: center;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e5e7eb;
    }

    .reset-password-links a {
        color: #4facfe;
        text-decoration: none;
        font-weight: 500;
    }

    .reset-password-links a:hover {
        text-decoration: underline;
    }

    .reset-password-links i {
        margin-right: 0.5rem;
    }

    .alert-danger {
        background: #fee2e2;
        border: 1px solid #fecaca;
        color: #991b1b;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .text-danger {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
    }

    .form-text {
        font-size: 0.85rem;
        margin-top: 0.25rem;
    }
</style>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
