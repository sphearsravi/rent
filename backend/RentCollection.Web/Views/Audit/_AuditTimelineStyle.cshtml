@* Shared style block for the AuditLog Index + Entity timelines. Kept as a
   partial so the same CSS applies to both pages without duplication. *@
<style>
    .page-container { padding: 1.5rem 2rem; max-width: 1100px; margin: 0 auto; }

    .audit-filter {
        background: white; border: 1px solid #e2e8f0; border-radius: 12px;
        padding: 1rem 1.25rem; margin-bottom: 1.25rem;
    }
    .chip-row {
        display: flex; gap: 0.35rem; flex-wrap: wrap; align-items: center;
        margin-bottom: 0.55rem;
    }
    .chip-row:last-of-type { margin-bottom: 0; }
    .chip-label {
        font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em;
        color: #94a3b8; font-weight: 700; min-width: 64px;
    }
    .chip {
        display: inline-flex; align-items: center; gap: 0.35rem;
        padding: 0.3rem 0.7rem; border-radius: 999px;
        background: #f1f5f9; color: #475569;
        font-size: 0.78rem; font-weight: 500;
        text-decoration: none; border: 1px solid transparent;
    }
    .chip:hover { background: #e2e8f0; }
    .chip.is-on {
        background: linear-gradient(135deg, #8a6d1f, #b8860b);
        color: white;
    }
    .search-row {
        display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;
        margin-top: 0.85rem; padding-top: 0.75rem; border-top: 1px solid #f1f5f9;
    }
    .search-row input[type=text] {
        flex: 1; min-width: 260px;
        padding: 0.5rem 0.85rem;
        border: 1px solid #e2e8f0; border-radius: 6px;
        background: #f8fafc; font-size: 0.88rem;
    }
    .btn-filter {
        display: inline-flex; align-items: center; gap: 0.4rem;
        padding: 0.55rem 0.95rem; border-radius: 8px;
        background: linear-gradient(135deg, #8a6d1f, #b8860b);
        color: white; border: 0; cursor: pointer;
        font-size: 0.85rem; font-weight: 500;
    }
    .btn-link {
        color: #64748b; text-decoration: none;
        font-size: 0.85rem;
    }

    .timeline { list-style: none; padding: 0; margin: 0; position: relative; }
    .timeline::before {
        content: ''; position: absolute; left: 20px; top: 0; bottom: 0;
        width: 2px; background: linear-gradient(180deg, #e2e8f0, #f1f5f9);
    }
    .tl-row {
        position: relative; padding-left: 56px; padding-bottom: 1.05rem;
        min-height: 52px;
    }
    .tl-marker {
        position: absolute; left: 6px; top: 0;
        width: 28px; height: 28px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 0.7rem;
        border: 3px solid white;
        box-shadow: 0 2px 6px rgba(15, 23, 42, 0.15);
    }
    .tl-body {
        background: white; border: 1px solid #e2e8f0; border-radius: 10px;
        padding: 0.7rem 0.95rem;
    }
    .tl-head {
        display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem;
        margin-bottom: 0.25rem;
    }
    .tl-head strong { color: #0f172a; font-size: 0.92rem; }
    .tl-entity {
        background: rgba(138, 109, 31,0.08); color: #5a4512;
        padding: 0.1rem 0.5rem; border-radius: 6px;
        font-size: 0.78rem; font-weight: 600; text-decoration: none;
    }
    .tl-entity:hover { background: rgba(138, 109, 31,0.16); }
    .tl-when { color: #94a3b8; font-size: 0.75rem; margin-left: auto; }
    .tl-actor { color: #64748b; font-size: 0.82rem; }
    .tl-actor i { color: #94a3b8; margin-right: 0.3rem; }
    .tl-payload summary {
        cursor: pointer; font-size: 0.78rem;
        color: #64748b; margin-top: 0.4rem;
    }
    .tl-payload pre {
        margin: 0.35rem 0 0; padding: 0.55rem 0.7rem;
        background: #f8fafc; border-radius: 6px;
        font-size: 0.75rem; color: #334155;
        max-height: 200px; overflow: auto;
        font-family: 'Courier New', monospace;
    }
    /* Human-readable payload: small "Label: value" chips instead of raw JSON. */
    .tl-payload { margin-top: 0.4rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .tl-kv {
        background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 6px;
        padding: 0.2rem 0.55rem; font-size: 0.78rem; color: #334155;
    }
    .tl-kv strong { color: #475569; font-weight: 600; }

    .empty {
        text-align: center; padding: 3rem 1rem;
        background: white; border: 1px solid #e2e8f0; border-radius: 12px;
    }
    .empty i { font-size: 2.5rem; color: #cbd5e1; display: block; margin-bottom: 0.6rem; }
    .empty h3 { margin: 0; color: #475569; font-size: 1.05rem; }

    /* Entity page additions */
    .entity-card {
        background: white; border: 1px solid #e2e8f0; border-radius: 12px;
        padding: 1rem 1.25rem; margin-bottom: 1.25rem;
        display: flex; justify-content: space-between; align-items: center;
        flex-wrap: wrap; gap: 0.85rem;
    }
    .entity-card .ent-info { font-size: 0.9rem; color: #475569; }
    .entity-card .ent-info strong { color: #0f172a; }
    .entity-card a.btn-link { color: #8a6d1f; font-weight: 500; }
</style>
