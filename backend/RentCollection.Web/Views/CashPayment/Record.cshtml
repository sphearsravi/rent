@model RentCollection.Application.DTOs.CashPaymentDto
@{
    ViewData["Title"] = "Record Cash Payment";
    int? preTenant = ViewBag.PreselectTenantId as int?;
    int? preInvoice = ViewBag.PreselectInvoiceId as int? ?? Model?.InvoiceId;
    // Kuwait's calendar date, not the server's (the host runs in a US zone).
    DateTime today = ViewBag.Today as DateTime? ?? DateTime.UtcNow.AddHours(3).Date;
}

@*
    Cash at the counter, redesigned (2026-10):
      1. WHO is paying   — searchable tenant list showing what each one owes
      2. WHICH invoice   — the tenant's open invoices as cards; the oldest
                           is the only one payable (pay-oldest-first rule)
      3. HOW MUCH        — amount prefilled with the invoice balance
    The summary on the right states what happens next: the payment goes
    to the Approval queue and a *different* user confirms it; the receipt
    is issued then. No more guessing from a long dropdown.
*@

<div class="lp-page">
    @await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData)
    {
        ["Title"] = L["Record cash payment"].Value,
        ["Subtitle"] = L["Cash taken at the counter. A second person confirms it in the Approval queue, then the receipt is issued."].Value,
        ["Crumbs"] = new (string label, string? href)[] { (L["Admin"].Value, "/Dashboard"), (L["Payments"].Value, "/Payments"), (L["Record cash"].Value, null) },
        ["ActionsHtml"] = Html.Raw("<a class=\"lp-btn\" href=\"/PaymentApproval\"><i class=\"fas fa-clipboard-check\"></i> " + L["Approval queue"].Value + "</a>")
    })

    @await Html.PartialAsync("_AlertMessages")

    <form asp-action="Record" method="post" class="form-revamp lw-form" id="cashForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="lw-grid">
            <div class="lw-main">

                @* 1 · WHO *@
                <div class="fr-zone fr-zone-essentials">
                    <h3 class="fr-zone-title"><span class="lw-step">1</span><span>@L["Who is paying"]</span></h3>
                    <div class="fr-row fr-row-1">
                        <div class="fr-field">
                            <label for="tenantSelect">@L["Tenant"] <span class="required">*</span></label>
                            <select id="tenantSelect" class="select2-enable">
                                <option value="">@L["-- Search by name or Civil ID --"]</option>
                            </select>
                            <span class="fr-hint">@L["Only tenants with an open invoice are listed, with what they owe"]</span>
                        </div>
                    </div>
                    <div id="tenantCard" class="lw-availability" hidden>
                        <i class="fas fa-user"></i>
                        <span id="tenantCardText"></span>
                    </div>
                </div>

                @* 2 · WHICH *@
                <div class="fr-zone fr-zone-essentials">
                    <h3 class="fr-zone-title"><span class="lw-step">2</span><span>@L["Which invoice"]</span></h3>
                    <p class="fr-zone-hint">@L["Invoices are settled oldest first — only the oldest open invoice can be paid now."]</p>
                    <div id="invoiceList" class="cr-invoices">
                        <div class="lp-empty" style="padding:1.25rem"><i class="fas fa-file-invoice"></i>@L["Pick a tenant to see their open invoices"]</div>
                    </div>
                    <span asp-validation-for="InvoiceId" class="fr-hint is-error"></span>
                </div>

                @* 3 · HOW MUCH *@
                <div class="fr-zone fr-zone-essentials">
                    <h3 class="fr-zone-title"><span class="lw-step">3</span><span>@L["Cash received"]</span></h3>
                    <div class="fr-row fr-row-3">
                        <div class="fr-field">
                            <label asp-for="Amount">@L["Amount (KWD)"] <span class="required">*</span></label>
                            <div class="fr-currency">
                                <span class="fr-prefix">KWD</span>
                                <input asp-for="Amount" type="number" step="0.001" min="0.001" required />
                            </div>
                            <span asp-validation-for="Amount" class="fr-hint is-error"></span>
                            <div class="lw-quick">
                                <button type="button" class="lw-quick-btn" id="fullBalanceBtn">@L["Full balance"]</button>
                                <span class="fr-hint" id="amountHint"></span>
                            </div>
                        </div>
                        <div class="fr-field">
                            <label asp-for="PaymentDate">@L["Received on"] <span class="required">*</span></label>
                            <input asp-for="PaymentDate" type="date" value="@((Model?.PaymentDate == default ? today : Model!.PaymentDate).ToString("yyyy-MM-dd"))" max="@today.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="PaymentDate" class="fr-hint is-error"></span>
                            <span class="fr-hint">@L["Defaults to today; cannot be in the future"]</span>
                        </div>
                        <div class="fr-field">
                            <label asp-for="ManualReceiptNumber">@L["Manual receipt no."] <span class="optional">@L["optional"]</span></label>
                            <input asp-for="ManualReceiptNumber" type="text" maxlength="50" placeholder="@(L["Number from the paper receipt book"].Value)" />
                            <span class="fr-hint">@L["Printed on the PDF receipt so the paper slip can be matched."]</span>
                        </div>
                        <div class="fr-field">
                            <label asp-for="Notes">@L["Note"] <span class="optional">@L["optional"]</span></label>
                            <input asp-for="Notes" type="text" maxlength="200" placeholder="@(L["Who handed it over, denominations…"].Value)" />
                        </div>
                    </div>
                </div>

                <div class="fr-actions">
                    <a href="/PaymentApproval" class="fr-btn fr-btn-ghost">@L["Cancel"]</a>
                    <div class="fr-spacer"></div>
                    <button type="submit" class="fr-btn fr-btn-primary" id="recordBtn" disabled>
                        <i class="fas fa-money-bill-wave"></i> @L["Record cash — send for approval"]
                    </button>
                </div>
            </div>

            @* Summary *@
            <aside class="lw-summary" aria-live="polite">
                <div class="lw-summary-card">
                    <div class="lw-summary-head"><i class="fas fa-money-bill-wave"></i><span>@L["Payment summary"]</span></div>
                    <dl class="lw-summary-list">
                        <div><dt>@L["Tenant"]</dt><dd id="sumTenant">—</dd></div>
                        <div><dt>@L["Invoice"]</dt><dd id="sumInvoice">—</dd></div>
                        <div><dt>@L["Invoice balance"]</dt><dd id="sumBalance">—</dd></div>
                        <div><dt>@L["Cash received"]</dt><dd id="sumAmount">—</dd></div>
                        <div><dt>@L["Remaining after"]</dt><dd id="sumRemaining">—</dd></div>
                    </dl>
                    <div class="lw-outcome is-pending" id="sumOutcome">
                        <i class="fas fa-clipboard-check"></i>
                        <span>@L["Will be recorded as Pending verification. A different user confirms it in the Approval queue; the invoice is settled and the receipt issued at that moment."]</span>
                    </div>
                    <ul class="lw-checklist" id="sumChecklist">
                        <li data-check="tenant"><i class="fas fa-circle"></i> @L["Tenant chosen"]</li>
                        <li data-check="invoice"><i class="fas fa-circle"></i> @L["Payable invoice chosen"]</li>
                        <li data-check="amount"><i class="fas fa-circle"></i> @L["Amount between 0.001 and the balance"]</li>
                    </ul>
                </div>
            </aside>
        </div>
    </form>

    <script id="cashData" type="application/json">@Html.Raw(ViewBag.CashFormJson ?? "[]")</script>
</div>

<style>
    .cr-invoices { display: grid; gap: 0.6rem; }
    .cr-inv { display: grid; grid-template-columns: 24px 1fr auto; gap: 0.75rem; align-items: center; padding: 0.7rem 0.9rem; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; cursor: pointer; }
    .cr-inv:hover { border-color: #c9a647; }
    .cr-inv.is-on { border-color: #8a6d1f; background: #fbfaf6; box-shadow: 0 0 0 3px rgba(138,109,31,0.12); }
    .cr-inv.is-off { opacity: 0.55; cursor: not-allowed; background: #f8fafc; }
    .cr-inv input { width: 18px; height: 18px; accent-color: #8a6d1f; }
    .cr-inv-title { font-weight: 700; color: #0f172a; }
    .cr-inv-sub { font-size: 0.78rem; color: #64748b; margin-top: 2px; }
    .cr-inv-bal { text-align: end; font-weight: 700; font-variant-numeric: tabular-nums; color: #0f172a; }
    .cr-inv-bal small { display: block; font-weight: 500; color: #94a3b8; font-size: 0.72rem; }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var $ = window.jQuery, hasSelect2 = $ && $.fn && $.fn.select2;
            var tenants = [];
            try { tenants = JSON.parse(document.getElementById('cashData').textContent || '[]'); } catch (e) { console.error(e); }
            var L = {
                owes: @Json.Serialize(L["owes"].Value),
                invoices: @Json.Serialize(L["open invoice(s)"].Value),
                none: @Json.Serialize(L["No open invoices — nothing to collect"].Value),
                pick: @Json.Serialize(L["Pick a tenant to see their open invoices"].Value),
                payFirst: @Json.Serialize(L["Pay the older invoice first"].Value),
                overdue: @Json.Serialize(L["days overdue"].Value),
                due: @Json.Serialize(L["due"].Value),
                balance: @Json.Serialize(L["balance"].Value),
                ofBalance: @Json.Serialize(L["of the invoice balance"].Value),
                settles: @Json.Serialize(L["Settles the invoice in full"].Value),
            };
            var sel = document.getElementById('tenantSelect'), list = document.getElementById('invoiceList');
            var amount = document.getElementById('Amount'), btn = document.getElementById('recordBtn');
            var card = document.getElementById('tenantCard'), cardText = document.getElementById('tenantCardText');
            var hint = document.getElementById('amountHint');
            var fmt = function (n) { return (Number(n) || 0).toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 }); };
            var current = null, currentInv = null;

            tenants.forEach(function (t) {
                var o = new Option(t.name + (t.civilId ? ' · ' + t.civilId : '') + ' · ' + fmt(t.outstanding) + ' KWD', t.id);
                sel.appendChild(o);
            });
            if (hasSelect2) $(sel).select2({ theme: 'bootstrap-5', width: '100%' });

            function renderInvoices(t) {
                list.innerHTML = '';
                if (!t) { list.innerHTML = '<div class="lp-empty" style="padding:1.25rem"><i class="fas fa-file-invoice"></i>' + L.pick + '</div>'; return; }
                if (!t.invoices.length) { list.innerHTML = '<div class="lp-empty" style="padding:1.25rem"><i class="fas fa-circle-check"></i>' + L.none + '</div>'; return; }
                t.invoices.forEach(function (inv) {
                    var el = document.createElement('label');
                    el.className = 'cr-inv' + (inv.eligible ? '' : ' is-off');
                    var late = inv.daysLate > 0 ? '<span class="lp-chip lp-chip-red">' + inv.daysLate + ' ' + L.overdue + '</span>' : '<span class="lp-chip lp-chip-amber">' + L.due + ' ' + inv.due + '</span>';
                    el.innerHTML =
                        '<input type="radio" name="InvoiceId" value="' + inv.id + '"' + (inv.eligible ? '' : ' disabled') + '>' +
                        '<div><div class="cr-inv-title">' + inv.number + ' · ' + inv.type + ' · ' + inv.period + '</div>' +
                        '<div class="cr-inv-sub">' + (inv.property || '') + (inv.unit ? ' · Unit ' + inv.unit : '') + ' &nbsp; ' + late +
                        (inv.eligible ? '' : ' &nbsp; <span class="lp-chip lp-chip-grey"><i class="fas fa-lock"></i> ' + L.payFirst + '</span>') + '</div></div>' +
                        '<div class="cr-inv-bal">' + fmt(inv.balance) + '<small>KWD ' + L.balance + (inv.paid > 0 ? ' · ' + fmt(inv.paid) + ' paid' : '') + '</small></div>';
                    el.addEventListener('click', function (e) {
                        if (!inv.eligible) { e.preventDefault(); return; }
                        selectInvoice(inv, el);
                    });
                    list.appendChild(el);
                    if (inv.eligible && (String(inv.id) === String(@(preInvoice ?? 0)) || t.invoices.length >= 1 && !currentInv && String(@(preInvoice ?? 0)) === '0')) selectInvoice(inv, el);
                });
            }

            function selectInvoice(inv, el) {
                currentInv = inv;
                list.querySelectorAll('.cr-inv').forEach(function (x) { x.classList.remove('is-on'); });
                el.classList.add('is-on');
                el.querySelector('input').checked = true;
                amount.value = Number(inv.balance).toFixed(3);
                amount.max = Number(inv.balance).toFixed(3);
                update();
            }

            function onTenant() {
                current = tenants.find(function (t) { return String(t.id) === String(sel.value); }) || null;
                currentInv = null;
                if (current) {
                    card.hidden = false; card.classList.remove('is-bad');
                    cardText.textContent = current.name + (current.phone ? ' · ' + current.phone : '') + ' · ' + L.owes + ' ' + fmt(current.outstanding) + ' KWD · ' + current.invoices.length + ' ' + L.invoices;
                } else if (!card.classList.contains('is-bad')) { card.hidden = true; }
                renderInvoices(current);
                update();
            }

            function update() {
                var a = Number(amount.value) || 0;
                var bal = currentInv ? Number(currentInv.balance) : 0;
                document.getElementById('sumTenant').textContent = current ? current.name : '—';
                document.getElementById('sumInvoice').textContent = currentInv ? currentInv.number + ' · ' + currentInv.type + ' ' + currentInv.period : '—';
                document.getElementById('sumBalance').textContent = currentInv ? 'KWD ' + fmt(bal) : '—';
                document.getElementById('sumAmount').textContent = a > 0 ? 'KWD ' + fmt(a) : '—';
                var rem = currentInv ? bal - a : null;
                document.getElementById('sumRemaining').textContent = rem === null ? '—' : (rem <= 0.0005 ? L.settles : 'KWD ' + fmt(rem));
                hint.textContent = currentInv ? (a > 0 && a <= bal + 0.0005 ? Math.round(100 * a / bal) + '% ' + L.ofBalance : '') : '';
                var okAmt = currentInv && a > 0 && a <= bal + 0.0005;
                function mark(k, ok) { var li = document.querySelector('#sumChecklist [data-check="' + k + '"]'); li.classList.toggle('ok', !!ok); li.querySelector('i').className = ok ? 'fas fa-circle-check' : 'fas fa-circle'; }
                mark('tenant', !!current); mark('invoice', !!currentInv); mark('amount', okAmt);
                btn.disabled = !(current && currentInv && okAmt);
            }

            sel.addEventListener('change', onTenant);
            amount.addEventListener('input', update);
            document.getElementById('fullBalanceBtn').addEventListener('click', function () { if (currentInv) { amount.value = Number(currentInv.balance).toFixed(3); update(); } });

            var pre = '@(preTenant ?? 0)';
            if (pre !== '0') {
                if (tenants.some(function (t) { return String(t.id) === pre; })) {
                    sel.value = pre; if (hasSelect2) $(sel).trigger('change.select2');
                } else {
                    // Deep link to a tenant with nothing open: say so instead of a blank form.
                    card.hidden = false; card.classList.add('is-bad');
                    cardText.textContent = @Json.Serialize(L["This tenant has no open invoices — there is nothing to collect. Pick another tenant."].Value);
                }
            }
            onTenant();
        })();
    </script>
}
