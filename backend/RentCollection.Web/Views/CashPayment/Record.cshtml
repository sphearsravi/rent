@model RentCollection.Application.DTOs.CashPaymentDto
@{
    ViewData["Title"] = "Record Cash Payment";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <h1><i class="fas fa-money-bill-wave text-success"></i> @L["Record Cash Payment"]</h1>
            <p class="text-muted">@L["Log cash collected at the office. It will require verification by an approver before the invoice is settled."]</p>
        </div>
        <a href="/PaymentApproval" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> @L["Back to Approvals"]
        </a>
    </div>

    <div class="form-card">
        <form asp-action="Record" method="post" class="cash-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-field">
                <label for="InvoiceId">@L["Invoice"]</label>
                <select asp-for="InvoiceId" asp-items="ViewBag.Invoices" class="form-control">
                    <option value="">@L["-- Select an outstanding invoice --"]</option>
                </select>
                <span asp-validation-for="InvoiceId" class="field-error"></span>
                <small class="hint">@L["Tenant & property are taken from the invoice automatically."]</small>
            </div>

            <div class="form-row">
                <div class="form-field">
                    <label for="Amount">@L["Amount (KWD)"]</label>
                    <input asp-for="Amount" type="number" step="0.001" min="0" class="form-control" placeholder="0.000" />
                    <span asp-validation-for="Amount" class="field-error"></span>
                    <small class="hint">@L["Partial payments are allowed."]</small>
                </div>
                <div class="form-field">
                    <label for="PaymentDate">@L["Payment date"]</label>
                    <input asp-for="PaymentDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="PaymentDate" class="field-error"></span>
                </div>
            </div>

            <div class="form-field">
                <label for="Notes">@L["Notes (optional)"]</label>
                <textarea asp-for="Notes" rows="3" class="form-control" placeholder="@(L["Denominations, payer name at counter, etc."].Value)"></textarea>
            </div>

            <div class="form-actions">
                <a href="/PaymentApproval" class="btn btn-secondary"><i class="fas fa-times"></i> @L["Cancel"]</a>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-check"></i> @L["Record Payment"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <style>
        body { background: linear-gradient(135deg,#f8fafc 0%,#e0e7ff 50%,#c7d2fe 100%); min-height: 100vh; }
        .page-container { padding: 24px; max-width: 820px; margin: 0 auto; }
        .page-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:24px; gap:16px; }
        .page-header h1 { font-size:1.6rem; font-weight:700; color:#0f172a; display:flex; align-items:center; gap:.5rem; }
        .page-header .text-muted { color:#64748b; margin-top:4px; }
        .text-success { color:#10b981; }
        .form-card { background:white; border-radius:16px; padding:28px; box-shadow:0 4px 16px rgba(15,23,42,.06); border:1px solid rgba(99, 102, 241,.08); }
        .form-field { display:flex; flex-direction:column; gap:6px; margin-bottom:18px; }
        .form-row { display:grid; grid-template-columns:1fr 1fr; gap:20px; }
        .form-field label { font-size:.85rem; font-weight:600; color:#334155; }
        .form-control { border:1px solid #cbd5e1; border-radius:10px; padding:10px 14px; font:inherit; color:#0f172a; width:100%; }
        .form-control:focus { outline:none; border-color:#6366f1; box-shadow:0 0 0 3px rgba(99, 102, 241,.18); }
        .hint { color:#94a3b8; font-size:.8rem; }
        .field-error, .validation-summary { color:#ef4444; font-size:.82rem; }
        .validation-summary ul { margin:0; padding-left:1rem; }
        .form-actions { display:flex; justify-content:flex-end; gap:10px; padding-top:18px; border-top:1px solid #e2e8f0; margin-top:8px; }
        .btn { display:inline-flex; align-items:center; gap:6px; padding:10px 18px; border-radius:10px; font-weight:600; font-size:.92rem; border:1px solid transparent; cursor:pointer; text-decoration:none; }
        .btn-secondary { background:white; color:#334155; border-color:#cbd5e1; }
        .btn-success { background:linear-gradient(135deg,#10b981,#059669); color:white; box-shadow:0 6px 20px rgba(16,185,129,.25); }
        @@media (max-width:680px){ .form-row{grid-template-columns:1fr;} .page-header{flex-direction:column;} }
    </style>
}
