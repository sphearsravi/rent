@model RentCollection.Web.Models.DashboardViewModel
@using System.Globalization
@using RentCollection.Web.Helpers
@{
    ViewData["Title"] = "Dashboard";
    var ci = CultureInfo.CurrentUICulture;
    var todayLabel = DateTime.Now.ToString("dddd, d MMMM yyyy", ci);
    bool loadError = (ViewBag.LoadError as bool?) == true;
    var expiring = Model.UpcomingLeaseExpirations;
}

<div class="od" style="max-width:1280px;margin:0 auto;">

    @await Html.PartialAsync("_AlertMessages")

    @if (loadError)
    {
        <div class="od-note" role="alert">
            <strong>@L["Couldn't load live figures."]</strong>
            @L["The numbers below are placeholders — please refresh, or contact support if this keeps happening."]
        </div>
    }

    @* ===== Header ===== *@
    <header class="od-header">
        <div style="display:flex;flex-direction:column;gap:4px;">
            <div class="od-eyebrow">@(todayLabel + (string.IsNullOrWhiteSpace(Model.CompanyName) ? "" : " · " + Model.CompanyName))</div>
            <h1 class="od-title">@L[Model.GreetingKey]@(string.IsNullOrWhiteSpace(Model.FirstName) ? "" : ", " + Model.FirstName)</h1>
            <div class="od-sub">@L["Here's how your portfolio is doing this month."]</div>
        </div>
        <div class="od-toolbar">
            <span class="od-card-meta">@L["Period"]</span>
            <span class="od-pill od-pill-gold">@L["This month"] · @DateTime.Now.ToString("MMM yyyy", ci)</span>
            <a class="od-btn od-btn-primary" asp-controller="Reports" asp-action="ExecutiveDashboardExcel">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v3h16v-3"/></svg>
                @L["Export report"]
            </a>
        </div>
    </header>

    @* ===== Money row ===== *@
    <section class="od-grid-kpi" aria-label="@(L["This month in numbers"].Value)">

        <article class="od-card od-kpi-hero">
            <div class="od-kpi-row">
                <span class="od-kpi-label">@L["Collected this month"]</span>
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.8)" stroke-width="2" stroke-linecap="round"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>
            </div>
            <div class="od-kpi-value">@CurrencyHelper.FormatKWD(Model.CollectedThisMonth)</div>
            <div class="od-kpi-sub">@L["of {0} expected rent roll", CurrencyHelper.FormatKWD(Model.ExpectedThisMonth)]</div>
            <div class="od-bar"><span style="width:@(Math.Min(100, Model.CollectionRate))%"></span></div>
            <div class="od-kpi-row" style="font-size:13px;">
                <span style="font-weight:700;">@L["{0}% collected", Model.CollectionRate]</span>
                <span class="od-kpi-sub">@L["{0} days left", Model.DaysLeftInMonth]</span>
            </div>
        </article>

        <article class="od-card">
            <div class="od-kpi-row">
                <span class="od-kpi-label">@L["Outstanding"]</span>
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B45309" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            </div>
            <div class="od-kpi-value">@CurrencyHelper.FormatKWD(Model.OutstandingAmount)</div>
            <div class="od-kpi-sub">@L["{0} invoices not yet paid", Model.OutstandingInvoiceCount]</div>
            <a class="od-card-link" href="/Invoices">@L["View outstanding →"]</a>
        </article>

        <article class="od-card">
            <div class="od-kpi-row">
                <span class="od-kpi-label">@L["Overdue"]</span>
                <span class="od-pill @(Model.OverdueTenantCount > 0 ? "od-pill-red" : "od-pill-grey")">@L["{0} tenants", Model.OverdueTenantCount]</span>
            </div>
            <div class="od-kpi-value @(Model.OverdueAmount > 0 ? "is-red" : "")">@CurrencyHelper.FormatKWD(Model.OverdueAmount)</div>
            <div class="od-kpi-sub">
                @if (Model.OverdueOver30Amount > 0)
                {
                    @L["{0} of it is over 30 days late", CurrencyHelper.FormatKWD(Model.OverdueOver30Amount)]
                }
                else if (Model.OverdueAmount > 0)
                {
                    @L["Nothing is more than 30 days late"]
                }
                else
                {
                    @L["No overdue rent right now"]
                }
            </div>
            <a class="od-card-link" href="/Invoices?status=Overdue">@L["Chase overdue →"]</a>
        </article>

        <article class="od-card">
            <div class="od-kpi-row">
                <span class="od-kpi-label">@L["Occupancy"]</span>
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="2" stroke-linecap="round"><path d="M3 21V9l9-6 9 6v12M9 21v-6h6v6"/></svg>
            </div>
            <div style="display:flex;align-items:baseline;gap:8px;">
                <span class="od-kpi-value is-green">@Model.OccupancyRate.ToString("0")%</span>
                <span class="od-kpi-sub">@L["{0} of {1} units", Model.OccupiedUnits, Model.TotalUnits]</span>
            </div>
            <div class="od-kpi-sub">
                @if (Model.VacantUnits > 0)
                {
                    @L["{0} vacant · costing about {1}", Model.VacantUnits, Html.Raw("<strong style=\"color:var(--od-ink)\">" + Html.Encode(CurrencyHelper.FormatKWD(Model.VacancyCostPerMonth)) + "/" + Html.Encode(L["month"].Value) + "</strong>")]
                }
                else
                {
                    @L["Every unit is let"]
                }
            </div>
            <a class="od-card-link" href="/Units?status=Vacant">@L["See vacant units →"]</a>
        </article>
    </section>

    @* ===== Attention queue + trend ===== *@
    <section class="od-grid-2">

        <article class="od-card">
            <div class="od-card-head">
                <h2 class="od-card-title">@L["Needs your attention"]</h2>
                <span class="od-card-meta">@L["{0} items", Model.AttentionItemCount]</span>
            </div>

            @if (Model.AttentionItemCount == 0)
            {
                <div class="od-empty">@L["Nothing needs your attention right now — enjoy the quiet."]</div>
            }
            else
            {
                <div class="od-queue">
                    @if (Model.PaymentsToVerifyCount > 0)
                    {
                        <a class="od-queue-row" href="/PaymentApproval">
                            <span class="od-count od-count-gold">@Model.PaymentsToVerifyCount</span>
                            <span class="od-queue-text">
                                <strong>@L["Payments waiting for your verification"]</strong>
                                <span>@L["{0} bank transfers · {1} cash — {2}", Model.PaymentsToVerifyBankCount, Model.PaymentsToVerifyCashCount, CurrencyHelper.FormatKWD(Model.PaymentsToVerifyAmount)]</span>
                            </span>
                            <span class="od-queue-cta">@L["Verify →"]</span>
                        </a>
                    }
                    @if (Model.OverdueTenantCount > 0)
                    {
                        <a class="od-queue-row" href="/Invoices?status=Overdue">
                            <span class="od-count od-count-red">@Model.OverdueTenantCount</span>
                            <span class="od-queue-text">
                                <strong>@L["Overdue tenants to follow up"]</strong>
                                <span>@L["{0} are over 30 days late", Model.OverdueOver30TenantCount]</span>
                            </span>
                            <span class="od-queue-cta">@L["Remind →"]</span>
                        </a>
                    }
                    @if (Model.PendingLeasesAwaitingActivation > 0)
                    {
                        <a class="od-queue-row" href="/Leases?status=Pending">
                            <span class="od-count od-count-gold">@Model.PendingLeasesAwaitingActivation</span>
                            <span class="od-queue-text">
                                <strong>@L["Leases waiting to be activated"]</strong>
                                <span>@L["Deposit invoice will be issued on activation"]</span>
                            </span>
                            <span class="od-queue-cta">@L["Activate →"]</span>
                        </a>
                    }
                    @if (Model.LeasesExpiringIn30Days > 0)
                    {
                        <a class="od-queue-row" href="/Leases">
                            <span class="od-count od-count-amber">@Model.LeasesExpiringIn30Days</span>
                            <span class="od-queue-text">
                                <strong>@L["Leases ending within 30 days"]</strong>
                                <span>@L["Renew or plan the vacancy now"]</span>
                            </span>
                            <span class="od-queue-cta">@L["Review →"]</span>
                        </a>
                    }
                    @if (Model.MaintenanceOpenCount > 0)
                    {
                        <a class="od-queue-row" href="/Maintenance">
                            <span class="od-count od-count-amber">@Model.MaintenanceOpenCount</span>
                            <span class="od-queue-text">
                                <strong>@L["Open maintenance requests"]</strong>
                                @if (Model.MaintenanceSlaBreachedCount > 0)
                                {
                                    <span style="color:var(--od-red);font-weight:600;">@L["{0} have passed their SLA", Model.MaintenanceSlaBreachedCount]</span>
                                }
                                else
                                {
                                    <span>@L["All within SLA"]</span>
                                }
                            </span>
                            <span class="od-queue-cta">@L["Assign →"]</span>
                        </a>
                    }
                    @if (Model.VacantUnits > 0)
                    {
                        <a class="od-queue-row" href="/Units?status=Vacant">
                            <span class="od-count od-count-green">@Model.VacantUnits</span>
                            <span class="od-queue-text">
                                <strong>@L["Vacant units to let"]</strong>
                                @if (Model.LongestVacantDays > 0 && !string.IsNullOrEmpty(Model.LongestVacantUnitLabel))
                                {
                                    <span>@L["Longest vacant: {0} days ({1})", Model.LongestVacantDays, Model.LongestVacantUnitLabel]</span>
                                }
                                else
                                {
                                    <span>@L["Ready to list today"]</span>
                                }
                            </span>
                            <span class="od-queue-cta">@L["List →"]</span>
                        </a>
                    }
                </div>
            }
        </article>

        <article class="od-card" style="gap:14px;">
            <div class="od-card-head">
                <h2 class="od-card-title">@L["Collections — last 6 months"]</h2>
                <div class="od-legend">
                    <span><span class="od-swatch od-trend-expected"></span>@L["Expected"]</span>
                    <span><span class="od-swatch od-trend-collected"></span>@L["Collected"]</span>
                </div>
            </div>

            @if (Model.CollectionTrend.Count == 0 || Model.CollectionTrend.All(t => t.Expected == 0 && t.Collected == 0))
            {
                <div class="od-empty">@L["No rent has been invoiced or collected in the last 6 months yet."]</div>
            }
            else
            {
                <div class="od-trend" role="img" aria-label="@(L["Expected versus collected rent, by month"].Value)">
                    @foreach (var t in Model.CollectionTrend)
                    {
                        <div class="od-trend-col" title="@t.Label: @CurrencyHelper.FormatKWD(t.Collected) / @CurrencyHelper.FormatKWD(t.Expected)">
                            <div class="od-trend-bars">
                                <span class="od-trend-expected" style="height:@(t.ExpectedPx)px"></span>
                                <span class="od-trend-collected @(t.IsCurrent ? "is-partial" : "")" style="height:@(t.CollectedPx)px"></span>
                            </div>
                            <span class="od-trend-label">
                                @t.Label
                                @if (t.IsCurrent)
                                {
                                    <em style="font-style:normal;color:var(--od-amber);">@L["(so far)"]</em>
                                }
                            </span>
                        </div>
                    }
                </div>

                <div class="od-grid-3 od-divider-top">
                    <div class="od-stat">
                        <span>@L["Avg collection rate"]</span>
                        <strong style="color:var(--od-green);">@Model.AvgCollectionRate.ToString("0")%</strong>
                    </div>
                    <div class="od-stat">
                        <span>@L["Best month"]</span>
                        <strong>@(string.IsNullOrEmpty(Model.BestMonthLabel) ? "—" : $"{Model.BestMonthLabel} · {Model.BestMonthRate:0}%")</strong>
                    </div>
                    <div class="od-stat">
                        <span>@L["Avg days to pay"]</span>
                        <strong>@L["{0} days", Model.AvgDaysToPay.ToString("0.#", ci)]</strong>
                    </div>
                </div>
            }
        </article>
    </section>

    @* ===== Property health ===== *@
    <section class="od-card" style="gap:14px;">
        <div class="od-card-head">
            <h2 class="od-card-title">@L["Property health"]</h2>
            <span class="od-card-meta">@L["Sorted by collection rate — weakest first"]</span>
        </div>
        @if (Model.PropertyHealth.Count == 0)
        {
            <div class="od-empty">@L["No properties yet. Add your first property to see how it performs here."]</div>
        }
        else
        {
            <div class="od-table-wrap">
                <table class="od-table">
                    <thead>
                        <tr>
                            <th>@L["Property"]</th>
                            <th>@L["Occupied"]</th>
                            <th class="num">@L["Rent roll"]</th>
                            <th class="num">@L["Collected"]</th>
                            <th>@L["Collection"]</th>
                            <th class="num">@L["Overdue"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.PropertyHealth)
                        {
                            var tone = row.RentRoll == 0 ? "grey" : row.CollectionRate < 60 ? "red" : row.CollectionRate < 90 ? "amber" : "green";
                            var toneVar = tone == "grey" ? "var(--od-muted)" : $"var(--od-{tone})";
                            <tr>
                                <td style="font-weight:600;">
                                    @if (tone != "grey")
                                    {
                                        <span class="od-dot od-dot-@tone"></span>
                                    }
                                    else
                                    {
                                        <span class="od-dot" style="background:var(--od-line);"></span>
                                    }@row.PropertyName
                                </td>
                                <td>@row.OccupiedUnits / @row.TotalUnits</td>
                                <td class="num">@row.RentRoll.ToString("N3")</td>
                                <td class="num">@row.Collected.ToString("N3")</td>
                                <td>
                                    <div class="od-rate">
                                        <div class="od-bar is-thin"><span class="@(tone == "grey" ? "" : "is-" + tone)" style="width:@(row.CollectionRate)%"></span></div>
                                        <strong style="color:@toneVar;">@row.CollectionRate.ToString("0")%</strong>
                                    </div>
                                </td>
                                <td class="num" style="@(row.OverdueAmount > 0 ? $"color:{toneVar};font-weight:700;" : "color:var(--od-muted);")">
                                    @(row.OverdueAmount > 0 ? row.OverdueAmount.ToString("N3") : "—")
                                </td>
                                <td class="num"><a href="/Properties/Details/@row.PropertyId" style="font-weight:700;font-size:13px;">@L["Open →"]</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @* ===== Arrears + expiries ===== *@
    <section class="od-grid-2">

        <article class="od-card">
            <div class="od-card-head">
                <h2 class="od-card-title">@L["Who owes the most"]</h2>
                <a href="/Invoices?status=Overdue" style="font-size:13px;font-weight:700;">@L["All overdue →"]</a>
            </div>
            @if (Model.TopArrears.Count == 0)
            {
                <div class="od-empty">@L["Nobody is behind on rent. Nice work."]</div>
            }
            else
            {
                <div class="od-rows">
                    @foreach (var a in Model.TopArrears)
                    {
                        var lateTone = a.DaysLate > 30 ? "var(--od-red)" : "var(--od-amber)";
                        <div class="od-row">
                            <span class="od-avatar" aria-hidden="true">@a.Initials</span>
                            <span class="od-row-text">
                                <strong>@a.TenantName</strong>
                                <span>@a.PropertyName · @("U" + a.UnitNumber) · <span style="color:@lateTone;font-weight:600;">@L["{0} days late", a.DaysLate]</span></span>
                            </span>
                            <span class="od-amount is-red">@a.Amount.ToString("N3")</span>
                            <a class="od-btn od-btn-ghost od-btn-sm" href="/Tenants/Details/@a.TenantId">@L["Remind"]</a>
                        </div>
                    }
                </div>
            }
        </article>

        <article class="od-card">
            <div class="od-card-head">
                <h2 class="od-card-title">@L["Leases ending soon"]</h2>
                <a href="/Leases" style="font-size:13px;font-weight:700;">@L["All leases →"]</a>
            </div>
            @if (!expiring.Any())
            {
                <div class="od-empty">@L["No expiring leases in the next 30 days"]</div>
            }
            else
            {
                <div class="od-rows">
                    @foreach (var lease in expiring)
                    {
                        var daysLeft = Math.Max(0, (lease.LeaseEndDate.Date - DateTime.UtcNow.Date).Days);
                        var tenantName = $"{lease.Tenant?.FirstName} {lease.Tenant?.LastName}".Trim();
                        var leaseWhere = $"{lease.Unit?.Property?.PropertyName} · U{lease.Unit?.UnitNumber}";
                        <div class="od-row">
                            <span class="od-days @(daysLeft <= 10 ? "od-days-red" : "od-days-amber")">
                                <strong>@daysLeft</strong>
                                <span>@L["days"]</span>
                            </span>
                            <span class="od-row-text">
                                <strong>@(string.IsNullOrEmpty(tenantName) ? "—" : tenantName)</strong>
                                <span>@leaseWhere · @L["ends {0}", lease.LeaseEndDate.ToString("d MMM yyyy", ci)] · @(CurrencyHelper.FormatKWD(lease.MonthlyRent) + "/")@L["mo"]</span>
                            </span>
                            <a class="od-btn od-btn-primary od-btn-sm" href="/Leases/Details/@lease.LeaseId">@L["Renew"]</a>
                        </div>
                    }
                </div>
                <div class="od-note" style="margin-top:4px;">
                    @L["If none renew, rent roll drops by {0} from {1}.", Html.Raw("<strong>" + Html.Encode(CurrencyHelper.FormatKWD(Model.RentRollAtRisk)) + "/" + Html.Encode(L["month"].Value) + "</strong>"), DateTime.Now.AddMonths(1).ToString("MMMM", ci)]
                </div>
            }
        </article>
    </section>

    @* ===== Recent payments (compact) ===== *@
    <section class="od-card">
        <div class="od-card-head">
            <h2 class="od-card-title">@L["Money received recently"]</h2>
            <a href="/Payments" style="font-size:13px;font-weight:700;">@L["All payments →"]</a>
        </div>
        @if (!Model.RecentPayments.Any())
        {
            <div class="od-empty">@L["No recent payments"]</div>
        }
        else
        {
            <div class="od-tiles">
                @foreach (var payment in Model.RecentPayments)
                {
                    var psRaw = payment.PaymentStatus ?? "";
                    var (tone, psLabel) = psRaw switch
                    {
                        "Completed" or "Approved" => ("green", L["Completed"].Value),
                        "Pending" or "PendingVerification" => ("amber", L["Verify"].Value),
                        "Rejected" or "Failed" or "Cancelled" => ("red", L[psRaw].Value),
                        _ => ("grey", psRaw)
                    };
                    var methodLabel = payment.PaymentType switch
                    {
                        RentCollection.Core.Enums.PaymentType.BankTransfer => L["Bank transfer"].Value,
                        RentCollection.Core.Enums.PaymentType.Cash => L["Cash"].Value,
                        RentCollection.Core.Enums.PaymentType.Cheque => L["Cheque"].Value,
                        _ => "KNET"
                    };
                    var iconBg = tone == "grey" ? "var(--od-line-soft)" : $"var(--od-{tone}-soft)";
                    var iconStroke = tone == "grey" ? "var(--od-muted)" : $"var(--od-{tone})";
                    var paymentWhere = $"{payment.Lease?.Unit?.Property?.PropertyName} U{payment.Lease?.Unit?.UnitNumber}";
                    <div class="od-tile">
                        <span class="od-tile-icon" style="background:@iconBg;">
                            @if (tone == "green")
                            {
                                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="@iconStroke" stroke-width="2.4" stroke-linecap="round"><path d="M5 12l5 5L20 7"/></svg>
                            }
                            else if (tone == "red")
                            {
                                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="@iconStroke" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M15 9l-6 6M9 9l6 6"/></svg>
                            }
                            else
                            {
                                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="@iconStroke" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                            }
                        </span>
                        <span class="od-tile-text">
                            <strong>@CurrencyHelper.FormatKWD(payment.AmountPaid) · @methodLabel</strong>
                            <span>@paymentWhere · @FormatWhen(payment.PaymentDate)</span>
                        </span>
                        <span class="od-pill od-pill-@tone">@psLabel</span>
                    </div>
                }
            </div>
        }
    </section>
</div>

@functions {
    string FormatWhen(DateTime when)
    {
        var ci = CultureInfo.CurrentUICulture;
        var today = DateTime.UtcNow.Date;
        if (when.Date == today) return L["today"].Value + " " + when.ToString("HH:mm", ci);
        if (when.Date == today.AddDays(-1)) return L["yesterday"].Value;
        return when.ToString("d MMM", ci);
    }
}
