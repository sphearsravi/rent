@model RentCollection.Core.Entities.Invoice
@using RentCollection.Core.Entities
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var invNo = $"INV-{Model.InvoiceId:D6}";
    ViewData["Title"] = $"{L["Invoice"].Value} {invNo}";

    var balance = Model.TotalAmount - Model.PaidAmount;
    var pdfLang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    // One source of truth: Download and Print use the SAME QuestPDF document
    // (letterhead, proper invoice layout). Print opens it inline so the
    // browser's PDF viewer prints the real invoice — not the admin page.
    // ?culture matches the current UI language, so an Arabic session gets the
    // Arabic right-to-left invoice.
    var pdfHref = $"/api/tenant/{Model.TenantId}/invoices/{Model.InvoiceId}/invoice.pdf?culture={pdfLang}";
    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var canMarkPaid = isSuperAdmin && Model.Status != "Paid" && Model.Status != "Pending Verification";

    var tenant = Model.Tenant;
    var tenantName = string.Join(" ", new[] { tenant?.FirstName, tenant?.LastName }.Where(s => !string.IsNullOrWhiteSpace(s)));
    if (string.IsNullOrWhiteSpace(tenantName)) { tenantName = "—"; }
    var lease = Model.Lease;
    var unit = lease?.Unit;
    var property = unit?.Property;

    var isOpen = Model.Status != "Paid" && Model.Status != "Cancelled";
    var daysToDue = (Model.DueDate.Date - DateTime.Today).Days;
    string dueSub = !isOpen
        ? L[Model.Status].Value
        : daysToDue < 0 ? $"{-daysToDue} {L["days overdue"].Value}"
        : daysToDue == 0 ? L["due today"].Value
        : $"{L["due in"].Value} {daysToDue} {L["days"].Value}";

    string Chip(string s) => s switch
    {
        "Paid" => "lp-chip-green",
        "Overdue" => "lp-chip-red",
        "Pending" => "lp-chip-amber",
        "Partially Paid" => "lp-chip-amber",
        "Pending Verification" => "lp-chip-blue",
        "Cancelled" => "lp-chip-grey",
        _ => "lp-chip-grey",
    };
    string ChipIcon(string s) => s switch
    {
        "Paid" => "fa-check-circle",
        "Overdue" => "fa-exclamation-circle",
        "Pending" => "fa-clock",
        "Partially Paid" => "fa-adjust",
        "Pending Verification" => "fa-hourglass-half",
        "Cancelled" => "fa-ban",
        _ => "fa-circle",
    };
    string PayChip(string s) => s switch
    {
        "Completed" => "lp-chip-green",
        "Approved" => "lp-chip-green",
        "PendingVerification" => "lp-chip-blue",
        "Pending" => "lp-chip-amber",
        "Failed" => "lp-chip-red",
        "Rejected" => "lp-chip-red",
        "Refunded" => "lp-chip-purple",
        _ => "lp-chip-grey",
    };
    string PayLabel(string s) => s switch
    {
        "PendingVerification" => L["Awaiting confirmation"].Value,
        _ => L[s].Value,
    };
    string MethodLabel(string m) => m switch
    {
        "KNET" => "K-NET",
        "BankTransfer" => L["Bank transfer"].Value,
        _ => L[m].Value,
    };
    string MethodIcon(string m) => m switch
    {
        "KNET" => "fa-credit-card",
        "Cash" => "fa-money-bill",
        "BankTransfer" => "fa-building-columns",
        "Cheque" => "fa-money-check",
        _ => "fa-receipt",
    };

    var allPayments = (lease?.Payments ?? new List<Payment>()).ToList();
    var linkedPayments = allPayments.Where(p => p.InvoiceId == Model.InvoiceId).ToList();
    var showingLeasePayments = linkedPayments.Count == 0 && allPayments.Count > 0;
    var payments = (linkedPayments.Count > 0 ? linkedPayments : allPayments).OrderByDescending(p => p.PaymentDate).ToList();

    var statusChipHtml = "<span class=\"lp-chip " + Chip(Model.Status) + "\" style=\"font-size:0.74rem;padding:0.3rem 0.7rem\"><i class=\"fas " + ChipIcon(Model.Status) + "\"></i> " + L[Model.Status].Value + "</span>";
    var actions = new System.Text.StringBuilder();
    actions.Append(statusChipHtml);
    actions.Append("<a class=\"lp-btn\" href=\"" + pdfHref + "\" download=\"" + invNo + ".pdf\"><i class=\"fas fa-file-pdf\"></i> " + L["Download PDF"].Value + "</a>");
    actions.Append("<a class=\"lp-btn\" target=\"_blank\" rel=\"noopener\" href=\"" + pdfHref + "\"><i class=\"fas fa-print\"></i> " + L["Print"].Value + "</a>");
    if (balance > 0 && Model.Status != "Cancelled")
    {
        actions.Append("<a class=\"lp-btn lp-btn-primary\" href=\"/CashPayment/Record?invoiceId=" + Model.InvoiceId + "\"><i class=\"fas fa-money-bill\"></i> " + L["Record cash"].Value + "</a>");
    }
    actions.Append("<a class=\"lp-btn\" href=\"/Invoices\"><i class=\"fas fa-arrow-left\"></i> " + L["Back to List"].Value + "</a>");
}

<div class="lp-page">
    @await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData)
    {
        ["Title"] = $"{L["Invoice"].Value} {invNo}",
        ["Subtitle"] = string.Join(" · ", new[] { L[Model.InvoiceType].Value, Model.InvoiceDate.ToString("MMMM yyyy", inv), tenantName }.Where(s => !string.IsNullOrWhiteSpace(s))),
        ["Crumbs"] = new (string label, string? href)[] { (L["Admin"].Value, "/Dashboard"), (L["Invoices"].Value, "/Invoices"), (invNo, null) },
        ["ActionsHtml"] = Html.Raw(actions.ToString())
    })

    @await Html.PartialAsync("_AlertMessages")

    @* ── KPI strip ── *@
    <div class="od od-grid-kpi lp-kpi-5">
        <div class="od-card od-kpi-hero">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Total"]</span></div>
            <div class="od-kpi-value">@Model.TotalAmount.ToString("N3", inv) <small>KWD</small></div>
            <div class="od-kpi-sub">@L["Invoice date"] @Model.InvoiceDate.ToString("dd MMM yyyy", inv)</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Paid"]</span></div>
            <div class="od-kpi-value @(Model.PaidAmount > 0 ? "od-count-green" : "")">@Model.PaidAmount.ToString("N3", inv) <small>KWD</small></div>
            @{ var completedCount = payments.Count(p => p.Status == RentCollection.Core.Enums.PaymentStatus.Completed); }
            <div class="od-kpi-sub">@(completedCount > 0 ? $"{completedCount} {L["completed payments"].Value}" : L["No payments yet"].Value)</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Balance"]</span></div>
            <div class="od-kpi-value @(balance > 0 ? "od-count-red" : "")">@balance.ToString("N3", inv) <small>KWD</small></div>
            <div class="od-kpi-sub">@(balance > 0 ? L["outstanding"].Value : L["settled"].Value)</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Due date"]</span></div>
            <div class="od-kpi-value @(isOpen && daysToDue < 0 ? "od-count-red" : "")">@Model.DueDate.ToString("dd MMM yyyy", inv)</div>
            <div class="od-kpi-sub">@dueSub</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Status"]</span></div>
            <div class="od-kpi-value" style="margin-top:4px"><span class="lp-chip @Chip(Model.Status)" style="font-size:0.78rem;padding:0.3rem 0.75rem"><i class="fas @ChipIcon(Model.Status)"></i> @L[Model.Status]</span></div>
            <div class="od-kpi-sub">@L["Created"] @Model.CreatedDate.ToString("dd MMM yyyy", inv)</div>
        </div>
    </div>

    <div class="pd-grid">
        <div class="pd-main">

            @* ── Line items ── *@
            <section class="lp-table-wrap pd-section">
                <div class="pd-section-head">
                    <h2><i class="fas fa-file-invoice-dollar"></i> @L["Line items"]</h2>
                    <span class="lp-chip lp-chip-gold">@L[Model.InvoiceType]</span>
                </div>
                <table class="lp-table">
                    <thead>
                        <tr>
                            <th>@L["Description"]</th>
                            <th>@L["Type"]</th>
                            <th class="lp-num">@L["Amount (KWD)"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td data-label="@L["Description"]">
                                <span class="lp-primary">@L[Model.InvoiceType]</span>
                                <span class="lp-sub">@(string.IsNullOrWhiteSpace(Model.Notes) ? L["Monthly rent payment"].Value : Model.Notes)</span>
                            </td>
                            <td data-label="@L["Type"]"><span class="lp-chip lp-chip-blue">@L[Model.InvoiceType]</span></td>
                            <td class="lp-num" data-label="@L["Amount (KWD)"]"><span class="lp-amount">@Model.TotalAmount.ToString("N3", inv)</span></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2" class="lp-right">@L["Subtotal"]</td>
                            <td class="lp-num" data-label="@L["Subtotal"]">@Model.TotalAmount.ToString("N3", inv)</td>
                        </tr>
                        <tr>
                            <td colspan="2" class="lp-right">@L["Tax"]</td>
                            <td class="lp-num" data-label="@L["Tax"]"><span class="lp-amount-muted">0.000</span></td>
                        </tr>
                        <tr style="background:#fbfaf6">
                            <td colspan="2" class="lp-right lp-primary">@L["Total"]</td>
                            <td class="lp-num" data-label="@L["Total"]"><span class="lp-amount">@Model.TotalAmount.ToString("N3", inv)</span></td>
                        </tr>
                        <tr>
                            <td colspan="2" class="lp-right">@L["Paid"]</td>
                            <td class="lp-num" data-label="@L["Paid"]"><span class="lp-amount lp-amount-good">@Model.PaidAmount.ToString("N3", inv)</span></td>
                        </tr>
                        <tr style="background:#fbfaf6">
                            <td colspan="2" class="lp-right lp-primary">@L["Balance due"]</td>
                            <td class="lp-num" data-label="@L["Balance due"]"><span class="lp-amount @(balance > 0 ? "lp-amount-bad" : "lp-amount-muted")">@balance.ToString("N3", inv)</span></td>
                        </tr>
                    </tfoot>
                </table>
            </section>

            @* ── Payments applied ── *@
            <section class="lp-table-wrap pd-section">
                <div class="pd-section-head">
                    <h2><i class="fas fa-money-bill-wave"></i> @L["Payments applied"] <span class="lp-chip lp-chip-gold">@payments.Count</span></h2>
                    <div class="lp-row-actions">
                        @if (showingLeasePayments) { <span class="lp-chip lp-chip-amber" title="@(L["No payment is linked to this invoice; showing all payments on the lease."].Value)"><i class="fas fa-link-slash"></i> @L["All lease payments"]</span> }
                        <a class="lp-btn" href="/Payments?leaseId=@Model.LeaseId"><i class="fas fa-list"></i> @L["All payments"]</a>
                    </div>
                </div>
                @if (payments.Count == 0)
                {
                    <div class="lp-empty" style="border:0">
                        <i class="fas fa-receipt"></i>
                        <h3>@L["No payments yet"]</h3>
                        @if (balance > 0 && Model.Status != "Cancelled") { <p><a href="/CashPayment/Record?invoiceId=@Model.InvoiceId">@L["Record a cash payment"]</a></p> }
                    </div>
                }
                else
                {
                    <table class="lp-table">
                        <thead>
                            <tr>
                                <th>@L["Date"]</th>
                                <th>@L["Method"]</th>
                                <th>@L["Reference"]</th>
                                <th class="lp-num">@L["Amount (KWD)"]</th>
                                <th>@L["Status"]</th>
                                <th class="lp-right">@L["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in payments)
                            {
                                var method = p.PaymentType.ToString();
                                var pStatus = p.Status.ToString();
                                <tr class="@(pStatus == "Failed" || pStatus == "Rejected" || pStatus == "Cancelled" ? "is-muted" : "")">
                                    <td data-label="@L["Date"]" style="white-space:nowrap">@p.PaymentDate.ToString("dd MMM yyyy", inv)<span class="lp-sub">@p.PaymentDate.ToString("HH:mm", inv)</span></td>
                                    <td data-label="@L["Method"]"><span class="lp-chip lp-chip-grey"><i class="fas @MethodIcon(method)"></i> @MethodLabel(method)</span></td>
                                    <td data-label="@L["Reference"]">
                                        <a class="lp-link lp-mono" href="/Payments/Details/@p.PaymentId">@(string.IsNullOrWhiteSpace(p.ReceiptNumber) ? $"#{p.PaymentId}" : p.ReceiptNumber)</a>
                                        @if (!string.IsNullOrWhiteSpace(p.TransactionReference)) { <span class="lp-sub lp-mono">@p.TransactionReference</span> }
                                    </td>
                                    <td class="lp-num" data-label="@L["Amount (KWD)"]"><span class="lp-amount">@p.AmountPaid.ToString("N3", inv)</span></td>
                                    <td data-label="@L["Status"]"><span class="lp-chip @PayChip(pStatus)">@PayLabel(pStatus)</span></td>
                                    <td class="lp-right" data-label="@L["Actions"]">
                                        <div class="lp-row-actions">
                                            <a class="lp-icon-btn" title="@(L["Details"].Value)" href="/Payments/Details/@p.PaymentId"><i class="fas fa-eye"></i></a>
                                            @if (pStatus == "Completed") { <a class="lp-icon-btn" title="@(L["Receipt PDF"].Value)" target="_blank" rel="noopener" href="/api/payments/@p.PaymentId/receipt.pdf"><i class="fas fa-file-pdf"></i></a> }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        </div>

        <aside class="pd-side">
            <div class="pd-card">
                <div class="pd-card-head"><i class="fas fa-user"></i> @L["Tenant"]</div>
                <dl class="pd-dl">
                    <div><dt>@L["Name"]</dt><dd>@if (tenant != null) { <a class="lp-link" href="/Tenants/Details/@tenant.TenantId">@tenantName</a> } else { <span>—</span> }</dd></div>
                    <div><dt>@L["Civil ID"]</dt><dd class="lp-mono">@(string.IsNullOrWhiteSpace(tenant?.PACINumber) ? "—" : tenant!.PACINumber)</dd></div>
                    <div><dt>@L["Phone"]</dt><dd>@if (!string.IsNullOrWhiteSpace(tenant?.Phone)) { <a class="lp-link" href="tel:@tenant.Phone">@tenant.Phone</a> } else { <span>—</span> }</dd></div>
                    <div><dt>@L["Email"]</dt><dd style="overflow-wrap:anywhere">@if (!string.IsNullOrWhiteSpace(tenant?.Email)) { <a class="lp-link" href="mailto:@tenant.Email">@tenant.Email</a> } else { <span>—</span> }</dd></div>
                </dl>
            </div>

            <div class="pd-card">
                <div class="pd-card-head"><i class="fas fa-building"></i> @L["Property & unit"]</div>
                <dl class="pd-dl">
                    <div><dt>@L["Property"]</dt><dd>@if (property != null) { <a class="lp-link" href="/Properties/Details/@property.PropertyId">@property.PropertyName</a> } else { <span>—</span> }</dd></div>
                    <div><dt>@L["Unit"]</dt><dd>@if (unit != null) { <a class="lp-link" href="/Units/Details/@unit.UnitId">@unit.UnitNumber</a> } else { <span>—</span> }</dd></div>
                    <div><dt>@L["Address"]</dt><dd style="text-align:end">@(string.IsNullOrWhiteSpace(property?.Address) ? "—" : property!.Address)</dd></div>
                    <div><dt>@L["Governorate"]</dt><dd>@(string.IsNullOrWhiteSpace(property?.Governorate) ? "—" : property!.Governorate)</dd></div>
                </dl>
            </div>

            <div class="pd-card">
                <div class="pd-card-head"><i class="fas fa-file-contract"></i> @L["Lease"]</div>
                <dl class="pd-dl">
                    <div><dt>@L["Lease"]</dt><dd><a class="lp-link" href="/Leases/Details/@Model.LeaseId">#@Model.LeaseId</a></dd></div>
                    @if (lease != null)
                    {
                        <div><dt>@L["Period"]</dt><dd style="white-space:nowrap">@lease.LeaseStartDate.ToString("dd MMM yy", inv) → @lease.LeaseEndDate.ToString("dd MMM yy", inv)</dd></div>
                        <div><dt>@L["Monthly rent"]</dt><dd>@lease.MonthlyRent.ToString("N3", inv) KWD</dd></div>
                        <div><dt>@L["Status"]</dt><dd><span class="lp-chip @(lease.Status == LeaseStatuses.Active ? "lp-chip-green" : lease.Status == LeaseStatuses.Pending ? "lp-chip-amber" : "lp-chip-grey")">@L[lease.Status]</span></dd></div>
                    }
                </dl>
            </div>

            <div class="pd-card">
                <div class="pd-card-head"><i class="fas fa-sticky-note"></i> @L["Notes"]</div>
                <div class="pd-note" style="white-space:pre-wrap">@(string.IsNullOrWhiteSpace(Model.Notes) ? L["No notes"].Value : Model.Notes)</div>
            </div>

            @if (canMarkPaid)
            {
                <div class="pd-card pd-danger">
                    <div class="pd-card-head"><i class="fas fa-user-shield"></i> @L["Mark as Paid"]</div>
                    <div class="pd-note">@L["Marks this invoice as fully paid without a payment record. Bypasses payment approval; SuperAdmin only."]</div>
                    <form asp-action="MarkAsPaid" method="post" class="pd-actions-card" style="padding-top:0" onsubmit="return confirm('Mark this invoice as paid? This bypasses payment approval.')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.InvoiceId" />
                        <button type="submit" class="lp-btn lp-btn-export">
                            <i class="fas fa-check"></i> @L["Mark as Paid"]
                        </button>
                    </form>
                </div>
            }
        </aside>
    </div>
</div>
