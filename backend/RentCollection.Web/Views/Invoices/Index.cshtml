@model IEnumerable<RentCollection.Core.Entities.Invoice>

@{
    ViewData["Title"] = "Invoices";
    var totalInvoices = Model.Count();
    var pendingAmount = Model.Where(i => i.Status == "Pending").Sum(i => i.TotalAmount - i.PaidAmount);
    var paidAmount = Model.Sum(i => i.PaidAmount);
    var overdueCount = Model.Count(i => i.Status == "Overdue");
}

<div class="page-container">
    @await Html.PartialAsync("_AlertMessages")

    @{
        string invoicesActionsHtml;
        using (var __sw = new System.IO.StringWriter())
        {
            Html.AntiForgeryToken().WriteTo(__sw, System.Text.Encodings.Web.HtmlEncoder.Default);
            var antiForgery = __sw.ToString();
            var generateUrl = Url.Action("GenerateMonthlyInvoices");
            invoicesActionsHtml =
                "<form action=\"" + generateUrl + "\" method=\"post\" style=\"display: inline;\" onsubmit=\"return confirm('Generate monthly invoices for all active leases now?')\">" +
                antiForgery +
                "<button type=\"submit\" class=\"btn btn-primary\">" +
                "<i class=\"fas fa-file-invoice\"></i> Generate Monthly Invoices" +
                "</button>" +
                "</form>";
        }
    }
    @await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData) {
        ["Title"] = "Invoice Management",
        ["Subtitle"] = "Manage and track all invoices for your properties",
        ["ActionsHtml"] = new Microsoft.AspNetCore.Html.HtmlString(invoicesActionsHtml)
    })

    <!-- Summary Cards -->
    <div class="summary-cards">
        <div class="summary-card">
            <div class="summary-icon total">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div class="summary-info">
                <h3>@totalInvoices</h3>
                <p>@L["Total Invoices"]</p>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon pending">
                <i class="fas fa-clock"></i>
            </div>
            <div class="summary-info">
                <h3>KWD @pendingAmount.ToString("N3")</h3>
                <p>@L["Pending Amount"]</p>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon paid">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="summary-info">
                <h3>KWD @paidAmount.ToString("N3")</h3>
                <p>@L["Paid Amount"]</p>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon overdue">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="summary-info">
                <h3>@overdueCount</h3>
                <p>@L["Overdue Count"]</p>
            </div>
        </div>
    </div>

    <!-- Search/Filter Section -->
    <div class="filter-section">
        <div class="filter-row">
            <div class="search-group">
                <i class="fas fa-search"></i>
                <input type="text" id="searchInput" placeholder="@(L["Search by invoice #, tenant name, email, or property..."].Value)" onkeyup="filterInvoices()">
            </div>
            <div class="filter-group">
                <label>@L["Property:"]</label>
                <select id="propertyFilter" onchange="filterInvoices()">
                    <option value="">@L["All Properties"]</option>
                    @foreach (var prop in Model.Select(i => i.Lease.Unit.Property).DistinctBy(p => p.PropertyId).OrderBy(p => p.PropertyName))
                    {
                        <option value="@prop.PropertyId">@prop.PropertyName</option>
                    }
                </select>
            </div>
            <button class="btn-clear" onclick="clearFilters()">
                <i class="fas fa-times"></i> @L["Clear"]
            </button>
        </div>
        <div class="filter-results">
            <span id="resultCount">@L["Showing all"] @totalInvoices @L["invoices"]</span>
        </div>
    </div>

    <!-- Filter Tabs — by Status -->
    <div class="filter-tabs">
        <button class="filter-tab active" data-filter="all">
            <i class="fas fa-list"></i> @L["All Invoices"]
        </button>
        <button class="filter-tab" data-filter="Pending">
            <i class="fas fa-clock"></i> @L["Pending"]
        </button>
        <button class="filter-tab" data-filter="Paid">
            <i class="fas fa-check"></i> @L["Paid"]
        </button>
        <button class="filter-tab" data-filter="Overdue">
            <i class="fas fa-exclamation"></i> @L["Overdue"]
        </button>
    </div>

    <!-- Filter Tabs — by InvoiceType (deposit + insurance plan) -->
    <div class="filter-tabs type-tabs">
        <button class="filter-tab type-tab active" data-type-filter="all">
            <i class="fas fa-layer-group"></i> @L["All Types"]
        </button>
        <button class="filter-tab type-tab" data-type-filter="Rent">
            <i class="fas fa-home"></i> @L["Rent"]
        </button>
        <button class="filter-tab type-tab" data-type-filter="Deposit">
            <i class="fas fa-shield-halved"></i> @L["Deposit"]
        </button>
        <button class="filter-tab type-tab" data-type-filter="Insurance">
            <i class="fas fa-umbrella"></i> @L["Insurance"]
        </button>
        <button class="filter-tab type-tab" data-type-filter="LateFee">
            <i class="fas fa-triangle-exclamation"></i> @L["Late Fee"]
        </button>
        <button class="filter-tab type-tab" data-type-filter="Other">
            <i class="fas fa-ellipsis"></i> @L["Other"]
        </button>
    </div>

    <!-- Invoices Table -->
    @* Sprint 25 — the 10-column table overflows on narrow viewports (<992px).
       The inner .table-scroll wrapper gives it a horizontal scrollbar on
       mobile/tablet instead of clipping the right-most columns. Min-width
       keeps the layout stable; without it, browsers shrink columns until
       text wraps unreadably. *@
    <div class="table-container">
      <div class="table-scroll" style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
        <table class="data-table" style="min-width: 1100px;">
            <thead>
                <tr>
                    <th>@L["Invoice #"]</th>
                    <th>@L["Type"]</th>
                    <th>@L["Tenant Name"]</th>
                    <th>@L["Property/Unit"]</th>
                    <th>@L["Invoice Date"]</th>
                    <th>@L["Due Date"]</th>
                    <th>@L["Amount (KWD)"]</th>
                    <th>@L["Paid Amount (KWD)"]</th>
                    <th>@L["Status"]</th>
                    <th>@L["Actions"]</th>
                </tr>
            </thead>
            <tbody id="invoiceTableBody">
                @foreach (var invoice in Model)
                {
                    var tenantName = $"{invoice.Tenant.FirstName} {invoice.Tenant.LastName}";
                    var tenantEmail = invoice.Tenant.Email ?? "";
                    var propertyName = invoice.Lease.Unit.Property.PropertyName;
                    var unitNumber = invoice.Lease.Unit.UnitNumber;
                    var invoiceType = string.IsNullOrEmpty(invoice.InvoiceType) ? "Other" : invoice.InvoiceType;
                    var (typePillBg, typePillFg, typePillIcon, typePillLabel) = invoiceType switch
                    {
                        "Rent"           => ("#dbeafe", "#1e40af", "fa-home",                  "Rent"),
                        "Deposit"        => ("#d1fae5", "#065f46", "fa-shield-halved",        "Deposit"),
                        "Insurance"      => ("#ede9fe", "#5b21b6", "fa-umbrella",             "Insurance"),
                        "LateFee"        => ("#fee2e2", "#991b1b", "fa-triangle-exclamation", "Late Fee"),
                        "MaintenanceFee" => ("#fef3c7", "#92400e", "fa-screwdriver-wrench",   "Maintenance"),
                        _                => ("#f1f5f9", "#475569", "fa-ellipsis",             invoiceType),
                    };
                    <tr class="invoice-row"
                        data-status="@invoice.Status"
                        data-invoice-type="@invoiceType"
                        data-tenant-name="@tenantName"
                        data-tenant-email="@tenantEmail"
                        data-property-id="@invoice.Lease.Unit.Property.PropertyId"
                        data-property-name="@propertyName"
                        data-unit-number="@unitNumber"
                        data-invoice-id="@invoice.InvoiceId">
                        <td><strong>#@invoice.InvoiceId.ToString("D5")</strong></td>
                        <td>
                            <span class="type-pill"
                                  style="background:@typePillBg; color:@typePillFg;">
                                <i class="fas @typePillIcon"></i> @typePillLabel
                            </span>
                        </td>
                        <td>@invoice.Tenant.FirstName @invoice.Tenant.LastName</td>
                        <td>
                            @invoice.Lease.Unit.Property.PropertyName<br />
                            <small class="text-muted">@L["Unit"] @invoice.Lease.Unit.UnitNumber</small>
                        </td>
                        <td>@invoice.InvoiceDate.ToString("dd MMM yyyy")</td>
                        <td>@invoice.DueDate.ToString("dd MMM yyyy")</td>
                        <td class="text-right"><strong>@invoice.TotalAmount.ToString("N3")</strong></td>
                        <td class="text-right">@invoice.PaidAmount.ToString("N3")</td>
                        <td>
                            @if (invoice.Status == "Pending")
                            {
                                <span class="badge badge-warning">
                                    <i class="fas fa-clock"></i> @L["Pending"]
                                </span>
                            }
                            else if (invoice.Status == "Paid")
                            {
                                <span class="badge badge-success">
                                    <i class="fas fa-check-circle"></i> @L["Paid"]
                                </span>
                            }
                            else if (invoice.Status == "Overdue")
                            {
                                <span class="badge badge-danger">
                                    <i class="fas fa-exclamation-circle"></i> @L["Overdue"]
                                </span>
                            }
                            else if (invoice.Status == "Cancelled")
                            {
                                <span class="badge badge-secondary">
                                    <i class="fas fa-ban"></i> @L["Cancelled"]
                                </span>
                            }
                            else if (invoice.Status == "Partially Paid")
                            {
                                <span class="badge badge-warning">
                                    <i class="fas fa-adjust"></i> @L["Partially Paid"]
                                </span>
                            }
                            else if (invoice.Status == "Pending Verification")
                            {
                                <span class="badge badge-warning">
                                    <i class="fas fa-hourglass-half"></i> @L["Pending Verification"]
                                </span>
                            }
                            else if (!string.IsNullOrEmpty(invoice.Status))
                            {
                                <span class="badge badge-secondary">@invoice.Status</span>
                            }
                        </td>
                        <td>
                            <div class="action-buttons">
                                <a asp-action="Details" asp-route-id="@invoice.InvoiceId" class="btn-action btn-info" title="@(L["View Details"].Value)">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (invoice.Status != "Paid" && invoice.Status != "Pending Verification")
                                {
                                    <form asp-action="MarkAsPaid" method="post" style="display: inline;" onsubmit="return confirm('Mark this invoice as paid? This bypasses payment approval.')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@invoice.InvoiceId" />
                                        <button type="submit" class="btn-action btn-success" title="@(L["Mark as Paid"].Value)">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                }
                                @if (invoice.Status == "Pending" && invoice.DueDate < DateTime.Now)
                                {
                                    <form asp-action="MarkAsOverdue" method="post" style="display: inline;" onsubmit="return confirm('Mark this invoice as overdue?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@invoice.InvoiceId" />
                                        <button type="submit" class="btn-action btn-warning" title="@(L["Mark as Overdue"].Value)">
                                            <i class="fas fa-exclamation"></i>
                                        </button>
                                    </form>
                                }
                                <a asp-action="Delete" asp-route-id="@invoice.InvoiceId" class="btn-action btn-danger" title="@(L["Delete"].Value)">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
      </div>
      <!-- /.table-scroll (Sprint 25 horizontal-scroll wrapper) -->

        <!-- No Results Message -->
        <div id="noResultsMessage" class="no-results" style="display: none;">
            <i class="fas fa-search"></i>
            <h3>@L["No invoices found"]</h3>
            <p>@L["Try adjusting your search criteria or filters"]</p>
            <button class="btn btn-primary" onclick="clearFilters()">
                <i class="fas fa-redo"></i> @L["Reset Filters"]
            </button>
        </div>
    </div>
</div>

@section Styles {
    <style>
        body {
            background: linear-gradient(135deg, #f8fafc 0%, #f2e8c8 50%, #e6d4a0 100%);
            color: #1e293b;
            min-height: 100vh;
        }

        /* Scrollbar styles */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        .page-container {
            padding: 2rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .page-header h1 {
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
            color: #334155;
        }

        .text-muted {
            color: #475569;
            margin: 0.5rem 0 0 0;
        }

        .header-actions {
            display: flex;
            gap: 1rem;
        }

        .btn {
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s;
            border: none;
            cursor: pointer;
        }

        .btn-primary {
            background: linear-gradient(135deg, #8a6d1f, #b8860b);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(138, 109, 31, 0.4);
        }

        .alert {
            padding: 1rem 1.5rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .alert-success {
            background: #d1fae5;
            color: #065f46;
            border-left: 4px solid #10b981;
        }

        .alert-danger {
