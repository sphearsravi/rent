@model RentCollection.Core.Entities.Lease

@{
    ViewData["Title"] = "Create Lease";
}

@*
    Sprint 23 — Lease Create revamp.
    Zones: Essentials (Building/Unit/Tenant + Dates + Rent), Optional
    (Late fees, Lease type, Insurance), Documents. Optional zone is
    collapsed by default; the operator opens it only when they need it.

    Sprint 11 Select2 cascade + Sprint 20 inline documents preserved.
*@

<div class="container-fluid">
    <div class="page-header page-header-flex">
        <div>
            <h1>@L["Create New Lease"]</h1>
            <p class="text-muted">@L["Pick a unit + tenant, set dates + rent. Everything else is optional."]</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> @L["Back to List"]
            </a>
        </div>
    </div>

    @if (TempData["LeaseCreated"] != null)
    {
        <div class="alert alert-success" style="margin-bottom:1rem;">
            <i class="fas fa-check-circle"></i> @L["Lease"] @TempData["LeaseCreated"] @L["saved. Add another below."]
        </div>
    }

    <form asp-action="Create" method="post" enctype="multipart/form-data"
          class="form-revamp" id="leaseCreateForm">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div data-fr-draft-slot></div>

        @* ─────────── Zone 1 — Essentials ─────────── *@
        <div class="fr-zone fr-zone-essentials">
            <h3 class="fr-zone-title">
                <i class="fas fa-asterisk"></i>
                <span>@L["Essentials"]</span>
            </h3>
            <p class="fr-zone-hint">@L["Required to save. Picking a Building filters Units."]</p>

            <div class="fr-row">
                <div class="fr-field">
                    <label for="buildingSelect">@L["Building"] <span class="required">*</span></label>
                    <select id="buildingSelect" class="select2-enable" asp-items="ViewBag.PropertyId">
                        <option value="">@L["-- Select Building --"]</option>
                    </select>
                    <span class="fr-hint">@L["Pick this first to narrow the Unit list"]</span>
                </div>
                <div class="fr-field">
                    <label asp-for="UnitId">@L["Unit"] <span class="required">*</span></label>
                    <select asp-for="UnitId" id="unitSelect" class="select2-enable" asp-items="ViewBag.UnitId">
                        <option value="">@L["-- Select Unit --"]</option>
                    </select>
                    <span asp-validation-for="UnitId" class="fr-hint is-error"></span>
                </div>
            </div>

            <div class="fr-row fr-row-1">
                <div class="fr-field">
                    <label asp-for="TenantId">@L["Tenant"] <span class="required">*</span></label>
                    <select asp-for="TenantId" id="tenantSelect" class="select2-enable" asp-items="ViewBag.TenantId">
                        <option value="">@L["-- Select Tenant --"]</option>
                    </select>
                    <span asp-validation-for="TenantId" class="fr-hint is-error"></span>
                </div>
            </div>

            <div class="fr-row">
                <div class="fr-field">
                    <label asp-for="LeaseStartDate">@L["Start Date"] <span class="required">*</span></label>
                    <input asp-for="LeaseStartDate" type="date" required />
                    <span asp-validation-for="LeaseStartDate" class="fr-hint is-error"></span>
                </div>
                <div class="fr-field">
                    <label asp-for="LeaseEndDate">@L["End Date"] <span class="required">*</span></label>
                    <input asp-for="LeaseEndDate" type="date" required />
                    <span asp-validation-for="LeaseEndDate" class="fr-hint is-error"></span>
                </div>
            </div>

            <div class="fr-row">
                <div class="fr-field">
                    <label asp-for="MonthlyRent">@L["Monthly Rent"] <span class="required">*</span></label>
                    <div class="fr-currency">
                        <span class="fr-prefix">KWD</span>
                        <input asp-for="MonthlyRent" type="number" step="0.001" min="0" required />
                    </div>
                    <span asp-validation-for="MonthlyRent" class="fr-hint is-error"></span>
                </div>
                <div class="fr-field">
                    <label asp-for="SecurityDeposit">@L["Security Deposit"] <span class="optional">@L["optional"]</span></label>
                    <div class="fr-currency">
                        <span class="fr-prefix">KWD</span>
                        <input asp-for="SecurityDeposit" type="number" step="0.001" min="0" value="0" data-val-required="false" />
                    </div>
                    <span class="fr-hint">@L["> 0 ⇒ lease starts Pending until deposit invoice is collected"]</span>
                </div>
            </div>
        </div>

        @* Sprint 11 — units-by-building map for the cascade. *@
        <script id="unitsByBuilding" type="application/json">@Html.Raw(ViewBag.UnitsByBuildingJson ?? "{}")</script>

        @* ─────────── Zone 2 — More details (collapsed) ─────────── *@
        <button type="button" class="fr-toggle-more" data-fr-toggle="moreLease">
            <i class="fas fa-chevron-down"></i>
            <span>@L["More details (late fees, lease type, insurance)"]</span>
        </button>
        <div data-fr-collapsible="moreLease">
            <div class="fr-zone">
                <h3 class="fr-zone-title">
                    <i class="fas fa-money-bill-wave"></i>
                    <span>@L["Payment & Late Fees"]</span>
                </h3>
                <div class="fr-row fr-row-3">
                    <div class="fr-field">
                        <label asp-for="PaymentDueDay">@L["Due Day"] <span class="optional">1-31</span></label>
                        <input asp-for="PaymentDueDay" type="number" min="1" max="31" placeholder="@(L["Day of month"].Value)" />
                        <span class="fr-hint"></span>
                    </div>
                    <div class="fr-field">
                        <label asp-for="LateFeeAmount">@L["Late Fee"] <span class="optional">@L["optional"]</span></label>
                        <div class="fr-currency">
                            <span class="fr-prefix">KWD</span>
                            <input asp-for="LateFeeAmount" type="number" step="0.001" min="0" />
                        </div>
                        <span class="fr-hint"></span>
                    </div>
                    <div class="fr-field">
                        <label asp-for="LateFeeGracePeriod">@L["Grace Period"] <span class="optional">@L["days"]</span></label>
                        <input asp-for="LateFeeGracePeriod" type="number" min="0" />
                        <span class="fr-hint"></span>
                    </div>
                </div>
            </div>

            <div class="fr-zone">
                <h3 class="fr-zone-title">
                    <i class="fas fa-file-contract"></i>
                    <span>@L["Lease Settings"]</span>
                </h3>
                <div class="fr-row">
                    <div class="fr-field">
                        <label asp-for="LeaseType">@L["Lease Type"]</label>
                        <select asp-for="LeaseType">
                            <option value="Fixed">@L["Fixed Term"]</option>
                            <option value="Month-to-Month">@L["Month-to-Month"]</option>
                            <option value="Annual">@L["Annual"]</option>
                        </select>
                        <span class="fr-hint"></span>
                    </div>
                    <div class="fr-field"></div>
                </div>
            </div>

            <div class="fr-zone">
                <h3 class="fr-zone-title">
                    <i class="fas fa-shield-alt"></i>
                    <span>@L["Insurance"]</span>
                </h3>
                <p class="fr-zone-hint">@L["Set Frequency = None if this lease doesn't include insurance. Insurance invoices bill separately from rent."]</p>
                <div class="fr-row fr-row-3">
                    <div class="fr-field">
                        <label asp-for="InsuranceAmount">@L["Amount"]</label>
                        <div class="fr-currency">
                            <span class="fr-prefix">KWD</span>
                            <input asp-for="InsuranceAmount" type="number" step="0.001" min="0" placeholder="0.000" />
                        </div>
                        <span class="fr-hint"></span>
                    </div>
                    <div class="fr-field">
                        <label asp-for="InsuranceFrequency">@L["Frequency"]</label>
                        <select asp-for="InsuranceFrequency">
                            <option value="None">@L["None"]</option>
                            <option value="Monthly">@L["Monthly"]</option>
                            <option value="Annual">@L["Annual"]</option>
                            <option value="OneTime">@L["One-time (at lease start)"]</option>
                        </select>
                        <span class="fr-hint"></span>
                    </div>
                    <div class="fr-field">
                        <label asp-for="InsuranceStartDate">@L["Start"] <span class="optional">@L["optional"]</span></label>
                        <input asp-for="InsuranceStartDate" type="date" />
                        <span class="fr-hint">@L["Defaults to lease start"]</span>
                    </div>
                </div>
            </div>
        </div>

        @* ─────────── Zone 3 — Documents ─────────── *@
        <div class="fr-zone">
            <h3 class="fr-zone-title">
                <i class="fas fa-file-upload"></i>
                <span>@L["Documents"]</span>
            </h3>
            <p class="fr-zone-hint">@L["Signed lease, deposit receipt, insurance certificate, etc. Max 5MB per file."]</p>

            <div id="document-upload-area">
                <div class="document-row">
                    <div class="fr-row fr-row-3">
                        <div class="fr-field">
                            <label>@L["Document Type"]</label>
                            <select name="DocumentTypes[]">
                                <option value="">@L["-- Select Type --"]</option>
                                <option value="Signed Lease">@L["Signed Lease Agreement"]</option>
                                <option value="Deposit Receipt">@L["Security Deposit Receipt"]</option>
                                <option value="Insurance Document">@L["Insurance Document"]</option>
                                <option value="Addendum">@L["Lease Addendum"]</option>
                                <option value="Termination Notice">@L["Termination Notice"]</option>
                                <option value="Handover Form">@L["Unit Handover Form"]</option>
                                <option value="Inspection Report">@L["Inspection Report"]</option>
                                <option value="Other">@L["Other"]</option>
                            </select>
                        </div>
                        <div class="fr-field">
                            <label>@L["File"]</label>
                            <input type="file" name="Documents[]" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
                            <span class="fr-hint">@L["PDF, JPG, PNG, DOC, DOCX — max 5MB"]</span>
                        </div>
                        <div class="fr-field" style="justify-content:flex-end;">
                            <label>&nbsp;</label>
                            <button type="button" class="fr-btn fr-btn-ghost remove-document" style="display:none;">
                                <i class="fas fa-trash"></i> @L["Remove"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <button type="button" id="add-document-btn" class="fr-btn fr-btn-secondary" style="margin-top:0.5rem;">
                <i class="fas fa-plus"></i> @L["Add another document"]
            </button>
        </div>

        <div class="fr-actions">
            <a asp-action="Index" class="fr-btn fr-btn-ghost">@L["Cancel"]</a>
            <div class="fr-spacer"></div>
            <button type="submit" class="fr-btn fr-btn-secondary" data-fr-save-and-add>
                <i class="fas fa-plus"></i> @L["Save & add another"]
            </button>
            <button type="submit" class="fr-btn fr-btn-primary">
                <i class="fas fa-save"></i> @L["Create Lease"]
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        // Sprint 11 — Select2 typeahead + Building→Unit cascade.
        (function () {
            if (typeof jQuery === 'undefined' || typeof jQuery.fn.select2 === 'undefined') {
                console.warn('Select2 not available; using native selects.');
                return;
            }

            var $ = jQuery;
            var unitsByBuilding = {};
            try {
                unitsByBuilding = JSON.parse(document.getElementById('unitsByBuilding').textContent || '{}');
            } catch (e) {
                console.error('Failed to parse unitsByBuilding JSON', e);
            }

            $('.select2-enable').select2({ theme: 'bootstrap-5', width: '100%' });

            var $building = $('#buildingSelect');
            var $unit = $('#unitSelect');
            var preselectedUnitId = $unit.val();

            function rebuildUnitOptions(propertyId, preserveSelection) {
                var current = preserveSelection ? $unit.val() : '';
                $unit.empty().append('<option value="">-- Select Unit --</option>');
                var list = propertyId && unitsByBuilding[propertyId] ? unitsByBuilding[propertyId] : [];
                list.forEach(function (u) {
                    var opt = new Option(u.text, u.id, false, String(u.id) === String(current));
                    $unit.append(opt);
                });
                $unit.trigger('change.select2');
            }

            if (preselectedUnitId) {
                for (var pid in unitsByBuilding) {
                    if (!Object.prototype.hasOwnProperty.call(unitsByBuilding, pid)) continue;
                    var matches = unitsByBuilding[pid].some(function (u) {
                        return String(u.id) === String(preselectedUnitId);
                    });
                    if (matches) {
                        $building.val(pid).trigger('change.select2');
                        rebuildUnitOptions(pid, true);
                        break;
                    }
                }
            }

            $building.on('change', function () {
                rebuildUnitOptions(this.value, false);
            });
        })();
    </script>

    <script>
        // Inline document add/remove rows (revamped markup).
        (function () {
            var addBtn = document.getElementById('add-document-btn');
            if (!addBtn) return;

            var typeOptions =
                '<option value="">-- Select Type --</option>' +
                '<option value="Signed Lease">Signed Lease Agreement</option>' +
                '<option value="Deposit Receipt">Security Deposit Receipt</option>' +
                '<option value="Insurance Document">Insurance Document</option>' +
                '<option value="Addendum">Lease Addendum</option>' +
                '<option value="Termination Notice">Termination Notice</option>' +
                '<option value="Handover Form">Unit Handover Form</option>' +
                '<option value="Inspection Report">Inspection Report</option>' +
                '<option value="Other">Other</option>';

            function attachRemove(rowEl) {
                var btn = rowEl.querySelector('.remove-document');
                if (!btn) return;
                btn.addEventListener('click', function () {
                    rowEl.remove();
                    var rows = document.querySelectorAll('.document-row');
                    if (rows.length === 1) rows[0].querySelector('.remove-document').style.display = 'none';
                });
            }

            addBtn.addEventListener('click', function () {
                var area = document.getElementById('document-upload-area');
                var row = document.createElement('div');
                row.className = 'document-row';
                row.style.marginTop = '0.75rem';
                row.innerHTML =
                    '<div class="fr-row fr-row-3">' +
                        '<div class="fr-field">' +
                            '<label>Document Type</label>' +
                            '<select name="DocumentTypes[]">' + typeOptions + '</select>' +
                        '</div>' +
                        '<div class="fr-field">' +
                            '<label>File</label>' +
                            '<input type="file" name="Documents[]" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />' +
                            '<span class="fr-hint">PDF, JPG, PNG, DOC, DOCX — max 5MB</span>' +
                        '</div>' +
                        '<div class="fr-field" style="justify-content:flex-end;">' +
                            '<label>&nbsp;</label>' +
                            '<button type="button" class="fr-btn fr-btn-ghost remove-document">' +
                                '<i class="fas fa-trash"></i> Remove' +
                            '</button>' +
                        '</div>' +
                    '</div>';
                area.appendChild(row);
                var first = document.querySelector('.document-row:first-child .remove-document');
                if (first) first.style.display = 'inline-flex';
                attachRemove(row);
            });
        })();
    </script>
}
