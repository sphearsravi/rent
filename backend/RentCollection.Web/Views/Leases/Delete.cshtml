@model RentCollection.Core.Entities.Lease

@{
    ViewData["Title"] = "Delete Lease";
}

<div class="container-fluid">
    <div class="page-header">
        <div>
            <h1>@L["Delete Lease"]</h1>
            <p class="text-danger">@L["Are you sure you want to delete this lease?"]</p>
        </div>
    </div>

    <div class="delete-card">
        <div class="warning-banner">
            <i class="fas fa-exclamation-triangle"></i>
            <div>
                <h3>@L["Warning"]</h3>
                <p>@L["This action cannot be undone. Deleting this lease will remove all associated data including payment history and invoices."]</p>
            </div>
        </div>

        <div class="lease-summary">
            <h3>@L["Lease Information"]</h3>
            <dl class="summary-list">
                <dt>@L["Tenant"]</dt>
                <dd>@Model.Tenant.FirstName @Model.Tenant.LastName</dd>

                <dt>@L["Tenant Email"]</dt>
                <dd>@Model.Tenant.Email</dd>

                <dt>@L["Property"]</dt>
                <dd>@Model.Unit.Property.PropertyName</dd>

                <dt>@L["Unit"]</dt>
                <dd>@L["Unit"] @Model.Unit.UnitNumber</dd>

                <dt>@L["Lease Period"]</dt>
                <dd>@Model.LeaseStartDate.ToString("MMM dd, yyyy") - @Model.LeaseEndDate.ToString("MMM dd, yyyy")</dd>

                <dt>@L["Monthly Rent"]</dt>
                <dd class="highlight-amount">@Model.MonthlyRent.ToString("C")</dd>

                <dt>@L["Security Deposit"]</dt>
                <dd>@Model.SecurityDeposit.ToString("C")</dd>

                <dt>@L["Lease Status"]</dt>
                <dd>
                    @if (Model.Status == "Active")
                    {
                        <span class="badge badge-success">@L["Active"]</span>
                    }
                    else if (Model.Status == "Expired")
                    {
                        <span class="badge badge-danger">@L["Expired"]</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary">@Model.Status</span>
                    }
                </dd>

                @if (Model.Payments != null && Model.Payments.Any())
                {
                    <dt>@L["Total Payments"]</dt>
                    <dd>@Model.Payments.Count() @L["payment(s)"]</dd>
                }

                @if (Model.Invoices != null && Model.Invoices.Any())
                {
                    <dt>@L["Total Invoices"]</dt>
                    <dd>@Model.Invoices.Count() @L["invoice(s)"]</dd>
                }

                <dt>@L["Created Date"]</dt>
                <dd>@Model.CreatedDate.ToString("MMMM dd, yyyy")</dd>
            </dl>
        </div>

        @if (Model.Status == "Active")
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i>
                <div>
                    <strong>@L["Active Lease Detected!"]</strong>
                    <p>@L["This is an active lease. Consider terminating the lease and updating the unit status before deletion."]</p>
                </div>
            </div>
        }

        @* LEASE_AUDIT Flaw #18 Ã¢â‚¬” surface the renewal-chain risk. *@
        @if (ViewBag.SuccessorLeaseId != null)
        {
            var succActive = (bool?)ViewBag.SuccessorIsActive ?? false;
            <div class="alert @(succActive ? "alert-danger" : "alert-warning")">
                <i class="fas fa-link"></i>
                <div>
                    <strong>@L["Renewal chain link!"]</strong>
                    <p>
                        @L["This lease was renewed as lease"]
                        <a asp-action="Details" asp-route-id="@ViewBag.SuccessorLeaseId">#@ViewBag.SuccessorLeaseId</a>@(succActive ? ", which is still Active." : ".")
                        @L["Deleting it will orphan the successor's"]
                        <code>RenewedFromLeaseId</code> @L["back-link."]
                    </p>
                </div>
            </div>
        }

        @* LEASE_AUDIT Flaw #19 Ã¢â‚¬” controller pre-check blocks deletion when
           invoices/payments exist; show the same warning here so the
           operator doesn't even attempt it. *@
        @if (Model.Invoices != null && Model.Invoices.Any())
        {
            <div class="alert alert-danger">
                <i class="fas fa-ban"></i>
                <div>
                    <strong>@L["Deletion will fail."]</strong>
                    <p>@L["This lease has"] @Model.Invoices.Count() @L["invoice(s). Terminate it instead — financial history must be preserved."]</p>
                </div>
            </div>
        }

        @if (Model.Payments != null && Model.Payments.Any())
        {
            <div class="alert alert-warning">
                <i class="fas fa-info-circle"></i>
                <div>
                    <strong>@L["Payment History Will Be Lost!"]</strong>
                    <p>@L["This lease has"] @Model.Payments.Count() @L["payment record(s) that will be permanently deleted."]</p>
                </div>
            </div>
        }

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="LeaseId" />
            <div class="form-actions">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> @L["Confirm Delete"]
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times"></i> @L["Cancel"]
                </a>
                <a asp-action="Details" asp-route-id="@Model.LeaseId" class="btn btn-info">
                    <i class="fas fa-info-circle"></i> @L["View Details"]
                </a>
            </div>
        </form>
    </div>
</div>

<style>
    body {
        background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 50%, #c7d2fe 100%);
        color: #1e293b;
        min-height: 100vh;
    }

    .container-fluid {
        color: #1e293b;
    }

    .delete-card {
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid rgba(99, 102, 241, 0.2);
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        max-width: 900px;
    }

    .warning-banner {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
        padding: 1.5rem;
        border-radius: 8px;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .warning-banner i {
        font-size: 2rem;
        flex-shrink: 0;
    }

    .warning-banner h3 {
        margin: 0 0 0.5rem 0;
        font-size: 1.25rem;
        font-weight: 600;
    }

    .warning-banner p {
        margin: 0;
        opacity: 0.95;
    }

    .lease-summary {
        margin-bottom: 2rem;
    }

    .lease-summary h3 {
        font-size: 1.25rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #6366f1;
    }

    .summary-list {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 1rem 2rem;
        margin: 0;
    }

    .summary-list dt {
        font-weight: 600;
        color: #475569;
    }

    .summary-list dd {
        margin: 0;
        color: #1e293b;
    }

    .highlight-amount {
        font-size: 1.25rem;
        font-weight: 700;
        color: #10b981;
    }

    .badge {
        padding: 0.375rem 0.75rem;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
    }

    .badge-success {
        background: #dcfce7;
        color: #166534;
    }

    .badge-danger {
        background: #fee2e2;
        color: #991b1b;
    }

    .badge-secondary {
        background: #e5e7eb;
        color: #374151;
    }

    .alert {
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .alert i {
        font-size: 1.25rem;
        flex-shrink: 0;
        margin-top: 0.25rem;
    }

    .alert strong {
        display: block;
        margin-bottom: 0.25rem;
    }

    .alert p {
        margin: 0;
    }

    .alert-danger {
        background-color: #fee2e2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }

    .alert-warning {
        background-color: #fef3c7;
        border: 1px solid #fde68a;
        color: #92400e;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid #e2e8f0;
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 500;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-danger {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
    }

    .btn-danger:hover {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    }

    .btn-secondary {
        background: #6b7280;
        color: white;
    }

    .btn-secondary:hover {
        background: #4b5563;
    }

    .btn-info {
        background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
        color: white;
    }

    .btn-info:hover {
        background: linear-gradient(135deg, #0891b2 0%, #0e7490 100%);
    }

    .page-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e2e8f0;
    }

    .page-header h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #334155;
        margin: 0 0 0.5rem 0;
    }

    .page-header .text-danger {
        color: #dc2626;
        margin: 0;
        font-size: 1rem;
    }

    /* Scrollbar styling */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #f1f5f9;
    }

    ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    @@media (max-width: 768px) {
        .delete-card {
            padding: 1rem;
        }

        .summary-list {
            grid-template-columns: 1fr;
            gap: 0.5rem;
        }

        .summary-list dt {
            margin-top: 1rem;
        }

        .form-actions {
            flex-direction: column;
        }

        .warning-banner {
            flex-direction: column;
        }
    }
</style>
