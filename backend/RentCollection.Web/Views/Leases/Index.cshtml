@model List<RentCollection.Core.Entities.Lease>
@using RentCollection.Core.Entities
@{
    ViewData["Title"] = "Leases";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var caseByLease = ViewBag.CaseByLease as Dictionary<int, LegalCase> ?? new();

    // Group leases by property (same grouping the old page used).
    var groups = Model
        .Where(l => l.Unit != null)
        .GroupBy(l => l.Unit!.Property)
        .OrderBy(g => g.Key?.PropertyName)
        .ToList();
    var openAll = Model.Count <= 80 || groups.Count == 1;

    static string NatKey(string? s) => System.Text.RegularExpressions.Regex.Replace(s ?? "", @"\d+", m => m.Value.PadLeft(8, '0'));
    static string Initials(Tenant? t) => t == null ? "?" :
        string.Concat(new[] { t.FirstName, t.LastName }.Where(s => !string.IsNullOrEmpty(s)).Select(s => s![0])).ToUpperInvariant();

    string Chip(string? status) => status switch
    {
        LeaseStatuses.Active => "lp-chip-green",
        LeaseStatuses.Pending => "lp-chip-amber",
        LeaseStatuses.Renewed => "lp-chip-gold",
        LeaseStatuses.Terminated => "lp-chip-red",
        LeaseStatuses.Expired => "lp-chip-grey",
        _ => "lp-chip-grey",
    };
    var statusOrder = new[] { LeaseStatuses.Active, LeaseStatuses.Pending, LeaseStatuses.Expired, LeaseStatuses.Renewed, LeaseStatuses.Terminated };
}

<div class="lp-page" data-lp-scope>
    @await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData)
    {
        ["Title"] = L["Leases"].Value,
        ["Subtitle"] = L["Manage tenant lease agreements by property"].Value,
        ["ActionLabel"] = L["Create Lease"].Value,
        ["ActionHref"] = Url.Action("Create", "Leases"),
        ["Crumbs"] = new (string label, string? href)[]
        {
            (L["Admin"].Value, "/Dashboard"),
            (L["Leases"].Value, null),
        }
    })

    @await Html.PartialAsync("_AlertMessages")
    @Html.AntiForgeryToken()

    @* ── KPI strip (filled by /Leases/Snapshot) ── *@
    <div class="od od-grid-kpi lp-kpi-5" id="leasesStrip" aria-live="polite">
        <div class="od-card od-kpi-hero">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Monthly rent roll"]</span></div>
            <div class="od-kpi-value lp-skel" data-k="monthlyRentRoll">&nbsp;</div>
            <div class="od-kpi-sub">@L["from Active leases"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Total leases"]</span></div>
            <div class="od-kpi-value lp-skel" data-k="totalLeases">&nbsp;</div>
            <div class="od-kpi-sub">@L["all statuses"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Active"]</span></div>
            <div class="od-kpi-value lp-skel" data-k="activeLeases">&nbsp;</div>
            <div class="od-kpi-sub">@L["in force"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Expiring ≤ 30d"]</span></div>
            <div class="od-kpi-value lp-skel" data-k="expiringSoon">&nbsp;</div>
            <div class="od-kpi-sub">@L["renew or terminate"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Past end date"]</span></div>
            <div class="od-kpi-value lp-skel" data-k="expired">&nbsp;</div>
            <div class="od-kpi-sub">@L["still Active"]</div>
        </div>
    </div>

    @* ── Toolbar: instant client-side search + chips (all leases are on the page) ── *@
    <div class="lp-toolbar" id="leaseFilters">
        <div class="lp-toolbar-row">
            <label class="lp-search">
                <i class="fas fa-search"></i>
                <input type="search" id="leaseSearch" data-lp-search placeholder="@(L["Tenant, Civil ID, unit or property…"].Value)" />
            </label>
            <select id="propertyFilter" class="lp-select">
                <option value="">@L["All properties"]</option>
                @foreach (var p in groups.Select(g => g.Key).Where(p => p != null))
                {
                    <option value="@p!.PropertyId">@p.PropertyName</option>
                }
            </select>
            <span class="lp-result-count" data-lp-count data-all="@(L["Showing all {0} leases"].Value)" data-some="@(L["Showing {0} of {1} leases"].Value)"></span>
            <div class="lp-toolbar-spacer"></div>
            <button type="button" class="lp-btn" id="clearLeaseFilters">@L["Clear filters"]</button>
            <a class="lp-btn lp-btn-export" id="exportExcelLink" download href="/Leases/ExportExcel">
                <i class="fas fa-file-excel"></i> @L["Export"]
            </a>
        </div>
        <div class="lp-toolbar-row">
            <div class="lp-chips" data-lp-filter="status">
                <span class="lp-chips-label">@L["Status"]</span>
                <button type="button" class="lp-chip-btn is-on" data-value="">@L["All"]</button>
                @foreach (var s in statusOrder)
                {
                    <button type="button" class="lp-chip-btn" data-value="@s">@L[s]</button>
                }
            </div>
            <div class="lp-chips" data-lp-filter="expiring">
                <span class="lp-chips-label">@L["Expiring"]</span>
                <button type="button" class="lp-chip-btn is-on" data-value="">@L["Any"]</button>
                <button type="button" class="lp-chip-btn" data-value="30">@L["≤ 30 days"]</button>
                <button type="button" class="lp-chip-btn" data-value="60">@L["≤ 60 days"]</button>
                <button type="button" class="lp-chip-btn" data-value="90">@L["≤ 90 days"]</button>
                <button type="button" class="lp-chip-btn" data-value="past">@L["Past end"]</button>
            </div>
        </div>
        <div class="lp-toolbar-row">
            <div class="lp-chips" data-lp-filter="case">
                <span class="lp-chips-label">@L["Legal case"]</span>
                <button type="button" class="lp-chip-btn is-on" data-value="">@L["All"]</button>
                <button type="button" class="lp-chip-btn" data-value="__open">@L["Has open case"]</button>
                <button type="button" class="lp-chip-btn" data-value="__any">@L["Has any case"]</button>
                @foreach (var s in LegalCaseStatuses.All)
                {
                    <button type="button" class="lp-chip-btn" data-value="@s">@L[s]</button>
                }
            </div>
            @* Property filter is a <select>; the kit filters on chip groups, so this
               hidden group mirrors it (one chip per property, driven by script). *@
            <div class="lp-chips" data-lp-filter="property" hidden>
                <button type="button" class="lp-chip-btn is-on" data-value=""></button>
                @foreach (var p in groups.Select(g => g.Key).Where(p => p != null))
                {
                    <button type="button" class="lp-chip-btn" data-value="@p!.PropertyId"></button>
                }
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="lp-empty">
            <i class="fas fa-file-contract"></i>
            <h3>@L["No Leases Found"]</h3>
            <p>@L["Start by creating a lease agreement for your tenants"]</p>
            <p style="margin-top:0.6rem"><a class="lp-btn lp-btn-primary" href="/Leases/Create"><i class="fas fa-file-signature"></i> @L["Create Lease"]</a></p>
        </div>
    }
    else
    {
        <div class="lp-empty" data-lp-empty hidden>
            <i class="fas fa-search"></i>
            <h3>@L["No matching results found"]</h3>
            <p>@L["Try adjusting your search or filter criteria"]</p>
        </div>
    }

    @* ── Leases grouped by property ── *@
    @foreach (var g in groups)
    {
        var prop = g.Key;
        var leases = g.OrderBy(l => Array.IndexOf(statusOrder, l.Status ?? "") is var i && i < 0 ? 99 : i)
                      .ThenBy(l => NatKey(l.Unit?.UnitNumber)).ToList();
        var activeCount = leases.Count(l => l.Status == LeaseStatuses.Active);
        var rentRoll = leases.Where(l => l.Status == LeaseStatuses.Active).Sum(l => l.MonthlyRent);
        var attention = leases.Count(l => l.Status == LeaseStatuses.Active && l.LeaseEndDate.Date < DateTime.Today)
                      + leases.Count(l => l.Status == LeaseStatuses.Pending);
        var openCases = leases.Count(l => caseByLease.TryGetValue(l.LeaseId, out var c) && c.IsOpen);
        var initials = string.Concat((prop?.PropertyName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpperInvariant();

        <details class="lp-group" @(openAll ? "open" : "")>
            <summary>
                <span class="lp-group-mark">@initials</span>
                <div>
                    <div class="lp-group-title">@(prop?.PropertyName ?? L["Unknown property"].Value)</div>
                    <div class="lp-group-meta">
                        <span data-lp-group-count>@leases.Count</span> @L["leases"]
                        @if (!string.IsNullOrWhiteSpace(prop?.Area) || !string.IsNullOrWhiteSpace(prop?.Governorate))
                        {
                            <text> · @string.Join(", ", new[] { prop?.Area, prop?.Governorate }.Where(s => !string.IsNullOrWhiteSpace(s)))</text>
                        }
                        @if (attention > 0)
                        {
                            <text> · </text><span class="lp-chip lp-chip-amber" title="@(L["Past end date or awaiting activation"].Value)">@attention @L["need attention"]</span>
                        }
                        @if (openCases > 0)
                        {
                            <text> · </text><span class="lp-chip lp-chip-red"><i class="fas fa-scale-balanced"></i> @openCases @L["open legal"]</span>
                        }
                    </div>
                </div>
                <div class="lp-group-stats">
                    <div class="lp-group-stat"><b>@activeCount / @(prop?.NumberOfUnits ?? leases.Count)</b><span>@L["Active / units"]</span></div>
                    <div class="lp-group-stat"><b>@rentRoll.ToString("N3", inv)</b><span>@L["Rent roll / mo"]</span></div>
                    <a class="lp-btn" href="/Properties/Details/@prop?.PropertyId" onclick="event.stopPropagation()"><i class="fas fa-building"></i> @L["Property"]</a>
                    <i class="fas fa-chevron-down lp-group-chevron"></i>
                </div>
            </summary>
            <div class="lp-table-wrap">
                <table class="lp-table">
                    <thead>
                        <tr>
                            <th data-sort="tenant">@L["Tenant"]</th>
                            <th data-sort="unit">@L["Unit"]</th>
                            <th data-sort="end">@L["Lease period"]</th>
                            <th class="lp-num" data-sort="rent">@L["Rent (KWD)"]</th>
                            <th class="lp-num">@L["Collection"]</th>
                            <th data-sort="status">@L["Status"]</th>
                            <th class="lp-right">@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lease in leases)
                        {
                            var t = lease.Tenant;
                            var status = lease.Status ?? LeaseStatuses.Active;
                            var days = RentCollection.Core.Leases.LeaseMath.DaysRemaining(lease.LeaseEndDate);
                            var isActive = status == LeaseStatuses.Active;
                            var pastEnd = isActive && days < 0;
                            // Tokens the chip filters match against (space-separated).
                            var expiringTokens = pastEnd ? "past"
                                : isActive && days >= 0 ? string.Join(" ", new[] { 30, 60, 90 }.Where(h => days <= h)) : "";
                            caseByLease.TryGetValue(lease.LeaseId, out var lc);
                            var caseTokens = lc == null ? "" : $"__any {(lc.IsOpen ? "__open " : "")}{lc.Status}";
                            var search = $"{t?.FirstName} {t?.LastName} {t?.PACINumber} {t?.Email} {lease.Unit?.UnitNumber} {prop?.PropertyName} {status} #{lease.LeaseId}".ToLowerInvariant();

                            <tr data-search="@search" data-lease-id="@lease.LeaseId"
                                data-status="@status" data-expiring="@expiringTokens" data-case="@caseTokens" data-property="@prop?.PropertyId"
                                data-sort-tenant="@t?.FirstName @t?.LastName" data-sort-unit="@NatKey(lease.Unit?.UnitNumber)"
                                data-sort-end="@lease.LeaseEndDate.ToString("yyyy-MM-dd")" data-sort-rent="@lease.MonthlyRent" data-sort-status="@status">
                                <td data-label="@L["Tenant"]">
                                    <div class="lp-cell-person">
                                        <span class="lp-avatar">@Initials(t)</span>
                                        <div>
                                            <a class="lp-link lp-primary" href="/Tenants/Details/@lease.TenantId">@(t == null ? L["Unknown"].Value : $"{t.FirstName} {t.LastName}")</a>
                                            @if (!string.IsNullOrEmpty(t?.PACINumber)) { <span class="lp-sub lp-mono">@t.PACINumber</span> }
                                        </div>
                                    </div>
                                </td>
                                <td data-label="@L["Unit"]">
                                    <a class="lp-link" href="/Units/Details/@lease.UnitId">@L["Unit"] @(lease.Unit?.UnitNumber ?? "—")</a>
                                    @if (!string.IsNullOrWhiteSpace(lease.Unit?.UnitType)) { <span class="lp-sub">@L[lease.Unit.UnitType]</span> }
                                </td>
                                <td data-label="@L["Lease period"]">
                                    <span style="white-space:nowrap">@lease.LeaseStartDate.ToString("dd MMM yyyy", inv) → @lease.LeaseEndDate.ToString("dd MMM yyyy", inv)</span>
                                    <span class="lp-sub">
                                        @if (pastEnd) { <span class="lp-chip lp-chip-red">@L["Past end"] · @Math.Abs(days) @L["days"]</span> }
                                        else if (isActive && days <= 30) { <span class="lp-chip lp-chip-amber">@days @L["days left"]</span> }
                                        else if (isActive) { <text>@days @L["days left"]</text> }
                                        else if (status == LeaseStatuses.Pending) { <text>@L["awaiting activation"]</text> }
                                        else if (lease.TerminationDate.HasValue) { <text>@L["ended"] @lease.TerminationDate.Value.ToString("dd MMM yyyy", inv)</text> }
                                    </span>
                                </td>
                                <td class="lp-num" data-label="@L["Rent (KWD)"]">
                                    <span class="lp-amount">@lease.MonthlyRent.ToString("N3", inv)</span>
                                    @if (lease.SecurityDeposit > 0) { <span class="lp-sub">@L["deposit"] @lease.SecurityDeposit.ToString("N3", inv)</span> }
                                </td>
                                <td class="lp-num" data-label="@L["Collection"]">
                                    <a class="lp-link" href="/Invoices?leaseId=@lease.LeaseId" title="@(L["View invoices for this lease"].Value)">
                                        <span class="lp-amount lp-skel coll-outstanding">&nbsp;</span>
                                        <span class="lp-sub lp-skel coll-sub">&nbsp;</span>
                                    </a>
                                </td>
                                <td data-label="@L["Status"]">
                                    <span class="lp-chip @Chip(status)">@L[status]</span>
                                    @if (lc != null)
                                    {
                                        <a class="lp-chip @(lc.IsOpen ? "lp-chip-amber" : "lp-chip-grey")" style="margin-top:4px;display:inline-flex" href="/Leases/Details/@lease.LeaseId#legal-case" title="@(L["Legal Case"].Value): @lc.Status">
                                            <i class="fas fa-scale-balanced"></i> @L[lc.Status]
                                        </a>
                                    }
                                </td>
                                <td class="lp-right" data-label="@L["Actions"]">
                                    <div class="lp-row-actions">
                                        @if (status == LeaseStatuses.Pending)
                                        {
                                            <a class="lp-btn lp-btn-primary" style="padding:0.3rem 0.6rem;font-size:0.76rem" href="/Leases/Details/@lease.LeaseId#activate"><i class="fas fa-play"></i> @L["Activate"]</a>
                                        }
                                        else if (pastEnd)
                                        {
                                            <a class="lp-btn lp-btn-primary" style="padding:0.3rem 0.6rem;font-size:0.76rem" href="/Leases/Details/@lease.LeaseId#renew"><i class="fas fa-arrows-rotate"></i> @L["Renew"]</a>
                                        }
                                        <a class="lp-icon-btn" title="@(L["View"].Value)" href="/Leases/Details/@lease.LeaseId"><i class="fas fa-eye"></i></a>
                                        <div class="kebab-wrap">
                                            <button type="button" class="kebab-btn" aria-label="@(L["More actions"].Value)" aria-haspopup="menu" aria-expanded="false"><i class="fas fa-ellipsis-vertical"></i></button>
                                            <div class="kebab-menu" role="menu" hidden>
                                                <a href="/Leases/Details/@lease.LeaseId" role="menuitem"><i class="fas fa-eye"></i> @L["View"]</a>
                                                <a href="/Leases/History/@lease.LeaseId" role="menuitem"><i class="fas fa-clock-rotate-left"></i> @L["History"]</a>
                                                <a href="/Leases/Edit/@lease.LeaseId" role="menuitem"><i class="fas fa-edit"></i> @L["Edit"]</a>
                                                <a href="/Tenants/Details/@lease.TenantId" role="menuitem"><i class="fas fa-user"></i> @L["View tenant"]</a>
                                                <a href="/Invoices?leaseId=@lease.LeaseId" role="menuitem"><i class="fas fa-file-invoice-dollar"></i> @L["Invoices"]</a>
                                                <a href="/CashPayment/Record?tenantId=@lease.TenantId" role="menuitem"><i class="fas fa-money-bill"></i> @L["Record payment"]</a>
                                                @if (status == LeaseStatuses.Active || status == LeaseStatuses.Expired)
                                                {
                                                    <a href="/Leases/Details/@lease.LeaseId#renew" role="menuitem"><i class="fas fa-arrows-rotate"></i> @L["Renew"]</a>
                                                }
                                                @if (status == LeaseStatuses.Active)
                                                {
                                                    <a href="/Leases/Details/@lease.LeaseId#terminate" role="menuitem" class="danger-item"><i class="fas fa-circle-stop"></i> @L["Terminate"]</a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const T = {
                notInvoiced: @Json.Serialize(L["Not invoiced yet"].Value),
                paidUp: @Json.Serialize(L["Paid up"].Value),
                mtd: @Json.Serialize(L["MTD"].Value),
                last: @Json.Serialize(L["last"].Value),
                firstInvoice: @Json.Serialize(L["first invoice on the due day"].Value),
                noPayments: @Json.Serialize(L["no payments yet"].Value),
            };
            const scope = document.querySelector('[data-lp-scope]');

            // 1. KPI strip
            fetch('/Leases/Snapshot', { credentials: 'same-origin' })
                .then(r => r.ok ? r.json() : Promise.reject(r.status))
                .then(d => {
                    document.querySelectorAll('#leasesStrip [data-k]').forEach(el => {
                        const k = el.dataset.k; if (d[k] === undefined) return;
                        el.classList.remove('lp-skel');
                        el.textContent = k === 'monthlyRentRoll' ? LP.kwd(d[k]) : Math.round(d[k]).toLocaleString('en-US');
                    });
                })
                .catch(() => document.querySelectorAll('#leasesStrip .lp-skel').forEach(el => { el.classList.remove('lp-skel'); el.textContent = '—'; }));

            // 2. Per-row collection figures (outstanding / MTD / last payment)
            const ids = Array.from(document.querySelectorAll('tr[data-lease-id]')).map(r => r.dataset.leaseId);
            if (ids.length) {
                fetch('/Leases/KpiBatch?ids=' + ids.join(','), { credentials: 'same-origin' })
                    .then(r => r.ok ? r.json() : Promise.reject(r.status))
                    .then(rows => {
                        const byId = new Map(rows.map(r => [String(r.leaseId), r]));
                        document.querySelectorAll('tr[data-lease-id]').forEach(row => {
                            const r = byId.get(row.dataset.leaseId); if (!r) return;
                            const out = row.querySelector('.coll-outstanding'), sub = row.querySelector('.coll-sub');
                            out.classList.remove('lp-skel'); sub.classList.remove('lp-skel');
                            if (r.outstanding > 0) { out.textContent = LP.kwd(r.outstanding); out.classList.add('lp-amount-bad'); }
                            else if ((r.invoiceCount || 0) === 0) { out.textContent = T.notInvoiced; out.classList.add('lp-amount-muted'); }
                            else { out.textContent = T.paidUp; out.classList.add('lp-amount-good'); }
                            const parts = [];
                            if (r.mtdCollected > 0) parts.push(T.mtd + ' ' + LP.kwd(r.mtdCollected));
                            if (r.lastPaymentDate) parts.push(T.last + ' ' + LP.shortDate(r.lastPaymentDate));
                            sub.textContent = parts.length ? parts.join(' · ') : ((r.invoiceCount || 0) === 0 ? T.firstInvoice : T.noPayments);
                        });
                    })
                    .catch(() => document.querySelectorAll('.coll-outstanding, .coll-sub').forEach(el => { el.classList.remove('lp-skel'); el.textContent = '—'; }));
            }

            // 3. Property <select> drives the hidden "property" chip group.
            const propSel = document.getElementById('propertyFilter');
            const propGroup = scope.querySelector('[data-lp-filter="property"]');
            function setChip(group, value) {
                if (!group) return;
                group.querySelectorAll('.lp-chip-btn').forEach(b => b.classList.toggle('is-on', b.dataset.value === value));
            }
            propSel.addEventListener('change', () => { setChip(propGroup, propSel.value); LP.refresh(scope); syncExport(); });
            scope.querySelectorAll('[data-lp-filter]').forEach(g => g.addEventListener('click', () => setTimeout(syncExport, 0)));
            document.getElementById('leaseSearch').addEventListener('input', () => setTimeout(syncExport, 150));

            // 4. Clear everything
            document.getElementById('clearLeaseFilters').addEventListener('click', () => {
                document.getElementById('leaseSearch').value = '';
                propSel.value = '';
                scope.querySelectorAll('[data-lp-filter]').forEach(g => setChip(g, ''));
                LP.refresh(scope); syncExport();
            });

            // 5. Export link follows the current filters
            function syncExport() {
                const q = new URLSearchParams();
                const s = document.getElementById('leaseSearch').value.trim(); if (s) q.set('search', s);
                if (propSel.value) q.set('propertyId', propSel.value);
                const on = k => (scope.querySelector('[data-lp-filter="' + k + '"] .lp-chip-btn.is-on') || {}).dataset?.value || '';
                if (on('status')) q.set('status', on('status'));
                if (on('expiring') && on('expiring') !== 'past') q.set('expiring', on('expiring'));
                document.getElementById('exportExcelLink').href = '/Leases/ExportExcel' + (q.toString() ? '?' + q : '');
            }

            // 6. Deep links: ?propertyId= (Property details), ?status=, ?case=__open, ?expiring=30 (notification bell)
            const p = new URLSearchParams(location.search);
            if (p.get('propertyId')) { propSel.value = p.get('propertyId'); setChip(propGroup, propSel.value); }
            if (p.get('status')) setChip(scope.querySelector('[data-lp-filter="status"]'), p.get('status'));
            if (p.get('case')) setChip(scope.querySelector('[data-lp-filter="case"]'), p.get('case'));
            if (p.get('expiring')) setChip(scope.querySelector('[data-lp-filter="expiring"]'), p.get('expiring'));
            if (p.get('search')) document.getElementById('leaseSearch').value = p.get('search');
            LP.refresh(scope); syncExport();
        })();
    </script>
}
