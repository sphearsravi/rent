@model RentCollection.Core.Entities.MaintenanceRequest
@{
    ViewData["Title"] = $"Close Request #{Model.RequestId}";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <h1><i class="fas fa-check-circle text-success"></i> @L["Close Request"] #@Model.RequestId</h1>
            <p class="text-muted">@L["Mark this maintenance request as completed."]</p>
        </div>
        <a href="/Maintenance/Details/@Model.RequestId" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> @L["Back to Details"]
        </a>
    </div>

    <div class="close-card">
        <div class="summary">
            <h3 class="section-title">@L["Request Information"]</h3>
            <div class="info-grid">
                <div class="info-item">
                    <label>@L["Property"]</label>
                    <div class="info-value">@(Model.Property?.PropertyName ?? "-")</div>
                </div>
                <div class="info-item">
                    <label>@L["Unit"]</label>
                    <div class="info-value">@(Model.Unit?.UnitNumber ?? "-")</div>
                </div>
                <div class="info-item">
                    <label>@L["Tenant"]</label>
                    <div class="info-value">@(Model.Tenant != null ? $"{Model.Tenant.FirstName} {Model.Tenant.LastName}" : "-")</div>
                </div>
                <div class="info-item">
                    <label>@L["Category"]</label>
                    <div class="info-value">@Model.Category</div>
                </div>
                <div class="info-item">
                    <label>@L["Priority"]</label>
                    <div class="info-value">@Model.Priority</div>
                </div>
                <div class="info-item">
                    <label>@L["Requested"]</label>
                    <div class="info-value">@Model.RequestDate.ToString("MMMM dd, yyyy")</div>
                </div>
                <div class="info-item info-item-wide">
                    <label>@L["Description"]</label>
                    <div class="info-value">@Model.Description</div>
                </div>
            </div>
        </div>

        <form asp-action="Close" asp-route-id="@Model.RequestId" method="post" class="close-form">
            @Html.AntiForgeryToken()

            <h3 class="section-title">@L["Completion Details"]</h3>

            <div class="form-grid">
                <div class="form-field">
                    <label for="actualCost">@L["Actual Cost (KWD)"]</label>
                    <input type="number" step="0.001" min="0" id="actualCost" name="actualCost"
                           placeholder="0.000" value="@(Model.EstimatedCost?.ToString("0.000"))" />
                    <small class="hint">@L["Optional. Defaults to the estimated cost if you leave it blank."]</small>
                </div>

                <div class="form-field form-field-wide">
                    <label for="notes">@L["Completion Notes"]</label>
                    <textarea id="notes" name="notes" rows="4"
                              placeholder="@(L["What was done, parts replaced, follow-up needed..."].Value)"></textarea>
                    <small class="hint">@L["Appended to the existing notes — old notes are preserved."]</small>
                </div>
            </div>

            <div class="form-actions">
                <a href="/Maintenance/Details/@Model.RequestId" class="btn btn-secondary">
                    <i class="fas fa-times"></i> @L["Cancel"]
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-check"></i> @L["Close Request"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <style>
        body {
            background: linear-gradient(135deg, #f8fafc 0%, #f2e8c8 50%, #e6d4a0 100%);
            min-height: 100vh;
        }

        .page-container { padding: 24px; max-width: 1100px; margin: 0 auto; }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 24px;
            gap: 16px;
        }
        .page-header h1 {
            font-size: 1.6rem;
            font-weight: 700;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .page-header .text-muted { color: #64748b; margin-top: 4px; }
        .text-success { color: #10b981; }

        .close-card {
            background: white;
            border-radius: 16px;
            padding: 28px;
            box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
            border: 1px solid rgba(138, 109, 31, 0.08);
        }

        .summary { margin-bottom: 28px; padding-bottom: 24px; border-bottom: 1px solid #e2e8f0; }

        .section-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: #0f172a;
            margin: 0 0 16px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
        }
        .info-item { display: flex; flex-direction: column; gap: 4px; }
        .info-item-wide { grid-column: 1 / -1; }
        .info-item label {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #94a3b8;
        }
        .info-item .info-value { color: #1e293b; font-weight: 500; }

        .close-form .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px 20px;
            margin-bottom: 24px;
        }
        .form-field { display: flex; flex-direction: column; gap: 6px; }
        .form-field-wide { grid-column: 1 / -1; }
        .form-field label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #334155;
        }
        .form-field input,
        .form-field textarea {
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            padding: 10px 14px;
            font: inherit;
            color: #0f172a;
            transition: border-color 0.15s, box-shadow 0.15s;
            width: 100%;
            background: white;
        }
        .form-field input:focus,
        .form-field textarea:focus {
            outline: none;
            border-color: #8a6d1f;
            box-shadow: 0 0 0 3px rgba(138, 109, 31, 0.18);
        }
        .form-field .hint { color: #94a3b8; font-size: 0.8rem; }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding-top: 20px;
            border-top: 1px solid #e2e8f0;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 18px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.92rem;
            border: 1px solid transparent;
            cursor: pointer;
            text-decoration: none;
            transition: transform 0.1s, box-shadow 0.1s, background 0.15s;
        }
        .btn-secondary {
            background: white;
            color: #334155;
            border-color: #cbd5e1;
        }
        .btn-secondary:hover { background: #f1f5f9; }
        .btn-success {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.25);
        }
        .btn-success:hover { transform: translateY(-1px); }

        @@media (max-width: 700px) {
            .close-form .form-grid { grid-template-columns: 1fr; }
            .form-actions { flex-direction: column-reverse; }
            .form-actions .btn { width: 100%; justify-content: center; }
            .page-header { flex-direction: column; align-items: stretch; }
        }
    </style>
}
