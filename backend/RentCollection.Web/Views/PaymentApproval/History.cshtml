@model IEnumerable<RentCollection.Core.Entities.Payment>
@{
    ViewData["Title"] = "Approval History";
}

@section Styles {
    <style>
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        .page-header {
            background: rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(99, 102, 241, 0.2);
            border-radius: 12px;
            padding: 24px 32px;
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
        }

        .page-title {
            font-size: 28px;
            font-weight: 600;
            color: #1e293b;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .page-title i {
            color: #6366f1;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: #6366f1;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .back-link:hover {
            background: #4f46e5;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
        }

        .filter-card {
            background: rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(99, 102, 241, 0.2);
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 24px;
        }

        .filter-title {
            font-size: 16px;
            font-weight: 600;
            color: #374151;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .filter-title i {
            color: #6366f1;
        }

        .filter-row {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            align-items: flex-end;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .filter-group label {
            font-size: 13px;
            font-weight: 500;
            color: #4b5563;
        }

        .filter-group select,
        .filter-group input {
            padding: 10px 14px;
            border: 1px solid rgba(99, 102, 241, 0.3);
            border-radius: 8px;
            font-size: 14px;
            background: white;
            min-width: 180px;
            transition: all 0.3s ease;
        }

        .filter-group select:focus,
        .filter-group input:focus {
            outline: none;
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }

        .filter-btn {
            padding: 10px 20px;
            background: #6366f1;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .filter-btn:hover {
            background: #4f46e5;
        }

        .clear-btn {
            padding: 10px 20px;
            background: #f3f4f6;
            color: #4b5563;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .clear-btn:hover {
            background: #e5e7eb;
        }

        .data-card {
            background: rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(99, 102, 241, 0.2);
            border-radius: 12px;
            overflow: hidden;
        }

        .table-container {
            overflow-x: auto;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th {
            background: rgba(99, 102, 241, 0.1);
            padding: 16px;
            text-align: left;
            font-size: 13px;
            font-weight: 600;
            color: #374151;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .data-table td {
            padding: 14px 16px;
            border-bottom: 1px solid rgba(99, 102, 241, 0.1);
            font-size: 14px;
            color: #1e293b;
        }

        .data-table tbody tr {
            transition: background-color 0.2s ease;
        }

        .data-table tbody tr:hover {
            background: rgba(99, 102, 241, 0.05);
        }

        .data-table tbody tr:last-child td {
            border-bottom: none;
        }

        .tenant-info {
            font-weight: 500;
        }

        .property-info {
            font-size: 13px;
            color: #6b7280;
        }

        .amount {
            font-weight: 600;
            color: #059669;
        }

        .payment-type {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            background: rgba(99, 102, 241, 0.1);
            color: #6366f1;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 500;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-approved {
            background: rgba(16, 185, 129, 0.1);
            color: #059669;
        }

        .status-rejected {
            background: rgba(239, 68, 68, 0.1);
            color: #dc2626;
        }

        .approver-info {
            font-size: 13px;
        }

        .approver-name {
            font-weight: 500;
            color: #374151;
        }

        .approval-date {
            font-size: 12px;
            color: #6b7280;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            background: #f0f9ff;
            color: #0284c7;
            border: 1px solid rgba(2, 132, 199, 0.3);
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .action-btn:hover {
            background: #e0f2fe;
            border-color: #0284c7;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #6b7280;
        }

        .empty-state i {
            font-size: 48px;
            color: #d1d5db;
            margin-bottom: 16px;
        }

        .empty-state h3 {
            font-size: 18px;
            font-weight: 600;
            color: #374151;
            margin-bottom: 8px;
        }

        .empty-state p {
            font-size: 14px;
        }

        .table-footer {
            padding: 16px 24px;
            background: rgba(99, 102, 241, 0.05);
            border-top: 1px solid rgba(99, 102, 241, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .record-count {
            font-size: 14px;
            color: #6b7280;
        }

        .record-count strong {
            color: #374151;
        }

        @@media (max-width: 768px) {
            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .filter-row {
                flex-direction: column;
            }

            .filter-group select,
            .filter-group input {
                min-width: 100%;
            }

            .data-table th,
            .data-table td {
                padding: 12px 10px;
                font-size: 12px;
            }
        }
    </style>
}

<div class="container">
    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">
            <i class="fas fa-history"></i>
            @L["Approval History"]
        </h1>
        <a href="@Url.Action("Index", "PaymentApproval")" class="back-link">
            <i class="fas fa-arrow-left"></i>
            @L["Back to Pending Approvals"]
        </a>
    </div>

    <!-- Filter Card -->
    <div class="filter-card">
        <h3 class="filter-title">
            <i class="fas fa-filter"></i>
            @L["Filter History"]
        </h3>
        <form method="get" id="filterForm">
            <div class="filter-row">
                <div class="filter-group">
                    <label for="statusFilter">@L["Status"]</label>
                    <select id="statusFilter" name="status">
                        <option value="">@L["All Statuses"]</option>
                        <option value="Approved">@L["Approved"]</option>
                        <option value="Rejected">@L["Rejected"]</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label for="fromDate">@L["From Date"]</label>
                    <input type="date" id="fromDate" name="fromDate" />
                </div>
                <div class="filter-group">
                    <label for="toDate">@L["To Date"]</label>
                    <input type="date" id="toDate" name="toDate" />
                </div>
                <button type="submit" class="filter-btn">
                    <i class="fas fa-search"></i>
                    @L["Apply Filters"]
                </button>
                <button type="button" class="clear-btn" onclick="clearFilters()">
                    <i class="fas fa-times"></i>
                    @L["Clear"]
                </button>
            </div>
        </form>
    </div>

    <!-- Data Table Card -->
    <div class="data-card">
        @if (Model != null && Model.Any())
        {
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@L["Payment Date"]</th>
                            <th>@L["Tenant Name"]</th>
                            <th>@L["Property / Unit"]</th>
                            <th>@L["Amount (KWD)"]</th>
                            <th>@L["Payment Type"]</th>
                            <th>@L["Status"]</th>
                            <th>@L["Approved/Rejected By"]</th>
                            <th>@L["Approval/Rejection Date"]</th>
                            <th>@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model)
                        {
                            <tr>
                                <td>@payment.PaymentDate.ToString("dd MMM yyyy")</td>
                                <td class="tenant-info">
                                    @(payment.Tenant != null ? $"{payment.Tenant.FirstName} {payment.Tenant.LastName}" : "N/A")
                                </td>
                                <td>
                                    <div class="tenant-info">
                                        @(payment.Property?.PropertyName ?? "N/A")
                                    </div>
                                    <div class="property-info">
                                        @(payment.Lease?.Unit?.UnitNumber ?? "N/A")
                                    </div>
                                </td>
                                <td class="amount">@payment.AmountPaid.ToString("N3")</td>
                                <td>
                                    <span class="payment-type">
                                        @if (payment.PaymentType == RentCollection.Core.Enums.PaymentType.Cash)
                                        {
                                            <i class="fas fa-money-bill-wave"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-university"></i>
                                        }
                                        @payment.PaymentType
                                    </span>
                                </td>
                                <td>
                                    @if (payment.Status == RentCollection.Core.Enums.PaymentStatus.Approved)
                                    {
                                        <span class="status-badge status-approved">
                                            <i class="fas fa-check-circle"></i>
                                            @L["Approved"]
                                        </span>
                                    }
                                    else if (payment.Status == RentCollection.Core.Enums.PaymentStatus.Rejected)
                                    {
                                        <span class="status-badge status-rejected">
                                            <i class="fas fa-times-circle"></i>
                                            @L["Rejected"]
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="approver-name">
                                        @(payment.ApprovedBy ?? "N/A")
                                    </div>
                                </td>
                                <td>
                                    <div class="approval-date">
                                        @if (payment.ApprovedDate.HasValue)
                                        {
                                            @payment.ApprovedDate.Value.ToString("dd MMM yyyy HH:mm")
                                        }
                                        else if (payment.ModifiedDate.HasValue)
                                        {
                                            @payment.ModifiedDate.Value.ToString("dd MMM yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span>N/A</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <a href="@Url.Action("Details", "PaymentApproval", new { id = payment.PaymentId })" class="action-btn">
                                        <i class="fas fa-eye"></i>
                                        @L["View Details"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="table-footer">
                <span class="record-count">
                    @L["Showing"] <strong>@Model.Count()</strong> @L["record(s)"]
                </span>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <h3>@L["No History Found"]</h3>
                <p>@L["There are no approved or rejected payments matching your criteria."]</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function clearFilters() {
            document.getElementById('statusFilter').value = '';
            document.getElementById('fromDate').value = '';
            document.getElementById('toDate').value = '';
            document.getElementById('filterForm').submit();
        }

        // Set filter values from URL parameters on page load
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);

            if (urlParams.has('status')) {
                document.getElementById('statusFilter').value = urlParams.get('status');
            }
            if (urlParams.has('fromDate')) {
                document.getElementById('fromDate').value = urlParams.get('fromDate');
            }
            if (urlParams.has('toDate')) {
                document.getElementById('toDate').value = urlParams.get('toDate');
            }
        });
    </script>
}
