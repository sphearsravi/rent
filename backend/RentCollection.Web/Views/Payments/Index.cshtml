@model List<RentCollection.Application.DTOs.AdminPaymentVerificationDto>
@{
    ViewData["Title"] = "Payments";
    var properties = ViewBag.Properties as dynamic;
    int? curPropertyId = ViewBag.PropertyId as int?;
    string? curStatus = ViewBag.Status as string;
    DateTime? startDate = ViewBag.StartDate as DateTime?;
    DateTime? endDate = ViewBag.EndDate as DateTime?;
    bool? hasMismatch = ViewBag.HasMismatch as bool?;
    string? civilId = ViewBag.CivilId as string;

    decimal kpiMtd = ViewBag.KpiCollectedMtd ?? 0m;
    int kpiMtdCount = ViewBag.KpiCollectedMtdCount ?? 0;
    decimal kpiAll = ViewBag.KpiCollectedAll ?? 0m;
    int kpiPending = ViewBag.KpiPendingCount ?? 0;
    decimal kpiPendingAmt = ViewBag.KpiPendingAmount ?? 0m;
    int kpiFailed = ViewBag.KpiFailed30 ?? 0;
    int kpiMismatch = ViewBag.KpiMismatchAll ?? 0;

    var methodCounts = Model.GroupBy(p => p.PaymentType).ToDictionary(g => g.Key, g => g.Count());
    var statusCounts = Model.GroupBy(p => p.Status).ToDictionary(g => g.Key, g => g.Count());

    string StatusChip(string s) => s switch
    {
        "Completed" => "lp-chip-green",
        "PendingVerification" => "lp-chip-blue",
        "Pending" => "lp-chip-amber",
        "Failed" => "lp-chip-red",
        "Rejected" => "lp-chip-red",
        "Refunded" => "lp-chip-purple",
        _ => "lp-chip-grey",
    };
    string StatusLabel(string s) => s switch
    {
        "PendingVerification" => L["Awaiting confirmation"].Value,
        _ => L[s].Value,
    };
    string MethodLabel(string m) => m switch
    {
        "KNET" => "K-NET",
        "BankTransfer" => L["Bank transfer"].Value,
        _ => L[m].Value,
    };
    string MethodIcon(string m) => m switch
    {
        "KNET" => "fa-credit-card",
        "Cash" => "fa-money-bill",
        "BankTransfer" => "fa-building-columns",
        "Cheque" => "fa-money-check",
        _ => "fa-circle",
    };
}

<div class="lp-page" data-lp-scope>
    @await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData)
    {
        ["Title"] = L["Payments"].Value,
        ["Subtitle"] = L["Every payment across K-NET, cash and bank transfer — with what still needs confirming"].Value,
        ["Crumbs"] = new (string label, string? href)[] { (L["Admin"].Value, "/Dashboard"), (L["Payments"].Value, null) },
        ["ActionsHtml"] = Html.Raw(
            "<a class=\"lp-btn\" href=\"/Payments/Reconciliation\"><i class=\"fas fa-scale-balanced\"></i> " + L["Reconciliation"].Value + "</a>" +
            "<a class=\"lp-btn\" href=\"/PaymentApproval\"><i class=\"fas fa-clipboard-check\"></i> " + L["Approval queue"].Value + (kpiPending > 0 ? " <span class=\"lp-chip lp-chip-blue\">" + kpiPending + "</span>" : "") + "</a>" +
            "<a class=\"lp-btn lp-btn-primary\" href=\"/CashPayment/Record\"><i class=\"fas fa-plus\"></i> " + L["Record payment"].Value + "</a>")
    })

    @await Html.PartialAsync("_AlertMessages")

    @* ── KPI strip ── *@
    <div class="od od-grid-kpi lp-kpi-5">
        <div class="od-card od-kpi-hero">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Collected this month"]</span></div>
            <div class="od-kpi-value">@kpiMtd.ToString("N3", System.Globalization.CultureInfo.InvariantCulture) <small style="font-size:0.6em;font-weight:500">KWD</small></div>
            <div class="od-kpi-sub">@kpiMtdCount @L["completed payments"]</div>
        </div>
        <a class="od-card od-card-link" href="/PaymentApproval">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Awaiting confirmation"]</span></div>
            <div class="od-kpi-value @(kpiPending > 0 ? "od-count-amber" : "")">@kpiPending</div>
            <div class="od-kpi-sub">@kpiPendingAmt.ToString("N3", System.Globalization.CultureInfo.InvariantCulture) KWD @L["cash & bank transfers"]</div>
        </a>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Failed (30 days)"]</span></div>
            <div class="od-kpi-value @(kpiFailed > 0 ? "od-count-red" : "")">@kpiFailed</div>
            <div class="od-kpi-sub">@L["K-NET attempts that did not capture"]</div>
        </div>
        <a class="od-card od-card-link" href="/Payments/Mismatches">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Mismatches"]</span></div>
            <div class="od-kpi-value @(kpiMismatch > 0 ? "od-count-red" : "")">@kpiMismatch</div>
            <div class="od-kpi-sub">@L["Civil ID / building / merchant checks"]</div>
        </a>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Collected all time"]</span></div>
            <div class="od-kpi-value">@kpiAll.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) <small style="font-size:0.6em;font-weight:500">KWD</small></div>
            <div class="od-kpi-sub">@L["completed payments"]</div>
        </div>
    </div>

    @* ── Toolbar ── *@
    <form method="get" class="lp-toolbar">
        <div class="lp-toolbar-row">
            <label class="lp-search">
                <i class="fas fa-search"></i>
                <input type="search" data-lp-search placeholder="@(L["Tenant, Civil ID, unit, reference…"].Value)" />
            </label>
            <select name="propertyId" class="lp-select" onchange="this.form.submit()">
                <option value="">@L["All properties"]</option>
                @if (properties != null)
                {
                    @foreach (var p in properties)
                    {
                        <option value="@p.PropertyId" selected="@(curPropertyId == (int?)p.PropertyId)">@p.PropertyName</option>
                    }
                }
            </select>
            <input type="date" name="startDate" class="lp-select" style="min-width:150px" value="@(startDate?.ToString("yyyy-MM-dd"))" title="@(L["From"].Value)" onchange="this.form.submit()" />
            <input type="date" name="endDate" class="lp-select" style="min-width:150px" value="@(endDate?.ToString("yyyy-MM-dd"))" title="@(L["To"].Value)" onchange="this.form.submit()" />
            @if (!string.IsNullOrEmpty(civilId)) { <input type="hidden" name="civilId" value="@civilId" /> }
            <span class="lp-result-count" data-lp-count data-all="@(L["Showing all {0} payments"].Value)" data-some="@(L["Showing {0} of {1} payments"].Value)"></span>
            <div class="lp-toolbar-spacer"></div>
            <a class="lp-btn" href="/Payments">@L["Clear filters"]</a>
        </div>
        <div class="lp-toolbar-row">
            <div class="lp-chips" data-lp-filter="method">
                <span class="lp-chips-label">@L["Method"]</span>
                <button type="button" class="lp-chip-btn is-on" data-value="">@L["All"]</button>
                @foreach (var m in new[] { "KNET", "Cash", "BankTransfer", "Cheque" })
                {
                    if (!methodCounts.ContainsKey(m)) { continue; }
                    <button type="button" class="lp-chip-btn" data-value="@m"><i class="fas @MethodIcon(m)"></i> @MethodLabel(m) <span class="lp-count">@methodCounts[m]</span></button>
                }
            </div>
            <div class="lp-chips" data-lp-filter="status">
                <span class="lp-chips-label">@L["Status"]</span>
                <button type="button" class="lp-chip-btn is-on" data-value="">@L["All"]</button>
                @foreach (var s in new[] { "Completed", "PendingVerification", "Pending", "Failed", "Rejected", "Refunded" })
                {
                    if (!statusCounts.ContainsKey(s)) { continue; }
                    <button type="button" class="lp-chip-btn" data-value="@s">@StatusLabel(s) <span class="lp-count">@statusCounts[s]</span></button>
                }
            </div>
            <div class="lp-chips" data-lp-filter="mismatch">
                <span class="lp-chips-label">@L["Checks"]</span>
                <button type="button" class="lp-chip-btn is-on" data-value="">@L["All"]</button>
                <button type="button" class="lp-chip-btn" data-value="1"><i class="fas fa-triangle-exclamation"></i> @L["Mismatch only"]</button>
            </div>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="lp-empty">
            <i class="fas fa-receipt"></i>
            <h3>@L["No payments match these filters"]</h3>
            <p><a href="/Payments">@L["Clear filters"]</a></p>
        </div>
    }
    else
    {
        <div class="lp-table-wrap">
            <table class="lp-table">
                <thead>
                    <tr>
                        <th data-sort="date" class="desc">@L["Date"]</th>
                        <th>@L["Tenant"]</th>
                        <th>@L["Property / unit"]</th>
                        <th>@L["Method"]</th>
                        <th class="lp-num" data-sort="amount">@L["Amount"]</th>
                        <th data-sort="status">@L["Status"]</th>
                        <th>@L["Reference"]</th>
                        <th class="lp-right">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.OrderByDescending(x => x.PaymentDate))
                    {
                        var search = $"{p.TenantName} {p.TenantCivilID} {p.PaymentCivilID} {p.BuildingName} {p.UnitNumber} {p.TransactionReference} {p.ReceiptNumber} {p.PaymentType} {p.Status}".ToLowerInvariant();
                        var initials = string.Concat((p.TenantName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpperInvariant();
                        var reference = !string.IsNullOrEmpty(p.TransactionReference) ? p.TransactionReference : p.ReceiptNumber;
                        <tr data-search="@search" data-method="@p.PaymentType" data-status="@p.Status" data-mismatch="@(p.HasMismatch ? "1" : "")"
                            data-sort-date="@p.PaymentDate.ToString("yyyy-MM-ddTHH:mm:ss")" data-sort-amount="@p.Amount" data-sort-status="@p.Status">
                            <td data-label="@L["Date"]">
                                <span class="lp-primary">@p.PaymentDate.ToString("dd MMM yyyy")</span>
                                <span class="lp-sub">@p.PaymentDate.ToString("HH:mm")</span>
                            </td>
                            <td data-label="@L["Tenant"]">
                                <a class="lp-cell-person lp-link" href="/Tenants/Details/@p.TenantId">
                                    <span class="lp-avatar">@initials</span>
                                    <div>
                                        <span class="lp-primary lp-trunc" style="max-width:180px">@p.TenantName</span>
                                        <span class="lp-sub lp-mono">@p.TenantCivilID</span>
                                    </div>
                                </a>
                            </td>
                            <td data-label="@L["Property / unit"]">
                                <span class="lp-trunc" style="max-width:200px">@p.BuildingName</span>
                                <span class="lp-sub">@L["Unit"] @p.UnitNumber</span>
                            </td>
                            <td data-label="@L["Method"]"><span class="lp-chip lp-chip-grey"><i class="fas @MethodIcon(p.PaymentType)"></i> @MethodLabel(p.PaymentType)</span></td>
                            <td class="lp-num" data-label="@L["Amount"]">
                                <span class="lp-amount @(p.Status == "Completed" ? "lp-amount-good" : p.Status is "Failed" or "Rejected" ? "lp-amount-muted" : "")">@p.Amount.ToString("N3", System.Globalization.CultureInfo.InvariantCulture)</span>
                                <span class="lp-sub">KWD</span>
                            </td>
                            <td data-label="@L["Status"]">
                                <span class="lp-chip @StatusChip(p.Status)">@StatusLabel(p.Status)</span>
                                @if (p.HasMismatch)
                                {
                                    <span class="lp-chip lp-chip-red" title="@p.MismatchDetails"><i class="fas fa-triangle-exclamation"></i> @L["Mismatch"]</span>
                                }
                            </td>
                            <td data-label="@L["Reference"]"><span class="lp-mono lp-trunc" style="max-width:160px" title="@reference">@(string.IsNullOrEmpty(reference) ? "—" : reference)</span></td>
                            <td class="lp-right" data-label="@L["Actions"]">
                                <div class="lp-row-actions">
                                    @if (p.Status == "PendingVerification")
                                    {
                                        <a class="lp-btn lp-btn-primary" style="padding:0.3rem 0.6rem;font-size:0.76rem" href="/PaymentApproval/Details/@p.PaymentId"><i class="fas fa-clipboard-check"></i> @L["Confirm"]</a>
                                    }
                                    @if (p.Status == "Completed")
                                    {
                                        <a class="lp-icon-btn" title="@(L["Receipt PDF"].Value)" href="/api/payments/@p.PaymentId/receipt.pdf" target="_blank" rel="noopener"><i class="fas fa-file-pdf"></i></a>
                                    }
                                    <a class="lp-icon-btn" title="@(L["Details"].Value)" href="/Payments/Details/@p.PaymentId"><i class="fas fa-eye"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="lp-empty" data-lp-empty hidden>
            <i class="fas fa-search"></i>
            <h3>@L["No payments match your search"]</h3>
        </div>
    }
</div>
