@model RentCollection.Core.Entities.Property

@{
    ViewData["Title"] = "Delete Property";
    var totalUnits = Model.Units?.Count ?? 0;
    var occupiedUnits = Model.Units?.Count(u => u.Leases != null && u.Leases.Any(l => l.Status == "Active")) ?? 0;
}

<div class="container-fluid">
    <div class="page-header">
        <div>
            <h1>@L["Delete Property"]</h1>
            <p class="text-danger">@L["Are you sure you want to delete this property?"]</p>
        </div>
    </div>

    <div class="delete-card">
        <div class="warning-banner">
            <i class="fas fa-exclamation-triangle"></i>
            <div>
                <h3>@L["Warning"]</h3>
                <p>@L["This action cannot be undone. Deleting this property will remove all associated units, leases, and data."]</p>
            </div>
        </div>

        <div class="property-summary">
            <h3>@L["Property Information"]</h3>
            <dl class="summary-list">
                <dt>@L["Property Name"]</dt>
                <dd>@Model.PropertyName</dd>

                <dt>@L["PACI Number"]</dt>
                <dd>@Model.PACINumber</dd>

                <dt>@L["Property Type"]</dt>
                <dd>@Model.PropertyType</dd>

                <dt>@L["Address"]</dt>
                <dd>@Model.Address, @Model.Governorate, @Model.Area @Model.Block</dd>

                <dt>@L["Total Units"]</dt>
                <dd>@totalUnits</dd>

                <dt>@L["Occupied Units"]</dt>
                <dd>@occupiedUnits</dd>

                <dt>@L["Property Value"]</dt>
                <dd>@("KWD " + (Model.PropertyValue?.ToString("N3") ?? "0.000"))</dd>

                <dt>@L["Purchase Date"]</dt>
                <dd>@Model.PurchaseDate?.ToString("MMMM dd, yyyy")</dd>

                <dt>@L["Manager"]</dt>
                <dd>@(Model.Manager != null ? $"{Model.Manager.FirstName} {Model.Manager.LastName}" : "No Manager Assigned")</dd>

                <dt>@L["Company"]</dt>
                <dd>@Model.Company?.CompanyName</dd>

                <dt>@L["Created Date"]</dt>
                <dd>@Model.CreatedDate.ToString("MMMM dd, yyyy")</dd>
            </dl>
        </div>

        @if (occupiedUnits > 0)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i>
                <div>
                    <strong>@L["Active Tenants Detected!"]</strong>
                    <p>@L["This property has"] @occupiedUnits @L["occupied unit(s). You should terminate or transfer leases before deleting this property."]</p>
                </div>
            </div>
        }

        @if (totalUnits > 0)
        {
            <div class="alert alert-warning">
                <i class="fas fa-info-circle"></i>
                <div>
                    <strong>@L["Units Will Be Deleted"]</strong>
                    <p>@L["This property contains"] @totalUnits @L["unit(s). All units and their associated data will be permanently deleted."]</p>
                </div>
            </div>
        }

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="PropertyId" />
            <div class="form-actions">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> @L["Confirm Delete"]
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times"></i> @L["Cancel"]
                </a>
                <a asp-action="Details" asp-route-id="@Model.PropertyId" class="btn btn-info">
                    <i class="fas fa-info-circle"></i> @L["View Details"]
                </a>
            </div>
        </form>
    </div>
</div>

<style>
    body {
        background: linear-gradient(135deg, #f8fafc 0%, #f2e8c8 50%, #e6d4a0 100%);
        color: #1e293b;
        min-height: 100vh;
    }

    /* Scrollbar styling */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #f1f5f9;
    }

    ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    .delete-card {
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid rgba(138, 109, 31, 0.2);
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        max-width: 900px;
    }

    .warning-banner {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
        padding: 1.5rem;
        border-radius: 8px;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .warning-banner i {
        font-size: 2rem;
        flex-shrink: 0;
    }

    .warning-banner h3 {
        margin: 0 0 0.5rem 0;
        font-size: 1.25rem;
        font-weight: 600;
    }

    .warning-banner p {
        margin: 0;
        opacity: 0.95;
    }

    .property-summary {
        margin-bottom: 2rem;
    }

    .property-summary h3 {
        font-size: 1.25rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #8a6d1f;
    }

    .summary-list {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 1rem 2rem;
        margin: 0;
    }

    .summary-list dt {
        font-weight: 600;
        color: #475569;
    }

    .summary-list dd {
        margin: 0;
        color: #1e293b;
    }

    .description-section {
        margin-bottom: 2rem;
        padding: 1.5rem;
        background: #f9fafb;
        border-radius: 8px;
        border-left: 4px solid #3b82f6;
    }

    .description-section h4 {
        margin: 0 0 1rem 0;
        color: #334155;
        font-size: 1rem;
        font-weight: 600;
    }

    .description-section p {
        margin: 0;
        color: #1e293b;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    .alert {
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .alert-danger {
        background-color: #fee2e2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }

    .alert-warning {
        background-color: #fef3c7;
        border: 1px solid #fde68a;
        color: #92400e;
    }

    .alert i {
        font-size: 1.25rem;
        flex-shrink: 0;
        margin-top: 0.125rem;
    }

    .alert strong {
        display: block;
        margin-bottom: 0.25rem;
    }

    .alert p {
        margin: 0;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid #e5e7eb;
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 500;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-danger {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
    }

    .btn-danger:hover {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    }

    .btn-secondary {
        background: #6b7280;
        color: white;
    }

    .btn-secondary:hover {
        background: #4b5563;
    }

    .btn-info {
        background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
        color: white;
    }

    .btn-info:hover {
        background: linear-gradient(135deg, #0891b2 0%, #0e7490 100%);
    }

    .page-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e5e7eb;
    }

    .page-header h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #334155;
        margin: 0 0 0.5rem 0;
    }

    .page-header .text-danger {
        color: #dc2626;
        margin: 0;
        font-size: 1rem;
    }

    @@media (max-width: 768px) {
        .delete-card {
            padding: 1rem;
        }

        .summary-list {
            grid-template-columns: 1fr;
            gap: 0.5rem;
        }

        .summary-list dt {
            margin-top: 1rem;
        }

        .form-actions {
            flex-direction: column;
        }

        .warning-banner {
            flex-direction: column;
        }
    }
</style>
