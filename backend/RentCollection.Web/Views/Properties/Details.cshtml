@model RentCollection.Core.Entities.Property
@using RentCollection.Core.Entities
@{
    ViewData["Title"] = Model.PropertyName;
    var units = (Model.Units ?? new List<Unit>()).ToList();
    var totalUnits = units.Count;
    var occupiedUnits = units.Count(u => u.Status == "Occupied");
    var vacantUnits = units.Count(u => u.Status == "Vacant");
    var maintenanceUnits = units.Count(u => u.Status == "Maintenance");
    var reservedUnits = units.Count(u => u.Status == "Reserved");
    var unpriced = units.Count(u => u.MonthlyRent <= 0);
    var vacancyCost = units.Where(u => u.Status == "Vacant").Sum(u => u.MonthlyRent);
    var occupancyPct = totalUnits > 0 ? (int)Math.Round(occupiedUnits * 100.0 / totalUnits) : 0;

    decimal rentRoll = ViewBag.RentRoll ?? 0m;
    decimal outstanding = ViewBag.Outstanding ?? 0m;
    decimal collectedMtd = ViewBag.CollectedMtd ?? 0m;
    DateTime? lastPayment = ViewBag.LastPaymentDate as DateTime?;
    var outstandingByLease = ViewBag.OutstandingByLease as Dictionary<int, (decimal Balance, DateTime Oldest)> ?? new();
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    static string NatKey(string s) => System.Text.RegularExpressions.Regex.Replace(s ?? "", @"\d+", m => m.Value.PadLeft(8, '0'));
    string Chip(string status) => status switch
    {
        "Occupied" => "lp-chip-blue", "Vacant" => "lp-chip-green", "Maintenance" => "lp-chip-amber", "Reserved" => "lp-chip-purple", _ => "lp-chip-grey",
    };
    var address = string.Join(", ", new[] {
        string.IsNullOrWhiteSpace(Model.BuildingNumber) ? null : $"{L["Building"].Value} {Model.BuildingNumber}",
        string.IsNullOrWhiteSpace(Model.Street) ? null : $"{L["Street"].Value} {Model.Street}",
        string.IsNullOrWhiteSpace(Model.Block) ? null : $"{L["Block"].Value} {Model.Block}",
        string.IsNullOrWhiteSpace(Model.Area) ? null : Model.Area,
        string.IsNullOrWhiteSpace(Model.Governorate) ? null : Model.Governorate,
    }.Where(s => !string.IsNullOrWhiteSpace(s)));

    var tenants = units
        .SelectMany(u => (u.Leases ?? new List<Lease>()).Where(l => (l.Status == LeaseStatuses.Active || l.Status == LeaseStatuses.Pending) && l.Tenant != null)
            .Select(l => new { Lease = l, Unit = u, Tenant = l.Tenant! }))
        .OrderBy(x => NatKey(x.Unit.UnitNumber))
        .ToList();
    var initials = string.Concat((Model.PropertyName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpperInvariant();
    const int unitPreview = 12;
}

<div class="lp-page">
    @await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData)
    {
        ["Title"] = Model.PropertyName,
        ["Subtitle"] = string.Join(" · ", new[] { string.IsNullOrWhiteSpace(Model.PropertyType) ? null : L[Model.PropertyType].Value, address, string.IsNullOrWhiteSpace(Model.PACINumber) ? null : $"PACI {Model.PACINumber}" }.Where(s => !string.IsNullOrWhiteSpace(s))),
        ["Crumbs"] = new (string label, string? href)[] { (L["Admin"].Value, "/Dashboard"), (L["Properties"].Value, "/Properties"), (Model.PropertyName, null) },
        ["ActionsHtml"] = Html.Raw(
            "<a class=\"lp-btn\" href=\"/Units?propertyId=" + Model.PropertyId + "\"><i class=\"fas fa-door-closed\"></i> " + L["All units"].Value + "</a>" +
            "<a class=\"lp-btn\" href=\"/Units/Create?propertyId=" + Model.PropertyId + "\"><i class=\"fas fa-plus\"></i> " + L["Add unit"].Value + "</a>" +
            "<a class=\"lp-btn\" href=\"/Reports/PropertyPerformance?propertyId=" + Model.PropertyId + "\"><i class=\"fas fa-chart-line\"></i> " + L["Performance"].Value + "</a>" +
            "<a class=\"lp-btn lp-btn-primary\" href=\"/Properties/Edit/" + Model.PropertyId + "\"><i class=\"fas fa-pen\"></i> " + L["Edit"].Value + "</a>")
    })

    @await Html.PartialAsync("_AlertMessages")

    @* ── KPI strip ── *@
    <div class="od od-grid-kpi lp-kpi-5">
        <div class="od-card od-kpi-hero">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Occupancy"]</span></div>
            <div class="od-kpi-value">@occupancyPct%</div>
            <div class="od-kpi-sub">@occupiedUnits / @totalUnits @L["units occupied"]</div>
            <div class="lp-bar" style="margin-top:8px;background:rgba(255,255,255,0.25)"><span style="width:@occupancyPct%;background:#fff"></span></div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Rent roll"]</span></div>
            <div class="od-kpi-value">@rentRoll.ToString("N3", inv) <small>KWD</small></div>
            <div class="od-kpi-sub">@L["per month from active leases"]</div>
        </div>
        <a class="od-card od-card-link" href="/Invoices?propertyId=@Model.PropertyId">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Outstanding"]</span></div>
            <div class="od-kpi-value @(outstanding > 0 ? "od-count-red" : "")">@outstanding.ToString("N3", inv) <small>KWD</small></div>
            <div class="od-kpi-sub">@L["unpaid invoices"]</div>
        </a>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Collected this month"]</span></div>
            <div class="od-kpi-value">@collectedMtd.ToString("N3", inv) <small>KWD</small></div>
            <div class="od-kpi-sub">@(lastPayment.HasValue ? $"{L["Last payment"].Value} {lastPayment.Value.ToString("dd MMM yyyy", inv)}" : L["No payments yet"].Value)</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Vacancy cost"]</span></div>
            <div class="od-kpi-value @(vacancyCost > 0 ? "od-count-red" : "")">@vacancyCost.ToString("N3", inv) <small>KWD</small></div>
            <div class="od-kpi-sub">@vacantUnits @L["vacant"]@(unpriced > 0 ? $" · {unpriced} {L["without rent"].Value}" : "")</div>
        </div>
    </div>

    <div class="pd-grid">
        <div class="pd-main">

            @* ── Current tenants ── *@
            <section class="lp-table-wrap pd-section">
                <div class="pd-section-head">
                    <h2><i class="fas fa-users"></i> @L["Current tenants"] <span class="lp-chip lp-chip-gold">@tenants.Count</span></h2>
                    <div class="lp-row-actions">
                        <a class="lp-btn" href="/Leases?propertyId=@Model.PropertyId"><i class="fas fa-file-contract"></i> @L["Leases"]</a>
                        <a class="lp-btn lp-btn-primary" href="/Leases/Create"><i class="fas fa-file-signature"></i> @L["New lease"]</a>
                    </div>
                </div>
                @if (tenants.Count == 0)
                {
                    <div class="lp-empty" style="border:0"><i class="fas fa-user-slash"></i><h3>@L["No tenants yet"]</h3><p>@L["Create a lease on a vacant unit to add the first tenant."]</p></div>
                }
                else
                {
                    <table class="lp-table">
                        <thead>
                            <tr>
                                <th>@L["Unit"]</th>
                                <th>@L["Tenant"]</th>
                                <th>@L["Lease period"]</th>
                                <th class="lp-num">@L["Rent (KWD)"]</th>
                                <th class="lp-num">@L["Outstanding (KWD)"]</th>
                                <th class="lp-right">@L["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in tenants)
                            {
                                var daysLeft = (t.Lease.LeaseEndDate.Date - DateTime.Today).Days;
                                var has = outstandingByLease.TryGetValue(t.Lease.LeaseId, out var o);
                                var late = has ? (DateTime.Today - o.Oldest.Date).Days : 0;
                                var tInit = string.Concat(new[] { t.Tenant.FirstName, t.Tenant.LastName }.Where(s => !string.IsNullOrEmpty(s)).Select(s => s![0])).ToUpperInvariant();
                                <tr>
                                    <td data-label="@L["Unit"]"><a class="lp-link lp-primary" href="/Units/Details/@t.Unit.UnitId">@t.Unit.UnitNumber</a><span class="lp-sub">@t.Unit.UnitType</span></td>
                                    <td data-label="@L["Tenant"]">
                                        <div class="lp-cell-person">
                                            <span class="lp-avatar">@(tInit.Length == 0 ? "T" : tInit)</span>
                                            <div>
                                                <a class="lp-link lp-primary lp-trunc" style="max-width:150px" href="/Tenants/Details/@t.Tenant.TenantId">@t.Tenant.FirstName @t.Tenant.LastName</a>
                                                <span class="lp-sub lp-mono">@t.Tenant.PACINumber</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="@L["Lease period"]" style="white-space:nowrap;font-size:0.82rem">
                                        <span>@t.Lease.LeaseStartDate.ToString("dd MMM yy", inv) → @t.Lease.LeaseEndDate.ToString("dd MMM yy", inv)</span>
                                        <span class="lp-sub"><span class="lp-chip @(t.Lease.Status == "Active" ? "lp-chip-green" : "lp-chip-amber")">@L[t.Lease.Status]</span>
                                        @if (daysLeft < 0) { <span class="lp-chip lp-chip-red">@L["past end"]</span> } else if (daysLeft <= 30) { <span class="lp-chip lp-chip-amber">@daysLeft @L["days"]</span> }</span>
                                    </td>
                                    <td class="lp-num" data-label="@L["Rent (KWD)"]"><span class="lp-amount">@t.Lease.MonthlyRent.ToString("N3", inv)</span></td>
                                    <td class="lp-num" data-label="@L["Outstanding (KWD)"]">
                                        @if (has) { <span class="lp-amount lp-amount-bad">@o.Balance.ToString("N3", inv)</span><span class="lp-sub">@(late > 0 ? $"{late} {L["days overdue"].Value}" : L["due"].Value)</span> }
                                        else { <span class="lp-amount-muted">0.000</span> }
                                    </td>
                                    <td class="lp-right" data-label="@L["Actions"]">
                                        <div class="lp-row-actions">
                                            @if (has) { <a class="lp-icon-btn" title="@(L["Record payment"].Value)" href="/CashPayment/Record?tenantId=@t.Tenant.TenantId"><i class="fas fa-money-bill"></i></a> }
                                            <a class="lp-icon-btn" title="@(L["Lease"].Value)" href="/Leases/Details/@t.Lease.LeaseId"><i class="fas fa-file-contract"></i></a>
                                            <a class="lp-icon-btn" title="@(L["Invoices"].Value)" href="/Invoices?leaseId=@t.Lease.LeaseId"><i class="fas fa-file-invoice-dollar"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>

            @* ── Units ── *@
            <section class="lp-table-wrap pd-section">
                <div class="pd-section-head">
                    <h2><i class="fas fa-door-closed"></i> @L["Units"] <span class="lp-chip lp-chip-gold">@totalUnits</span></h2>
                    <div class="lp-chips">
                        <a class="lp-chip-btn" href="/Units?propertyId=@Model.PropertyId&status=Vacant"><span class="lp-dot lp-dot-green"></span> @vacantUnits @L["Vacant"]</a>
                        <a class="lp-chip-btn" href="/Units?propertyId=@Model.PropertyId&status=Occupied"><span class="lp-dot" style="background:#3b82f6"></span> @occupiedUnits @L["Occupied"]</a>
                        @if (maintenanceUnits > 0) { <a class="lp-chip-btn" href="/Units?propertyId=@Model.PropertyId&status=Maintenance"><span class="lp-dot lp-dot-amber"></span> @maintenanceUnits @L["Maintenance"]</a> }
                        @if (reservedUnits > 0) { <a class="lp-chip-btn" href="/Units?propertyId=@Model.PropertyId&status=Reserved"><span class="lp-dot" style="background:#a855f7"></span> @reservedUnits @L["Reserved"]</a> }
                        @if (unpriced > 0) { <span class="lp-chip lp-chip-amber"><i class="fas fa-tag"></i> @unpriced @L["without rent"]</span> }
                    </div>
                </div>
                @if (totalUnits == 0)
                {
                    <div class="lp-empty" style="border:0"><i class="fas fa-door-open"></i><h3>@L["No units yet"]</h3><p><a href="/Units/Create?propertyId=@Model.PropertyId">@L["Add the first unit"]</a></p></div>
                }
                else
                {
                    <table class="lp-table" id="pdUnits">
                        <thead>
                            <tr>
                                <th>@L["Unit"]</th>
                                <th>@L["Details"]</th>
                                <th class="lp-num">@L["Listed rent"]</th>
                                <th>@L["Status"]</th>
                                <th>@L["Tenant / availability"]</th>
                                <th class="lp-right">@L["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var idx = 0; }
                            @foreach (var u in units.OrderBy(x => NatKey(x.FloorNumber ?? "")).ThenBy(x => NatKey(x.UnitNumber)))
                            {
                                idx++;
                                var lease = (u.Leases ?? new List<Lease>()).Where(l => l.Status == LeaseStatuses.Active || l.Status == LeaseStatuses.Pending)
                                    .OrderBy(l => l.Status == LeaseStatuses.Active ? 0 : 1).FirstOrDefault();
                                // A Vacant unit with a Pending (deposit-awaiting) lease is shown as Reserved.
                                var isPendingHold = u.Status == "Vacant" && lease?.Status == LeaseStatuses.Pending;
                                var displayStatus = isPendingHold ? "Reserved" : u.Status;
                                var specs = new List<string>();
                                if (!string.IsNullOrWhiteSpace(u.UnitType)) specs.Add(L[u.UnitType].Value);
                                if (!string.IsNullOrWhiteSpace(u.FloorNumber)) specs.Add($"{L["Floor"].Value} {u.FloorNumber}");
                                if (u.Bedrooms.HasValue) specs.Add($"{u.Bedrooms} {L["bed"].Value}");
                                if (u.Bathrooms.HasValue) specs.Add($"{u.Bathrooms} {L["bath"].Value}");
                                <tr class="@(idx > unitPreview ? "pd-more" : "")" @(idx > unitPreview ? "hidden" : "")>
                                    <td data-label="@L["Unit"]"><a class="lp-link lp-primary" href="/Units/Details/@u.UnitId">@u.UnitNumber</a></td>
                                    <td data-label="@L["Details"]"><span style="font-size:0.8rem;color:#475569">@(specs.Count > 0 ? string.Join(" · ", specs) : "—")</span></td>
                                    <td class="lp-num" data-label="@L["Listed rent"]">@if (u.MonthlyRent > 0) { <span class="lp-amount">@u.MonthlyRent.ToString("N3", inv)</span> } else { <span class="lp-chip lp-chip-amber">@L["No rent set"]</span> }</td>
                                    <td data-label="@L["Status"]"><span class="lp-chip @Chip(displayStatus)">@L[displayStatus]</span>@if (isPendingHold) { <span class="lp-sub">@L["Pending lease"]</span> }</td>
                                    <td data-label="@L["Tenant / availability"]">
                                        @if (lease?.Tenant != null) { <a class="lp-link" href="/Tenants/Details/@lease.Tenant.TenantId">@lease.Tenant.FirstName @lease.Tenant.LastName</a>@if (lease.Status == LeaseStatuses.Pending) { <span class="lp-sub"><span class="lp-chip lp-chip-amber">@L["Pending"]</span> @L["activate to occupy"]</span> } else { <span class="lp-sub">@L["until"] @lease.LeaseEndDate.ToString("dd MMM yyyy", inv)</span> } }
                                        else if (u.Status == "Vacant") { <span class="lp-amount-good">@L["Available"]</span>@if (u.AvailableFromDate.HasValue && u.AvailableFromDate.Value.Date > DateTime.Today) { <span class="lp-sub">@L["from"] @u.AvailableFromDate.Value.ToString("dd MMM yyyy", inv)</span> } }
                                        else { <span class="lp-amount-muted">—</span> }
                                    </td>
                                    <td class="lp-right" data-label="@L["Actions"]">
                                        <div class="lp-row-actions">
                                            @if (u.Status == "Vacant" && lease == null) { <a class="lp-btn lp-btn-primary" style="padding:0.3rem 0.6rem;font-size:0.76rem" href="/Leases/Create?unitId=@u.UnitId"><i class="fas fa-file-signature"></i> @L["Lease"]</a> }
                                            <a class="lp-icon-btn" title="@(L["Edit"].Value)" href="/Units/Edit/@u.UnitId"><i class="fas fa-pen"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (totalUnits > unitPreview)
                    {
                        <div class="pd-more-bar">
                            <button type="button" class="lp-btn" id="pdShowAll" data-more="@(totalUnits - unitPreview)"><i class="fas fa-chevron-down"></i> @L["Show all"] @totalUnits @L["units"]</button>
                            <a class="lp-btn" href="/Units?propertyId=@Model.PropertyId"><i class="fas fa-filter"></i> @L["Open in Units with filters"]</a>
                        </div>
                    }
                }
            </section>
        </div>

        <aside class="pd-side">
            <div class="pd-card">
                <div class="pd-card-head"><i class="fas fa-building"></i> @L["Property information"]</div>
                <dl class="pd-dl">
                    <div><dt>@L["Type"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.PropertyType) ? "—" : L[Model.PropertyType].Value)</dd></div>
                    <div><dt>@L["PACI Number"]</dt><dd class="lp-mono">@(string.IsNullOrWhiteSpace(Model.PACINumber) ? "—" : Model.PACINumber)</dd></div>
                    <div><dt>@L["Status"]</dt><dd><span class="lp-chip @(Model.Status == "Active" ? "lp-chip-green" : "lp-chip-grey")">@L[Model.Status]</span></dd></div>
                    <div><dt>@L["Units"]</dt><dd>@totalUnits @(Model.NumberOfUnits != totalUnits ? $"({L["planned"].Value} {Model.NumberOfUnits})" : "")</dd></div>
                    <div><dt>@L["Property Value"]</dt><dd>@(Model.PropertyValue.HasValue ? $"KWD {Model.PropertyValue.Value.ToString("N3", inv)}" : "—")</dd></div>
                    <div><dt>@L["Purchase Date"]</dt><dd>@(Model.PurchaseDate?.ToString("dd MMM yyyy", inv) ?? "—")</dd></div>
                    <div><dt>@L["Company"]</dt><dd>@(Model.Company?.CompanyName ?? "—")</dd></div>
                    <div><dt>@L["Created"]</dt><dd>@Model.CreatedDate.ToString("dd MMM yyyy", inv)</dd></div>
                </dl>
            </div>

            <div class="pd-card">
                <div class="pd-card-head"><i class="fas fa-location-dot"></i> @L["Address"]</div>
                <dl class="pd-dl">
                    <div><dt>@L["Address"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.Address) ? "—" : Model.Address)</dd></div>
                    <div><dt>@L["Governorate"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.Governorate) ? "—" : Model.Governorate)</dd></div>
                    <div><dt>@L["Area"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.Area) ? "—" : Model.Area)</dd></div>
                    <div><dt>@L["Block"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.Block) ? "—" : Model.Block)</dd></div>
                    <div><dt>@L["Street"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.Street) ? "—" : Model.Street)</dd></div>
                    <div><dt>@L["Building"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.BuildingNumber) ? "—" : Model.BuildingNumber)</dd></div>
                </dl>
            </div>

            @if (Model.Manager != null)
            {
                <div class="pd-card">
                    <div class="pd-card-head"><i class="fas fa-user-tie"></i> @L["Property Manager"]</div>
                    <dl class="pd-dl">
                        <div><dt>@L["Name"]</dt><dd>@Model.Manager.FirstName @Model.Manager.LastName</dd></div>
                        <div><dt>@L["Email"]</dt><dd><a class="lp-link" href="mailto:@Model.Manager.Email">@Model.Manager.Email</a></dd></div>
                        <div><dt>@L["Phone"]</dt><dd><a class="lp-link" href="tel:@Model.Manager.PhoneNumber">@Model.Manager.PhoneNumber</a></dd></div>
                    </dl>
                </div>
            }

            @* Documents — markup/ids unchanged; the script below drives it. *@
            <div class="info-card pd-card" id="docsCard">
                <div class="info-card-header">
                    <h2 class="info-card-title">
                        <i class="fas fa-folder-open"></i>
                        @L["Documents"]
                        <span class="docs-count" id="docsCount" aria-live="polite"></span>
                    </h2>
                    <button type="button" class="btn-add" id="docsToggleUpload">
                        <i class="fas fa-upload"></i> @L["Upload"]
                    </button>
                </div>
                @Html.AntiForgeryToken()
                <form class="docs-upload-form" id="docsUploadForm" enctype="multipart/form-data" hidden>
                    <input type="hidden" name="entityType" value="Property" />
                    <input type="hidden" name="entityId" value="@Model.PropertyId" />
                    <div class="upload-row">
                        <input type="file" name="file" required accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" />
                        <input type="text" name="documentType" placeholder="@(L["Type (e.g. Contract, ID)"].Value)" required maxlength="50" />
                    </div>
                    <div class="upload-row">
                        <input type="text" name="description" placeholder="@(L["Description (optional)"].Value)" maxlength="200" />
                        <button type="submit" class="btn-primary">
                            <i class="fas fa-circle-check"></i> @L["Upload & link"]
                        </button>
                    </div>
                    <div class="upload-msg" id="docsUploadMsg" hidden></div>
                </form>
                <div class="docs-list" id="docsList">
                    <div class="docs-skeleton" id="docsSkeleton">
                        <div class="skel-row"></div>
                        <div class="skel-row"></div>
                    </div>
                </div>
                <div class="docs-empty" id="docsEmpty" hidden>
                    <i class="fas fa-folder-open"></i>
                    <p>@L["No documents linked to this property yet."]</p>
                </div>
            </div>
        </aside>
    </div>
</div>


<script>
    document.getElementById('pdShowAll')?.addEventListener('click', function () {
        document.querySelectorAll('#pdUnits tr.pd-more').forEach(function (r) { r.hidden = false; });
        this.closest('.pd-more-bar').querySelector('#pdShowAll').remove();
    });
</script>

@section Scripts {
    <script>
    (function () {
        const PROPERTY_ID = @Model.PropertyId;
        const list = document.getElementById('docsList');
        const empty = document.getElementById('docsEmpty');
        const count = document.getElementById('docsCount');
        const skel = document.getElementById('docsSkeleton');
        const token = document.querySelector('#docsCard input[name="__RequestVerificationToken"]').value;

        const ICONS = {
            '.pdf': 'fa-file-pdf', '.doc': 'fa-file-word', '.docx': 'fa-file-word',
            '.xls': 'fa-file-excel', '.xlsx': 'fa-file-excel',
            '.jpg': 'fa-file-image', '.jpeg': 'fa-file-image', '.png': 'fa-file-image',
        };
        const KB = b => b < 1024 ? `${b} B` : b < 1024*1024 ? `${(b/1024).toFixed(1)} KB` : `${(b/1024/1024).toFixed(1)} MB`;
        const ext = n => { const i = n.lastIndexOf('.'); return i < 0 ? '' : n.slice(i).toLowerCase(); };

        async function load() {
            try {
                const res = await fetch(`/Documents/ByEntity?type=Property&id=${PROPERTY_ID}`,
                    { credentials: 'same-origin' });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const docs = await res.json();
                render(docs);
            } catch (e) {
                skel?.remove();
                list.innerHTML = `<div class="docs-error">Couldn't load documents (${e.message}).</div>`;
            }
        }

        function render(docs) {
            skel?.remove();
            list.innerHTML = '';
            count.textContent = docs.length ? `· ${docs.length}` : '';
            if (!docs.length) { empty.removeAttribute('hidden'); return; }
            empty.setAttribute('hidden', '');

            for (const d of docs) {
                const icon = ICONS[ext(d.documentName)] || 'fa-file';
                const date = new Date(d.uploadedDate).toLocaleDateString(undefined,
                    { year: 'numeric', month: 'short', day: '2-digit' });
                const row = document.createElement('div');
                row.className = 'doc-row';
                row.dataset.docId = d.documentId;
                row.dataset.linkId = d.linkId ?? '';
                row.innerHTML = `
                    <i class="fas ${icon} doc-row-icon"></i>
                    <div class="doc-row-body">
                      <a class="doc-row-name" href="/Documents/Download/${d.documentId}">${escapeHtml(d.documentName)}</a>
                      <div class="doc-row-meta">
                        <span class="doc-row-type">${escapeHtml(d.documentType || '—')}</span>
                        &middot; ${KB(d.fileSize)} &middot; ${escapeHtml(d.uploadedBy || '')} &middot; ${date}
                      </div>
                      ${d.description ? `<div class="doc-row-desc">${escapeHtml(d.description)}</div>` : ''}
                    </div>
                    <div class="doc-row-actions">
                      <a href="/Documents/Download/${d.documentId}" title="Download" class="btn-row-icon"><i class="fas fa-download"></i></a>
                      <button type="button" class="btn-row-icon btn-row-danger" title="Unlink from this property"
                              data-action="unlink"><i class="fas fa-link-slash"></i></button>
                    </div>`;
                list.appendChild(row);
            }
        }

        function escapeHtml(s) {
            return (s ?? '').replace(/[&<>"']/g, c => ({
                '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
            }[c]));
        }

        list.addEventListener('click', async (e) => {
            const btn = e.target.closest('[data-action="unlink"]');
            if (!btn) return;
            const row = btn.closest('.doc-row');
            const linkId = row.dataset.linkId;
            if (!linkId) { alert('No link id - refresh and try again.'); return; }
            if (!confirm("Remove this document's link to this property? The file itself isn't deleted.")) return;
            btn.disabled = true;
            try {
                const fd = new FormData();
                fd.set('linkId', linkId);
                fd.set('__RequestVerificationToken', token);
                const res = await fetch('/Documents/Unlink', { method: 'POST', body: fd, credentials: 'same-origin' });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                row.remove();
                const remaining = list.querySelectorAll('.doc-row').length;
                count.textContent = remaining ? `· ${remaining}` : '';
                if (!remaining) empty.removeAttribute('hidden');
            } catch (err) {
                alert('Unlink failed: ' + err.message);
                btn.disabled = false;
            }
        });

        // Inline upload form
        const form = document.getElementById('docsUploadForm');
        const toggle = document.getElementById('docsToggleUpload');
        const msg = document.getElementById('docsUploadMsg');
        toggle.addEventListener('click', () => {
            form.hidden = !form.hidden;
            if (!form.hidden) form.querySelector('input[type="file"]').focus();
        });
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            msg.hidden = true;
            const fd = new FormData(form);
            fd.set('__RequestVerificationToken', token);
            const btn = form.querySelector('button[type="submit"]');
            btn.disabled = true;
            try {
                const res = await fetch('/Documents/Upload', { method: 'POST', body: fd, credentials: 'same-origin' });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                form.reset();
                form.hidden = true;
                msg.hidden = false;
                msg.className = 'upload-msg upload-msg-ok';
                msg.innerHTML = '<i class="fas fa-circle-check"></i> Uploaded.';
                setTimeout(() => msg.hidden = true, 3000);
                await load();
            } catch (err) {
                msg.hidden = false;
                msg.className = 'upload-msg upload-msg-err';
                msg.textContent = 'Upload failed: ' + err.message;
            } finally {
                btn.disabled = false;
            }
        });

        load();
    })();
    </script>
}

