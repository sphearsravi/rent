@model List<RentCollection.Core.Entities.Property>
@using RentCollection.Core.Entities
@{
    ViewData["Title"] = "Properties";
    var stats = ViewBag.PropertyStats as Dictionary<int, RentCollection.Web.Controllers.PropertiesController.PropertyListStats>
                ?? new Dictionary<int, RentCollection.Web.Controllers.PropertiesController.PropertyListStats>();
    RentCollection.Web.Controllers.PropertiesController.PropertyListStats S(int id) =>
        stats.TryGetValue(id, out var s) ? s : new(0, 0, 0, 0, 0, 0, 0);

    var types = Model.Select(p => p.PropertyType).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct().OrderBy(t => t).ToList();
    var governorates = Model.Select(p => p.Governorate).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct().OrderBy(t => t).ToList();
    var totalRentRoll = Model.Sum(p => S(p.PropertyId).RentRoll);
    var totalVacancyCost = Model.Sum(p => S(p.PropertyId).VacancyCost);
    var totalUnits = Model.Sum(p => S(p.PropertyId).Total);
    var totalOcc = Model.Sum(p => S(p.PropertyId).Occupied);

    string Initials(string name) => string.Concat((name ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpperInvariant();
}

<div class="lp-page" data-lp-scope>
    @await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData)
    {
        ["Title"] = L["Properties"].Value,
        ["Subtitle"] = string.Format(L["{0} properties · {1} units · {2}% occupied"].Value, Model.Count, totalUnits, totalUnits == 0 ? 0 : Math.Round(100.0 * totalOcc / totalUnits)),
        ["Crumbs"] = new (string label, string? href)[] { (L["Admin"].Value, "/Dashboard"), (L["Properties"].Value, null) },
        ["ActionsHtml"] = Html.Raw(
            "<a class=\"lp-btn lp-btn-export\" href=\"/Properties/ExportExcel\"><i class=\"fas fa-file-excel\"></i> " + L["Export"].Value + "</a>" +
            "<a class=\"lp-btn lp-btn-primary\" href=\"/Properties/Create\"><i class=\"fas fa-plus\"></i> " + L["Add Property"].Value + "</a>")
    })

    @await Html.PartialAsync("_AlertMessages")

    @* ── KPI strip ── *@
    <div class="od od-grid-kpi lp-kpi-5">
        <div class="od-card od-kpi-hero">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Rent roll"]</span></div>
            <div class="od-kpi-value">@totalRentRoll.ToString("N3", System.Globalization.CultureInfo.InvariantCulture) <small style="font-size:0.6em;font-weight:500">KWD</small></div>
            <div class="od-kpi-sub">@L["per month from active leases"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Occupancy"]</span></div>
            <div class="od-kpi-value">@((totalUnits == 0 ? 0 : Math.Round(100.0 * totalOcc / totalUnits, 1)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%</div>
            <div class="od-kpi-sub">@totalOcc / @totalUnits @L["units occupied"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Vacancy cost"]</span></div>
            <div class="od-kpi-value @(totalVacancyCost > 0 ? "od-count-red" : "")">@totalVacancyCost.ToString("N3", System.Globalization.CultureInfo.InvariantCulture) <small style="font-size:0.6em;font-weight:500">KWD</small></div>
            <div class="od-kpi-sub">@L["listed rent of vacant units, per month"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Outstanding"]</span></div>
            <div class="od-kpi-value lp-skel" id="kpiOutstanding">&nbsp;</div>
            <div class="od-kpi-sub">@L["unpaid invoices, all properties"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Collected this month"]</span></div>
            <div class="od-kpi-value lp-skel" id="kpiMtd">&nbsp;</div>
            <div class="od-kpi-sub">@L["completed payments"]</div>
        </div>
    </div>

    @* ── Toolbar ── *@
    <div class="lp-toolbar">
        <div class="lp-toolbar-row">
            <label class="lp-search">
                <i class="fas fa-search"></i>
                <input type="search" data-lp-search placeholder="@(L["Search by property name, PACI number or area…"].Value)" />
            </label>
            <span class="lp-result-count" data-lp-count data-all="@(L["Showing all {0} properties"].Value)" data-some="@(L["Showing {0} of {1} properties"].Value)"></span>
            <div class="lp-toolbar-spacer"></div>
            <div class="lp-chips" id="propSort">
                <span class="lp-chips-label">@L["Sort"]</span>
                <button type="button" class="lp-chip-btn is-on" data-sort="name">@L["Name"]</button>
                <button type="button" class="lp-chip-btn" data-sort="rent" data-dir="desc">@L["Rent roll"]</button>
                <button type="button" class="lp-chip-btn" data-sort="occ">@L["Lowest occupancy"]</button>
                <button type="button" class="lp-chip-btn" data-sort="out" data-dir="desc">@L["Outstanding"]</button>
            </div>
        </div>
        <div class="lp-toolbar-row">
            <div class="lp-chips" data-lp-filter="type">
                <span class="lp-chips-label">@L["Type"]</span>
                <button type="button" class="lp-chip-btn is-on" data-value="">@L["All"]</button>
                @foreach (var t in types) { <button type="button" class="lp-chip-btn" data-value="@t">@L[t]</button> }
            </div>
            @if (governorates.Count > 1)
            {
                <div class="lp-chips" data-lp-filter="gov">
                    <span class="lp-chips-label">@L["Governorate"]</span>
                    <button type="button" class="lp-chip-btn is-on" data-value="">@L["All"]</button>
                    @foreach (var g in governorates) { <button type="button" class="lp-chip-btn" data-value="@g">@g</button> }
                </div>
            }
            <div class="lp-chips" data-lp-filter="flag">
                <span class="lp-chips-label">@L["Show"]</span>
                <button type="button" class="lp-chip-btn is-on" data-value="">@L["All"]</button>
                <button type="button" class="lp-chip-btn" data-value="vacant"><i class="fas fa-door-open"></i> @L["Has vacancies"]</button>
                <button type="button" class="lp-chip-btn" data-value="arrears"><i class="fas fa-triangle-exclamation"></i> @L["Has arrears"]</button>
                <button type="button" class="lp-chip-btn" data-value="unpriced"><i class="fas fa-tag"></i> @L["Units without rent"]</button>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="lp-empty">
            <i class="fas fa-building"></i>
            <h3>@L["No properties yet"]</h3>
            <p><a href="/Properties/Create">@L["Add your first property"]</a></p>
        </div>
    }

    <div class="lp-cards" id="propCards">
        @foreach (var p in Model)
        {
            var s = S(p.PropertyId);
            var pct = (int)Math.Round(s.OccupancyPercent);
            var addr = string.Join(", ", new[] { p.Block, p.Area, p.Governorate }.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x.Trim()));
            var search = $"{p.PropertyName} {p.PACINumber} {p.Area} {p.Governorate} {p.PropertyType}".ToLowerInvariant();
            var flags = new List<string>();
            if (s.Vacant > 0) flags.Add("vacant");
            if (s.UnpricedUnits > 0) flags.Add("unpriced");
            <article class="lp-card" data-search="@search" data-type="@p.PropertyType" data-gov="@p.Governorate" data-flag="@string.Join(" ", flags)"
                     data-property-id="@p.PropertyId" data-name="@p.PropertyName" data-rent="@s.RentRoll" data-occ="@s.OccupancyPercent" data-out="0">
                <div class="lp-card-head">
                    <span class="lp-group-mark">@Initials(p.PropertyName)</span>
                    <div style="min-width:0;flex:1">
                        <h3 class="lp-card-title"><a href="/Properties/Details/@p.PropertyId">@p.PropertyName</a></h3>
                        <div class="lp-card-sub">
                            @if (!string.IsNullOrWhiteSpace(p.PropertyType)) { <span class="lp-chip lp-chip-gold">@L[p.PropertyType]</span> }
                            @if (!string.IsNullOrWhiteSpace(addr)) { <text> <i class="fas fa-location-dot" style="color:#c9a647"></i> @addr</text> }
                            @if (!string.IsNullOrWhiteSpace(p.PACINumber)) { <span class="lp-sub lp-mono">PACI @p.PACINumber</span> }
                        </div>
                    </div>
                    <div class="lp-row-actions">
                        <span class="lp-chip @(p.Status == "Active" ? "lp-chip-green" : "lp-chip-grey")">@L[p.Status]</span>
                        <div class="kebab-wrap">
                            <button type="button" class="kebab-btn" aria-haspopup="menu" aria-expanded="false" aria-label="@(L["More actions"].Value)"><i class="fas fa-ellipsis-vertical"></i></button>
                            <div class="kebab-menu" role="menu" hidden>
                                <a href="/Properties/Details/@p.PropertyId" role="menuitem"><i class="fas fa-eye"></i> @L["View"]</a>
                                <a href="/Properties/Edit/@p.PropertyId" role="menuitem"><i class="fas fa-pen"></i> @L["Edit"]</a>
                                <div class="kebab-sep"></div>
                                <a href="/Units?propertyId=@p.PropertyId" role="menuitem"><i class="fas fa-door-closed"></i> @L["Units"]</a>
                                <a href="/Units/Create?propertyId=@p.PropertyId" role="menuitem"><i class="fas fa-plus"></i> @L["Add unit"]</a>
                                <a href="/Tenants?propertyId=@p.PropertyId" role="menuitem"><i class="fas fa-users"></i> @L["Tenants"]</a>
                                <a href="/Invoices?propertyId=@p.PropertyId" role="menuitem"><i class="fas fa-file-invoice-dollar"></i> @L["Invoices"]</a>
                                <a href="/Reports/PropertyPerformance?propertyId=@p.PropertyId" role="menuitem"><i class="fas fa-chart-line"></i> @L["Performance report"]</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="lp-card-hero">
                    <div>
                        <b>@s.RentRoll.ToString("N3", System.Globalization.CultureInfo.InvariantCulture) <small style="font-size:0.7em;font-weight:500;color:#64748b">KWD</small></b>
                        <span>@L["Rent roll / month"]</span>
                    </div>
                    <div>
                        <b class="prop-outstanding lp-skel" data-kpi="outstanding">&nbsp;</b>
                        <span>@L["Outstanding"]</span>
                    </div>
                </div>

                <div class="lp-card-occ">
                    <div class="lp-card-occ-row">
                        <span><b>@s.Occupied</b> @L["occupied"] · <b>@s.Vacant</b> @L["vacant"]@(s.Total - s.Occupied - s.Vacant > 0 ? $" · {s.Total - s.Occupied - s.Vacant} {L["other"].Value}" : "")</span>
                        <span><b>@pct%</b></span>
                    </div>
                    <div class="lp-bar @(s.Total == 0 || pct == 0 ? "is-zero" : pct < 50 ? "is-low" : "")"><span style="width:@pct%"></span></div>
                </div>

                <div class="lp-card-stats">
                    <div><b class="lp-skel" data-kpi="mtd">&nbsp;</b><span>@L["Collected MTD (KWD)"]</span></div>
                    <div><b class="lp-skel" data-kpi="last">&nbsp;</b><span>@L["Last payment"]</span></div>
                    <div><b class="@(s.VacancyCost > 0 ? "lp-amount-bad" : "")">@s.VacancyCost.ToString("N3", System.Globalization.CultureInfo.InvariantCulture)</b><span>@L["Vacancy cost / mo (KWD)"]</span></div>
                </div>
                @if (s.UnpricedUnits > 0)
                {
                    <div style="padding:0.4rem 1rem;font-size:0.76rem;color:#b45309;background:#fffbeb;border-top:1px solid #fde68a">
                        <i class="fas fa-tag"></i> @s.UnpricedUnits @L["unit(s) have no monthly rent set — vacancy cost and rent roll are understated."]
                    </div>
                }
                <div class="lp-card-foot">
                    <a class="lp-btn" href="/Units?propertyId=@p.PropertyId"><i class="fas fa-door-closed"></i> @L["Units"]</a>
                    <a class="lp-btn" href="/Leases?propertyId=@p.PropertyId"><i class="fas fa-file-contract"></i> @L["Leases"]</a>
                    <a class="lp-btn lp-btn-primary" href="/Properties/Details/@p.PropertyId"><i class="fas fa-eye"></i> @L["Open"]</a>
                </div>
            </article>
        }
    </div>
    <div class="lp-empty" data-lp-empty hidden>
        <i class="fas fa-search"></i>
        <h3>@L["No properties match your search"]</h3>
    </div>
</div>

@section Scripts {
    <script>
        (async function () {
            // Per-property collection figures (outstanding / MTD / last payment)
            // from /Properties/KpiBatch, plus portfolio totals for the strip.
            const cards = Array.from(document.querySelectorAll('.lp-card[data-property-id]'));
            const ids = cards.map(c => c.dataset.propertyId);
            const setText = (el, text, cls) => { if (!el) return; el.classList.remove('lp-skel'); el.textContent = text; if (cls) el.classList.add(cls); };
            const num = v => (Number(v) || 0).toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
            const setMoney = (el, v, cls) => { if (!el) return; el.classList.remove('lp-skel'); el.innerHTML = num(v) + ' <small style="font-size:0.7em;font-weight:500;color:#64748b">KWD</small>'; if (cls) el.classList.add(cls); };
            const fail = () => document.querySelectorAll('.lp-skel').forEach(el => { el.classList.remove('lp-skel'); el.textContent = '—'; });
            if (!ids.length) { fail(); return; }
            try {
                const res = await fetch('/Properties/KpiBatch?ids=' + ids.join(','), { credentials: 'same-origin' });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const rows = await res.json();
                let totOut = 0, totMtd = 0;
                const byId = new Map(rows.map(r => [String(r.propertyId), r]));
                cards.forEach(card => {
                    const r = byId.get(card.dataset.propertyId); if (!r) return;
                    const out = Number(r.outstanding ?? r.outstandingBalance ?? 0), mtd = Number(r.mtdCollected ?? 0);
                    totOut += out; totMtd += mtd;
                    card.dataset.out = out;
                    if (out > 0) card.dataset.flag = (card.dataset.flag + ' arrears').trim();
                    setMoney(card.querySelector('[data-kpi="outstanding"]'), out, out > 0 ? 'lp-amount-bad' : 'lp-amount-muted');
                    setText(card.querySelector('[data-kpi="mtd"]'), num(mtd), mtd > 0 ? 'lp-amount-good' : '');
                    setText(card.querySelector('[data-kpi="last"]'), r.lastPaymentDate ? LP.fullDate(r.lastPaymentDate) : '—');
                });
                setMoney(document.getElementById('kpiOutstanding'), totOut, totOut > 0 ? 'od-count-red' : '');
                setMoney(document.getElementById('kpiMtd'), totMtd);
            } catch (e) { fail(); }
        })();

        // Sort chips (client-side; the grid is the whole portfolio).
        (function () {
            const grid = document.getElementById('propCards');
            document.querySelectorAll('#propSort .lp-chip-btn').forEach(btn => btn.addEventListener('click', () => {
                document.querySelectorAll('#propSort .lp-chip-btn').forEach(b => b.classList.remove('is-on'));
                btn.classList.add('is-on');
                const key = btn.dataset.sort, dir = btn.dataset.dir === 'desc' ? -1 : 1;
                Array.from(grid.children).sort((a, b) => {
                    if (key === 'name') return a.dataset.name.localeCompare(b.dataset.name) * dir;
                    return (parseFloat(a.dataset[key]) - parseFloat(b.dataset[key])) * dir;
                }).forEach(el => grid.appendChild(el));
            }));
        })();
    </script>
}
