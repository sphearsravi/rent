@using RentCollection.Web.Models
@{
    ViewData["Title"] = "Executive Dashboard";

    DateTime fromDate = ViewBag.FromDate;
    DateTime toDate = ViewBag.ToDate;

    // KPI row
    decimal periodCollected = ViewBag.PeriodCollected;
    decimal periodInvoiced = ViewBag.PeriodInvoiced;
    decimal collectionRate = ViewBag.CollectionRate;
    decimal totalOutstanding = ViewBag.TotalOutstanding;
    int outstandingInvoices = ViewBag.OutstandingInvoices;
    decimal overdueAmount = ViewBag.OverdueAmount;
    int overdueInvoices = ViewBag.OverdueInvoices;
    decimal occupancyRate = ViewBag.OccupancyRate;
    int totalUnits = ViewBag.TotalUnits;
    int occupiedUnits = ViewBag.OccupiedUnits;
    int vacantUnits = ViewBag.VacantUnits;
    int totalProperties = ViewBag.TotalProperties;

    // Financials
    decimal potentialMonthlyRent = ViewBag.PotentialMonthlyRent;
    decimal actualMonthlyRent = ViewBag.ActualMonthlyRent;
    decimal ytdRevenue = ViewBag.YTDRevenue;
    decimal maintenanceCost = ViewBag.YTDMaintenanceCosts;
    int maintenanceCount = ViewBag.MaintenanceCount;
    decimal netRevenue = ViewBag.NetRevenue;
    decimal prevMonthRevenue = ViewBag.PrevMonthRevenue;
    decimal revenueChange = ViewBag.RevenueChange;

    // People
    int activeTenants = ViewBag.ActiveTenants;
    int activeLeases = ViewBag.ActiveLeases;
    int expiringLeases = ViewBag.ExpiringLeases;
    decimal avgRentPerTenant = ViewBag.AvgRentPerTenant;
    decimal avgMaintenanceCost = ViewBag.AvgMaintenanceCost;

    var trend = ViewBag.Trend as List<ExecutiveTrendPoint> ?? new List<ExecutiveTrendPoint>();
    var propertyRows = ViewBag.PropertyRows as List<ExecutivePropertyRow> ?? new List<ExecutivePropertyRow>();

    var barPct = (int)Math.Clamp(Math.Round(collectionRate), 0, 100);
    var unletRent = Math.Max(0, potentialMonthlyRent - actualMonthlyRent);
    var trendExpected = trend.Sum(t => t.Expected);
    var trendCollected = trend.Sum(t => t.Collected);
    decimal? trendRate = trendExpected > 0 ? Math.Min(100, trendCollected / trendExpected * 100) : null;
    var bestMonth = trend.Where(t => t.Expected > 0)
        .OrderByDescending(t => t.Collected / t.Expected).FirstOrDefault();

    var fromQ = fromDate.ToString("yyyy-MM-dd");
    var toQ = toDate.ToString("yyyy-MM-dd");

    string Kwd(decimal v) => "KWD " + v.ToString("N3");
    string Pct(decimal v) => v.ToString("N1") + "%";
    string Grade(decimal? r) => r == null ? "" : r < 60 ? "is-red" : r < 90 ? "is-amber" : "is-green";
    string Dot(decimal? r) => r == null ? "" : r < 60 ? "od-dot-red" : r < 90 ? "od-dot-amber" : "od-dot-green";
}

<div class="od">

    @* ── Header ── *@
    <header class="od-header">
        <div>
            <div class="od-eyebrow">@L["Executive report"] · @fromDate.ToString("d MMM yyyy") – @toDate.ToString("d MMM yyyy")</div>
            <h1 class="od-title">@L["How the portfolio performed"]</h1>
            <div class="od-sub">@L["Collections, occupancy and costs for the selected period."]</div>
        </div>
        <form method="get" class="od-toolbar">
            <label class="od-sub" for="fromDate">@L["From Date"]</label>
            <input type="date" id="fromDate" name="fromDate" class="od-select" value="@fromQ" />
            <label class="od-sub" for="toDate">@L["To Date"]</label>
            <input type="date" id="toDate" name="toDate" class="od-select" value="@toQ" />
            <button type="submit" class="od-btn od-btn-primary">@L["Apply Filter"]</button>
            <a class="od-btn od-btn-ghost" href="@Url.Action("ExecutiveDashboardExcel", new { fromDate = fromQ, toDate = toQ })">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v3h16v-3"/></svg>
                @L["Export Excel"]
            </a>
            <a class="od-btn od-btn-ghost" href="@Url.Action("ExecutiveDashboardPdf", new { from = fromQ, to = toQ })">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V8z"/><path d="M14 3v5h5"/></svg>
                @L["Download PDF"]
            </a>
            <a class="od-btn od-btn-ghost" href="@Url.Action("Index")">@L["Back"]</a>
        </form>
    </header>

    @* ── KPI row ── *@
    <section class="od-grid-kpi" aria-label="@(L["Executive report"].Value)">

        <article class="od-card od-kpi-hero">
            <div class="od-kpi-row">
                <span class="od-kpi-label">@L["Collected in period"]</span>
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.8)" stroke-width="2" stroke-linecap="round"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>
            </div>
            <div class="od-kpi-value">@Kwd(periodCollected)</div>
            <div class="od-kpi-sub">@L["of {0} invoiced in this period", Kwd(periodInvoiced)]</div>
            <div class="od-bar"><span style="width:@(barPct)%"></span></div>
            <div class="od-kpi-row" style="font-size:13px">
                <strong>@L["{0} collected", Pct(collectionRate)]</strong>
                <span class="od-kpi-sub">@L["Previous month: {0}", Kwd(prevMonthRevenue)]</span>
            </div>
        </article>

        <article class="od-card">
            <div class="od-kpi-row">
                <span class="od-kpi-label">@L["Outstanding"]</span>
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color:var(--od-amber)"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            </div>
            <div class="od-kpi-value">@Kwd(totalOutstanding)</div>
            <div class="od-kpi-sub">@L["{0} unpaid invoices", outstandingInvoices]</div>
            <a class="od-card-link" href="@Url.Action("Index", "Invoices")">@L["View invoices"] →</a>
        </article>

        <article class="od-card">
            <div class="od-kpi-row">
                <span class="od-kpi-label">@L["Overdue"]</span>
                @if (overdueInvoices > 0)
                {
                    <span class="od-pill od-pill-red">@L["{0} invoices", overdueInvoices]</span>
                }
                else
                {
                    <span class="od-pill od-pill-green">0</span>
                }
            </div>
            <div class="od-kpi-value @(overdueAmount > 0 ? "is-red" : "is-green")">@Kwd(overdueAmount)</div>
            <div class="od-kpi-sub">@L["Past due date as of today"]</div>
        </article>

        <article class="od-card">
            <div class="od-kpi-row">
                <span class="od-kpi-label">@L["Occupancy"]</span>
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color:var(--od-green)"><path d="M3 21V9l9-6 9 6v12M9 21v-6h6v6"/></svg>
            </div>
            <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap">
                <span class="od-kpi-value @Grade(occupancyRate)">@Pct(occupancyRate)</span>
                <span class="od-kpi-sub">@L["{0} of {1} units", occupiedUnits, totalUnits]</span>
            </div>
            <div class="od-kpi-sub">@L["{0} vacant · about {1} per month unlet", vacantUnits, Kwd(unletRent)]</div>
        </article>
    </section>

    @* ── Trend + financial summary ── *@
    <section class="od-grid-2">

        <article class="od-card">
            <div class="od-card-head">
                <h2 class="od-card-title">@L["Collections — last 6 months"]</h2>
                <div class="od-legend">
                    <span><span class="od-swatch od-trend-expected"></span>@L["Expected"]</span>
                    <span><span class="od-swatch od-trend-collected"></span>@L["Collected"]</span>
                </div>
            </div>

            @if (trend.Count == 0 || trend.All(t => t.Expected == 0 && t.Collected == 0))
            {
                <div class="od-empty">@L["No invoices in this period"]</div>
            }
            else
            {
                <div class="od-trend" role="img" aria-label="@(L["Collections — last 6 months"].Value)">
                    @foreach (var t in trend)
                    {
                        <div class="od-trend-col">
                            <div class="od-trend-bars">
                                <span class="od-trend-expected" style="height:@(t.ExpectedPx)px" title="@L["Expected"]: @Kwd(t.Expected)"></span>
                                <span class="od-trend-collected @(t.IsPartial ? "is-partial" : "")" style="height:@(t.CollectedPx)px" title="@L["Collected"]: @Kwd(t.Collected)"></span>
                            </div>
                            <span class="od-trend-label">@t.Label@(t.IsPartial ? " (" + L["so far"].Value + ")" : "")</span>
                        </div>
                    }
                </div>
            }

            <div class="od-grid-3 od-divider-top">
                <div class="od-stat">
                    <span>@L["Avg collection rate"]</span>
                    <strong class="@Grade(trendRate)">@(trendRate.HasValue ? Pct(trendRate.Value) : "—")</strong>
                </div>
                <div class="od-stat">
                    <span>@L["Best month"]</span>
                    <strong>@(bestMonth != null ? bestMonth.Label + " · " + Pct(Math.Min(100, bestMonth.Collected / bestMonth.Expected * 100)) : "—")</strong>
                </div>
                <div class="od-stat">
                    <span>@L["YTD Revenue"]</span>
                    <strong>@Kwd(ytdRevenue)</strong>
                </div>
            </div>
        </article>

        <article class="od-card">
            <div class="od-card-head">
                <h2 class="od-card-title">@L["Financial Summary"]</h2>
                <span class="od-card-meta">KWD</span>
            </div>
            <div class="od-rows">
                <div class="od-row">
                    <span class="od-row-text"><strong>@L["Potential Monthly Rent"]</strong><span>@L["If all units were occupied"]</span></span>
                    <span class="od-amount">@potentialMonthlyRent.ToString("N3")</span>
                </div>
                <div class="od-row">
                    <span class="od-row-text">
                        <strong>@L["Actual Monthly Rent"]</strong>
                        <span>@L["Current occupied units"] ·
                            <span class="od-pill @(revenueChange >= 0 ? "od-pill-green" : "od-pill-red")">@(revenueChange >= 0 ? "+" : "")@revenueChange.ToString("N1")% @L["vs previous month"]</span>
                        </span>
                    </span>
                    <span class="od-amount">@actualMonthlyRent.ToString("N3")</span>
                </div>
                <div class="od-row">
                    <span class="od-row-text"><strong>@L["YTD Revenue"]</strong><span>@L["Year-to-date collected payments"]</span></span>
                    <span class="od-amount">@ytdRevenue.ToString("N3")</span>
                </div>
                <div class="od-row">
                    <span class="od-row-text"><strong>@L["YTD Maintenance Costs"]</strong><span>@maintenanceCount @L["completed requests"]</span></span>
                    <span class="od-amount @(maintenanceCost > 0 ? "is-red" : "")">@maintenanceCost.ToString("N3")</span>
                </div>
                <div class="od-row">
                    <span class="od-row-text"><strong>@L["Net Revenue (YTD)"]</strong><span>@L["Revenue minus maintenance costs"]</span></span>
                    <span class="od-amount">@netRevenue.ToString("N3")</span>
                </div>
            </div>
        </article>
    </section>

    @* ── Property health ── *@
    <section class="od-card">
        <div class="od-card-head">
            <h2 class="od-card-title">@L["Property health"]</h2>
            <span class="od-card-meta">@L["{0} properties · {1} units", totalProperties, totalUnits] · @L["Sorted by collection rate — weakest first"]</span>
        </div>
        @if (propertyRows.Count == 0)
        {
            <div class="od-empty">@L["No properties in scope"]</div>
        }
        else
        {
            <div class="od-table-wrap">
                <table class="od-table">
                    <thead>
                        <tr>
                            <th>@L["Property"]</th>
                            <th>@L["Occupied"]</th>
                            <th class="num">@L["Invoiced"]</th>
                            <th class="num">@L["Collected"]</th>
                            <th>@L["Collection"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in propertyRows)
                        {
                            var rate = r.CollectionRate;
                            <tr>
                                <td><strong>@if (rate != null) {<span class="od-dot @Dot(rate)"></span>}@r.Name</strong></td>
                                <td>@r.OccupiedUnits / @r.TotalUnits <span class="od-card-meta">(@Pct(r.OccupancyRate))</span></td>
                                <td class="num">@r.Invoiced.ToString("N3")</td>
                                <td class="num">@r.Collected.ToString("N3")</td>
                                <td>
                                    @if (rate != null)
                                    {
                                        <div class="od-rate">
                                            <div class="od-bar is-thin"><span class="@Grade(rate)" style="width:@((int)Math.Round(rate.Value))%"></span></div>
                                            <strong class="od-kpi-value @Grade(rate)" style="font-size:14px">@((int)Math.Round(rate.Value))%</strong>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="od-card-meta">—</span>
                                    }
                                </td>
                                <td class="num"><a href="@Url.Action("Details", "Properties", new { id = r.PropertyId })" class="od-card-link">@L["Open"] →</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @* ── Tenants + maintenance ── *@
    <section class="od-grid-2">

        <article class="od-card">
            <div class="od-card-head">
                <h2 class="od-card-title">@L["Tenant Summary"]</h2>
            </div>
            <div class="od-rows">
                <div class="od-row">
                    <span class="od-row-text"><strong>@L["Total Active Tenants"]</strong></span>
                    <span class="od-amount">@activeTenants</span>
                </div>
                <div class="od-row">
                    <span class="od-row-text"><strong>@L["Total Active Leases"]</strong></span>
                    <span class="od-amount">@activeLeases</span>
                </div>
                <div class="od-row">
                    <span class="od-row-text"><strong>@L["Expiring within 30 days"]</strong><span>@L["renew or terminate"]</span></span>
                    <span class="od-amount">
                        @if (expiringLeases > 0)
                        {
                            <span class="od-pill od-pill-amber">@expiringLeases</span>
                        }
                        else
                        {
                            <span>@expiringLeases</span>
                        }
                    </span>
                </div>
                <div class="od-row">
                    <span class="od-row-text"><strong>@L["Average Rent per Tenant"]</strong></span>
                    <span class="od-amount">@Kwd(avgRentPerTenant)</span>
                </div>
            </div>
        </article>

        <article class="od-card">
            <div class="od-card-head">
                <h2 class="od-card-title">@L["Maintenance Summary"]</h2>
            </div>
            <div class="od-rows">
                <div class="od-row">
                    <span class="od-row-text"><strong>@L["Total Requests (Period)"]</strong></span>
                    <span class="od-amount">@maintenanceCount</span>
                </div>
                <div class="od-row">
                    <span class="od-row-text"><strong>@L["Total Cost (Period)"]</strong></span>
                    <span class="od-amount @(maintenanceCost > 0 ? "is-red" : "")">@Kwd(maintenanceCost)</span>
                </div>
                <div class="od-row">
                    <span class="od-row-text"><strong>@L["Average Cost per Request"]</strong></span>
                    <span class="od-amount">@Kwd(avgMaintenanceCost)</span>
                </div>
            </div>
            <div class="od-note">@L["Maintenance costs count completed requests dated within the period."]</div>
        </article>
    </section>
</div>
