@{
    ViewData["Title"] = "Reports";
    var from = DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd");
    var to = DateTime.Today.ToString("yyyy-MM-dd");
}

@*
    Report Center (2026-10 redesign).
    1. One period picker that every report and the snapshot share.
    2. Four KPIs for that period with vs-prior-period deltas.
    3. The catalogue — every report the system can produce, grouped, each
       with what it answers and View / PDF / Excel for the chosen period.
    4. A compact snapshot (trend, invoice status, top properties) at the end
       for people who want a picture before they open a report.
*@

<div class="lp-page">
    @await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData)
    {
        ["Title"] = L["Reports"].Value,
        ["Subtitle"] = L["Pick a period, then open or export any report for it"].Value,
        ["Crumbs"] = new (string label, string? href)[] { (L["Admin"].Value, "/Dashboard"), (L["Reports"].Value, null) },
        ["ActionsHtml"] = Html.Raw("<a class=\"lp-btn lp-btn-primary\" href=\"/Reports/MonthEndClose\"><i class=\"fas fa-lock\"></i> " + L["Month-end close"].Value + "</a>")
    })

    @await Html.PartialAsync("_AlertMessages")

    @* ── Period ── *@
    <div class="lp-toolbar" id="periodBar">
        <div class="lp-toolbar-row">
            <span class="lp-chips-label" style="min-width:auto"><i class="fas fa-calendar"></i> @L["Period"]</span>
            <input type="date" id="fromDate" class="lp-select" value="@from" aria-label="@(L["From"].Value)" />
            <span class="lp-sub" style="margin:0">→</span>
            <input type="date" id="toDate" class="lp-select" value="@to" aria-label="@(L["To"].Value)" />
            <div class="lp-chips">
                <button type="button" class="lp-chip-btn" data-period="thisMonth">@L["This Month"]</button>
                <button type="button" class="lp-chip-btn" data-period="lastMonth">@L["Last Month"]</button>
                <button type="button" class="lp-chip-btn" data-period="thisQuarter">@L["This Quarter"]</button>
                <button type="button" class="lp-chip-btn" data-period="thisYear">@L["This Year"]</button>
            </div>
            <div class="lp-toolbar-spacer"></div>
            <span class="lp-result-count" id="snapshotMeta" style="white-space:nowrap">@L["Loading snapshot…"]</span>
            <button type="button" id="refreshSnapshot" class="lp-btn" aria-label="@(L["Refresh snapshot"].Value)" title="@(L["Refresh snapshot"].Value)"><i class="fas fa-rotate"></i></button>
        </div>
    </div>

    @* ── KPIs for the period ── *@
    @{
        var kpis = new[]
        {
            new { id = "kpi-collected",   label = L["Collected"].Value,   sub = L["completed payments in period"].Value, drill = "/Reports/PaymentReport",   hero = true },
            new { id = "kpi-outstanding", label = L["Outstanding"].Value, sub = L["unpaid invoice balance today"].Value, drill = "/Reports/InvoiceStatus",   hero = false },
            new { id = "kpi-overdue",     label = L["Overdue"].Value,     sub = L["invoices past due"].Value,            drill = "/Reports/InvoiceStatus?status=Overdue", hero = false },
            new { id = "kpi-occupancy",   label = L["Occupancy"].Value,   sub = L["units occupied today"].Value,         drill = "/Reports/PropertyPerformance", hero = false },
        };
    }
    <div class="od od-grid-kpi" id="kpiStrip" aria-live="polite">
        @foreach (var c in kpis)
        {
            <a href="@c.drill" class="od-card od-card-link @(c.hero ? "od-kpi-hero" : "")" id="@c.id" data-drill="@c.drill" aria-busy="true">
                <div class="od-kpi-row"><span class="od-kpi-label">@c.label</span></div>
                <div class="od-kpi-value kpi-value lp-skel">&nbsp;</div>
                <div class="od-kpi-sub"><span class="kpi-delta"></span> @c.sub</div>
            </a>
        }
    </div>

    @* ── Catalogue ── *@
    <div class="lp-section-title"><h2>@L["Financial"]</h2></div>
    <div class="lp-reports">
        <div class="lp-report">
            <div class="lp-report-head"><span class="lp-report-icon"><i class="fas fa-money-bill-trend-up"></i></span><h3>@L["Payment Report"]</h3></div>
            <p>@L["Every payment in the period by date, tenant, property, method and status — the register you reconcile against the bank."]</p>
            <div class="lp-report-foot">
                <a class="lp-btn lp-btn-primary" data-report="PaymentReport" href="#"><i class="fas fa-eye"></i> @L["View"]</a>
                <a class="lp-btn lp-btn-export" data-report="PaymentReportExcel" href="#"><i class="fas fa-file-excel"></i> Excel</a>
            </div>
        </div>
        <div class="lp-report">
            <div class="lp-report-head"><span class="lp-report-icon"><i class="fas fa-file-invoice-dollar"></i></span><h3>@L["Invoice Status & Aging"]</h3></div>
            <p>@L["What is owed, by how long it has been owed and by whom — the arrears list to chase this week."]</p>
            <div class="lp-report-foot">
                <a class="lp-btn lp-btn-primary" data-report="InvoiceStatus" href="#"><i class="fas fa-eye"></i> @L["View"]</a>
                <a class="lp-btn lp-btn-export" data-report="InvoiceStatusExcel" href="#"><i class="fas fa-file-excel"></i> Excel</a>
                <a class="lp-btn" href="/Reports/InvoiceStatus?status=Overdue"><i class="fas fa-triangle-exclamation"></i> @L["Overdue only"]</a>
            </div>
        </div>
        <div class="lp-report">
            <div class="lp-report-head"><span class="lp-report-icon"><i class="fas fa-book"></i></span><h3>@L["GL Export & Owner Statement"]</h3></div>
            <p>@L["Journal lines for your accountant and a per-property owner statement for the period."]</p>
            <div class="lp-report-foot">
                <a class="lp-btn lp-btn-primary" data-report="GlExport" data-base="/GlExport" data-from="start" data-to="end" href="#"><i class="fas fa-eye"></i> @L["GL export"]</a>
                <a class="lp-btn" data-report="OwnerStatement" data-base="/GlExport/OwnerStatement" data-from="start" data-to="end" href="#"><i class="fas fa-file-lines"></i> @L["Owner statement"]</a>
            </div>
        </div>
        <div class="lp-report">
            <div class="lp-report-head"><span class="lp-report-icon"><i class="fas fa-lock"></i></span><h3>@L["Month-end close"]</h3></div>
            <p>@L["Run the billing jobs, review the month's figures and lock the period so nothing changes after the books are done."]</p>
            <div class="lp-report-foot">
                <a class="lp-btn lp-btn-primary" href="/Reports/MonthEndClose"><i class="fas fa-eye"></i> @L["Open"]</a>
            </div>
        </div>
    </div>

    <div class="lp-section-title"><h2>@L["Portfolio"]</h2></div>
    <div class="lp-reports">
        <div class="lp-report">
            <div class="lp-report-head"><span class="lp-report-icon"><i class="fas fa-chart-line"></i></span><h3>@L["Executive Dashboard"]</h3></div>
            <p>@L["Collected, outstanding, occupancy and the 12-month trend on one page — the owner's monthly pack."]</p>
            <div class="lp-report-foot">
                <a class="lp-btn lp-btn-primary" data-report="ExecutiveDashboard" href="#"><i class="fas fa-eye"></i> @L["View"]</a>
                <a class="lp-btn" data-report="ExecutiveDashboardPdf" data-from="from" data-to="to" href="#"><i class="fas fa-file-pdf"></i> PDF</a>
                <a class="lp-btn lp-btn-export" data-report="ExecutiveDashboardExcel" href="#"><i class="fas fa-file-excel"></i> Excel</a>
            </div>
        </div>
        <div class="lp-report">
            <div class="lp-report-head"><span class="lp-report-icon"><i class="fas fa-building"></i></span><h3>@L["Property Performance"]</h3></div>
            <p>@L["Collection rate, occupancy and arrears per property — which buildings earn and which ones leak."]</p>
            <div class="lp-report-foot">
                <a class="lp-btn lp-btn-primary" data-report="PropertyPerformance" href="#"><i class="fas fa-eye"></i> @L["View"]</a>
                <a class="lp-btn lp-btn-export" data-report="PropertyPerformanceExcel" href="#"><i class="fas fa-file-excel"></i> Excel</a>
            </div>
        </div>
        <div class="lp-report">
            <div class="lp-report-head"><span class="lp-report-icon"><i class="fas fa-users"></i></span><h3>@L["Tenant Payment Analysis"]</h3></div>
            <p>@L["Who pays on time, who pays late and who has stopped — payment behaviour per tenant for the period."]</p>
            <div class="lp-report-foot">
                <a class="lp-btn lp-btn-primary" data-report="TenantPaymentAnalysis" href="#"><i class="fas fa-eye"></i> @L["View"]</a>
                <a class="lp-btn lp-btn-export" data-report="TenantPaymentAnalysisExcel" href="#"><i class="fas fa-file-excel"></i> Excel</a>
            </div>
        </div>
    </div>

    @* ── Snapshot charts ── *@
    <div class="lp-section-title"><h2>@L["Snapshot"]</h2></div>
    <div class="od-grid-3" style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:1rem">
        <div class="od-card" style="min-height:260px">
            <div class="od-card-head"><span class="od-card-title">@L["Revenue — last 12 months"]</span></div>
            <div style="height:210px"><canvas id="trendChart" role="img" aria-label="@(L["Revenue trend over the last 12 months"].Value)"></canvas></div>
        </div>
        <div class="od-card" style="min-height:260px">
            <div class="od-card-head"><span class="od-card-title">@L["Invoices by status"]</span></div>
            <div style="height:210px"><canvas id="statusChart" role="img" aria-label="@(L["Breakdown of invoices by status"].Value)"></canvas></div>
        </div>
        <div class="od-card" style="min-height:260px">
            <div class="od-card-head"><span class="od-card-title">@L["Top 5 properties"]</span></div>
            <div style="height:210px"><canvas id="topPropertiesChart" role="img" aria-label="@(L["Top 5 properties by collected revenue"].Value)"></canvas></div>
        </div>
    </div>
</div>

<style>
    .kpi-delta.up { color: #047857; } .kpi-delta.down { color: #b91c1c; } .kpi-delta.flat { color: #94a3b8; }
    .kpi-delta:not(:empty)::after { content: " · "; color: #cbd5e1; }
    @@media (max-width: 1000px) { .od-grid-3 { grid-template-columns: 1fr !important; } }
</style>

@section Scripts {
    <script>
        (function () {
            const fromEl = document.getElementById('fromDate'), toEl = document.getElementById('toDate');
            const toInput = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');

            // Period presets + persistence
            function setPeriod(p) {
                const t = new Date(); let a, b = t;
                if (p === 'thisMonth') a = new Date(t.getFullYear(), t.getMonth(), 1);
                else if (p === 'lastMonth') { a = new Date(t.getFullYear(), t.getMonth() - 1, 1); b = new Date(t.getFullYear(), t.getMonth(), 0); }
                else if (p === 'thisQuarter') a = new Date(t.getFullYear(), Math.floor(t.getMonth() / 3) * 3, 1);
                else a = new Date(t.getFullYear(), 0, 1);
                fromEl.value = toInput(a); toEl.value = toInput(b);
                persist(); loadSnapshot();
            }
            document.querySelectorAll('[data-period]').forEach(b => b.addEventListener('click', () => {
                document.querySelectorAll('[data-period]').forEach(x => x.classList.remove('is-on')); b.classList.add('is-on'); setPeriod(b.dataset.period);
            }));
            const PREF = 'rc-reports-period=';
            function persist() {
                const d = new Date(); d.setDate(d.getDate() + 30);
                document.cookie = PREF + encodeURIComponent(JSON.stringify({ from: fromEl.value, to: toEl.value })) + '; expires=' + d.toUTCString() + '; path=/; samesite=lax';
            }
            (function restore() {
                const m = document.cookie.split('; ').find(c => c.startsWith(PREF)); if (!m) return;
                try { const s = JSON.parse(decodeURIComponent(m.slice(PREF.length))); if (s.from) fromEl.value = s.from; if (s.to) toEl.value = s.to; } catch { }
            })();
            [fromEl, toEl].forEach(el => el.addEventListener('change', () => { persist(); loadSnapshot(); }));

            // Report links carry the period (each action's parameter names differ).
            document.querySelectorAll('[data-report]').forEach(a => a.addEventListener('click', e => {
                e.preventDefault();
                const base = a.dataset.base || ('/Reports/' + a.dataset.report);
                const fromKey = a.dataset.from || 'fromDate', toKey = a.dataset.to || 'toDate';
                const q = new URLSearchParams(); if (fromEl.value) q.set(fromKey, fromEl.value); if (toEl.value) q.set(toKey, toEl.value);
                window.location.href = base + '?' + q.toString();
            }));

            // Snapshot: KPIs + charts
            const charts = {};
            const KWD = n => (n ?? 0).toLocaleString("en-US", { maximumFractionDigits: 3 }) + ' KWD';
            const PCT = n => (n ?? 0).toLocaleString("en-US", { maximumFractionDigits: 1 }) + '%';
            const fmt = { 'kpi-collected': KWD, 'kpi-outstanding': KWD, 'kpi-overdue': v => Math.round(v).toString(), 'kpi-occupancy': PCT };
            function relTime(iso) { const m = Math.round((Date.now() - new Date(iso).getTime()) / 60000); return m < 1 ? 'just now' : m < 60 ? m + ' min ago' : Math.round(m / 60) + ' hr ago'; }
            function renderKPI(id, p) {
                const card = document.getElementById(id); if (!card || !p) return;
                card.removeAttribute('aria-busy');
                const v = card.querySelector('.kpi-value'), d = card.querySelector('.kpi-delta');
                v.classList.remove('lp-skel'); v.textContent = fmt[id](p.value);
                if (p.delta === null || p.delta === undefined) { d.textContent = ''; d.className = 'kpi-delta'; return; }
                const up = p.delta > 0, down = p.delta < 0;
                const good = p.goodWhenUp ? up : down, bad = p.goodWhenUp ? down : up;
                d.className = 'kpi-delta ' + (good ? 'up' : bad ? 'down' : 'flat');
                d.textContent = (up ? '▲' : down ? '▼' : '—') + ' ' + Math.abs(p.delta).toFixed(1) + '% vs prior period';
            }
            function renderTrend(trend) {
                if (typeof Chart === 'undefined' || !trend) return;
                charts.trend?.destroy();
                charts.trend = new Chart(document.getElementById('trendChart'), {
                    type: 'line',
                    data: { labels: trend.map(t => t.label), datasets: [
                        { label: 'This year', data: trend.map(t => t.value), borderColor: '#8a6d1f', backgroundColor: 'rgba(138,109,31,0.12)', fill: true, tension: 0.35, pointRadius: 3 },
                        { label: 'Last year', data: trend.map(t => t.previous ?? 0), borderColor: '#94a3b8', borderDash: [4, 4], fill: false, tension: 0.35, pointRadius: 2 }] },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 11 } } } }, scales: { y: { beginAtZero: true, ticks: { callback: v => v.toLocaleString("en-US") } } } }
                });
            }
            const COLOURS = { Paid: '#10b981', Pending: '#f59e0b', Overdue: '#ef4444', 'Partially Paid': '#b8860b', Cancelled: '#94a3b8', 'Pending Verification': '#3b82f6' };
            function renderStatus(items) {
                if (typeof Chart === 'undefined' || !items) return;
                charts.status?.destroy();
                charts.status = new Chart(document.getElementById('statusChart'), {
                    type: 'doughnut',
                    data: { labels: items.map(i => i.status), datasets: [{ data: items.map(i => i.count), backgroundColor: items.map(i => COLOURS[i.status] || '#cbd5e1'), borderWidth: 0 }] },
                    options: { responsive: true, maintainAspectRatio: false, cutout: '62%', plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 11 } } } },
                        onClick: (_, els) => { if (els.length) window.location.href = '/Reports/InvoiceStatus?status=' + encodeURIComponent(charts.status.data.labels[els[0].index]); } }
                });
            }
            function renderTop(items) {
                if (typeof Chart === 'undefined' || !items) return;
                charts.top?.destroy();
                charts.top = new Chart(document.getElementById('topPropertiesChart'), {
                    type: 'bar',
                    data: { labels: items.map(i => i.name), datasets: [{ label: 'Collected', data: items.map(i => i.value), backgroundColor: '#b8860b', borderRadius: 6 }] },
                    options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true, ticks: { callback: v => v.toLocaleString("en-US") } } } }
                });
            }
            async function loadSnapshot() {
                const q = new URLSearchParams(); if (fromEl.value) q.set('from', fromEl.value); if (toEl.value) q.set('to', toEl.value);
                document.querySelectorAll('.kpi-value').forEach(el => { el.classList.add('lp-skel'); el.textContent = ' '; });
                document.getElementById('snapshotMeta').textContent = 'Loading snapshot…';
                // Drill links follow the period too.
                document.querySelectorAll('#kpiStrip [data-drill]').forEach(a => {
                    const u = new URL(a.dataset.drill, location.origin); if (fromEl.value) u.searchParams.set('fromDate', fromEl.value); if (toEl.value) u.searchParams.set('toDate', toEl.value); a.href = u.pathname + u.search;
                });
                try {
                    const res = await fetch('/Reports/Snapshot?' + q.toString(), { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' });
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    const data = await res.json();
                    renderKPI('kpi-collected', data.kpis.collected); renderKPI('kpi-outstanding', data.kpis.outstanding);
                    renderKPI('kpi-overdue', data.kpis.overdueCount); renderKPI('kpi-occupancy', data.kpis.occupancy);
                    renderTrend(data.trend); renderStatus(data.statusBreakdown); renderTop(data.topProperties);
                    document.getElementById('snapshotMeta').textContent = (data.from || '').substring(0, 10) + ' → ' + (data.to || '').substring(0, 10) + ' · updated ' + relTime(data.generatedAt);
                } catch (err) {
                    document.getElementById('snapshotMeta').textContent = 'Snapshot failed: ' + err.message;
                    document.querySelectorAll('.kpi-value.lp-skel').forEach(el => { el.classList.remove('lp-skel'); el.textContent = '—'; });
                }
            }
            document.getElementById('refreshSnapshot').addEventListener('click', loadSnapshot);
            const s = document.createElement('script');
            s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js';
            s.onload = loadSnapshot; s.onerror = loadSnapshot; document.head.appendChild(s);
        })();
    </script>
}
