@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Invoice Status Report";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        /* Animated Background */
        .bg-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .bg-animation .circle {
            position: absolute;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(138, 109, 31, 0.15), rgba(184, 134, 11, 0.15));
            animation: float 20s infinite;
        }

        .bg-animation .circle:nth-child(1) {
            width: 400px;
            height: 400px;
            top: -100px;
            right: -100px;
            animation-delay: 0s;
        }

        .bg-animation .circle:nth-child(2) {
            width: 300px;
            height: 300px;
            bottom: -50px;
            left: -50px;
            animation-delay: 5s;
        }

        .bg-animation .circle:nth-child(3) {
            width: 200px;
            height: 200px;
            top: 50%;
            left: 50%;
            animation-delay: 10s;
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.5; }
            50% { transform: translateY(-30px) rotate(180deg); opacity: 0.8; }
        }

        .app-container {
            position: relative;
            z-index: 1;
            padding: 1.5rem;
            max-width: 1800px;
            margin: 0 auto;
        }

        /* Header */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding: 1.5rem;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(138, 109, 31, 0.2);
        }

        .header-content h1 {
            font-size: 2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #2E2614, #8A6D1F);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .header-content h1 i {
            background: linear-gradient(135deg, #8a6d1f, #b8860b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header-content p {
            color: #64748b;
            margin-top: 0.5rem;
            font-size: 0.9rem;
        }

        .header-actions {
            display: flex;
            gap: 1rem;
        }

        /* Glassmorphic Cards */
        .glass-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(138, 109, 31, 0.2);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            transition: all 0.3s ease;
        }

        .glass-card:hover {
            border-color: rgba(138, 109, 31, 0.4);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        /* Filter Section */
        .filter-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }

        .filter-header h3 {
            font-size: 1.25rem;
            font-weight: 600;
            color: #334155;
        }

        .filter-header i {
            color: #B8860B;
        }

        .filter-form {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .form-group label {
            font-size: 0.85rem;
            font-weight: 500;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            padding: 0.875rem 1rem;
            color: #1e293b;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: #B8860B;
            box-shadow: 0 0 0 3px rgba(129, 140, 248, 0.2);
            background: #ffffff;
        }

        /* Buttons */
        .btn {
            padding: 0.875rem 1.5rem;
            border-radius: 12px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            font-size: 0.9rem;
            text-decoration: none;
            position: relative;
            overflow: hidden;
        }

        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .btn:hover::before {
            left: 100%;
        }

        .btn-primary {
            background: linear-gradient(135deg, #8a6d1f, #b8860b);
            color: white;
            box-shadow: 0 4px 15px rgba(138, 109, 31, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(138, 109, 31, 0.5);
        }

        .btn-secondary {
            background: rgba(138, 109, 31, 0.1);
            color: #6e5518;
            border: 1px solid rgba(138, 109, 31, 0.3);
        }

        .btn-secondary:hover {
            background: rgba(138, 109, 31, 0.2);
            transform: translateY(-2px);
        }

        .btn-success {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
        }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.5);
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.25rem;
            margin-bottom: 1.5rem;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(138, 109, 31, 0.2);
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1.25rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--accent-color), transparent);
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .stat-card.total { --accent-color: #8a6d1f; }
        .stat-card.paid { --accent-color: #10b981; }
        .stat-card.partial { --accent-color: #f59e0b; }
        .stat-card.unpaid { --accent-color: #ef4444; }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .stat-card.total .stat-icon {
            background: linear-gradient(135deg, rgba(138, 109, 31, 0.2), rgba(138, 109, 31, 0.1));
            color: #B8860B;
        }

        .stat-card.paid .stat-icon {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(16, 185, 129, 0.1));
            color: #047857;
        }

        .stat-card.partial .stat-icon {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(245, 158, 11, 0.1));
            color: #B45309;
        }

        .stat-card.unpaid .stat-icon {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(239, 68, 68, 0.1));
            color: #f87171;
        }

        .stat-content {
            flex: 1;
        }

        .stat-label {
            font-size: 0.85rem;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 800;
            color: #1e293b;
            line-height: 1.2;
        }

        .stat-sub {
            font-size: 0.85rem;
            color: #94a3b8;
            margin-top: 0.25rem;
        }

        /* Aging Summary */
        .aging-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
        }

        .aging-card {
            background: rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(138, 109, 31, 0.15);
            border-radius: 16px;
            padding: 1.25rem;
            text-align: center;
            transition: all 0.3s ease;
        }

        .aging-card:hover {
            background: rgba(255, 255, 255, 0.9);
            transform: translateY(-3px);
        }

        .aging-card h6 {
            font-size: 0.85rem;
            margin-bottom: 0.5rem;
        }

        .aging-card h4 {
            font-size: 1.25rem;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 0.25rem;
        }

        .aging-card p {
            font-size: 0.9rem;
            font-weight: 600;
            margin: 0;
        }

        .aging-card.current h6 { color: #047857; }
        .aging-card.current p { color: #047857; }
        .aging-card.days-31 h6 { color: #1D4ED8; }
        .aging-card.days-31 p { color: #1D4ED8; }
        .aging-card.days-61 h6 { color: #B45309; }
        .aging-card.days-61 p { color: #B45309; }
        .aging-card.days-90 h6 { color: #f87171; }
        .aging-card.days-90 p { color: #f87171; }

        /* Data Table */
        .table-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(138, 109, 31, 0.2);
            overflow: hidden;
        }

        .table-header {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid rgba(138, 109, 31, 0.2);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-header h3 {
            font-size: 1.25rem;
            font-weight: 600;
            color: #334155;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .table-header h3 i {
            color: #B8860B;
        }

        .record-count {
            font-size: 0.85rem;
            color: #8a6d1f;
            background: rgba(138, 109, 31, 0.1);
            padding: 0.5rem 1rem;
            border-radius: 20px;
        }

        .table-responsive {
            overflow-x: auto;
            max-height: 600px;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th {
            background: rgba(138, 109, 31, 0.08);
            padding: 1rem 1rem;
            text-align: left;
            font-weight: 600;
            color: #475569;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 10;
            cursor: pointer;
        }

        .data-table th:hover {
            background: rgba(138, 109, 31, 0.15);
        }

        .data-table td {
            padding: 0.875rem 1rem;
            border-bottom: 1px solid #e2e8f0;
            font-size: 0.85rem;
            color: #334155;
        }

        .data-table tr {
            transition: all 0.2s ease;
        }

        .data-table tbody tr:hover {
            background: rgba(138, 109, 31, 0.05);
        }

        .data-table .amount {
            font-weight: 600;
            font-family: 'SF Mono', 'Fira Code', monospace;
        }

        .data-table tfoot {
            background: rgba(138, 109, 31, 0.08);
        }

        .data-table tfoot th {
            position: static;
            font-weight: 700;
            color: #1e293b;
        }

        .text-center {
            text-align: center;
        }

        .text-right {
            text-align: right;
        }

        /* Status Badges */
        .badge {
            padding: 0.375rem 0.75rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
        }

        .badge::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .badge-success {
            background: rgba(16, 185, 129, 0.15);
            color: #047857;
        }

        .badge-info {
            background: rgba(59, 130, 246, 0.15);
            color: #1D4ED8;
        }

        .badge-warning {
            background: rgba(245, 158, 11, 0.15);
            color: #B45309;
        }

        .badge-danger {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }

        .badge-secondary {
            background: rgba(107, 114, 128, 0.15);
            color: #9ca3af;
        }

        .badge-light {
            background: rgba(138, 109, 31, 0.1);
            color: #475569;
        }

        .text-success {
            color: #047857;
        }

        .text-danger {
            color: #f87171;
        }

        .text-muted {
            color: #94a3b8;
        }

        .alert {
            padding: 1rem 1.5rem;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .alert-info {
            background: rgba(59, 130, 246, 0.15);
            color: #1D4ED8;
            border: 1px solid rgba(59, 130, 246, 0.3);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .page-header {
                flex-direction: column;
                gap: 1.5rem;
                text-align: center;
            }

            .header-actions {
                width: 100%;
                justify-content: center;
            }

            .filter-form {
                flex-direction: column;
                align-items: stretch;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }

            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }

            .aging-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
}

<!-- Animated Background -->
<div class="bg-animation">
    <div class="circle"></div>
    <div class="circle"></div>
    <div class="circle"></div>
</div>

<div class="app-container">
    <!-- Header -->
    <div class="page-header">
        <div class="header-content">
            <h1><i class="fas fa-file-invoice-dollar"></i> @L["Invoice Status & Aging"]</h1>
            <p>@L["Track billing, collection rates, and aging analysis"]</p>
        </div>
        <div class="header-actions">
            <a href="@Url.Action("InvoiceStatusExcel", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })" class="btn btn-success">
                <i class="fas fa-file-excel"></i> @L["Export Excel"]
            </a>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> @L["Back"]
            </a>
        </div>
    </div>

    <!-- Date Filter -->
    <div class="glass-card">
        <div class="filter-header">
            <i class="fas fa-calendar-alt"></i>
            <h3>@L["Date Range Filter"]</h3>
        </div>
        <form method="get" class="filter-form">
            <div class="form-group">
                <label>@L["From Date"]</label>
                <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="form-group">
                <label>@L["To Date"]</label>
                <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate?.ToString("yyyy-MM-dd")" />
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-filter"></i> @L["Apply Filter"]
            </button>
        </form>
    </div>

    <!-- Summary Cards -->
    <div class="stats-grid">
        <div class="stat-card total">
            <div class="stat-icon">
                <i class="fas fa-file-invoice"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">@L["Total Invoices"]</div>
                <div class="stat-value">@ViewBag.TotalInvoices</div>
                <div class="stat-sub">@L["In selected period"]</div>
            </div>
        </div>
        <div class="stat-card paid">
            <div class="stat-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">@L["Paid Invoices"]</div>
                <div class="stat-value">@ViewBag.PaidInvoices</div>
                <div class="stat-sub">@ViewBag.TotalPaidAmount.ToString("N3") KWD</div>
            </div>
        </div>
        <div class="stat-card partial">
            <div class="stat-icon">
                <i class="fas fa-adjust"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">@L["Partial Invoices"]</div>
                <div class="stat-value">@ViewBag.PartialInvoices</div>
                <div class="stat-sub">@ViewBag.TotalPartialAmount.ToString("N3") KWD @L["outstanding"]</div>
            </div>
        </div>
        <div class="stat-card unpaid">
            <div class="stat-icon">
                <i class="fas fa-times-circle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">@L["Unpaid Invoices"]</div>
                <div class="stat-value">@ViewBag.UnpaidInvoices</div>
                <div class="stat-sub">@ViewBag.TotalUnpaidAmount.ToString("N3") KWD</div>
            </div>
        </div>
    </div>

    <!-- Aging Summary -->
    <div class="glass-card">
        <div class="filter-header">
            <i class="fas fa-clock"></i>
            <h3>@L["Aging Summary"]</h3>
        </div>
        <div class="aging-grid">
            <div class="aging-card current">
                <h6>@L["Current (0-30 days)"]</h6>
                <h4>@ViewBag.Aging0to30Count @L["invoices"]</h4>
                <p><strong>@ViewBag.Aging0to30Amount.ToString("N3") KWD</strong></p>
            </div>
            <div class="aging-card days-31">
                <h6>@L["31-60 days"]</h6>
                <h4>@ViewBag.Aging31to60Count @L["invoices"]</h4>
                <p><strong>@ViewBag.Aging31to60Amount.ToString("N3") KWD</strong></p>
            </div>
            <div class="aging-card days-61">
                <h6>@L["61-90 days"]</h6>
                <h4>@ViewBag.Aging61to90Count @L["invoices"]</h4>
                <p><strong>@ViewBag.Aging61to90Amount.ToString("N3") KWD</strong></p>
            </div>
            <div class="aging-card days-90">
                <h6>@L["Over 90 days"]</h6>
                <h4>@ViewBag.AgingOver90Count @L["invoices"]</h4>
                <p><strong>@ViewBag.AgingOver90Amount.ToString("N3") KWD</strong></p>
            </div>
        </div>
    </div>

    <!-- Invoice Details Grid -->
    <div class="table-card">
        <div class="table-header">
            <h3><i class="fas fa-list"></i> @L["Invoice Details"]</h3>
            @if (Model != null && Model.Any())
            {
                <span class="record-count">@Model.Count() @L["invoices"]</span>
            }
        </div>
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="data-table" id="invoiceTable">
                    <thead>
                        <tr>
                            <th>@L["Invoice Number"]</th>
                            <th>@L["Tenant Name"]</th>
                            <th>@L["Property"]</th>
                            <th>@L["Unit"]</th>
                            <th class="text-right">@L["Invoice Date"]</th>
                            <th class="text-right">@L["Due Date"]</th>
                            <th class="text-right">@L["Total Amount (KWD)"]</th>
                            <th class="text-right">@L["Paid Amount (KWD)"]</th>
                            <th class="text-right">@L["Outstanding (KWD)"]</th>
                            <th class="text-center">@L["Status"]</th>
                            <th class="text-center">@L["Days Overdue"]</th>
                            <th class="text-center">@L["Aging Bucket"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model)
                        {
                            <tr>
                                <td><strong>@invoice.InvoiceNumber</strong></td>
                                <td>@invoice.TenantName</td>
                                <td>@invoice.PropertyName</td>
                                <td>@invoice.UnitNumber</td>
                                <td class="text-right">@Convert.ToDateTime(invoice.InvoiceDate).ToString("dd-MMM-yyyy")</td>
                                <td class="text-right">@Convert.ToDateTime(invoice.DueDate).ToString("dd-MMM-yyyy")</td>
                                <td class="text-right amount">@invoice.TotalAmount.ToString("N3")</td>
                                <td class="text-right amount">@invoice.PaidAmount.ToString("N3")</td>
                                <td class="text-right">
                                    @if (invoice.OutstandingAmount > 0)
                                    {
                                        <strong class="text-danger">@invoice.OutstandingAmount.ToString("N3")</strong>
                                    }
                                    else
                                    {
                                        <span class="text-success">0.000</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (invoice.Status == "Paid")
                                    {
                                        <span class="badge badge-success">@L["Paid"]</span>
                                    }
                                    else if (invoice.Status == "Partial")
                                    {
                                        <span class="badge badge-warning">@L["Partial"]</span>
                                    }
                                    else if (invoice.Status == "Overdue")
                                    {
                                        <span class="badge badge-danger">@L["Overdue"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">@invoice.Status</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (invoice.DaysOverdue > 0)
                                    {
                                        if (invoice.DaysOverdue > 90)
                                        {
                                            <span class="badge badge-danger">@invoice.DaysOverdue @L["days"]</span>
                                        }
                                        else if (invoice.DaysOverdue > 60)
                                        {
                                            <span class="badge badge-warning">@invoice.DaysOverdue @L["days"]</span>
                                        }
                                        else if (invoice.DaysOverdue > 30)
                                        {
                                            <span class="badge badge-info">@invoice.DaysOverdue @L["days"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-light">@invoice.DaysOverdue @L["days"]</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-success">@L["Current"]</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (invoice.AgingBucket == "0-30 days")
                                    {
                                        <span class="badge badge-success">@invoice.AgingBucket</span>
                                    }
                                    else if (invoice.AgingBucket == "31-60 days")
                                    {
                                        <span class="badge badge-info">@invoice.AgingBucket</span>
                                    }
                                    else if (invoice.AgingBucket == "61-90 days")
                                    {
                                        <span class="badge badge-warning">@invoice.AgingBucket</span>
                                    }
                                    else if (invoice.AgingBucket == "Over 90 days")
                                    {
                                        <span class="badge badge-danger">@invoice.AgingBucket</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="6">@L["TOTALS"]</th>
                            <th class="text-right">@Model.Sum(i => (decimal)i.TotalAmount).ToString("N3")</th>
                            <th class="text-right">@Model.Sum(i => (decimal)i.PaidAmount).ToString("N3")</th>
                            <th class="text-right"><strong>@Model.Sum(i => (decimal)i.OutstandingAmount).ToString("N3")</strong></th>
                            <th colspan="3">-</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div style="padding: 1.5rem;">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> @L["No invoice data available for the selected date range."]
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Add sorting functionality
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById('invoiceTable');
            if (table) {
                const headers = table.querySelectorAll('thead th');
                headers.forEach((header, index) => {
                    header.addEventListener('click', () => sortTable(index));
                });
            }

            // Add scroll reveal animation
            const cards = document.querySelectorAll('.glass-card, .table-card, .stat-card');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, { threshold: 0.1 });

            cards.forEach(card => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                card.style.transition = 'all 0.6s ease';
                observer.observe(card);
            });
        });

        function sortTable(columnIndex) {
            const table = document.getElementById('invoiceTable');
            const tbody = table.querySelector('tbody');
            const rows = Array.from(tbody.querySelectorAll('tr'));

            rows.sort((a, b) => {
                const aValue = a.cells[columnIndex].textContent.trim();
                const bValue = b.cells[columnIndex].textContent.trim();

                const aNum = parseFloat(aValue.replace(/[^0-9.-]/g, ''));
                const bNum = parseFloat(bValue.replace(/[^0-9.-]/g, ''));

                if (!isNaN(aNum) && !isNaN(bNum)) {
                    return bNum - aNum;
                }

                return aValue.localeCompare(bValue);
            });

            rows.forEach(row => tbody.appendChild(row));
        }
    </script>
}
