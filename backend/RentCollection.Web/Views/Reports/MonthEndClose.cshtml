@{
    ViewData["Title"] = "Month-end close";
    // PeriodState is a dynamic anonymous object from the aggregator.
    // We render it through JSON so the markup stays simple; the client
    // hydrates the steps from the JSON blob below.
    var stateJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.PeriodState);
}

<div class="page-container">
    @await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData)
    {
        ["Title"] = "Month-end close",
        ["Subtitle"] = "Did everything that should have happened on the 1st actually happen?",
        ["Crumbs"] = new (string label, string? href)[]
        {
            ("Admin", "/Dashboard"),
            ("Reports", "/Reports"),
            ("Month-end close", null),
        }
    })

    @Html.AntiForgeryToken()

    <div class="period-bar">
        <a class="period-nav" id="prevPeriod" title="@(L["Previous period"].Value)">
            <i class="fas fa-chevron-left"></i> @L["Prev"]
        </a>
        <div class="period-label" id="periodLabel">…</div>
        <a class="period-nav" id="nextPeriod" title="@(L["Next period"].Value)">
            @L["Next"] <i class="fas fa-chevron-right"></i>
        </a>
    </div>

    <div class="summary-strip" id="summaryStrip">
        <div class="sum-card sum-green"><span id="sumGreen">0</span> @L["green"]</div>
        <div class="sum-card sum-amber"><span id="sumAmber">0</span> @L["amber"]</div>
        <div class="sum-card sum-red"><span id="sumRed">0</span> @L["red"]</div>
        <div class="sum-card sum-muted"><span id="sumMuted">0</span> @L["not yet"]</div>
    </div>

    <div id="closedBanner" hidden class="closed-banner">
        <i class="fas fa-lock"></i>
        <div>
            <strong>@L["Period closed."]</strong>
            <span id="closedDetail"></span>
        </div>
    </div>

    <ol class="steps" id="stepsList"></ol>

    <div class="close-section" id="closeSection">
        <h3><i class="fas fa-lock"></i> @L["Close this period"]</h3>
        <p class="muted">
            @L["Closes the books for the current period. The close action is irreversible. Snapshot of the current checklist state is saved for audit. Re-running the monthly invoice job for a closed period will be blocked."]
        </p>
        <textarea id="closeNotes" rows="2" placeholder="@(L["Optional close-out note (e.g. 'all items addressed, ready for end-of-month sign-off')…"].Value)"></textarea>
        <button id="closeBtn" class="btn-danger">
            <i class="fas fa-lock"></i> @L["Mark period closed"]
        </button>
    </div>

</div>

<style>
    .page-container { padding: 1.5rem 2rem; max-width: 1100px; margin: 0 auto; }

    .period-bar {
        display: flex; justify-content: space-between; align-items: center;
        background: white; border: 1px solid #e2e8f0; border-radius: 12px;
        padding: 0.75rem 1.25rem; margin-bottom: 0.85rem;
    }
    .period-label { font-size: 1.3rem; font-weight: 700; color: #0f172a; }
    .period-nav {
        display: inline-flex; align-items: center; gap: 0.4rem;
        color: #475569; text-decoration: none; font-weight: 500; font-size: 0.9rem;
    }
    .period-nav:hover { color: #6366f1; }

    .summary-strip {
        display: flex; gap: 0.65rem; flex-wrap: wrap; margin-bottom: 1.25rem;
    }
    .sum-card {
        flex: 1; min-width: 140px;
        padding: 0.7rem 1rem; border-radius: 10px;
        font-size: 0.85rem; font-weight: 600; color: #334155;
        display: flex; align-items: baseline; gap: 0.4rem;
        background: white; border: 1px solid #e2e8f0;
        border-left: 4px solid #cbd5e1;
    }
    .sum-card span { font-size: 1.25rem; font-weight: 700; color: #0f172a; }
    .sum-green { border-left-color: #10b981; }
    .sum-amber { border-left-color: #f59e0b; }
    .sum-red   { border-left-color: #ef4444; }
    .sum-muted { border-left-color: #cbd5e1; }

    .closed-banner {
        display: flex; gap: 0.85rem; align-items: center;
        background: #fef3c7; border: 1px solid #fbbf24; border-radius: 10px;
        padding: 0.85rem 1.1rem; margin-bottom: 1rem;
        color: #78350f; font-size: 0.92rem;
    }
    .closed-banner i { font-size: 1.4rem; color: #d97706; }

    .steps { list-style: none; padding: 0; margin: 0; }
    .step {
        display: grid;
        grid-template-columns: 40px 1fr auto;
        gap: 0.75rem; align-items: center;
        background: white; border: 1px solid #e2e8f0; border-radius: 10px;
        padding: 0.85rem 1.1rem; margin-bottom: 0.55rem;
    }
    .step-status {
        width: 32px; height: 32px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 0.85rem;
    }
    .step-status.green { background: #10b981; }
    .step-status.amber { background: #f59e0b; }
    .step-status.red   { background: #ef4444; }
    .step-status.muted { background: #cbd5e1; }
    .step-body h4 { margin: 0 0 0.15rem; font-size: 0.95rem; color: #0f172a; }
    .step-body .step-detail { font-size: 0.82rem; color: #64748b; }
    .step-actions { display: flex; gap: 0.35rem; flex-wrap: wrap; }
    .step-actions a, .step-actions button {
        display: inline-flex; align-items: center; gap: 0.35rem;
        padding: 0.35rem 0.7rem; border-radius: 6px;
        text-decoration: none; font-size: 0.78rem; font-weight: 500;
        background: #f1f5f9; color: #334155;
        border: 1px solid #e2e8f0; cursor: pointer;
    }
    .step-actions a:hover, .step-actions button:hover {
        background: #e2e8f0; color: #6366f1;
    }
    .step-actions .btn-trigger {
        background: rgba(99,102,241,0.08); color: #4338ca; border-color: rgba(99,102,241,0.2);
    }

    .close-section {
        background: white; border: 1px solid #e2e8f0; border-radius: 12px;
        padding: 1.25rem; margin-top: 1.5rem;
    }
    .close-section h3 {
        margin: 0 0 0.5rem; font-size: 1.05rem; color: #334155;
        display: flex; align-items: center; gap: 0.5rem;
    }
    .close-section h3 i { color: #ef4444; }
    .close-section p.muted { color: #64748b; font-size: 0.88rem; margin: 0 0 0.85rem; }
    .close-section textarea {
        width: 100%; min-height: 60px;
        padding: 0.55rem 0.75rem; border: 1px solid #e2e8f0; border-radius: 6px;
        background: #f8fafc; font-size: 0.88rem; font-family: inherit;
        margin-bottom: 0.85rem;
    }
    .btn-danger {
        display: inline-flex; align-items: center; gap: 0.4rem;
        padding: 0.6rem 1.1rem; border-radius: 8px;
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white; border: 0; cursor: pointer;
        font-size: 0.9rem; font-weight: 600;
    }
    .btn-danger:hover { box-shadow: 0 4px 14px rgba(239,68,68,0.35); }
    .btn-danger:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

@section Scripts {
    <script id="initialState" type="application/json">@Html.Raw(stateJson)</script>
    <script>
        // Boot from server-rendered JSON; subsequent period navigation
        // fetches the same shape from /Reports/MonthEndCloseState.
        let state = JSON.parse(document.getElementById('initialState').textContent);
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

        function shiftPeriod(label, delta) {
            const [y, m] = label.split('-').map(Number);
            const d = new Date(y, m - 1 + delta, 1);
            return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
        }

        async function load(period) {
            const url = '/Reports/MonthEndCloseState' + (period ? `?period=${period}` : '');
            const res = await fetch(url, { credentials: 'same-origin' });
            if (!res.ok) {
                alert('Couldn\'t load period state: ' + res.status);
                return;
            }
            state = await res.json();
            render();
        }

        function statusIcon(s) {
            return s === 'green' ? 'fa-check'
                : s === 'amber' ? 'fa-exclamation'
                : s === 'red'   ? 'fa-times'
                : 'fa-minus';
        }

        function actionsHtml(step) {
            const parts = [];
            if (step.blockerHref) parts.push(`<a href="${step.blockerHref}"><i class="fas fa-arrow-right"></i> Open</a>`);
            if (step.actionHref)  parts.push(`<a href="${step.actionHref}"><i class="fas fa-arrow-right"></i> Open</a>`);
            if (step.triggerJobId) parts.push(`<button class="btn-trigger" data-job="${step.triggerJobId}"><i class="fas fa-bolt"></i> Trigger now</button>`);
            return parts.join('');
        }

        function escapeHtml(s) {
            return (s ?? '').toString().replace(/[&<>"']/g, c => ({
                '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
            }[c]));
        }

        function render() {
            document.getElementById('periodLabel').textContent = state.period;
            document.getElementById('sumGreen').textContent = state.summary.green;
            document.getElementById('sumAmber').textContent = state.summary.amber;
            document.getElementById('sumRed').textContent = state.summary.red;
            document.getElementById('sumMuted').textContent = state.summary.muted;

            // Closed banner
            const banner = document.getElementById('closedBanner');
            const closeSection = document.getElementById('closeSection');
            if (state.closed) {
                banner.hidden = false;
                document.getElementById('closedDetail').textContent =
                    ` Closed on ${new Date(state.closed.closedAt).toLocaleString()} by ${state.closed.closedBy}.`
                    + (state.closed.notes ? ` Note: "${state.closed.notes}"` : '');
                closeSection.hidden = true;
            } else {
                banner.hidden = true;
                closeSection.hidden = false;
            }

            // Build the 9 step rows in display order
            const rows = [
                { key: 'rentInvoices',        title: 'Rent invoices issued',
                  detail: s => `${s.issued} of ${s.expected} active leases` },
                { key: 'depositInvoices',     title: 'Deposit invoices issued',
                  detail: s => `${s.issued} of ${s.expected} active leases · ${s.pendingActivations} pending lease(s)` },
                { key: 'insuranceInvoices',   title: 'Insurance invoices issued',
                  detail: s => `${s.issued} of ${s.expected} eligible leases` },
                { key: 'overdueFlip',         title: 'Overdue invoices flipped',
                  detail: s => s.leftover === 0 ? 'All Pending invoices within due date' : `${s.leftover} Pending invoice(s) past due — job missed a run?` },
                { key: 'expiredLeaseFlip',    title: 'Expired leases flipped',
                  detail: s => s.leftover === 0 ? 'All Active leases within end date' : `${s.leftover} Active lease(s) past end date — job missed a run?` },
                { key: 'bankTransferApprovals', title: 'Bank transfers reviewed',
                  detail: s => s.pending === 0 ? 'Queue is clear' : `${s.pending} transfer(s) awaiting review` },
                { key: 'knetReconciliation',  title: 'K-NET batch reconciled',
                  detail: s => s.lastBatchDate
                    ? `Last batch ${new Date(s.lastBatchDate).toLocaleDateString()} · ${s.lastBatchStatus}`
                    : 'No K-NET batches this period' },
                { key: 'executiveDashboardEmail', title: 'Executive dashboard emailed',
                  detail: s => s.lastSentAt ? `Sent ${new Date(s.lastSentAt).toLocaleString()}` : 'Not yet sent' },
                { key: 'glExport',            title: 'GL export generated',
                  detail: s => s.status === 'green' ? 'Generated' : 'Optional — not yet run' },
            ];

            const list = document.getElementById('stepsList');
            list.innerHTML = '';
            rows.forEach((row, i) => {
                const step = state.steps[row.key] || {};
                const li = document.createElement('li');
                li.className = 'step';
                li.innerHTML = `
                    <div class="step-status ${step.status || 'muted'}">
                        <i class="fas ${statusIcon(step.status)}"></i>
                    </div>
                    <div class="step-body">
                        <h4>Step ${i + 1} · ${escapeHtml(row.title)}</h4>
                        <div class="step-detail">${escapeHtml(row.detail(step))}</div>
                    </div>
                    <div class="step-actions">${actionsHtml(step)}</div>`;
                list.appendChild(li);
            });

            // Wire the "Trigger now" buttons (only enabled when NOT closed).
            list.querySelectorAll('.btn-trigger').forEach(btn => {
                if (state.closed) { btn.disabled = true; return; }
                btn.addEventListener('click', () => triggerJob(btn.dataset.job, btn));
            });
        }

        async function triggerJob(jobId, btn) {
            if (!confirm(`Trigger '${jobId}' immediately? It runs in the background; check /hangfire for status.`)) return;
            btn.disabled = true;
            try {
                const fd = new FormData();
                fd.set('jobId', jobId);
                fd.set('__RequestVerificationToken', tokenInput.value);
                const res = await fetch('/Reports/TriggerJob', { method: 'POST', body: fd, credentials: 'same-origin' });
                const json = await res.json();
                alert(json.message);
                if (json.success) setTimeout(() => load(state.period), 1500);
            } catch (e) {
                alert('Trigger failed: ' + e.message);
            } finally {
                btn.disabled = false;
            }
        }

        document.getElementById('prevPeriod').addEventListener('click', () => load(shiftPeriod(state.period, -1)));
        document.getElementById('nextPeriod').addEventListener('click', () => load(shiftPeriod(state.period, 1)));

        document.getElementById('closeBtn').addEventListener('click', async (e) => {
            if (!confirm(`Close period ${state.period}? This is irreversible.`)) return;
            const notes = document.getElementById('closeNotes').value;
            e.target.disabled = true;
            try {
                const fd = new FormData();
                fd.set('period', state.period);
                fd.set('notes', notes);
                fd.set('__RequestVerificationToken', tokenInput.value);
                const res = await fetch('/Reports/ConfirmClose', { method: 'POST', body: fd, credentials: 'same-origin' });
                const json = await res.json();
                alert(json.message);
                if (json.success) await load(state.period);
            } catch (err) {
                alert('Close failed: ' + err.message);
            } finally {
                e.target.disabled = false;
            }
        });

        render();
    </script>
}
