@model List<RentCollection.Web.Controllers.PaymentReportData>
@{
    ViewData["Title"] = "Payment Report";
    var properties = ViewBag.Properties as List<RentCollection.Core.Entities.Property>;
    var tenants = ViewBag.Tenants as List<RentCollection.Core.Entities.Tenant>;
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        /* Animated Background */
        .bg-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .bg-animation .circle {
            position: absolute;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(138, 109, 31, 0.15), rgba(184, 134, 11, 0.15));
            animation: float 20s infinite;
        }

        .bg-animation .circle:nth-child(1) {
            width: 400px;
            height: 400px;
            top: -100px;
            right: -100px;
            animation-delay: 0s;
        }

        .bg-animation .circle:nth-child(2) {
            width: 300px;
            height: 300px;
            bottom: -50px;
            left: -50px;
            animation-delay: 5s;
        }

        .bg-animation .circle:nth-child(3) {
            width: 200px;
            height: 200px;
            top: 50%;
            left: 50%;
            animation-delay: 10s;
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.5; }
            50% { transform: translateY(-30px) rotate(180deg); opacity: 0.8; }
        }

        .app-container {
            position: relative;
            z-index: 1;
            padding: 1.5rem;
            max-width: 1800px;
            margin: 0 auto;
        }

        /* Header */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding: 1.5rem;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(138, 109, 31, 0.2);
        }

        .header-content h1 {
            font-size: 2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #2E2614, #8A6D1F);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .header-content h1 i {
            background: linear-gradient(135deg, #8a6d1f, #b8860b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header-content p {
            color: #64748b;
            margin-top: 0.5rem;
            font-size: 0.9rem;
        }

        .header-actions {
            display: flex;
            gap: 1rem;
        }

        /* Glassmorphic Cards */
        .glass-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(138, 109, 31, 0.2);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            transition: all 0.3s ease;
        }

        .glass-card:hover {
            border-color: rgba(138, 109, 31, 0.4);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        /* Filter Section */
        .filter-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }

        .filter-header h3 {
            font-size: 1.25rem;
            font-weight: 600;
            color: #334155;
        }

        .filter-header i {
            color: #B8860B;
        }

        .filter-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.25rem;
            margin-bottom: 1.5rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .form-group label {
            font-size: 0.85rem;
            font-weight: 500;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            padding: 0.875rem 1rem;
            color: #1e293b;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: #B8860B;
            box-shadow: 0 0 0 3px rgba(129, 140, 248, 0.2);
            background: #ffffff;
        }

        .form-control option {
            background: #ffffff;
            color: #1e293b;
        }

        .filter-actions {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        /* Buttons */
        .btn {
            padding: 0.875rem 1.5rem;
            border-radius: 12px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            font-size: 0.9rem;
            text-decoration: none;
            position: relative;
            overflow: hidden;
        }

        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .btn:hover::before {
            left: 100%;
        }

        .btn-primary {
            background: linear-gradient(135deg, #8a6d1f, #b8860b);
            color: white;
            box-shadow: 0 4px 15px rgba(138, 109, 31, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(138, 109, 31, 0.5);
        }

        .btn-secondary {
            background: rgba(138, 109, 31, 0.1);
            color: #6e5518;
            border: 1px solid rgba(138, 109, 31, 0.3);
        }

        .btn-secondary:hover {
            background: rgba(138, 109, 31, 0.2);
            transform: translateY(-2px);
        }

        .btn-success {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
        }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.5);
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.25rem;
            margin-bottom: 1.5rem;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(138, 109, 31, 0.2);
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1.25rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--accent-color), transparent);
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .stat-card.total { --accent-color: #8a6d1f; }
        .stat-card.completed { --accent-color: #10b981; }
        .stat-card.pending { --accent-color: #f59e0b; }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .stat-card.total .stat-icon {
            background: linear-gradient(135deg, rgba(138, 109, 31, 0.2), rgba(138, 109, 31, 0.1));
            color: #B8860B;
        }

        .stat-card.completed .stat-icon {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(16, 185, 129, 0.1));
            color: #047857;
        }

        .stat-card.pending .stat-icon {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(245, 158, 11, 0.1));
            color: #B45309;
        }

        .stat-content {
            flex: 1;
        }

        .stat-label {
            font-size: 0.85rem;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 800;
            color: #1e293b;
            line-height: 1.2;
        }

        .stat-amount {
            font-size: 0.9rem;
            color: #B8860B;
            font-weight: 600;
        }

        /* Payment Type Cards */
        .type-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .type-card {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(20px);
            border-radius: 16px;
            border: 1px solid rgba(138, 109, 31, 0.15);
            padding: 1.25rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: all 0.3s ease;
        }

        .type-card:hover {
            background: rgba(255, 255, 255, 0.9);
            transform: translateX(5px);
        }

        .type-icon {
            width: 45px;
            height: 45px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .type-card.knet .type-icon {
            background: linear-gradient(135deg, rgba(184, 134, 11, 0.2), rgba(184, 134, 11, 0.1));
            color: #a78bfa;
        }

        .type-card.cash .type-icon {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(16, 185, 129, 0.1));
            color: #047857;
        }

        .type-card.bank .type-icon {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(59, 130, 246, 0.1));
            color: #1D4ED8;
        }

        .type-info {
            flex: 1;
        }

        .type-name {
            font-weight: 600;
            color: #1e293b;
            font-size: 0.95rem;
        }

        .type-count {
            font-size: 0.8rem;
            color: #94a3b8;
        }

        .type-amount {
            font-weight: 700;
            color: #334155;
            font-size: 0.95rem;
        }

        /* Data Table */
        .table-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(138, 109, 31, 0.2);
            overflow: hidden;
        }

        .table-header {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid rgba(138, 109, 31, 0.2);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-header h3 {
            font-size: 1.25rem;
            font-weight: 600;
            color: #334155;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .table-header h3 i {
            color: #B8860B;
        }

        .record-count {
            font-size: 0.85rem;
            color: #8a6d1f;
            background: rgba(138, 109, 31, 0.1);
            padding: 0.5rem 1rem;
            border-radius: 20px;
        }

        .table-responsive {
            overflow-x: auto;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th {
            background: rgba(138, 109, 31, 0.08);
            padding: 1rem 1.25rem;
            text-align: left;
            font-weight: 600;
            color: #475569;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
        }

        .data-table td {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid #e2e8f0;
            font-size: 0.9rem;
            color: #334155;
        }

        .data-table tr {
            transition: all 0.2s ease;
        }

        .data-table tr:hover {
            background: rgba(138, 109, 31, 0.05);
        }

        .data-table .amount {
            font-weight: 600;
            font-family: 'SF Mono', 'Fira Code', monospace;
            color: #047857;
        }

        /* Status Badges */
        .badge {
            padding: 0.375rem 0.875rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
        }

        .badge::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .status-completed {
            background: rgba(16, 185, 129, 0.15);
            color: #047857;
        }

        .status-pending {
            background: rgba(245, 158, 11, 0.15);
            color: #B45309;
        }

        .status-failed {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }

        .status-cancelled {
            background: rgba(107, 114, 128, 0.15);
            color: #9ca3af;
        }

        /* Method Badges */
        .method-knet {
            background: rgba(184, 134, 11, 0.15);
            color: #a78bfa;
        }

        .method-cash {
            background: rgba(16, 185, 129, 0.15);
            color: #047857;
        }

        .method-bank {
            background: rgba(59, 130, 246, 0.15);
            color: #1D4ED8;
        }

        .no-data {
            text-align: center;
            padding: 3rem !important;
            color: #94a3b8;
        }

        .no-data i {
            font-size: 2rem;
            margin-bottom: 1rem;
            display: block;
            color: #cbd5e1;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .page-header {
                flex-direction: column;
                gap: 1.5rem;
                text-align: center;
            }

            .header-actions {
                width: 100%;
                justify-content: center;
            }

            .filter-grid {
                grid-template-columns: 1fr;
            }

            .filter-actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .type-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- Animated Background -->
<div class="bg-animation">
    <div class="circle"></div>
    <div class="circle"></div>
    <div class="circle"></div>
</div>

<div class="app-container">
    <!-- Header -->
    <div class="page-header">
        <div class="header-content">
            <h1><i class="fas fa-chart-line"></i> @L["Payment Analytics"]</h1>
            <p>@L["Real-time payment tracking with advanced filtering"]</p>
        </div>
        <div class="header-actions">
            <a href="/Reports/Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> @L["Back"]
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="glass-card">
        <div class="filter-header">
            <i class="fas fa-sliders-h"></i>
            <h3>@L["Filters"]</h3>
        </div>
        <form method="get" id="filterForm">
            <div class="filter-grid">
                <div class="form-group">
                    <label>@L["From Date"]</label>
                    <input type="date" name="fromDate" class="form-control" value="@((ViewBag.FromDate as DateTime?)?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="form-group">
                    <label>@L["To Date"]</label>
                    <input type="date" name="toDate" class="form-control" value="@((ViewBag.ToDate as DateTime?)?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="form-group">
                    <label>@L["Property"]</label>
                    <select name="propertyId" class="form-control">
                        <option value="">@L["All Properties"]</option>
                        @if (properties != null)
                        {
                            foreach (var prop in properties)
                            {
                                <option value="@prop.PropertyId" selected="@(ViewBag.SelectedPropertyId != null && (int)ViewBag.SelectedPropertyId == prop.PropertyId)">
                                    @prop.PropertyName
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>@L["Payment Type"]</label>
                    <select name="paymentType" class="form-control">
                        <option value="">@L["All Types"]</option>
                        <option value="KNET" selected="@(ViewBag.SelectedPaymentType == "KNET")">KNET</option>
                        <option value="Cash" selected="@(ViewBag.SelectedPaymentType == "Cash")">@L["Cash"]</option>
                        <option value="BankTransfer" selected="@(ViewBag.SelectedPaymentType == "BankTransfer")">@L["Bank Transfer"]</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>@L["Status"]</label>
                    <select name="paymentStatus" class="form-control">
                        <option value="">@L["All Statuses"]</option>
                        <option value="Completed" selected="@(ViewBag.SelectedPaymentStatus == "Completed")">@L["Completed"]</option>
                        <option value="Pending" selected="@(ViewBag.SelectedPaymentStatus == "Pending")">@L["Pending"]</option>
                        <option value="PendingVerification" selected="@(ViewBag.SelectedPaymentStatus == "PendingVerification")">@L["Pending Verification"]</option>
                        <option value="Failed" selected="@(ViewBag.SelectedPaymentStatus == "Failed")">@L["Failed"]</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>@L["Tenant"]</label>
                    <select name="tenantId" class="form-control">
                        <option value="">@L["All Tenants"]</option>
                        @if (tenants != null)
                        {
                            foreach (var tenant in tenants)
                            {
                                <option value="@tenant.TenantId" selected="@(ViewBag.SelectedTenantId != null && (int)ViewBag.SelectedTenantId == tenant.TenantId)">
                                    @tenant.FirstName @tenant.LastName
                                </option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="filter-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> @L["Apply Filters"]
                </button>
                <a href="/Reports/PaymentReport" class="btn btn-secondary">
                    <i class="fas fa-undo"></i> @L["Reset"]
                </a>
                <button type="button" onclick="exportToExcel()" class="btn btn-success">
                    <i class="fas fa-file-excel"></i> @L["Export Excel"]
                </button>
            </div>
        </form>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card total">
            <div class="stat-icon">
                <i class="fas fa-layer-group"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">@L["Total Payments"]</div>
                <div class="stat-value">@ViewBag.TotalPayments</div>
                <div class="stat-amount">@((ViewBag.TotalAmount as decimal?)?.ToString("N3") ?? "0.000") KWD</div>
            </div>
        </div>
        <div class="stat-card completed">
            <div class="stat-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">@L["Completed"]</div>
                <div class="stat-value">@ViewBag.CompletedCount</div>
                <div class="stat-amount">@((ViewBag.CompletedAmount as decimal?)?.ToString("N3") ?? "0.000") KWD</div>
            </div>
        </div>
        <div class="stat-card pending">
            <div class="stat-icon">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">@L["Pending"]</div>
                <div class="stat-value">@ViewBag.PendingCount</div>
                <div class="stat-amount">@((ViewBag.PendingAmount as decimal?)?.ToString("N3") ?? "0.000") KWD</div>
            </div>
        </div>
    </div>

    <!-- Payment Type Breakdown -->
    <div class="type-grid">
        <div class="type-card knet">
            <div class="type-icon">
                <i class="fas fa-credit-card"></i>
            </div>
            <div class="type-info">
                <div class="type-name">KNET</div>
                <div class="type-count">@ViewBag.KNETCount @L["payments"]</div>
            </div>
            <div class="type-amount">@((ViewBag.KNETAmount as decimal?)?.ToString("N3") ?? "0.000") KWD</div>
        </div>
        <div class="type-card cash">
            <div class="type-icon">
                <i class="fas fa-money-bill-wave"></i>
            </div>
            <div class="type-info">
                <div class="type-name">@L["Cash"]</div>
                <div class="type-count">@ViewBag.CashCount @L["payments"]</div>
            </div>
            <div class="type-amount">@((ViewBag.CashAmount as decimal?)?.ToString("N3") ?? "0.000") KWD</div>
        </div>
        <div class="type-card bank">
            <div class="type-icon">
                <i class="fas fa-university"></i>
            </div>
            <div class="type-info">
                <div class="type-name">@L["Bank Transfer"]</div>
                <div class="type-count">@ViewBag.BankTransferCount @L["payments"]</div>
            </div>
            <div class="type-amount">@((ViewBag.BankTransferAmount as decimal?)?.ToString("N3") ?? "0.000") KWD</div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="table-card">
        <div class="table-header">
            <h3><i class="fas fa-table"></i> @L["Payment Records"]</h3>
            <span class="record-count">@Model.Count @L["records"]</span>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@L["ID"]</th>
                        <th>@L["Date"]</th>
                        <th>@L["Tenant"]</th>
                        <th>@L["Property"]</th>
                        <th>@L["Unit"]</th>
                        <th>@L["Amount"]</th>
                        <th>@L["Method"]</th>
                        <th>@L["Status"]</th>
                        <th>@L["Reference"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var payment in Model)
                        {
                            var statusClass = payment.PaymentStatus switch
                            {
                                "Completed" => "status-completed",
                                "Pending" => "status-pending",
                                "PendingVerification" => "status-pending",
                                "Failed" => "status-failed",
                                "Cancelled" => "status-cancelled",
                                _ => ""
                            };

                            var methodClass = payment.PaymentMethod switch
                            {
                                "KNET" => "method-knet",
                                "Cash" => "method-cash",
                                "BankTransfer" => "method-bank",
                                _ => ""
                            };

                            <tr>
                                <td>#@payment.PaymentId</td>
                                <td>@payment.PaymentDate.ToString("dd MMM yyyy")</td>
                                <td>@payment.TenantName</td>
                                <td>@payment.PropertyName</td>
                                <td>@payment.UnitNumber</td>
                                <td class="amount">@payment.Amount.ToString("N3")</td>
                                <td><span class="badge @methodClass">@payment.PaymentMethod</span></td>
                                <td><span class="badge @statusClass">@payment.PaymentStatus</span></td>
                                <td>@payment.TransactionReference</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="no-data">
                                <i class="fas fa-search"></i>
                                @L["No payments found matching the selected filters"]
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function exportToExcel() {
            const form = document.getElementById('filterForm');
            const params = new URLSearchParams(new FormData(form));
            window.location.href = '/Reports/PaymentReportExcel?' + params.toString();
        }

        // Add subtle animation on scroll
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.stat-card, .type-card, .glass-card');

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, { threshold: 0.1 });

            cards.forEach(card => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                card.style.transition = 'all 0.6s ease';
                observer.observe(card);
            });
        });
    </script>
}
