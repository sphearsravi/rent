@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Tenant Payment Analysis";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        /* Animated Background */
        .bg-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .bg-animation .circle {
            position: absolute;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(138, 109, 31, 0.15), rgba(184, 134, 11, 0.15));
            animation: float 20s infinite;
        }

        .bg-animation .circle:nth-child(1) {
            width: 400px;
            height: 400px;
            top: -100px;
            right: -100px;
            animation-delay: 0s;
        }

        .bg-animation .circle:nth-child(2) {
            width: 300px;
            height: 300px;
            bottom: -50px;
            left: -50px;
            animation-delay: 5s;
        }

        .bg-animation .circle:nth-child(3) {
            width: 200px;
            height: 200px;
            top: 50%;
            left: 50%;
            animation-delay: 10s;
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.5; }
            50% { transform: translateY(-30px) rotate(180deg); opacity: 0.8; }
        }

        .app-container {
            position: relative;
            z-index: 1;
            padding: 1.5rem;
            max-width: 1800px;
            margin: 0 auto;
        }

        /* Header */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding: 1.5rem;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(138, 109, 31, 0.2);
        }

        .header-content h1 {
            font-size: 2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #2E2614, #8A6D1F);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .header-content h1 i {
            background: linear-gradient(135deg, #8a6d1f, #b8860b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header-content p {
            color: #64748b;
            margin-top: 0.5rem;
            font-size: 0.9rem;
        }

        .header-actions {
            display: flex;
            gap: 1rem;
        }

        /* Glassmorphic Cards */
        .glass-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(138, 109, 31, 0.2);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            transition: all 0.3s ease;
        }

        .glass-card:hover {
            border-color: rgba(138, 109, 31, 0.4);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        /* Filter Section */
        .filter-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }

        .filter-header h3 {
            font-size: 1.25rem;
            font-weight: 600;
            color: #334155;
        }

        .filter-header i {
            color: #B8860B;
        }

        .filter-form {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .form-group label {
            font-size: 0.85rem;
            font-weight: 500;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            padding: 0.875rem 1rem;
            color: #1e293b;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: #B8860B;
            box-shadow: 0 0 0 3px rgba(129, 140, 248, 0.2);
            background: #ffffff;
        }

        /* Buttons */
        .btn {
            padding: 0.875rem 1.5rem;
            border-radius: 12px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            font-size: 0.9rem;
            text-decoration: none;
            position: relative;
            overflow: hidden;
        }

        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .btn:hover::before {
            left: 100%;
        }

        .btn-primary {
            background: linear-gradient(135deg, #8a6d1f, #b8860b);
            color: white;
            box-shadow: 0 4px 15px rgba(138, 109, 31, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(138, 109, 31, 0.5);
        }

        .btn-secondary {
            background: rgba(138, 109, 31, 0.1);
            color: #6e5518;
            border: 1px solid rgba(138, 109, 31, 0.3);
        }

        .btn-secondary:hover {
            background: rgba(138, 109, 31, 0.2);
            transform: translateY(-2px);
        }

        .btn-success {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
        }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.5);
        }

        /* Legend Card */
        .legend-card {
            background: rgba(59, 130, 246, 0.1);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 12px;
            padding: 1rem 1.5rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .legend-card strong {
            color: #1D4ED8;
        }

        .legend-badge {
            margin-left: 0.5rem;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border-radius: 16px;
            border: 1px solid rgba(138, 109, 31, 0.2);
            padding: 1.25rem;
            text-align: center;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: var(--accent-color);
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .stat-card.excellent { --accent-color: #10b981; }
        .stat-card.good { --accent-color: #8a6d1f; }
        .stat-card.fair { --accent-color: #f59e0b; }
        .stat-card.poor { --accent-color: #ef4444; }

        .stat-card h6 {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #64748b;
            margin-bottom: 0.5rem;
        }

        .stat-card h3 {
            font-size: 2rem;
            font-weight: 800;
            color: #1e293b;
        }

        /* Data Table */
        .table-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(138, 109, 31, 0.2);
            overflow: hidden;
        }

        .table-header {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid rgba(138, 109, 31, 0.2);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-header h3 {
            font-size: 1.25rem;
            font-weight: 600;
            color: #334155;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .table-header h3 i {
            color: #B8860B;
        }

        .record-count {
            font-size: 0.85rem;
            color: #8a6d1f;
            background: rgba(138, 109, 31, 0.1);
            padding: 0.5rem 1rem;
            border-radius: 20px;
        }

        .table-responsive {
            overflow-x: auto;
            max-height: 600px;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th {
            background: rgba(138, 109, 31, 0.08);
            padding: 1rem 1rem;
            text-align: left;
            font-weight: 600;
            color: #475569;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 10;
            cursor: pointer;
        }

        .data-table th:hover {
            background: rgba(138, 109, 31, 0.15);
        }

        .data-table td {
            padding: 0.875rem 1rem;
            border-bottom: 1px solid #e2e8f0;
            font-size: 0.85rem;
            color: #334155;
        }

        .data-table tr {
            transition: all 0.2s ease;
        }

        .data-table tbody tr:hover {
            background: rgba(138, 109, 31, 0.05);
        }

        .data-table .amount {
            font-weight: 600;
            font-family: 'SF Mono', 'Fira Code', monospace;
        }

        .data-table tfoot {
            background: rgba(138, 109, 31, 0.08);
        }

        .data-table tfoot th {
            position: static;
            font-weight: 700;
            color: #1e293b;
        }

        .text-center {
            text-align: center;
        }

        .text-right {
            text-align: right;
        }

        /* Status Badges */
        .badge {
            padding: 0.375rem 0.75rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
        }

        .badge::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .badge-success {
            background: rgba(16, 185, 129, 0.15);
            color: #047857;
        }

        .badge-primary {
            background: rgba(138, 109, 31, 0.15);
            color: #B8860B;
        }

        .badge-warning {
            background: rgba(245, 158, 11, 0.15);
            color: #B45309;
        }

        .badge-danger {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }

        .text-success {
            color: #047857;
        }

        .text-danger {
            color: #f87171;
        }

        .text-muted {
            color: #94a3b8;
        }

        .alert {
            padding: 1rem 1.5rem;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .alert-info {
            background: rgba(59, 130, 246, 0.15);
            color: #1D4ED8;
            border: 1px solid rgba(59, 130, 246, 0.3);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .page-header {
                flex-direction: column;
                gap: 1.5rem;
                text-align: center;
            }

            .header-actions {
                width: 100%;
                justify-content: center;
            }

            .filter-form {
                flex-direction: column;
                align-items: stretch;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }

            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
}

<!-- Animated Background -->
<div class="bg-animation">
    <div class="circle"></div>
    <div class="circle"></div>
    <div class="circle"></div>
</div>

<div class="app-container">
    <!-- Header -->
    <div class="page-header">
        <div class="header-content">
            <h1><i class="fas fa-user-check"></i> @L["Tenant Payment Analysis"]</h1>
            <p>@L["Monitor tenant payment behavior and identify issues"]</p>
        </div>
        <div class="header-actions">
            <a href="@Url.Action("TenantPaymentAnalysisExcel", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })" class="btn btn-success">
                <i class="fas fa-file-excel"></i> @L["Export Excel"]
            </a>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> @L["Back"]
            </a>
        </div>
    </div>

    <!-- Date Filter -->
    <div class="glass-card">
        <div class="filter-header">
            <i class="fas fa-calendar-alt"></i>
            <h3>@L["Date Range Filter"]</h3>
        </div>
        <form method="get" class="filter-form">
            <div class="form-group">
                <label>@L["From Date"]</label>
                <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="form-group">
                <label>@L["To Date"]</label>
                <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate?.ToString("yyyy-MM-dd")" />
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-filter"></i> @L["Apply Filter"]
            </button>
        </form>
    </div>

    <!-- Payment Score Legend -->
    <div class="legend-card">
        <strong>@L["Payment Score Legend:"]</strong>
        <span class="badge badge-success legend-badge">@L["Excellent (95-100%)"]</span>
        <span class="badge badge-primary legend-badge">@L["Good (85-94%)"]</span>
        <span class="badge badge-warning legend-badge">@L["Fair (70-84%)"]</span>
        <span class="badge badge-danger legend-badge">Poor (&lt;70%)</span>
    </div>

    <!-- Tenant Payment Grid -->
    <div class="table-card">
        <div class="table-header">
            <h3><i class="fas fa-chart-line"></i> @L["Tenant Payment Behavior Analysis"]</h3>
            @if (Model != null && Model.Any())
            {
                <span class="record-count">@Model.Count() @L["tenants"]</span>
            }
        </div>
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="data-table" id="tenantTable">
                    <thead>
                        <tr>
                            <th>@L["Tenant Name"]</th>
                            <th>@L["PACI Number"]</th>
                            <th>@L["Email"]</th>
                            <th>@L["Phone"]</th>
                            <th class="text-center">@L["Active Leases"]</th>
                            <th class="text-right">@L["Total Billed (KWD)"]</th>
                            <th class="text-right">@L["Total Paid (KWD)"]</th>
                            <th class="text-right">@L["Outstanding (KWD)"]</th>
                            <th class="text-center">@L["Payment Rate %"]</th>
                            <th class="text-center">@L["Payment Score"]</th>
                            <th class="text-center">@L["Avg Days to Pay"]</th>
                            <th class="text-center">@L["Total Payments"]</th>
                            <th class="text-right">@L["Last Payment Date"]</th>
                            <th class="text-right">@L["Last Payment Amount"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tenant in Model)
                        {
                            <tr>
                                <td><strong>@tenant.TenantName</strong></td>
                                <td>@tenant.PACINumber</td>
                                <td>@tenant.Email</td>
                                <td>@tenant.Phone</td>
                                <td class="text-center">@tenant.ActiveLeases</td>
                                <td class="text-right amount">@tenant.TotalBilled.ToString("N3")</td>
                                <td class="text-right amount">@tenant.TotalPaid.ToString("N3")</td>
                                <td class="text-right">
                                    @if (tenant.OutstandingAmount > 0)
                                    {
                                        <span class="text-danger"><strong>@tenant.OutstandingAmount.ToString("N3")</strong></span>
                                    }
                                    else
                                    {
                                        <span class="text-success">0.000</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (tenant.PaymentRate >= 95)
                                    {
                                        <span class="badge badge-success">@tenant.PaymentRate.ToString("N2")%</span>
                                    }
                                    else if (tenant.PaymentRate >= 85)
                                    {
                                        <span class="badge badge-primary">@tenant.PaymentRate.ToString("N2")%</span>
                                    }
                                    else if (tenant.PaymentRate >= 70)
                                    {
                                        <span class="badge badge-warning">@tenant.PaymentRate.ToString("N2")%</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">@tenant.PaymentRate.ToString("N2")%</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (tenant.PaymentScore == "Excellent")
                                    {
                                        <span class="badge badge-success">@tenant.PaymentScore</span>
                                    }
                                    else if (tenant.PaymentScore == "Good")
                                    {
                                        <span class="badge badge-primary">@tenant.PaymentScore</span>
                                    }
                                    else if (tenant.PaymentScore == "Fair")
                                    {
                                        <span class="badge badge-warning">@tenant.PaymentScore</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">@tenant.PaymentScore</span>
                                    }
                                </td>
                                <td class="text-center">@tenant.AvgDaysToPay</td>
                                <td class="text-center">@tenant.TotalPayments</td>
                                <td class="text-right">
                                    @if (tenant.LastPaymentDate != null && tenant.LastPaymentDate.ToString() != "")
                                    {
                                        @Convert.ToDateTime(tenant.LastPaymentDate).ToString("dd-MMM-yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">@L["No payments"]</span>
                                    }
                                </td>
                                <td class="text-right">
                                    @if (tenant.LastPaymentAmount > 0)
                                    {
                                        @tenant.LastPaymentAmount.ToString("N3")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="4">@L["TOTALS"]</th>
                            <th class="text-center">@Model.Sum(t => (int)t.ActiveLeases)</th>
                            <th class="text-right">@Model.Sum(t => (decimal)t.TotalBilled).ToString("N3")</th>
                            <th class="text-right">@Model.Sum(t => (decimal)t.TotalPaid).ToString("N3")</th>
                            <th class="text-right">@Model.Sum(t => (decimal)t.OutstandingAmount).ToString("N3")</th>
                            <th class="text-center">@{
                                var totalPaid = Model.Sum(t => (decimal)t.TotalPaid);
                                var totalBilled = Model.Sum(t => (decimal)t.TotalBilled);
                                var paymentRate = totalBilled > 0 ? (totalPaid * 100.0m / totalBilled) : 0;
                            }@paymentRate.ToString("N2")%</th>
                            <th colspan="5">-</th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Summary Stats -->
            <div style="padding: 1.5rem;">
                <div class="stats-grid">
                    <div class="stat-card excellent">
                        <h6>@L["Excellent Payers"]</h6>
                        <h3>@Model.Count(t => t.PaymentScore == "Excellent")</h3>
                    </div>
                    <div class="stat-card good">
                        <h6>@L["Good Payers"]</h6>
                        <h3>@Model.Count(t => t.PaymentScore == "Good")</h3>
                    </div>
                    <div class="stat-card fair">
                        <h6>@L["Fair Payers"]</h6>
                        <h3>@Model.Count(t => t.PaymentScore == "Fair")</h3>
                    </div>
                    <div class="stat-card poor">
                        <h6>@L["Poor Payers"]</h6>
                        <h3>@Model.Count(t => t.PaymentScore == "Poor")</h3>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div style="padding: 1.5rem;">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> @L["No tenant payment data available for the selected date range."]
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Add sorting functionality
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById('tenantTable');
            if (table) {
                const headers = table.querySelectorAll('thead th');
                headers.forEach((header, index) => {
                    header.addEventListener('click', () => sortTable(index));
                });
            }

            // Add scroll reveal animation
            const cards = document.querySelectorAll('.glass-card, .table-card, .stat-card');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, { threshold: 0.1 });

            cards.forEach(card => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                card.style.transition = 'all 0.6s ease';
                observer.observe(card);
            });
        });

        function sortTable(columnIndex) {
            const table = document.getElementById('tenantTable');
            const tbody = table.querySelector('tbody');
            const rows = Array.from(tbody.querySelectorAll('tr'));

            rows.sort((a, b) => {
                const aValue = a.cells[columnIndex].textContent.trim();
                const bValue = b.cells[columnIndex].textContent.trim();

                const aNum = parseFloat(aValue.replace(/[^0-9.-]/g, ''));
                const bNum = parseFloat(bValue.replace(/[^0-9.-]/g, ''));

                if (!isNaN(aNum) && !isNaN(bNum)) {
                    return bNum - aNum;
                }

                return aValue.localeCompare(bValue);
            });

            rows.forEach(row => tbody.appendChild(row));
        }
    </script>
}
