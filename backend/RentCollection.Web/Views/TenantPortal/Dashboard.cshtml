@{
    ViewData["Title"] = "Tenant Dashboard";
    Layout = null;
    var tenant = ViewBag.Tenant as RentCollection.Core.Entities.Tenant;
    var leases = ViewBag.Leases as List<RentCollection.Core.Entities.Lease>;
    var payments = ViewBag.Payments as List<RentCollection.Core.Entities.Payment>;
    var maintenanceRequests = ViewBag.MaintenanceRequests as List<RentCollection.Core.Entities.MaintenanceRequest>;
    var documents = ViewBag.Documents as List<RentCollection.Core.Entities.Document>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VIIJAR</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="tenant-navbar">
        <div class="navbar-container">
            <div class="navbar-brand">
                <i class="fas fa-building"></i>
                <span>@L["VIIJAR Tenant Portal"]</span>
            </div>
            <div class="navbar-menu">
                <a href="/TenantPortal/Dashboard" class="nav-link active">
                    <i class="fas fa-home"></i> @L["Dashboard"]
                </a>
                <a href="/TenantPortal/MyDetails" class="nav-link">
                    <i class="fas fa-user"></i> @L["My Details"]
                </a>
                <a href="/TenantPortal/MakePayment" class="nav-link">
                    <i class="fas fa-credit-card"></i> @L["Make Payment"]
                </a>
                <a href="/TenantPortal/PaymentHistory" class="nav-link">
                    <i class="fas fa-history"></i> @L["Payment History"]
                </a>
                <a href="/TenantPortal/Logout" class="nav-link logout">
                    <i class="fas fa-sign-out-alt"></i> @L["Logout"]
                </a>
            </div>
        </div>
    </nav>

    <div class="dashboard-container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="welcome-section">
            <h1>@L["Welcome,"] @tenant.FirstName @tenant.LastName!</h1>
            <p class="text-muted">@L["Here's your rental dashboard"]</p>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon blue">
                    <i class="fas fa-home"></i>
                </div>
                <div class="stat-content">
                    <h3>@(leases?.Count ?? 0)</h3>
                    <p>@L["Active Leases"]</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-content">
                    <h3>@(payments?.Count ?? 0)</h3>
                    <p>@L["Total Payments"]</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon orange">
                    <i class="fas fa-tools"></i>
                </div>
                <div class="stat-content">
                    <h3>@(maintenanceRequests?.Count ?? 0)</h3>
                    <p>@L["Pending Requests"]</p>
                </div>
            </div>
        </div>

        <div class="content-grid">
            <div class="section-card">
                <div class="section-header">
                    <h2><i class="fas fa-building"></i> @L["My Properties"]</h2>
                    <a href="/TenantPortal/MakePayment" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> @L["Make Payment"]
                    </a>
                </div>
                <div class="section-content">
                    @if (leases != null && leases.Any())
                    {
                        foreach (var lease in leases)
                        {
                            var leaseDocuments = documents?.Where(d => d.RelatedEntityId == lease.LeaseId).ToList();
                            var daysRemaining = (lease.LeaseEndDate - DateTime.UtcNow).Days;

                            <div class="property-card">
                                <div class="property-header">
                                    <div>
                                        <h3>@lease.Unit?.Property?.PropertyName</h3>
                                        <p class="property-address">
                                            <i class="fas fa-map-marker-alt"></i>
                                            @lease.Unit?.Property?.Address, @lease.Unit?.Property?.Area
                                        </p>
                                    </div>
                                    <span class="badge badge-success">@lease.Status</span>
                                </div>

                                <div class="lease-info-section">
                                    <h4><i class="fas fa-file-contract"></i> @L["Lease Details"]</h4>
                                    <div class="property-details">
                                        <div class="detail-item">
                                            <span class="label">@L["Unit Number:"]</span>
                                            <span class="value">@lease.Unit?.UnitNumber</span>
                                        </div>
                                        <div class="detail-item">
                                            <span class="label">@L["Monthly Rent:"]</span>
                                            <span class="value">@lease.MonthlyRent.ToString("N3") KWD</span>
                                        </div>
                                        <div class="detail-item">
                                            <span class="label">@L["Security Deposit:"]</span>
                                            <span class="value">@lease.SecurityDeposit.ToString("N3") KWD</span>
                                        </div>
                                        <div class="detail-item">
                                            <span class="label">@L["Lease Type:"]</span>
                                            <span class="value">@lease.LeaseType</span>
                                        </div>
                                        <div class="detail-item">
                                            <span class="label">@L["Start Date:"]</span>
                                            <span class="value">@lease.LeaseStartDate.ToString("dd MMM yyyy")</span>
                                        </div>
                                        <div class="detail-item">
                                            <span class="label">@L["End Date:"]</span>
                                            <span class="value">@lease.LeaseEndDate.ToString("dd MMM yyyy")</span>
                                        </div>
                                        <div class="detail-item">
                                            <span class="label">@L["Days Remaining:"]</span>
                                            <span class="value @(daysRemaining < 30 ? "text-danger" : "")">@daysRemaining @L["days"]</span>
                                        </div>
                                        <div class="detail-item">
                                            <span class="label">@L["Payment Due Day:"]</span>
                                            <span class="value">@L["Day"] @lease.PaymentDueDay @L["of each month"]</span>
                                        </div>
                                        @if (lease.LateFeeAmount.HasValue)
                                        {
                                            <div class="detail-item">
                                                <span class="label">@L["Late Fee:"]</span>
                                                <span class="value">@lease.LateFeeAmount.Value.ToString("N3") KWD</span>
                                            </div>
                                        }
                                        @if (lease.LateFeeGracePeriod.HasValue)
                                        {
                                            <div class="detail-item">
                                                <span class="label">@L["Grace Period:"]</span>
                                                <span class="value">@lease.LateFeeGracePeriod @L["days"]</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (leaseDocuments != null && leaseDocuments.Any())
                                {
                                    <div class="documents-section">
                                        <h4><i class="fas fa-folder-open"></i> @L["Lease Documents"]</h4>
                                        <div class="documents-grid">
                                            @foreach (var doc in leaseDocuments)
                                            {
                                                <div class="document-card">
                                                    <div class="document-icon">
                                                        @if (doc.DocumentType.ToLower().Contains("pdf"))
                                                        {
                                                            <i class="fas fa-file-pdf text-danger"></i>
                                                        }
                                                        else if (doc.DocumentType.ToLower().Contains("image") || doc.DocumentType.ToLower().Contains("jpg") || doc.DocumentType.ToLower().Contains("png"))
                                                        {
                                                            <i class="fas fa-file-image text-primary"></i>
                                                        }
                                                        else if (doc.DocumentType.ToLower().Contains("word") || doc.DocumentType.ToLower().Contains("doc"))
                                                        {
                                                            <i class="fas fa-file-word text-info"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-file-alt"></i>
                                                        }
                                                    </div>
                                                    <div class="document-info">
                                                        <div class="document-name">@doc.DocumentName</div>
                                                        <div class="document-meta">
                                                            <span class="document-size">@((doc.FileSize / 1024.0).ToString("N1")) KB</span>
                                                            <span class="document-date">@doc.UploadedDate.ToString("dd MMM yyyy")</span>
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(doc.Description))
                                                        {
                                                            <div class="document-description">@doc.Description</div>
                                                        }
                                                    </div>
                                                    <a href="@Url.Action("Download", "Documents", new { id = doc.DocumentId })" class="document-download" title="@(L["Download"].Value)">
                                                        <i class="fas fa-download"></i>
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="documents-section">
                                        <h4><i class="fas fa-folder-open"></i> @L["Lease Documents"]</h4>
                                        <div class="empty-state-small">
                                            <i class="fas fa-folder-open"></i>
                                            <p>@L["No documents available"]</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-home"></i>
                            <p>@L["No active leases found"]</p>
                        </div>
                    }
                </div>
            </div>

            <div class="section-card">
                <div class="section-header">
                    <h2><i class="fas fa-receipt"></i> @L["Recent Payments"]</h2>
                    <a href="/TenantPortal/PaymentHistory" class="btn btn-secondary btn-sm">
                        @L["View All"]
                    </a>
                </div>
                <div class="section-content">
                    @if (payments != null && payments.Any())
                    {
                        <div class="table-responsive">
                            <table class="payment-table">
                                <thead>
                                    <tr>
                                        <th>@L["Date"]</th>
                                        <th>@L["Property"]</th>
                                        <th>@L["Amount"]</th>
                                        <th>@L["Method"]</th>
                                        <th>@L["Status"]</th>
                                        <th>@L["Action"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in payments)
                                    {
                                        <tr>
                                            <td>@payment.PaymentDate.ToString("dd MMM yyyy")</td>
                                            <td>@payment.Lease?.Unit?.Property?.PropertyName</td>
                                            <td>@payment.AmountPaid.ToString("N3") KWD</td>
                                            <td>@payment.PaymentMethod</td>
                                            <td>
                                                @if (payment.PaymentStatus == "Completed")
                                                {
                                                    <span class="badge badge-success">@payment.PaymentStatus</span>
                                                }
                                                else if (payment.PaymentStatus == "Pending")
                                                {
                                                    <span class="badge badge-warning">@payment.PaymentStatus</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">@payment.PaymentStatus</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("ViewReceipt", "TenantPortal", new { paymentId = payment.PaymentId })" class="btn-receipt" title="@(L["View Receipt"].Value)">
                                                    <i class="fas fa-file-invoice"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-receipt"></i>
                            <p>@L["No payments found"]</p>
                        </div>
                    }
                </div>
            </div>

            <div class="section-card">
                <div class="section-header">
                    <h2><i class="fas fa-tools"></i> @L["Maintenance Requests"]</h2>
                    <button class="btn btn-primary btn-sm" onclick="showMaintenanceModal()">
                        <i class="fas fa-plus"></i> @L["New Request"]
                    </button>
                </div>
                <div class="section-content">
                    @if (maintenanceRequests != null && maintenanceRequests.Any())
                    {
                        foreach (var request in maintenanceRequests)
                        {
                            <div class="maintenance-card">
                                <div class="maintenance-header">
                                    <span class="request-id">#@request.RequestId</span>
                                    @if (request.Status == "Open")
                                    {
                                        <span class="badge badge-info">@request.Status</span>
                                    }
                                    else if (request.Status == "In Progress")
                                    {
                                        <span class="badge badge-warning">@request.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">@request.Status</span>
                                    }
                                </div>
                                <div class="maintenance-body">
                                    <p class="category"><i class="fas fa-tag"></i> @request.Category</p>
                                    <p class="description">@request.Description</p>
                                    <p class="request-date">
                                        <i class="fas fa-calendar"></i>
                                        @L["Requested on"] @request.RequestDate.ToString("dd MMM yyyy")
                                    </p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-tools"></i>
                            <p>@L["No pending maintenance requests"]</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Maintenance Request Modal -->
    <div id="maintenanceModal" class="modal-overlay" style="display: none;">
        <div class="modal-container">
            <div class="modal-header">
                <h3><i class="fas fa-tools"></i> @L["New Maintenance Request"]</h3>
                <button class="modal-close" onclick="closeMaintenanceModal()">&times;</button>
            </div>
            <form id="maintenanceForm" method="post" action="/TenantPortal/CreateMaintenanceRequest">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group">
                        <label for="propertySelect">@L["Property/Unit"]</label>
                        <select id="propertySelect" name="LeaseId" class="form-control" required>
                            <option value="">@L["Select a property..."]</option>
                            @if (leases != null && leases.Any())
                            {
                                foreach (var lease in leases)
                                {
                                    <option value="@lease.LeaseId">
                                        @lease.Unit?.Property?.PropertyName - Unit @lease.Unit?.UnitNumber
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="categorySelect">@L["Category"]</label>
                        <select id="categorySelect" name="Category" class="form-control" required>
                            <option value="">@L["Select a category..."]</option>
                            <option value="Plumbing">@L["Plumbing"]</option>
                            <option value="Electrical">@L["Electrical"]</option>
                            <option value="HVAC">@L["HVAC"]</option>
                            <option value="Appliance">@L["Appliance"]</option>
                            <option value="Structural">@L["Structural"]</option>
                            <option value="Other">@L["Other"]</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="prioritySelect">@L["Priority"]</label>
                        <select id="prioritySelect" name="Priority" class="form-control" required>
                            <option value="">@L["Select priority..."]</option>
                            <option value="Low">@L["Low"]</option>
                            <option value="Medium">@L["Medium"]</option>
                            <option value="High">@L["High"]</option>
                            <option value="Emergency">@L["Emergency"]</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="descriptionText">@L["Description"]</label>
                        <textarea id="descriptionText" name="Description" class="form-control" rows="4" placeholder="@(L["Please describe the issue in detail..."].Value)" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="closeMaintenanceModal()">@L["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane"></i> @L["Submit Request"]
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function showMaintenanceModal() {
            document.getElementById('maintenanceModal').style.display = 'flex';
        }

        function closeMaintenanceModal() {
            document.getElementById('maintenanceModal').style.display = 'none';
            document.getElementById('maintenanceForm').reset();
        }

        // Close modal when clicking outside
        document.getElementById('maintenanceModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeMaintenanceModal();
            }
        });
    </script>
</body>
</html>

<style>
    body {
        background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 50%, #c7d2fe 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 0;
        min-height: 100vh;
    }

    .tenant-navbar {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: white;
        padding: 1rem 0;
        box-shadow: 0 2px 20px rgba(99, 102, 241, 0.3);
    }

    .navbar-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .navbar-brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.5rem;
        font-weight: 700;
    }

    .navbar-brand i {
        font-size: 1.75rem;
    }

    .navbar-menu {
        display: flex;
        gap: 0.5rem;
    }

    .nav-link {
        color: white;
        text-decoration: none;
        padding: 0.75rem 1.25rem;
        border-radius: 8px;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
    }

    .nav-link:hover {
        background: rgba(255,255,255,0.2);
    }

    .nav-link.active {
        background: rgba(255,255,255,0.3);
    }

    .nav-link.logout:hover {
        background: rgba(220,38,38,0.8);
    }

    .dashboard-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
    }

    .welcome-section {
        margin-bottom: 2rem;
    }

    .welcome-section h1 {
        font-size: 2.5rem;
        font-weight: 700;
        color: #111827;
        margin: 0;
    }

    .welcome-section .text-muted {
        color: #6b7280;
        font-size: 1.1rem;
        margin-top: 0.5rem;
    }

    .alert {
        border-radius: 12px;
        padding: 1rem 1.5rem;
        margin-bottom: 2rem;
        border: none;
    }

    .alert-success {
        background-color: #d1fae5;
        color: #065f46;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transition: transform 0.3s;
    }

    .stat-card:hover {
        transform: translateY(-4px);
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        color: white;
    }

    .stat-icon.blue {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
    }

    .stat-icon.green {
        background: linear-gradient(135deg, #10b981, #059669);
    }

    .stat-icon.orange {
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }

    .stat-content h3 {
        font-size: 2rem;
        font-weight: 700;
        margin: 0;
        color: #111827;
    }

    .stat-content p {
        margin: 0;
        color: #6b7280;
        font-size: 0.95rem;
    }

    .content-grid {
        display: grid;
        gap: 2rem;
    }

    .section-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .section-header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .section-header h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: #111827;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .section-content {
        padding: 2rem;
    }

    .property-card {
        background: #f9fafb;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        border: 1px solid #e5e7eb;
    }

    .property-card:last-child {
        margin-bottom: 0;
    }

    .property-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 1rem;
    }

    .property-header h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 0.5rem 0;
    }

    .property-address {
        color: #6b7280;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .property-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .detail-item .label {
        color: #6b7280;
        font-size: 0.875rem;
        font-weight: 500;
    }

    .detail-item .value {
        color: #111827;
        font-weight: 600;
        font-size: 1rem;
    }

    .badge {
        padding: 0.375rem 0.75rem;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 600;
        display: inline-block;
    }

    .badge-success {
        background: #d1fae5;
        color: #065f46;
    }

    .badge-warning {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-info {
        background: #dbeafe;
        color: #1e40af;
    }

    .badge-secondary {
        background: #e5e7eb;
        color: #374151;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .payment-table {
        width: 100%;
        border-collapse: collapse;
    }

    .payment-table thead {
        background: #f9fafb;
    }

    .payment-table th {
        padding: 1rem;
        text-align: left;
        font-weight: 600;
        color: #374151;
        border-bottom: 2px solid #e5e7eb;
    }

    .payment-table td {
        padding: 1rem;
        border-bottom: 1px solid #e5e7eb;
        color: #1f2937;
    }

    .payment-table tbody tr:hover {
        background: #f9fafb;
    }

    .maintenance-card {
        background: #f9fafb;
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1rem;
        border: 1px solid #e5e7eb;
    }

    .maintenance-card:last-child {
        margin-bottom: 0;
    }

    .maintenance-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
