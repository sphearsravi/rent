@using System.Globalization
@using RentCollection.Web.Helpers
@{
    ViewData["Title"] = "Tenant Dashboard";
    Layout = null;
    var _ci = CultureInfo.CurrentUICulture;
    var _rtl = _ci.TextInfo.IsRightToLeft;
    var _lang = _ci.TwoLetterISOLanguageName;
    var _return = Context.Request.Path + Context.Request.QueryString;

    var tenant = ViewBag.Tenant as RentCollection.Core.Entities.Tenant;
    var leases = ViewBag.Leases as List<RentCollection.Core.Entities.Lease> ?? new List<RentCollection.Core.Entities.Lease>();
    var payments = ViewBag.Payments as List<RentCollection.Core.Entities.Payment> ?? new List<RentCollection.Core.Entities.Payment>();
    var maintenanceRequests = ViewBag.MaintenanceRequests as List<RentCollection.Core.Entities.MaintenanceRequest> ?? new List<RentCollection.Core.Entities.MaintenanceRequest>();
    var documents = ViewBag.Documents as List<RentCollection.Core.Entities.Document> ?? new List<RentCollection.Core.Entities.Document>();

    // Account summary (computed in the controller, scoped to the session tenant)
    decimal outstandingTotal = ViewBag.OutstandingTotal ?? 0m;
    int outstandingCount = ViewBag.OutstandingCount ?? 0;
    int overdueCount = ViewBag.OverdueCount ?? 0;
    int? daysUntilNextDue = ViewBag.DaysUntilNextDue as int?;
    int? oldestUnpaidLeaseId = ViewBag.OldestUnpaidLeaseId as int?;
    decimal totalMonthlyRent = ViewBag.TotalMonthlyRent ?? 0m;
    var expiringLease = ViewBag.ExpiringLease as RentCollection.Core.Entities.Lease;
    int? expiringLeaseDays = ViewBag.ExpiringLeaseDays as int?;

    // Kuwait is UTC+3 with no DST — good enough for a greeting and the date eyebrow.
    var kwNow = DateTime.UtcNow.AddHours(3);
    var greetingKey = kwNow.Hour < 12 ? "Good morning" : kwNow.Hour < 17 ? "Good afternoon" : "Good evening";
    var longDate = kwNow.ToString("dddd, d MMMM yyyy", CultureInfo.CurrentCulture);
    var firstName = tenant?.FirstName ?? "";

    var payUrl = oldestUnpaidLeaseId.HasValue
        ? Url.Action("MakePayment", "TenantPortal", new { leaseId = oldestUnpaidLeaseId.Value })
        : Url.Action("MakePayment", "TenantPortal");
}
@functions {
    // Payment status → (pill class, localizer key). Pending bank transfers and
    // gateway-pending payments both read as "Pending Verification" to the tenant.
    private static (string Css, string Key) PaymentPill(string status) => status switch
    {
        "Completed" or "Approved" => ("od-pill-green", "Completed"),
        "Pending" or "PendingVerification" => ("od-pill-amber", "Pending Verification"),
        "Rejected" or "Failed" or "Cancelled" => ("od-pill-red", status),
        _ => ("od-pill-grey", status)
    };

    private static string PaymentIconCss(string status) => status switch
    {
        "Completed" or "Approved" => "od-count-green",
        "Pending" or "PendingVerification" => "od-count-amber",
        "Rejected" or "Failed" or "Cancelled" => "od-count-red",
        _ => "od-count-gold"
    };

    private static string MaintenancePill(string status) => status switch
    {
        "Open" => "od-pill-gold",
        "In Progress" => "od-pill-amber",
        _ => "od-pill-grey"
    };

    // PaymentType enum names → the resource keys the rest of the app already uses.
    private static string PaymentMethodKey(string method) => method switch
    {
        "BankTransfer" => "Bank Transfer",
        _ => method
    };

    private static string Initial(string? text) =>
        string.IsNullOrWhiteSpace(text) ? "?" : text.Trim().Substring(0, 1).ToUpperInvariant();
}

<!DOCTYPE html>
<html lang="@_lang" dir="@(_rtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ALRTAM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/owner-dashboard.css" asp-append-version="true" />
    <style>
        /* Page shell only — every component below comes from owner-dashboard.css (.od-*). */
        body { margin: 0; background: var(--od-bg); color: var(--od-ink); font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; min-height: 100vh; }
        .tp-nav { background: linear-gradient(135deg, var(--od-charcoal), var(--od-gold)); color: #fff; }
        .tp-nav-inner { max-width: 1200px; margin: 0 auto; padding: 12px 16px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
        .tp-brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 18px; color: #fff; text-decoration: none; }
        .tp-nav-menu { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; }
        .tp-nav-menu a { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 12px; border-radius: 10px; color: #fff; text-decoration: none; font-size: 14px; font-weight: 600; }
        .tp-nav-menu a:hover, .tp-nav-menu a.active { background: rgba(255,255,255,0.18); color: #fff; }
        .tp-lang { display: inline-flex; border: 1px solid rgba(255,255,255,0.45); border-radius: 999px; overflow: hidden; margin-inline-start: 8px; }
        .tp-lang button { background: transparent; border: 0; color: #fff; font: inherit; font-size: 13px; font-weight: 700; padding: 6px 12px; cursor: pointer; min-height: 36px; }
        .tp-lang button.active { background: #fff; color: var(--od-gold-ink); }
        .tp-page { max-width: 1200px; margin: 0 auto; padding: 24px 16px 48px; }
        .tp-alert { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: var(--od-radius-sm); font-size: 14px; font-weight: 600; }
        .tp-alert-success { background: var(--od-green-soft); color: var(--od-green); }
        .tp-alert-error { background: var(--od-red-soft); color: var(--od-red); }
        .tp-alert-info { background: var(--od-gold-soft); color: var(--od-gold-ink); }
        .tp-alert button { margin-inline-start: auto; background: transparent; border: 0; color: inherit; font-size: 20px; line-height: 1; cursor: pointer; }
        .tp-ico { width: 20px; height: 20px; flex: none; }
        .tp-ico-sm { width: 16px; height: 16px; flex: none; vertical-align: -3px; }
        .tp-btn-white { background: #fff; color: var(--od-gold-ink); border-color: #fff; }
        .tp-btn-white:hover { background: var(--od-gold-soft); color: var(--od-gold-ink); }
        .od-kpi-hero .od-pill-red { background: var(--od-red); color: #fff; }
        .tp-paid { border-color: var(--od-green-soft); background: linear-gradient(145deg, #fff, var(--od-green-soft)); flex-direction: row; align-items: center; gap: 16px; }
        .tp-paid .od-card-title { color: var(--od-green); font-size: 18px; }
        .tp-actions { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
        .tp-action { flex-direction: column; justify-content: center; text-align: center; gap: 8px; min-height: 96px; text-decoration: none; color: var(--od-ink); border: 1px solid var(--od-line); background: var(--od-surface); cursor: pointer; font: inherit; }
        .tp-action:hover { background: var(--od-gold-soft); color: var(--od-ink); }
        .tp-action .od-tile-icon { width: 44px; height: 44px; border-radius: 12px; }
        .tp-action strong { font-size: 13px; }
        .od-count-grey { background: var(--od-line-soft); color: var(--od-muted); }
        .tp-note-amber { display: flex; align-items: center; gap: 12px; background: var(--od-amber-soft); color: var(--od-amber); border: 1px solid #E7D7A8; text-decoration: none; }
        .tp-note-amber strong { color: var(--od-ink); }
        .tp-note-amber:hover { color: var(--od-amber); }
        .tp-note-text { display: flex; flex-direction: column; min-width: 0; }
        .tp-docs { display: flex; flex-wrap: wrap; gap: 6px 12px; margin-top: 4px; font-size: 12px; }
        .tp-docs a { display: inline-flex; align-items: center; gap: 4px; text-decoration: none; font-weight: 600; }
        .od-row-text .tp-desc { font-size: 13px; color: var(--od-ink); white-space: normal; }
        @@media (max-width: 640px) {
            .tp-nav-menu a span { display: none; }
            .tp-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .od-title { font-size: 26px; }
            .od-row { flex-wrap: wrap; }
            .od-row .od-amount { order: 3; }
        }

        /* Maintenance request modal (existing flow — posts to CreateMaintenanceRequest) */
        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(30,26,17,0.55); z-index: 9999; align-items: center; justify-content: center; padding: 16px; }
        .modal-overlay.is-open { display: flex; }
        .modal-container { background: #fff; border-radius: var(--od-radius); max-width: 560px; width: 100%; max-height: 92vh; overflow-y: auto; box-shadow: var(--od-shadow); }
        .modal-header { padding: 18px 20px; border-bottom: 1px solid var(--od-line); display: flex; justify-content: space-between; align-items: center; }
        .modal-header h3 { margin: 0; font-size: 18px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
        .modal-close { background: none; border: none; font-size: 26px; color: var(--od-muted); cursor: pointer; line-height: 1; width: 36px; height: 36px; border-radius: 8px; }
        .modal-close:hover { background: var(--od-surface-2); color: var(--od-ink); }
        .modal-body { padding: 20px; display: flex; flex-direction: column; gap: 14px; }
        .form-group label { display: block; margin-bottom: 6px; font-weight: 600; font-size: 14px; color: var(--od-ink); }
        .form-control { width: 100%; padding: 10px 12px; border: 1px solid var(--od-line); border-radius: 10px; font: inherit; font-size: 14px; color: var(--od-ink); background: #fff; min-height: 44px; }
        .form-control:focus { outline: none; border-color: var(--od-gold); box-shadow: 0 0 0 3px rgba(138,109,31,0.15); }
        textarea.form-control { resize: vertical; }
        .modal-footer { padding: 16px 20px; border-top: 1px solid var(--od-line); display: flex; justify-content: flex-end; gap: 10px; }
        @@media (max-width: 640px) { .modal-footer { flex-direction: column-reverse; } .modal-footer .od-btn { width: 100%; } }
    </style>
</head>
<body>
    <nav class="tp-nav" aria-label="@(L["ALRTAM Tenant Portal"].Value)">
        <div class="tp-nav-inner">
            <a href="@Url.Action("Dashboard", "TenantPortal")" class="tp-brand">
                <svg class="tp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/><path d="M9 10h.01M15 10h.01M9 14h.01M15 14h.01"/></svg>
                <span>@L["ALRTAM Tenant Portal"]</span>
            </a>
            <div class="tp-nav-menu">
                <a href="@Url.Action("Dashboard", "TenantPortal")" class="active" aria-current="page">
                    <svg class="tp-ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>
                    <span>@L["Dashboard"]</span>
                </a>
                <a href="@Url.Action("MyDetails", "TenantPortal")">
                    <svg class="tp-ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                    <span>@L["My Details"]</span>
                </a>
                <a href="@Url.Action("MakePayment", "TenantPortal")">
                    <svg class="tp-ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
                    <span>@L["Make Payment"]</span>
                </a>
                <a href="@Url.Action("PaymentHistory", "TenantPortal")">
                    <svg class="tp-ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    <span>@L["Payment History"]</span>
                </a>
                <a href="@Url.Action("Logout", "TenantPortal")">
                    <svg class="tp-ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
                    <span>@L["Logout"]</span>
                </a>
                @* Language switcher (EN | ع) — same CultureController.Set endpoint as the back office. *@
                <form class="tp-lang" method="post" action="/Culture/Set" aria-label="@(L["Language"].Value)">
                    <input type="hidden" name="returnUrl" value="@_return" />
                    <button type="submit" name="culture" value="en-US" class="@(_lang == "en" ? "active" : "")" lang="en">EN</button>
                    <button type="submit" name="culture" value="ar-KW" class="@(_lang == "ar" ? "active" : "")" lang="ar">ع</button>
                </form>
            </div>
        </div>
    </nav>

    <main class="tp-page">
        <div class="od">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="tp-alert tp-alert-success" role="status">
                    <svg class="tp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
                    <span>@TempData["SuccessMessage"]</span>
                    <button type="button" onclick="this.parentElement.remove()" aria-label="@(L["Close"].Value)">&times;</button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="tp-alert tp-alert-error" role="alert">
                    <svg class="tp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
                    <span>@TempData["ErrorMessage"]</span>
                    <button type="button" onclick="this.parentElement.remove()" aria-label="@(L["Close"].Value)">&times;</button>
                </div>
            }

            @* 1. Header *@
            <header class="od-header">
                <div>
                    <div class="od-eyebrow">@longDate</div>
                    <h1 class="od-title">@L[greetingKey], @firstName</h1>
                    <div class="od-sub">@L["Here's your rental dashboard"]</div>
                </div>
            </header>

            @* 2. Account summary hero — how much do I owe, when is it due, how do I pay *@
            @if (outstandingCount > 0)
            {
                <section class="od-card od-kpi-hero" aria-labelledby="amount-due-label">
                    <div class="od-kpi-row">
                        <span class="od-kpi-label" id="amount-due-label">@L["Amount due"]</span>
                        @if (overdueCount > 0)
                        {
                            <span class="od-pill od-pill-red">@L["{0} overdue", overdueCount]</span>
                        }
                    </div>
                    <div class="od-kpi-value">@CurrencyHelper.FormatKWD(outstandingTotal)</div>
                    <div class="od-kpi-sub">
                        <svg class="tp-ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                        @if (outstandingCount == 1)
                        {
                            @L["1 invoice to pay"]
                        }
                        else
                        {
                            @L["{0} invoices to pay", outstandingCount]
                        }
                        @if (daysUntilNextDue.HasValue)
                        {
                            var d = daysUntilNextDue.Value;
                            <text> · </text>
                            if (d < -1) { @L["Overdue by {0} days", -d] }
                            else if (d == -1) { @L["Overdue by 1 day"] }
                            else if (d == 0) { @L["Due today"] }
                            else if (d == 1) { @L["Due tomorrow"] }
                            else { @L["Due in {0} days", d] }
                        }
                    </div>
                    <div>
                        <a href="@payUrl" class="od-btn tp-btn-white">
                            <svg class="tp-ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
                            @L["Pay Now"]
                        </a>
                    </div>
                </section>
            }
            else
            {
                <section class="od-card tp-paid" role="status">
                    <div class="od-count od-count-green" aria-hidden="true">
                        <svg class="tp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                    </div>
                    <div>
                        <h2 class="od-card-title">@L["You're all paid up"]</h2>
                        <div class="od-sub">@L["No outstanding invoices — nothing to pay right now."]</div>
                    </div>
                </section>
            }

            @* 3. Quick actions *@
            <section aria-label="@(L["Quick Actions"].Value)">
                <div class="tp-actions">
                    <a href="@payUrl" class="od-tile tp-action">
                        <span class="od-tile-icon od-count-gold" aria-hidden="true">
                            <svg class="tp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
                        </span>
                        <strong>@L["Pay"]</strong>
                    </a>
                    <button type="button" class="od-tile tp-action" onclick="showMaintenanceModal()">
                        <span class="od-tile-icon od-count-amber" aria-hidden="true">
                            <svg class="tp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0 5 5l-9.4 9.4a2 2 0 0 1-2.8-2.8l9.4-9.4z"/><path d="M4 20l1-1"/></svg>
                        </span>
                        <strong>@L["New Request"]</strong>
                    </button>
                    <a href="#leases" class="od-tile tp-action">
                        <span class="od-tile-icon od-count-green" aria-hidden="true">
                            <svg class="tp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/></svg>
                        </span>
                        <strong>@L["My leases"]</strong>
                    </a>
                    <a href="@Url.Action("MyDetails", "TenantPortal")" class="od-tile tp-action">
                        <span class="od-tile-icon od-count-grey" aria-hidden="true">
                            <svg class="tp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                        </span>
                        <strong>@L["My Details"]</strong>
                    </a>
                </div>
            </section>

            @* 4. Lease-expiry nudge *@
            @if (expiringLease != null && expiringLeaseDays.HasValue)
            {
                <a href="#leases" class="od-note tp-note-amber">
                    <svg class="tp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    <span class="tp-note-text">
                        <strong>@L["Lease expires in {0} days", expiringLeaseDays.Value]</strong>
                        <span>@expiringLease.Unit?.Property?.PropertyName @L["Unit"] @expiringLease.Unit?.UnitNumber · @L["Contact office to renew"]</span>
                    </span>
                </a>
            }

            @* 5. Stats *@
            <section class="od-grid-kpi" aria-label="@(L["Dashboard"].Value)">
                <div class="od-card">
                    <span class="od-kpi-label">@L["Active Leases"]</span>
                    <span class="od-kpi-value">@leases.Count</span>
                </div>
                <div class="od-card">
                    <span class="od-kpi-label">@L["Monthly Rent"]</span>
                    <span class="od-kpi-value">@CurrencyHelper.FormatKWD(totalMonthlyRent)</span>
                </div>
                <div class="od-card">
                    <span class="od-kpi-label">@L["Open requests"]</span>
                    <span class="od-kpi-value @(maintenanceRequests.Count > 0 ? "" : "is-green")">@maintenanceRequests.Count</span>
                </div>
            </section>

            @* 6. My properties *@
            <section class="od-card" id="leases" aria-labelledby="leases-title">
                <div class="od-card-head">
                    <h2 class="od-card-title" id="leases-title">@L["My Properties"]</h2>
                    <a href="@payUrl" class="od-btn od-btn-ghost od-btn-sm">@L["Make Payment"]</a>
                </div>
                @if (leases.Any())
                {
                    <div class="od-rows">
                        @foreach (var lease in leases)
                        {
                            var leaseDocuments = documents.Where(d => d.RelatedEntityId == lease.LeaseId).ToList();
                            <div class="od-row">
                                <div class="od-avatar" aria-hidden="true">@Initial(lease.Unit?.Property?.PropertyName)</div>
                                <div class="od-row-text">
                                    <strong>@lease.Unit?.Property?.PropertyName · @L["Unit"] @lease.Unit?.UnitNumber</strong>
                                    <span>@L["Ends {0}", lease.LeaseEndDate.ToString("d MMM yyyy", CultureInfo.CurrentCulture)] · @L["Day"] @lease.PaymentDueDay @L["of each month"]</span>
                                    @if (leaseDocuments.Any())
                                    {
                                        <span class="tp-docs">
                                            @foreach (var doc in leaseDocuments)
                                            {
                                                <a href="@Url.Action("Download", "Documents", new { id = doc.DocumentId })" title="@(L["Download"].Value)">
                                                    <svg class="tp-ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M4 21h16"/></svg>
                                                    @doc.DocumentName
                                                </a>
                                            }
                                        </span>
                                    }
                                </div>
                                <div class="od-amount">@CurrencyHelper.FormatKWD(lease.MonthlyRent)</div>
                                <span class="od-pill od-pill-green">@L[lease.Status]</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="od-empty">@L["No active leases found"]</div>
                }
            </section>

            @* 7. Maintenance requests *@
            <section class="od-card" aria-labelledby="maintenance-title">
                <div class="od-card-head">
                    <h2 class="od-card-title" id="maintenance-title">@L["Maintenance Requests"]</h2>
                    <button type="button" class="od-btn od-btn-primary od-btn-sm" onclick="showMaintenanceModal()">
                        <svg class="tp-ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        @L["New Request"]
                    </button>
                </div>
                @if (maintenanceRequests.Any())
                {
                    <div class="od-rows">
                        @foreach (var request in maintenanceRequests)
                        {
                            <div class="od-row">
                                <div class="od-count od-count-amber" aria-hidden="true">
                                    <svg class="tp-ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0 5 5l-9.4 9.4a2 2 0 0 1-2.8-2.8l9.4-9.4z"/><path d="M4 20l1-1"/></svg>
                                </div>
                                <div class="od-row-text">
                                    <strong>#@request.RequestId · @L[request.Category]</strong>
                                    <span class="tp-desc">@request.Description</span>
                                    <span>@L["Requested on"] @request.RequestDate.ToString("d MMM yyyy", CultureInfo.CurrentCulture) · @L["Priority"]: @L[request.Priority]</span>
                                </div>
                                <span class="od-pill @MaintenancePill(request.Status)">@L[request.Status]</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="od-empty">@L["No pending maintenance requests"]</div>
                }
            </section>

            @* 8. Recent payments *@
            <section class="od-card" aria-labelledby="payments-title">
                <div class="od-card-head">
                    <h2 class="od-card-title" id="payments-title">@L["Recent Payments"]</h2>
                    <a href="@Url.Action("PaymentHistory", "TenantPortal")" class="od-btn od-btn-ghost od-btn-sm">@L["View All"]</a>
                </div>
                @if (payments.Any())
                {
                    <div class="od-tiles">
                        @foreach (var payment in payments)
                        {
                            var pill = PaymentPill(payment.PaymentStatus);
                            var isCompleted = payment.Status == RentCollection.Core.Enums.PaymentStatus.Completed
                                           || payment.Status == RentCollection.Core.Enums.PaymentStatus.Approved;
                            <div class="od-tile">
                                <div class="od-tile-icon @PaymentIconCss(payment.PaymentStatus)" aria-hidden="true">
                                    <svg class="tp-ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v15H6z"/><path d="M14 2v6h6"/><path d="M9 13h6M9 17h6"/></svg>
                                </div>
                                <div class="od-tile-text">
                                    <strong>@CurrencyHelper.FormatKWD(payment.AmountPaid)</strong>
                                    <span>@payment.PaymentDate.ToString("d MMM yyyy", CultureInfo.CurrentCulture) · @payment.Lease?.Unit?.Property?.PropertyName · @L[PaymentMethodKey(payment.PaymentMethod)]</span>
                                    @if (isCompleted)
                                    {
                                        <a class="od-card-link" href="@Url.Action("ViewReceipt", "TenantPortal", new { paymentId = payment.PaymentId })">@L["View Receipt"]</a>
                                    }
                                </div>
                                <span class="od-pill @pill.Css">@L[pill.Key]</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="od-empty">@L["No payments found"]</div>
                }
            </section>
        </div>
    </main>

    <!-- Maintenance Request Modal -->
    <div id="maintenanceModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="maintenanceModalTitle">
        <div class="modal-container">
            <div class="modal-header">
                <h3 id="maintenanceModalTitle">
                    <svg class="tp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0 5 5l-9.4 9.4a2 2 0 0 1-2.8-2.8l9.4-9.4z"/><path d="M4 20l1-1"/></svg>
                    @L["New Maintenance Request"]
                </h3>
                <button type="button" class="modal-close" onclick="closeMaintenanceModal()" aria-label="@(L["Close"].Value)">&times;</button>
            </div>
            <form id="maintenanceForm" method="post" action="@Url.Action("CreateMaintenanceRequest", "TenantPortal")">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group">
                        <label for="propertySelect">@L["Property/Unit"]</label>
                        <select id="propertySelect" name="LeaseId" class="form-control" required>
                            <option value="">@L["Select a property..."]</option>
                            @foreach (var lease in leases)
                            {
                                <option value="@lease.LeaseId">@lease.Unit?.Property?.PropertyName - @L["Unit"] @lease.Unit?.UnitNumber</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="categorySelect">@L["Category"]</label>
                        <select id="categorySelect" name="Category" class="form-control" required>
                            <option value="">@L["Select a category..."]</option>
                            <option value="Plumbing">@L["Plumbing"]</option>
                            <option value="Electrical">@L["Electrical"]</option>
                            <option value="HVAC">@L["HVAC"]</option>
                            <option value="Appliance">@L["Appliance"]</option>
                            <option value="Structural">@L["Structural"]</option>
                            <option value="Other">@L["Other"]</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="prioritySelect">@L["Priority"]</label>
                        <select id="prioritySelect" name="Priority" class="form-control" required>
                            <option value="">@L["Select priority..."]</option>
                            <option value="Low">@L["Low"]</option>
                            <option value="Medium">@L["Medium"]</option>
                            <option value="High">@L["High"]</option>
                            <option value="Emergency">@L["Emergency"]</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="descriptionText">@L["Description"]</label>
                        <textarea id="descriptionText" name="Description" class="form-control" rows="4" placeholder="@(L["Please describe the issue in detail..."].Value)" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="od-btn od-btn-ghost" onclick="closeMaintenanceModal()">@L["Cancel"]</button>
                    <button type="submit" class="od-btn od-btn-primary">@L["Submit Request"]</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function showMaintenanceModal() {
            document.getElementById('maintenanceModal').classList.add('is-open');
            document.getElementById('propertySelect').focus();
        }

        function closeMaintenanceModal() {
            document.getElementById('maintenanceModal').classList.remove('is-open');
            document.getElementById('maintenanceForm').reset();
        }

        // Close modal when clicking outside or pressing Escape
        document.getElementById('maintenanceModal').addEventListener('click', function (e) {
            if (e.target === this) {
                closeMaintenanceModal();
            }
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeMaintenanceModal();
            }
        });
    </script>
</body>
</html>
