@model RentCollection.Core.Entities.Tenant

@{
    ViewData["Title"] = "Delete Tenant";
}

<div class="container-fluid">
    <div class="page-header">
        <div>
            <h1>@L["Delete Tenant"]</h1>
            <p class="text-danger">@L["Are you sure you want to delete this tenant?"]</p>
        </div>
    </div>

    <div class="delete-card">
        <div class="warning-banner">
            <i class="fas fa-exclamation-triangle"></i>
            <div>
                <h3>@L["Warning"]</h3>
                <p>@L["This action cannot be undone. Deleting this tenant will remove all associated data."]</p>
            </div>
        </div>

        <div class="tenant-summary">
            <h3>@L["Tenant Information"]</h3>
            <dl class="summary-list">
                <dt>@L["Full Name"]</dt>
                <dd>@Model.FirstName @Model.LastName</dd>

                <dt>@L["PACI Number"]</dt>
                <dd>@Model.PACINumber</dd>

                <dt>@L["Email"]</dt>
                <dd>@Model.Email</dd>

                <dt>@L["Phone Number"]</dt>
                <dd>@Model.Phone</dd>

                <dt>@L["Date of Birth"]</dt>
                <dd>@Model.DateOfBirth?.ToString("MMMM dd, yyyy")</dd>

                <dt>@L["Company"]</dt>
                <dd>@Model.Company?.CompanyName</dd>

                <dt>@L["Active Leases"]</dt>
                <dd>@(Model.Leases?.Count(l => l.Status == "Active") ?? 0)</dd>

                <dt>@L["Total Leases"]</dt>
                <dd>@(Model.Leases?.Count ?? 0)</dd>

                <dt>@L["Status"]</dt>
                <dd>
                    @if (Model.Status == "Active")
                    {
                        <span class="badge badge-success">@L["Active"]</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">@L["Inactive"]</span>
                    }
                </dd>
            </dl>
        </div>

        @if (Model.Leases != null && Model.Leases.Any(l => l.Status == "Active"))
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i>
                <strong>@L["Active Leases Detected!"]</strong>
                @L["This tenant has active leases. Consider terminating or transferring leases before deletion."]
            </div>
        }

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="TenantId" />
            <div class="form-actions">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> @L["Confirm Delete"]
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times"></i> @L["Cancel"]
                </a>
                <a asp-action="Details" asp-route-id="@Model.TenantId" class="btn btn-info">
                    <i class="fas fa-info-circle"></i> @L["View Details"]
                </a>
            </div>
        </form>
    </div>
</div>

<style>
    body {
        background: linear-gradient(135deg, #f8fafc 0%, #f2e8c8 50%, #e6d4a0 100%);
        color: #1e293b;
        min-height: 100vh;
    }

    .container-fluid {
        background: linear-gradient(135deg, #f8fafc 0%, #f2e8c8 50%, #e6d4a0 100%);
        min-height: 100vh;
        padding: 2rem;
    }

    .delete-card {
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid rgba(138, 109, 31, 0.2);
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        max-width: 800px;
    }

    .warning-banner {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
        padding: 1.5rem;
        border-radius: 8px;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .warning-banner i {
        font-size: 2rem;
        flex-shrink: 0;
    }

    .warning-banner h3 {
        margin: 0 0 0.5rem 0;
        font-size: 1.25rem;
        font-weight: 600;
    }

    .warning-banner p {
        margin: 0;
        opacity: 0.95;
    }

    .tenant-summary {
        margin-bottom: 2rem;
    }

    .tenant-summary h3 {
        font-size: 1.25rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #8a6d1f;
    }

    .summary-list {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 1rem 2rem;
        margin: 0;
    }

    .summary-list dt {
        font-weight: 600;
        color: #475569;
    }

    .summary-list dd {
        margin: 0;
        color: #1e293b;
    }

    .badge {
        padding: 0.375rem 0.75rem;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
    }

    .badge-success {
        background: #dcfce7;
        color: #166534;
    }

    .badge-danger {
        background: #fee2e2;
        color: #991b1b;
    }

    .alert {
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .alert-danger {
        background-color: #fee2e2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }

    .alert i {
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid #e2e8f0;
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 500;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-danger {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
    }

    .btn-danger:hover {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    }

    .btn-secondary {
        background: #6b7280;
        color: white;
    }

    .btn-secondary:hover {
        background: #4b5563;
    }

    .btn-info {
        background: linear-gradient(135deg, #8a6d1f 0%, #b8860b 100%);
        color: white;
    }

    .btn-info:hover {
        background: linear-gradient(135deg, #b8860b 0%, #8a6d1f 100%);
    }

    .page-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e2e8f0;
    }

    .page-header h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #334155;
        margin: 0 0 0.5rem 0;
    }

    .page-header .text-danger {
        color: #dc2626;
        margin: 0;
        font-size: 1rem;
    }

    /* Scrollbar styles */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #f1f5f9;
    }

    ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    @@media (max-width: 768px) {
        .delete-card {
            padding: 1rem;
        }

        .summary-list {
            grid-template-columns: 1fr;
            gap: 0.5rem;
        }

        .summary-list dt {
            margin-top: 1rem;
        }

        .form-actions {
            flex-direction: column;
        }
    }
</style>
