@model RentCollection.Core.Entities.Tenant
@using RentCollection.Core.Entities
@using RentCollection.Core.Enums
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var fullName = $"{Model.FirstName} {Model.LastName}".Trim();
    if (fullName.Length == 0) { fullName = L["Tenant"].Value; }
    ViewData["Title"] = fullName;

    var leases = (Model.Leases ?? new List<Lease>()).ToList();
    var liveLeases = leases.Where(l => l.Status == LeaseStatuses.Active || l.Status == LeaseStatuses.Pending).OrderByDescending(l => l.LeaseStartDate).ToList();
    var pastLeases = leases.Where(l => !(l.Status == LeaseStatuses.Active || l.Status == LeaseStatuses.Pending)).OrderByDescending(l => l.LeaseStartDate).ToList();
    var activeLeases = leases.Where(l => l.Status == LeaseStatuses.Active).ToList();
    var monthlyRent = activeLeases.Sum(l => l.MonthlyRent);

    var tenantDocuments = ViewBag.TenantDocuments as List<Document> ?? new List<Document>();
    var leaseDocuments = ViewBag.LeaseDocuments as List<Document> ?? new List<Document>();
    var openInvoices = ViewBag.OpenInvoices as List<Invoice> ?? new List<Invoice>();
    var outstandingByLease = ViewBag.OutstandingByLease as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
    decimal outstanding = ViewBag.Outstanding ?? 0m;
    DateTime? lastPaymentDate = ViewBag.LastPaymentDate as DateTime?;
    decimal? lastPaymentAmount = ViewBag.LastPaymentAmount as decimal?;
    var openCase = ViewBag.OpenCase as LegalCase;

    DateTime? tenureStart = leases.Count > 0 ? leases.Min(l => l.LeaseStartDate) : (DateTime?)null;
    var tenureMonths = tenureStart.HasValue
        ? Math.Max(0, (DateTime.Today.Year - tenureStart.Value.Year) * 12 + DateTime.Today.Month - tenureStart.Value.Month - (DateTime.Today.Day < tenureStart.Value.Day ? 1 : 0))
        : 0;

    var recentPayments = leases
        .SelectMany(l => l.Payments ?? new List<Payment>())
        .Where(p => p.Status == PaymentStatus.Completed)
        .OrderByDescending(p => p.PaymentDate).ThenByDescending(p => p.PaymentId)
        .Take(10)
        .ToList();

    string LeaseChip(string status) => status switch
    {
        LeaseStatuses.Active => "lp-chip-green",
        LeaseStatuses.Pending => "lp-chip-amber",
        LeaseStatuses.Expired => "lp-chip-red",
        LeaseStatuses.Renewed => "lp-chip-blue",
        _ => "lp-chip-grey",
    };
    string DocIcon(string? type) => (type ?? "").ToLowerInvariant() switch
    {
        "pdf" => "fa-file-pdf",
        "image" or "jpg" or "jpeg" or "png" => "fa-file-image",
        "word" or "doc" or "docx" => "fa-file-word",
        "excel" or "xls" or "xlsx" => "fa-file-excel",
        "id" or "passport" or "civilid" => "fa-id-card",
        "contract" or "agreement" or "lease" => "fa-file-signature",
        _ => "fa-file",
    };

    var statusIsActive = Model.Status == "Active";
    var subtitle = string.Join(" · ", new[] {
        string.IsNullOrWhiteSpace(Model.PACINumber) ? null : $"{L["Civil ID"].Value} {Model.PACINumber}",
        string.IsNullOrWhiteSpace(Model.Phone) ? null : Model.Phone,
        string.IsNullOrWhiteSpace(Model.Email) ? null : Model.Email,
        string.IsNullOrWhiteSpace(Model.Status) ? null : L[Model.Status!].Value,
    }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var initials = string.Concat(new[] { Model.FirstName, Model.LastName }.Where(s => !string.IsNullOrEmpty(s)).Select(s => s![0])).ToUpperInvariant();
    if (initials.Length == 0) { initials = "T"; }
}

<div class="lp-page">
    @await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData)
    {
        ["Title"] = fullName,
        ["Subtitle"] = subtitle,
        ["Crumbs"] = new (string label, string? href)[] { (L["Admin"].Value, "/Dashboard"), (L["Tenants"].Value, "/Tenants"), (fullName, null) },
        ["ActionsHtml"] = Html.Raw(
            "<a class=\"lp-btn\" href=\"/Tenants/Statement/" + Model.TenantId + "\"><i class=\"fas fa-file-pdf\"></i> " + L["Statement PDF"].Value + "</a>" +
            "<a class=\"lp-btn\" href=\"/CashPayment/Record?tenantId=" + Model.TenantId + "\"><i class=\"fas fa-money-bill\"></i> " + L["Record cash"].Value + "</a>" +
            "<a class=\"lp-btn\" href=\"/Leases/Create?tenantId=" + Model.TenantId + "\"><i class=\"fas fa-file-signature\"></i> " + L["New lease"].Value + "</a>" +
            "<a class=\"lp-btn lp-btn-primary\" href=\"/Tenants/Edit/" + Model.TenantId + "\"><i class=\"fas fa-pen\"></i> " + L["Edit"].Value + "</a>")
    })

    @await Html.PartialAsync("_AlertMessages")

    @* ── KPI strip ── *@
    <div class="od od-grid-kpi lp-kpi-5">
        <a class="od-card od-card-link od-kpi-hero" href="/Invoices?tenantId=@Model.TenantId">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Outstanding"]</span></div>
            <div class="od-kpi-value @(outstanding > 0 ? "od-count-red" : "")">@outstanding.ToString("N3", inv) <small>KWD</small></div>
            <div class="od-kpi-sub">@(openInvoices.Count == 0 ? L["No unpaid invoices"].Value : openInvoices.Count == 1 ? L["1 open invoice"].Value : $"{openInvoices.Count} {L["open invoices"].Value}")</div>
        </a>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Monthly rent"]</span></div>
            <div class="od-kpi-value">@monthlyRent.ToString("N3", inv) <small>KWD</small></div>
            <div class="od-kpi-sub">@(activeLeases.Count == 1 ? L["1 active lease"].Value : $"{activeLeases.Count} {L["active leases"].Value}")</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Last payment"]</span></div>
            @if (lastPaymentDate.HasValue)
            {
                <div class="od-kpi-value">@((lastPaymentAmount ?? 0m).ToString("N3", inv)) <small>KWD</small></div>
                <div class="od-kpi-sub">@lastPaymentDate.Value.ToString("dd MMM yyyy", inv)</div>
            }
            else
            {
                <div class="od-kpi-value">—</div>
                <div class="od-kpi-sub">@L["No payments yet"]</div>
            }
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Tenure"]</span></div>
            @if (tenureStart.HasValue)
            {
                <div class="od-kpi-value">@tenureMonths <small>@L["months"]</small></div>
                <div class="od-kpi-sub">@L["since"] @tenureStart.Value.ToString("dd MMM yyyy", inv)</div>
            }
            else
            {
                <div class="od-kpi-value">—</div>
                <div class="od-kpi-sub">@L["No leases yet"]</div>
            }
        </div>
        @if (openCase != null)
        {
            <a class="od-card od-card-link" href="/Leases/Details/@openCase.LeaseId#legal-case">
                <div class="od-kpi-row"><span class="od-kpi-label">@L["Legal case"]</span></div>
                <div class="od-kpi-value @(openCase.IsOpen ? "od-count-red" : "")">@(openCase.IsOpen ? L["Open"].Value : L["Closed"].Value)</div>
                <div class="od-kpi-sub">@L[openCase.Status] · @openCase.FiledDate.ToString("dd MMM yyyy", inv)</div>
            </a>
        }
        else
        {
            <div class="od-card">
                <div class="od-kpi-row"><span class="od-kpi-label">@L["Legal case"]</span></div>
                <div class="od-kpi-value">@L["None"]</div>
                <div class="od-kpi-sub">@L["No legal case on file"]</div>
            </div>
        }
    </div>

    <div class="pd-grid">
        <div class="pd-main">

            @* ── Leases ── *@
            <section class="lp-table-wrap pd-section">
                <div class="pd-section-head">
                    <h2><i class="fas fa-file-contract"></i> @L["Leases"] <span class="lp-chip lp-chip-gold">@leases.Count</span></h2>
                    <div class="lp-row-actions">
                        <a class="lp-btn lp-btn-primary" href="/Leases/Create?tenantId=@Model.TenantId"><i class="fas fa-file-signature"></i> @L["New lease"]</a>
                    </div>
                </div>
                @if (leases.Count == 0)
                {
                    <div class="lp-empty" style="border:0"><i class="fas fa-file-contract"></i><h3>@L["No leases yet"]</h3><p><a href="/Leases/Create?tenantId=@Model.TenantId">@L["Create the first lease"]</a></p></div>
                }
                else
                {
                    <table class="lp-table">
                        <thead>
                            <tr>
                                <th>@L["Property · unit"]</th>
                                <th>@L["Lease period"]</th>
                                <th class="lp-num">@L["Rent (KWD)"]</th>
                                <th class="lp-num">@L["Deposit (KWD)"]</th>
                                <th>@L["Status"]</th>
                                <th class="lp-num">@L["Outstanding (KWD)"]</th>
                                <th class="lp-right">@L["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lease in liveLeases.Concat(pastLeases))
                            {
                                var isLive = lease.Status == LeaseStatuses.Active || lease.Status == LeaseStatuses.Pending;
                                var daysLeft = (lease.LeaseEndDate.Date - DateTime.Today).Days;
                                var has = outstandingByLease.TryGetValue(lease.LeaseId, out var bal) && bal > 0;
                                <tr class="@(isLive ? "" : "is-muted")">
                                    <td data-label="@L["Property · unit"]">
                                        @if (lease.Unit?.Property != null)
                                        {
                                            <a class="lp-link lp-primary" href="/Properties/Details/@lease.Unit.Property.PropertyId">@lease.Unit.Property.PropertyName</a>
                                        }
                                        else
                                        {
                                            <span class="lp-primary">—</span>
                                        }
                                        @if (lease.Unit != null)
                                        {
                                            <span class="lp-sub"><a class="lp-link" href="/Units/Details/@lease.Unit.UnitId">@L["Unit"] @lease.Unit.UnitNumber</a></span>
                                        }
                                    </td>
                                    <td data-label="@L["Lease period"]" style="white-space:nowrap;font-size:0.82rem">
                                        <span>@lease.LeaseStartDate.ToString("dd MMM yyyy", inv) → @lease.LeaseEndDate.ToString("dd MMM yyyy", inv)</span>
                                        <span class="lp-sub">
                                            @L["Due day"] @lease.PaymentDueDay
                                            @if (isLive && daysLeft < 0) { <span class="lp-chip lp-chip-red">@L["past end"]</span> }
                                            else if (isLive && daysLeft <= 30) { <span class="lp-chip lp-chip-amber">@daysLeft @L["days"]</span> }
                                        </span>
                                    </td>
                                    <td class="lp-num" data-label="@L["Rent (KWD)"]"><span class="lp-amount">@lease.MonthlyRent.ToString("N3", inv)</span></td>
                                    <td class="lp-num" data-label="@L["Deposit (KWD)"]">
                                        <span class="@(lease.SecurityDeposit > 0 ? "lp-amount" : "lp-amount-muted")">@lease.SecurityDeposit.ToString("N3", inv)</span>
                                        @if (lease.DepositRefunded) { <span class="lp-sub">@L["Refunded"]</span> }
                                    </td>
                                    <td data-label="@L["Status"]"><span class="lp-chip @LeaseChip(lease.Status)">@L[lease.Status]</span></td>
                                    <td class="lp-num" data-label="@L["Outstanding (KWD)"]">
                                        @if (has) { <span class="lp-amount lp-amount-bad">@bal.ToString("N3", inv)</span> }
                                        else { <span class="lp-amount-muted">0.000</span> }
                                    </td>
                                    <td class="lp-right" data-label="@L["Actions"]">
                                        <div class="lp-row-actions">
                                            <a class="lp-icon-btn" title="@(L["View lease"].Value)" href="/Leases/Details/@lease.LeaseId"><i class="fas fa-eye"></i></a>
                                            <a class="lp-icon-btn" title="@(L["Edit"].Value)" href="/Leases/Edit/@lease.LeaseId"><i class="fas fa-pen"></i></a>
                                            @if (isLive) { <a class="lp-icon-btn" title="@(L["Pay"].Value)" href="/CashPayment/Record?tenantId=@Model.TenantId"><i class="fas fa-money-bill"></i></a> }
                                            <a class="lp-icon-btn" title="@(L["Legal case"].Value)" href="/Leases/Details/@lease.LeaseId#legal-case"><i class="fas fa-scale-balanced"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>

            @* ── Open invoices ── *@
            <section class="lp-table-wrap pd-section">
                <div class="pd-section-head">
                    <h2><i class="fas fa-file-invoice-dollar"></i> @L["Open invoices"] <span class="lp-chip @(openInvoices.Count > 0 ? "lp-chip-red" : "lp-chip-gold")">@openInvoices.Count</span></h2>
                    <div class="lp-row-actions">
                        @if (openInvoices.Count > 0) { <a class="lp-btn lp-btn-primary" href="/CashPayment/Record?tenantId=@Model.TenantId"><i class="fas fa-money-bill"></i> @L["Record cash"]</a> }
                    </div>
                </div>
                @if (openInvoices.Count == 0)
                {
                    <div class="lp-empty" style="border:0"><i class="fas fa-circle-check"></i><h3>@L["No open invoices"]</h3><p>@L["Everything billed to this tenant has been paid."]</p></div>
                }
                else
                {
                    <table class="lp-table">
                        <thead>
                            <tr>
                                <th>@L["Invoice"]</th>
                                <th>@L["Type"]</th>
                                <th>@L["Period"]</th>
                                <th>@L["Due date"]</th>
                                <th class="lp-num">@L["Total (KWD)"]</th>
                                <th class="lp-num">@L["Paid (KWD)"]</th>
                                <th class="lp-num">@L["Balance (KWD)"]</th>
                                <th class="lp-right">@L["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in openInvoices)
                            {
                                var overdue = (DateTime.Today - i.DueDate.Date).Days;
                                var balance = i.TotalAmount - i.PaidAmount;
                                <tr>
                                    <td data-label="@L["Invoice"]"><a class="lp-link lp-primary lp-mono" href="/Invoices/Details/@i.InvoiceId">INV-@i.InvoiceId.ToString("D6", inv)</a></td>
                                    <td data-label="@L["Type"]">@L[i.InvoiceType]</td>
                                    <td data-label="@L["Period"]">@i.InvoiceDate.ToString("MMM yyyy", inv)</td>
                                    <td data-label="@L["Due date"]" style="white-space:nowrap">
                                        <span>@i.DueDate.ToString("dd MMM yyyy", inv)</span>
                                        @if (overdue > 0) { <span class="lp-chip lp-chip-red">@overdue @L["days overdue"]</span> }
                                        else if (overdue == 0) { <span class="lp-chip lp-chip-amber">@L["due today"]</span> }
                                        else { <span class="lp-chip lp-chip-grey">@L["due in"] @(-overdue) @L["days"]</span> }
                                    </td>
                                    <td class="lp-num" data-label="@L["Total (KWD)"]"><span class="lp-amount">@i.TotalAmount.ToString("N3", inv)</span></td>
                                    <td class="lp-num" data-label="@L["Paid (KWD)"]"><span class="@(i.PaidAmount > 0 ? "lp-amount lp-amount-good" : "lp-amount-muted")">@i.PaidAmount.ToString("N3", inv)</span></td>
                                    <td class="lp-num" data-label="@L["Balance (KWD)"]"><span class="lp-amount lp-amount-bad">@balance.ToString("N3", inv)</span></td>
                                    <td class="lp-right" data-label="@L["Actions"]">
                                        <div class="lp-row-actions">
                                            <a class="lp-icon-btn" title="@(L["View invoice"].Value)" href="/Invoices/Details/@i.InvoiceId"><i class="fas fa-eye"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>

            @* ── Recent payments ── *@
            <section class="lp-table-wrap pd-section">
                <div class="pd-section-head">
                    <h2><i class="fas fa-receipt"></i> @L["Recent payments"] <span class="lp-chip lp-chip-gold">@recentPayments.Count</span></h2>
                    <div class="lp-row-actions">
                        @if (!string.IsNullOrWhiteSpace(Model.PACINumber)) { <a class="lp-btn" href="/Payments?civilId=@Model.PACINumber"><i class="fas fa-list"></i> @L["All payments"]</a> }
                    </div>
                </div>
                @if (recentPayments.Count == 0)
                {
                    <div class="lp-empty" style="border:0"><i class="fas fa-receipt"></i><h3>@L["No payments yet"]</h3><p>@L["Completed payments on this tenant's leases will appear here."]</p></div>
                }
                else
                {
                    <table class="lp-table">
                        <thead>
                            <tr>
                                <th>@L["Date"]</th>
                                <th>@L["Method"]</th>
                                <th>@L["Reference"]</th>
                                <th class="lp-num">@L["Amount (KWD)"]</th>
                                <th>@L["Status"]</th>
                                <th class="lp-right">@L["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in recentPayments)
                            {
                                var reference = p.ReceiptNumber ?? p.TransactionReference;
                                <tr>
                                    <td data-label="@L["Date"]" style="white-space:nowrap">@p.PaymentDate.ToString("dd MMM yyyy", inv)</td>
                                    <td data-label="@L["Method"]">@L[p.PaymentType.ToString()]</td>
                                    <td data-label="@L["Reference"]">@if (string.IsNullOrWhiteSpace(reference)) { <span class="lp-amount-muted">—</span> } else { <span class="lp-mono">@reference</span> }</td>
                                    <td class="lp-num" data-label="@L["Amount (KWD)"]"><span class="lp-amount lp-amount-good">@p.AmountPaid.ToString("N3", inv)</span></td>
                                    <td data-label="@L["Status"]"><span class="lp-chip lp-chip-green">@L[p.Status.ToString()]</span></td>
                                    <td class="lp-right" data-label="@L["Actions"]">
                                        <div class="lp-row-actions">
                                            <a class="lp-icon-btn" title="@(L["View payment"].Value)" href="/Payments/Details/@p.PaymentId"><i class="fas fa-eye"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        </div>

        <aside class="pd-side">
            <div class="pd-card">
                <div class="pd-card-head"><i class="fas fa-user"></i> @L["Personal"]</div>
                <div class="pd-hero" style="padding:0.75rem 0.9rem 0.25rem">
                    <span class="lp-avatar">@initials</span>
                    <div>
                        <div class="lp-primary">@fullName</div>
                        <span class="lp-sub"><span class="lp-chip @(statusIsActive ? "lp-chip-green" : "lp-chip-grey")">@L[string.IsNullOrWhiteSpace(Model.Status) ? "Inactive" : Model.Status!]</span></span>
                    </div>
                </div>
                <dl class="pd-dl">
                    <div><dt>@L["Date of Birth"]</dt><dd>@(Model.DateOfBirth?.ToString("dd MMM yyyy", inv) ?? "—")</dd></div>
                    <div><dt>@L["Civil ID"]</dt><dd class="lp-mono">@(string.IsNullOrWhiteSpace(Model.PACINumber) ? "—" : Model.PACINumber)</dd></div>
                    <div><dt>@L["Government ID"]</dt><dd class="lp-mono">@(string.IsNullOrWhiteSpace(Model.GovernmentId) ? "—" : Model.GovernmentId)</dd></div>
                    <div><dt>@L["Employment"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.EmploymentStatus) ? "—" : L[Model.EmploymentStatus!].Value)</dd></div>
                    <div><dt>@L["Created"]</dt><dd>@Model.CreatedDate.ToString("dd MMM yyyy", inv)</dd></div>
                </dl>
            </div>

            <div class="pd-card">
                <div class="pd-card-head"><i class="fas fa-address-book"></i> @L["Contact"]</div>
                <dl class="pd-dl">
                    <div><dt>@L["Phone"]</dt><dd>@if (string.IsNullOrWhiteSpace(Model.Phone)) { <span class="lp-amount-muted">—</span> } else { <a class="lp-link" href="tel:@Model.Phone">@Model.Phone</a> }</dd></div>
                    <div><dt>@L["Email"]</dt><dd>@if (string.IsNullOrWhiteSpace(Model.Email)) { <span class="lp-chip lp-chip-amber">@L["No email"]</span> } else { <a class="lp-link lp-trunc" style="max-width:180px" href="mailto:@Model.Email">@Model.Email</a> }</dd></div>
                    <div><dt>@L["Emergency Contact"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.EmergencyContact) ? "—" : Model.EmergencyContact)</dd></div>
                    <div><dt>@L["Emergency Phone"]</dt><dd>@if (string.IsNullOrWhiteSpace(Model.EmergencyPhone)) { <span class="lp-amount-muted">—</span> } else { <a class="lp-link" href="tel:@Model.EmergencyPhone">@Model.EmergencyPhone</a> }</dd></div>
                </dl>
            </div>

            <div class="pd-card">
                <div class="pd-card-head"><i class="fas fa-building"></i> @L["Company"]</div>
                <dl class="pd-dl">
                    <div><dt>@L["Company Name"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.Company?.CompanyName) ? "—" : Model.Company!.CompanyName)</dd></div>
                    <div><dt>@L["Company Email"]</dt><dd>@if (string.IsNullOrWhiteSpace(Model.Company?.Email)) { <span class="lp-amount-muted">—</span> } else { <a class="lp-link lp-trunc" style="max-width:180px" href="mailto:@Model.Company!.Email">@Model.Company.Email</a> }</dd></div>
                </dl>
            </div>

            @* Documents — same hrefs as before (upload / download / view). *@
            <div class="pd-card">
                <div class="pd-card-head">
                    <i class="fas fa-folder-open"></i> @L["Documents"]
                    <span class="lp-chip lp-chip-gold">@(tenantDocuments.Count + leaseDocuments.Count)</span>
                    <a class="lp-btn td-doc-upload" href="/Documents/Upload?entityType=Tenant&entityId=@Model.TenantId"><i class="fas fa-upload"></i> @L["Upload"]</a>
                </div>
                @if (tenantDocuments.Count == 0 && leaseDocuments.Count == 0)
                {
                    <div class="lp-empty" style="border:0;padding:1.5rem 1rem"><i class="fas fa-folder-open"></i><h3>@L["No documents uploaded for this tenant"]</h3><p><a href="/Documents/Upload?entityType=Tenant&entityId=@Model.TenantId">@L["Upload First Document"]</a></p></div>
                }
                else
                {
                    @if (tenantDocuments.Count > 0)
                    {
                        <div class="td-doc-group">@L["Tenant Documents"]</div>
                        @foreach (var doc in tenantDocuments)
                        {
                            <div class="td-doc">
                                <i class="fas @DocIcon(doc.DocumentType) td-doc-ico"></i>
                                <div>
                                    <a class="lp-link lp-primary lp-trunc" href="/Documents/Download/@doc.DocumentId">@doc.DocumentName</a>
                                    <span class="lp-sub">@doc.DocumentType · @doc.UploadedDate.ToString("dd MMM yyyy", inv)</span>
                                </div>
                                <div class="lp-row-actions">
                                    <a class="lp-icon-btn" title="@(L["Download"].Value)" href="/Documents/Download/@doc.DocumentId"><i class="fas fa-download"></i></a>
                                    <a class="lp-icon-btn" title="@(L["View"].Value)" href="/Documents/Download/@doc.DocumentId" target="_blank"><i class="fas fa-eye"></i></a>
                                </div>
                            </div>
                        }
                    }
                    @if (leaseDocuments.Count > 0)
                    {
                        <div class="td-doc-group">@L["Lease Documents"]</div>
                        @foreach (var doc in leaseDocuments)
                        {
                            <div class="td-doc">
                                <i class="fas @DocIcon(doc.DocumentType) td-doc-ico"></i>
                                <div>
                                    <a class="lp-link lp-primary lp-trunc" href="/Documents/Download/@doc.DocumentId">@doc.DocumentName</a>
                                    <span class="lp-sub">@doc.DocumentType · @doc.UploadedDate.ToString("dd MMM yyyy", inv)</span>
                                </div>
                                <div class="lp-row-actions">
                                    <a class="lp-icon-btn" title="@(L["Download"].Value)" href="/Documents/Download/@doc.DocumentId"><i class="fas fa-download"></i></a>
                                    <a class="lp-icon-btn" title="@(L["View"].Value)" href="/Documents/Download/@doc.DocumentId" target="_blank"><i class="fas fa-eye"></i></a>
                                </div>
                            </div>
                        }
                    }
                }
            </div>
        </aside>
    </div>
</div>

