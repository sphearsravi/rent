@model List<RentCollection.Core.Entities.Tenant>
@using RentCollection.Core.Entities
@{
    ViewData["Title"] = "Tenants";
    var includeArchived = ViewBag.IncludeArchived as bool? ?? false;
    var caseByTenant = ViewBag.CaseByTenant as Dictionary<int, LegalCase> ?? new Dictionary<int, LegalCase>();
    var leasesByTenant = ViewBag.LeasesByTenant as Dictionary<int, List<RentCollection.Web.Controllers.TenantsController.TenantLeaseRow>>
                         ?? new Dictionary<int, List<RentCollection.Web.Controllers.TenantsController.TenantLeaseRow>>();
    string? errorMessage = ViewBag.ErrorMessage as string;

    string Initials(Tenant t)
    {
        var a = string.IsNullOrEmpty(t.FirstName) ? "" : t.FirstName.Trim()[..1];
        var b = string.IsNullOrEmpty(t.LastName) ? "" : t.LastName.Trim()[..1];
        var s = (a + b).ToUpperInvariant();
        return s.Length == 0 ? "T" : s;
    }
    var noEmailCount = Model.Count(t => string.IsNullOrWhiteSpace(t.Email));
}

<div class="lp-page" data-lp-scope>
    @await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData)
    {
        ["Title"] = L["Tenants"].Value,
        ["Subtitle"] = string.Format(L["{0} tenants — who lives where, what they owe, when their lease ends"].Value, Model.Count),
        ["Crumbs"] = new (string label, string? href)[] { (L["Admin"].Value, "/Dashboard"), (L["Tenants"].Value, null) },
        ["ActionsHtml"] = Html.Raw(
            "<a class=\"lp-btn\" href=\"/Tenants/Import\"><i class=\"fas fa-file-import\"></i> " + L["Import"].Value + "</a>" +
            "<a class=\"lp-btn lp-btn-export\" href=\"/Tenants/ExportExcel\"><i class=\"fas fa-file-excel\"></i> " + L["Export"].Value + "</a>" +
            "<a class=\"lp-btn lp-btn-primary\" href=\"/Tenants/Create\"><i class=\"fas fa-user-plus\"></i> " + L["Add Tenant"].Value + "</a>")
    })

    @await Html.PartialAsync("_AlertMessages")
    @Html.AntiForgeryToken()
    @if (!string.IsNullOrEmpty(errorMessage)) { <div class="alert alert-danger">@errorMessage</div> }

    @* ── KPI strip (Snapshot) ── *@
    <div class="od od-grid-kpi lp-kpi-5" id="tenantStrip" aria-live="polite">
        <div class="od-card od-kpi-hero">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["In arrears"]</span></div>
            <div class="od-kpi-value lp-skel" data-k="arrearsTenants">&nbsp;</div>
            <div class="od-kpi-sub">@L["tenants with an unpaid balance"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Tenants"]</span></div>
            <div class="od-kpi-value lp-skel" data-k="totalTenants">&nbsp;</div>
            <div class="od-kpi-sub"><span data-k="activeTenants">—</span> @L["active"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["With active leases"]</span></div>
            <div class="od-kpi-value lp-skel" data-k="withActiveLeases">&nbsp;</div>
            <div class="od-kpi-sub">@L["currently leased"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Avg tenure"]</span></div>
            <div class="od-kpi-value lp-skel" data-k="avgTenureMonths">&nbsp;</div>
            <div class="od-kpi-sub">@L["months on file"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Missing email"]</span></div>
            <div class="od-kpi-value @(noEmailCount > 0 ? "od-count-amber" : "")">@noEmailCount</div>
            <div class="od-kpi-sub">@L["cannot receive invoice emails"]</div>
        </div>
    </div>

    @* ── Toolbar ── *@
    <div class="lp-toolbar">
        <div class="lp-toolbar-row">
            <label class="lp-search">
                <i class="fas fa-search"></i>
                <input type="search" data-lp-search placeholder="@(L["Name, Civil ID, phone, email, property or unit…"].Value)" />
            </label>
            <span class="lp-result-count" data-lp-count data-all="@(L["Showing all {0} tenants"].Value)" data-some="@(L["Showing {0} of {1} tenants"].Value)"></span>
            <div class="lp-toolbar-spacer"></div>
            <a class="lp-btn @(includeArchived ? "is-on" : "")" href="/Tenants?includeArchived=@(includeArchived ? "false" : "true")">
                <i class="fas fa-box-archive"></i> @(includeArchived ? L["Hide archived"] : L["Show archived"])
            </a>
        </div>
        <div class="lp-toolbar-row">
            <div class="lp-chips" data-lp-filter="flag">
                <span class="lp-chips-label">@L["Show"]</span>
                <button type="button" class="lp-chip-btn is-on" data-value="">@L["All"]</button>
                <button type="button" class="lp-chip-btn" data-value="arrears"><i class="fas fa-triangle-exclamation"></i> @L["In arrears"]</button>
                <button type="button" class="lp-chip-btn" data-value="expiring"><i class="fas fa-hourglass-half"></i> @L["Lease ends ≤ 30 days"]</button>
                <button type="button" class="lp-chip-btn" data-value="nolease"><i class="fas fa-door-open"></i> @L["No active lease"]</button>
                <button type="button" class="lp-chip-btn" data-value="noemail"><i class="fas fa-envelope-open"></i> @L["No email"]</button>
                <button type="button" class="lp-chip-btn" data-value="legal"><i class="fas fa-scale-balanced"></i> @L["Legal case"]</button>
            </div>
            <div class="lp-chips" data-lp-filter="status">
                <span class="lp-chips-label">@L["Status"]</span>
                <button type="button" class="lp-chip-btn is-on" data-value="">@L["All"]</button>
                <button type="button" class="lp-chip-btn" data-value="Active">@L["Active"]</button>
                <button type="button" class="lp-chip-btn" data-value="Inactive">@L["Inactive"]</button>
                @if (includeArchived) { <button type="button" class="lp-chip-btn" data-value="Archived">@L["Archived"]</button> }
            </div>
        </div>
    </div>

    @* ── Bulk action bar (appears when rows are ticked) ── *@
    <div id="bulkBar" class="lp-toolbar" hidden style="margin-top:-0.5rem;background:#2E2614;color:#C9A647;border-color:#2E2614">
        <div class="lp-toolbar-row">
            <strong><span id="bulkCount">0</span> @L["selected"]</strong>
            <div class="lp-toolbar-spacer"></div>
            <button type="button" class="lp-btn" data-bulk="status" data-status="Active"><i class="fas fa-check"></i> @L["Set Active"]</button>
            <button type="button" class="lp-btn" data-bulk="status" data-status="Inactive"><i class="fas fa-ban"></i> @L["Set Inactive"]</button>
            <button type="button" class="lp-btn lp-btn-danger" data-bulk="archive"><i class="fas fa-box-archive"></i> @L["Archive"]</button>
            <button type="button" class="lp-btn" id="bulkClear">@L["Clear"]</button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="lp-empty">
            <i class="fas fa-users"></i>
            <h3>@L["No tenants yet"]</h3>
            <p><a href="/Tenants/Create">@L["Add your first tenant"]</a> · <a href="/Tenants/Import">@L["or import from Excel"]</a></p>
        </div>
    }
    else
    {
        <div class="lp-table-wrap">
            <table class="lp-table" id="tenantTable">
                <thead>
                    <tr>
                        <th style="width:32px"><input type="checkbox" id="selectAll" aria-label="@(L["Select all"].Value)" /></th>
                        <th data-sort="name">@L["Tenant"]</th>
                        <th data-sort="where">@L["Property · unit"]</th>
                        <th data-sort="end">@L["Lease ends"]</th>
                        <th class="lp-num" data-sort="rent">@L["Rent (KWD)"]</th>
                        <th class="lp-num" data-sort="out">@L["Outstanding (KWD)"]</th>
                        <th data-sort="status">@L["Status"]</th>
                        <th class="lp-right">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        var leases = leasesByTenant.TryGetValue(t.TenantId, out var ls) ? ls : new List<RentCollection.Web.Controllers.TenantsController.TenantLeaseRow>();
                        var first = leases.FirstOrDefault();
                        var rent = leases.Sum(l => l.MonthlyRent);
                        var end = leases.Count > 0 ? leases.Min(l => l.LeaseEndDate) : (DateTime?)null;
                        var daysLeft = end.HasValue ? (end.Value.Date - DateTime.Today).Days : (int?)null;
                        var legal = caseByTenant.TryGetValue(t.TenantId, out var lc) ? lc : null;
                        var status = t.IsDeleted ? "Archived" : (t.Status ?? "Active");
                        var flags = new List<string>();
                        if (leases.Count == 0) flags.Add("nolease");
                        if (daysLeft.HasValue && daysLeft <= 30) flags.Add("expiring");
                        if (string.IsNullOrWhiteSpace(t.Email)) flags.Add("noemail");
                        if (legal != null) flags.Add("legal");
                        var search = $"{t.FirstName} {t.LastName} {t.PACINumber} {t.GovernmentId} {t.Phone} {t.Email} {string.Join(" ", leases.Select(l => l.PropertyName + " " + l.UnitNumber))}".ToLowerInvariant();

                        <tr class="@(t.IsDeleted ? "is-muted" : "")" data-tenant-id="@t.TenantId" data-search="@search" data-flag="@string.Join(" ", flags)" data-status="@status"
                            data-sort-name="@t.FirstName @t.LastName" data-sort-where="@(first?.PropertyName) @(first?.UnitNumber)" data-sort-end="@(end?.ToString("yyyy-MM-dd") ?? "9999")"
                            data-sort-rent="@rent" data-sort-out="0" data-sort-last="" data-sort-status="@status">
                            <td><input type="checkbox" class="row-check" value="@t.TenantId" aria-label="@(L["Select"].Value)" /></td>
                            <td data-label="@L["Tenant"]">
                                @* No nested anchors: the name is the link, contact icons are siblings. *@
                                <div class="lp-cell-person">
                                    <a class="lp-avatar" href="/Tenants/Details/@t.TenantId" style="text-decoration:none">@Initials(t)</a>
                                    <div>
                                        <a class="lp-primary lp-trunc lp-link" style="max-width:210px" href="/Tenants/Details/@t.TenantId">@t.FirstName @t.LastName</a>
                                        <span class="lp-sub">
                                            <span class="lp-mono">@(string.IsNullOrWhiteSpace(t.PACINumber) ? L["No Civil ID"].Value : t.PACINumber)</span>
                                            <span class="lp-inline-contact">
                                                @if (!string.IsNullOrWhiteSpace(t.Phone)) { <a href="tel:@t.Phone" title="@t.Phone"><i class="fas fa-phone"></i></a> }
                                                @if (!string.IsNullOrWhiteSpace(t.Email)) { <a href="mailto:@t.Email" title="@t.Email"><i class="fas fa-envelope"></i></a> }
                                                else { <span title="@(L["No email on file"].Value)" style="color:#d97706;font-size:0.75rem"><i class="fas fa-envelope-open"></i></span> }
                                            </span>
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td data-label="@L["Property · unit"]">
                                @if (first != null)
                                {
                                    <a class="lp-link lp-primary" href="/Leases/Details/@first.LeaseId"><span class="lp-trunc" style="max-width:190px">@first.PropertyName</span> · @L["Unit"] @first.UnitNumber</a>
                                    @if (first.Status == "Pending") { <span class="lp-chip lp-chip-amber">@L["Pending"]</span> }
                                    @if (leases.Count > 1) { <span class="lp-sub">+@(leases.Count - 1) @L["more lease(s)"]</span> }
                                }
                                else { <span class="lp-amount-muted">@L["No active lease"]</span> }
                            </td>
                            <td data-label="@L["Lease ends"]">
                                @if (end.HasValue)
                                {
                                    <span>@end.Value.ToString("dd MMM yyyy")</span>
                                    @if (daysLeft < 0) { <span class="lp-chip lp-chip-red">@L["past end"]</span> }
                                    else if (daysLeft <= 30) { <span class="lp-chip lp-chip-amber">@daysLeft @L["days"]</span> }
                                }
                                else { <span class="lp-amount-muted">—</span> }
                            </td>
                            <td class="lp-num" data-label="@L["Rent (KWD)"]">
                                @if (rent > 0) { <span class="lp-amount">@rent.ToString("N3", System.Globalization.CultureInfo.InvariantCulture)</span> } else { <span class="lp-amount-muted">—</span> }
                            </td>
                            <td class="lp-num" data-label="@L["Outstanding (KWD)"]"><span class="lp-amount lp-skel" data-kpi="outstanding">&nbsp;</span><span class="lp-sub" data-kpi="oldest"></span></td>
                            <td data-label="@L["Status"]">
                                <span class="lp-dot" data-kpi="health" title="@(L["Payment health"].Value)"></span>
                                <span class="lp-chip @(status == "Active" ? "lp-chip-green" : status == "Archived" ? "lp-chip-grey" : "lp-chip-red")">@L[status]</span>
                                @if (legal != null)
                                {
                                    <a href="/Leases/Details/@legal.LeaseId#legal-case" class="lp-chip @(legal.IsOpen ? "lp-chip-amber" : "lp-chip-grey")" title="@(L["Legal Case"].Value): @legal.Status"><i class="fas fa-scale-balanced"></i> @L[legal.Status]</a>
                                }
                            </td>
                            <td class="lp-right" data-label="@L["Actions"]">
                                <div class="kebab-wrap">
                                    <button type="button" class="kebab-btn" aria-haspopup="menu" aria-expanded="false" aria-label="@(L["More actions"].Value)"><i class="fas fa-ellipsis-vertical"></i></button>
                                    <div class="kebab-menu" role="menu" hidden>
                                        <a href="/Tenants/Details/@t.TenantId" role="menuitem"><i class="fas fa-eye"></i> @L["View"]</a>
                                        <a href="/Tenants/Edit/@t.TenantId" role="menuitem"><i class="fas fa-pen"></i> @L["Edit"]</a>
                                        <a href="/Tenants/Statement/@t.TenantId" role="menuitem"><i class="fas fa-file-pdf"></i> @L["Statement PDF"]</a>
                                        <div class="kebab-sep"></div>
                                        <a href="/Invoices?tenantId=@t.TenantId" role="menuitem"><i class="fas fa-file-invoice-dollar"></i> @L["Invoices"]</a>
                                        <a href="/CashPayment/Record?tenantId=@t.TenantId" role="menuitem"><i class="fas fa-money-bill"></i> @L["Record payment"]</a>
                                        <a href="/Leases/Create?tenantId=@t.TenantId" role="menuitem"><i class="fas fa-file-signature"></i> @L["New lease"]</a>
                                        <div class="kebab-sep"></div>
                                        @if (t.IsDeleted)
                                        {
                                            <button type="button" role="menuitem" data-post="/Tenants/Restore/@t.TenantId"><i class="fas fa-rotate-left"></i> @L["Restore"]</button>
                                        }
                                        else
                                        {
                                            <button type="button" role="menuitem" data-post="/Tenants/ResendLogin/@t.TenantId"><i class="fas fa-key"></i> @L["Resend app login"]</button>
                                            <button type="button" role="menuitem" data-post="/Tenants/ToggleStatus/@t.TenantId"><i class="fas fa-toggle-on"></i> @(status == "Active" ? L["Set Inactive"] : L["Set Active"])</button>
                                            <a href="/Tenants/Delete/@t.TenantId" role="menuitem" class="danger-item"><i class="fas fa-box-archive"></i> @L["Archive"]</a>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="lp-empty" data-lp-empty hidden>
            <i class="fas fa-search"></i>
            <h3>@L["No tenants match your search"]</h3>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const scope = document.querySelector('[data-lp-scope]');

            // KPI strip
            (async function () {
                try {
                    const res = await fetch('/Tenants/Snapshot', { credentials: 'same-origin' });
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    const d = await res.json();
                    document.querySelectorAll('#tenantStrip [data-k]').forEach(el => {
                        const v = d[el.dataset.k]; if (v === undefined) return;
                        el.classList.remove('lp-skel');
                        el.textContent = el.dataset.k === 'avgTenureMonths' ? Number(v).toFixed(1) : Math.round(v).toLocaleString("en-US");
                    });
                } catch (e) { document.querySelectorAll('#tenantStrip .lp-skel').forEach(el => { el.classList.remove('lp-skel'); el.textContent = '—'; }); }
            })();

            // Per-row collection figures
            (async function () {
                const rows = Array.from(document.querySelectorAll('tr[data-tenant-id]'));
                const ids = rows.map(r => r.dataset.tenantId);
                const fail = () => document.querySelectorAll('tr .lp-skel').forEach(el => { el.classList.remove('lp-skel'); el.textContent = '—'; });
                if (!ids.length) return;
                try {
                    const res = await fetch('/Tenants/KpiBatch?ids=' + ids.join(','), { credentials: 'same-origin' });
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    const byId = new Map((await res.json()).map(r => [String(r.tenantId), r]));
                    rows.forEach(row => {
                        const r = byId.get(row.dataset.tenantId); if (!r) return;
                        const out = Number(r.outstanding || 0);
                        const o = row.querySelector('[data-kpi="outstanding"]');
                        o.classList.remove('lp-skel'); o.textContent = out > 0 ? out.toLocaleString('en-US', { minimumFractionDigits: 3 }) : '0.000';
                        o.classList.add(out > 0 ? 'lp-amount-bad' : 'lp-amount-muted');
                        // Sub-line: how old the oldest unpaid invoice is, else when they last paid.
                        const oldest = row.querySelector('[data-kpi="oldest"]');
                        if (out > 0 && r.oldestDueDate) {
                            const days = Math.floor((Date.now() - new Date(r.oldestDueDate)) / 86400000);
                            oldest.textContent = days > 0 ? days + ' d overdue' : 'due today';
                            oldest.style.color = days > 30 ? '#b91c1c' : '';
                        } else {
                            oldest.textContent = r.lastPaymentDate ? 'last paid ' + LP.shortDate(r.lastPaymentDate) : 'no payments yet';
                        }
                        const dot = row.querySelector('[data-kpi="health"]');
                        dot.className = 'lp-dot ' + (out <= 0 ? 'lp-dot-green' : r.health === 'bad' ? 'lp-dot-red' : 'lp-dot-amber');
                        row.dataset.sortOut = out; row.dataset.sortLast = r.lastPaymentDate || '';
                        if (out > 0) row.dataset.flag = (row.dataset.flag + ' arrears').trim();
                    });
                    LP.refresh(scope);
                } catch (e) { fail(); }
            })();

            // POST actions from the kebab (resend login / toggle status / restore)
            document.addEventListener('click', e => {
                const b = e.target.closest('button[data-post]'); if (!b) return;
                const f = document.createElement('form'); f.method = 'post'; f.action = b.dataset.post;
                f.innerHTML = '<input type="hidden" name="__RequestVerificationToken" value="' + token + '">';
                document.body.appendChild(f); f.submit();
            });

            // Bulk selection
            const bar = document.getElementById('bulkBar'), count = document.getElementById('bulkCount');
            const checks = () => Array.from(document.querySelectorAll('.row-check'));
            const selected = () => checks().filter(c => c.checked && !c.closest('tr').hidden).map(c => c.value);
            const sync = () => { const n = selected().length; count.textContent = n; bar.hidden = n === 0; };
            document.getElementById('selectAll')?.addEventListener('change', e => { checks().forEach(c => { if (!c.closest('tr').hidden) c.checked = e.target.checked; }); sync(); });
            document.addEventListener('change', e => { if (e.target.classList.contains('row-check')) sync(); });
            document.getElementById('bulkClear')?.addEventListener('click', () => { checks().forEach(c => c.checked = false); sync(); });
            document.querySelectorAll('[data-bulk]').forEach(btn => btn.addEventListener('click', () => {
                const ids = selected(); if (!ids.length) return;
                const archive = btn.dataset.bulk === 'archive';
                if (archive && !confirm(ids.length + ' tenant(s) will be archived. Continue?')) return;
                const f = document.createElement('form'); f.method = 'post';
                f.action = archive ? '/Tenants/BulkArchive' : '/Tenants/BulkUpdateStatus';
                let html = '<input type="hidden" name="__RequestVerificationToken" value="' + token + '">';
                ids.forEach(id => html += '<input type="hidden" name="ids" value="' + id + '">');
                if (!archive) html += '<input type="hidden" name="status" value="' + btn.dataset.status + '">';
                f.innerHTML = html; document.body.appendChild(f); f.submit();
            }));
        })();
    </script>
}
