@{
    // Rendered on the page the admin lands on right after creating a tenant that
    // has no email. Shows the login credentials in a persistent, copyable box —
    // it is the ONLY time the temp password is shown, so it must not auto-dismiss.
    var cred = TempData["NewTenantCredential"] as string;
}
@if (!string.IsNullOrEmpty(cred))
{
    var parts = cred.Split('|');
    var civilId = parts.Length > 0 ? parts[0] : "";
    var pwd = parts.Length > 1 ? parts[1] : "";

    <div class="alert alert-warning" role="alert" id="newTenantCredential"
         style="margin-bottom:1.25rem; border-left:4px solid #f59e0b;">
        <div style="display:flex; align-items:flex-start; gap:0.6rem;">
            <i class="fas fa-key" style="margin-top:0.2rem;"></i>
            <div style="flex:1;">
                <strong>@L["New tenant login"]</strong> — @L["give these to the tenant. Shown once only."]
                <div style="margin-top:0.5rem; display:flex; gap:1.5rem; flex-wrap:wrap; align-items:center;">
                    <span>@L["Civil ID:"] <code id="ntCivilId">@civilId</code></span>
                    <span>@L["Temp password:"] <code id="ntPwd">@pwd</code></span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="ntCopyBtn">
                        <i class="fas fa-copy"></i> @L["Copy"]
                    </button>
                </div>
                <div style="margin-top:0.35rem; font-size:0.8rem; color:#92400e;">
                    @L["The tenant enters the Civil ID + this password in the app, then sets their own password."]
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var btn = document.getElementById('ntCopyBtn');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var text = 'Civil ID: @civilId\nTemp password: @pwd';
                navigator.clipboard.writeText(text).then(function () {
                    btn.innerHTML = '<i class="fas fa-check"></i> Copied';
                    setTimeout(function () { btn.innerHTML = '<i class="fas fa-copy"></i> Copy'; }, 2000);
                });
            });
        })();
    </script>
}
