@model RentCollection.Core.Entities.Unit
@using RentCollection.Core.Enums
@using RentCollection.Core.Entities
@{
    ViewData["Title"] = $"Unit {Model.UnitNumber}";
    var leases = ViewBag.Leases as List<RentCollection.Core.Entities.Lease> ?? new();
    var maintenance = ViewBag.MaintenanceRequests as List<RentCollection.Core.Entities.MaintenanceRequest> ?? new();
    var active = leases.FirstOrDefault(l => l.Status == LeaseStatuses.Active);
    var lifetimeTenants = leases.Where(l => l.Tenant != null)
        .Select(l => l.Tenant!.TenantId).Distinct().Count();
    var totalMonthsOccupied = leases
        .Where(l => l.LeaseEndDate > l.LeaseStartDate)
        .Sum(l => ((l.TerminationDate ?? l.LeaseEndDate) - l.LeaseStartDate).TotalDays / 30.0);
}

<div class="page-container">
    @await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData)
    {
        ["Title"] = $"Unit {Model.UnitNumber}",
        ["Subtitle"] = $"{Model.Property?.PropertyName} · {Model.Status}",
        ["Crumbs"] = new (string label, string? href)[]
        {
            (L["Admin"].Value, "/Dashboard"),
            (L["Properties"].Value, "/Properties"),
            (Model.Property?.PropertyName ?? L["Property"].Value, $"/Properties/Details/{Model.PropertyId}"),
            ($"Unit {Model.UnitNumber}", null),
        }
    })

    @await Html.PartialAsync("_AlertMessages")
    @Html.AntiForgeryToken()

    <div class="unit-actions">
        <a asp-action="Edit" asp-route-id="@Model.UnitId" class="btn btn-primary">
            <i class="fas fa-pen"></i> @L["Edit unit"]
        </a>
        <a asp-action="History" asp-route-id="@Model.UnitId" class="btn btn-secondary">
            <i class="fas fa-clock-rotate-left"></i> @L["Full history"]
        </a>
        @if (Model.Status != "Occupied")
        {
            <div class="status-control">
                <span>@L["Hold:"]</span>
                <select id="statusSelect" data-current="@Model.Status">
                    @foreach (var s in UnitStatuses.All)
                    {
                        if (s == Model.Status)
                        {
                            <option value="@s" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
            </div>
        }
    </div>

    @* ── KPI strip ── *@
    <div class="unit-strip">
        <div class="kpi-card"><div class="kpi-icon ki-tenants"><i class="fas fa-users"></i></div>
            <div class="kpi-body"><div class="kpi-label">@L["Lifetime tenants"]</div><div class="kpi-value">@lifetimeTenants</div></div></div>
        <div class="kpi-card"><div class="kpi-icon ki-months"><i class="fas fa-calendar"></i></div>
            <div class="kpi-body"><div class="kpi-label">@L["Months occupied"]</div><div class="kpi-value">@Math.Round(totalMonthsOccupied, 0)</div></div></div>
        <div class="kpi-card"><div class="kpi-icon ki-leases"><i class="fas fa-file-contract"></i></div>
            <div class="kpi-body"><div class="kpi-label">@L["Total leases"]</div><div class="kpi-value">@leases.Count</div></div></div>
        <div class="kpi-card"><div class="kpi-icon ki-rent"><i class="fas fa-coins"></i></div>
            <div class="kpi-body"><div class="kpi-label">@L["Current rent"]</div><div class="kpi-value">@Model.MonthlyRent.ToString("N3") <small>KWD</small></div></div></div>
    </div>

    <div class="unit-grid">
        <div class="card">
            <div class="card-head"><h2><i class="fas fa-cube"></i> @L["Specs"]</h2></div>
            <div class="card-body">
                <div class="spec-row"><span>@L["Type"]</span><strong>@Model.UnitType</strong></div>
                <div class="spec-row"><span>@L["Size band"]</span><strong>@(string.IsNullOrEmpty(Model.SizeBand) ? "—" : Model.SizeBand)</strong></div>
                <div class="spec-row"><span>@L["Floor"]</span><strong>@(Model.FloorNumber.HasValue ? Model.FloorNumber.ToString() : "—")</strong></div>
                <div class="spec-row"><span>@L["Bedrooms"]</span><strong>@(Model.Bedrooms ?? 0)</strong></div>
                <div class="spec-row"><span>@L["Bathrooms"]</span><strong>@(Model.Bathrooms ?? 0)</strong></div>
                <div class="spec-row"><span>@L["Square feet"]</span><strong>@(Model.SquareFeet ?? 0)</strong></div>
                <div class="spec-row"><span>@L["Status"]</span>
                    <strong class="status-pill status-@Model.Status.ToLowerInvariant()">@Model.Status</strong>
                </div>
                @if (Model.Status != "Occupied" && Model.AvailableFromDate.HasValue)
                {
                    <div class="spec-row"><span>@L["Available from"]</span><strong>@Model.AvailableFromDate.Value.ToString("dd MMM yyyy")</strong></div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-head"><h2><i class="fas fa-user"></i> @L["Current tenant"]</h2></div>
            <div class="card-body">
                @if (active?.Tenant != null)
                {
                    <div class="tenant-row">
                        <div>
                            <strong><a href="/Tenants/Details/@active.Tenant.TenantId">@active.Tenant.FirstName @active.Tenant.LastName</a></strong>
                            <div class="tenant-meta">
                                @active.Tenant.Phone @(string.IsNullOrEmpty(active.Tenant.Email) ? "" : "· " + active.Tenant.Email)
                            </div>
                        </div>
                    </div>
                    <div class="tenant-lease">
                        <a href="/Leases/Details/@active.LeaseId">@L["Lease #"]@active.LeaseId</a>
                        · @active.LeaseStartDate.ToString("dd MMM yyyy") → @active.LeaseEndDate.ToString("dd MMM yyyy")
                        · @active.MonthlyRent.ToString("N3") @L["KWD/mo"]
                    </div>
                }
                else
                {
                    <p class="muted">@L["No active lease. The unit is currently"] <strong>@Model.Status</strong>.</p>
                    @if (Model.Status == "Vacant")
                    {
                        <a class="btn btn-secondary" href="/Leases/Create?unitId=@Model.UnitId">
                            <i class="fas fa-file-signature"></i> @L["Open new lease"]
                        </a>
                    }
                }
            </div>
        </div>
    </div>

    @* ── Past tenants strip (next-most-recent first) ── *@
    @if (leases.Count > (active != null ? 1 : 0))
    {
        <div class="card" style="margin-top:1rem;">
            <div class="card-head">
                <h2><i class="fas fa-clock-rotate-left"></i> @L["Recent past tenants"]</h2>
                <a asp-action="History" asp-route-id="@Model.UnitId" class="btn-link">@L["Full history"] →</a>
            </div>
            <div class="card-body">
                <table class="lease-table">
                    <thead>
                        <tr><th>@L["Tenant"]</th><th>@L["Period"]</th><th>@L["Status"]</th><th>@L["Rent"]</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var l in leases.Where(x => x.Status != LeaseStatuses.Active).Take(5))
                        {
                            <tr>
                                <td>
                                    @if (l.Tenant != null)
                                    {
                                        <a href="/Tenants/Details/@l.Tenant.TenantId">@l.Tenant.FirstName @l.Tenant.LastName</a>
                                    }
                                    else { <span class="muted">—</span> }
                                </td>
                                <td>@l.LeaseStartDate.ToString("MMM yyyy") → @((l.TerminationDate ?? l.LeaseEndDate).ToString("MMM yyyy"))</td>
                                <td><span class="lease-status lease-@l.Status.ToLowerInvariant()">@l.Status</span></td>
                                <td>@l.MonthlyRent.ToString("N3") KWD</td>
                                <td><a class="btn-link" href="/Leases/Details/@l.LeaseId">@L["Open"]</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (maintenance.Any())
    {
        <div class="card" style="margin-top:1rem;">
            <div class="card-head"><h2><i class="fas fa-screwdriver-wrench"></i> @L["Recent maintenance"]</h2></div>
            <div class="card-body">
                <ul style="list-style:none; padding:0; margin:0;">
                    @foreach (var m in maintenance)
                    {
                        <li style="display:flex; gap:0.7rem; padding:0.55rem 0; border-bottom:1px dashed #f1f5f9; font-size:0.88rem;">
                            <i class="fas fa-wrench" style="color:#94a3b8;"></i>
                            <div style="flex:1;">
                                <strong>@m.Category</strong>
                                <span class="muted"> · @m.RequestDate.ToString("dd MMM yyyy")</span>
                                <div class="muted">@m.Description</div>
                            </div>
                            <span class="lease-status lease-@m.Status.ToLowerInvariant()">@m.Status</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>

<style>
    .page-container { padding: 1.5rem 2rem; max-width: 1200px; margin: 0 auto; }
    .unit-actions {
        display: flex; gap: 0.5rem; align-items: center;
        margin-bottom: 1rem; flex-wrap: wrap;
    }
    .btn {
        display: inline-flex; align-items: center; gap: 0.4rem;
        padding: 0.55rem 1rem; border-radius: 8px;
        text-decoration: none; font-weight: 500; font-size: 0.85rem;
        border: 0; cursor: pointer;
    }
    .btn-primary { background: linear-gradient(135deg,#6366f1,#8b5cf6); color: white; }
    .btn-secondary { background: #f1f5f9; color: #334155; border: 1px solid #e2e8f0; }
    .status-control {
        display: inline-flex; align-items: center; gap: 0.4rem; margin-left: auto;
        font-size: 0.85rem; color: #475569;
    }
    .status-control select {
        padding: 0.45rem 0.7rem; border: 1px solid #e2e8f0; border-radius: 6px;
        background: white; font-size: 0.85rem;
    }

    .unit-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.85rem; margin-bottom: 1rem; }
    @@media (max-width: 900px) { .unit-strip { grid-template-columns: repeat(2, 1fr); } }
    .unit-strip .kpi-card {
        display: flex; align-items: center; gap: 0.65rem;
        padding: 0.85rem 1rem; background: white;
        border: 1px solid #e2e8f0; border-radius: 12px;
    }
    .kpi-icon { width: 34px; height: 34px; border-radius: 9px; display: flex; align-items: center; justify-content: center; color: white;
        background: linear-gradient(135deg,#6366f1,#8b5cf6); }
    .ki-tenants { background: linear-gradient(135deg,#3b82f6,#06b6d4) !important; }
    .ki-months  { background: linear-gradient(135deg,#10b981,#22c55e) !important; }
    .ki-leases  { background: linear-gradient(135deg,#a855f7,#d946ef) !important; }
    .ki-rent    { background: linear-gradient(135deg,#f59e0b,#f97316) !important; }
    .kpi-label { font-size: 0.65rem; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.4px; }
    .kpi-value { font-size: 1.2rem; font-weight: 700; color: #0f172a; line-height: 1.1; }
    .kpi-value small { font-size: 0.65rem; color: #94a3b8; font-weight: 500; }

    .unit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @@media (max-width: 800px) { .unit-grid { grid-template-columns: 1fr; } }
    .card { background: white; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
    .card-head {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.85rem 1.1rem; border-bottom: 1px solid #f1f5f9;
        background: linear-gradient(135deg, rgba(99,102,241,0.03), rgba(139,92,246,0.03));
    }
    .card-head h2 { font-size: 1rem; margin: 0; color: #334155; display: flex; align-items: center; gap: 0.5rem; }
    .card-head h2 i { color: #6366f1; }
    .card-body { padding: 1rem 1.15rem; }
    .spec-row { display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #f1f5f9; font-size: 0.88rem; }
    .spec-row:last-child { border-bottom: 0; }
    .spec-row span { color: #64748b; }
    .spec-row strong { color: #0f172a; }
    .status-pill { padding: 0.15rem 0.55rem; border-radius: 999px; font-size: 0.7rem; }
    .status-vacant      { background: rgba(16,185,129,0.15); color: #065f46; }
    .status-occupied    { background: rgba(59,130,246,0.15); color: #1e40af; }
    .status-maintenance { background: rgba(245,158,11,0.15); color: #92400e; }
    .status-reserved    { background: rgba(168,85,247,0.15); color: #6b21a8; }

    .tenant-row strong a { color: #0f172a; text-decoration: none; font-size: 1rem; }
    .tenant-row strong a:hover { color: #6366f1; }
    .tenant-meta { color: #64748b; font-size: 0.82rem; margin-top: 0.2rem; }
    .tenant-lease { color: #475569; font-size: 0.85rem; margin-top: 0.6rem; padding-top: 0.6rem; border-top: 1px dashed #f1f5f9; }
    .tenant-lease a { color: #6366f1; text-decoration: none; }

    .lease-table { width: 100%; border-collapse: collapse; }
    .lease-table thead th {
        font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em;
        color: #64748b; background: #f8fafc; padding: 0.55rem 0.7rem; text-align: left;
    }
    .lease-table tbody td { padding: 0.55rem 0.7rem; border-bottom: 1px solid #f1f5f9; font-size: 0.85rem; }
    .lease-status { padding: 0.1rem 0.5rem; border-radius: 999px; font-size: 0.7rem; font-weight: 700; }
    .lease-active     { background: rgba(16,185,129,0.15); color: #065f46; }
    .lease-renewed    { background: rgba(99,102,241,0.15); color: #4338ca; }
    .lease-terminated { background: rgba(239,68,68,0.12); color: #991b1b; }
    .lease-expired    { background: rgba(245,158,11,0.15); color: #92400e; }
    .lease-pending    { background: #f1f5f9; color: #475569; }
    .lease-resolved   { background: rgba(16,185,129,0.15); color: #065f46; }
    .lease-open       { background: rgba(245,158,11,0.18); color: #92400e; }
    .btn-link { color: #6366f1; text-decoration: none; font-size: 0.82rem; font-weight: 500; }
    .btn-link:hover { text-decoration: underline; }
    .muted { color: #94a3b8; }
</style>

@section Scripts {
    <script>
        // Inline status change (Maintenance / Reserved holds). Auto-managed
        // states (Vacant / Occupied) get refused server-side if the unit has
        // an active lease, so the operator can't accidentally hide a tenanted
        // unit.
        const sel = document.getElementById('statusSelect');
        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        if (sel && token) {
            sel.addEventListener('change', async () => {
                const previous = sel.dataset.current;
                const next = sel.value;
                if (previous === next) return;
                if (!confirm(`Change unit status from ${previous} to ${next}?`)) {
                    sel.value = previous;
                    return;
                }
                sel.disabled = true;
                try {
                    const fd = new FormData();
                    fd.set('id', '@Model.UnitId');
                    fd.set('newStatus', next);
                    fd.set('__RequestVerificationToken', token.value);
                    const res = await fetch('/Units/ChangeStatus', { method: 'POST', body: fd, credentials: 'same-origin' });
                    const json = await res.json();
                    if (!res.ok || !json.success) {
                        alert(json.error ?? `Status change failed (${res.status})`);
                        sel.value = previous;
                    } else {
                        sel.dataset.current = next;
                        location.reload();
                    }
                } catch (e) {
                    alert('Status change failed: ' + e.message);
                    sel.value = previous;
                } finally {
                    sel.disabled = false;
                }
            });
        }
    </script>
}
