@model RentCollection.Core.Entities.Unit
@using RentCollection.Core.Enums
@using RentCollection.Core.Entities
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var unitTitle = $"{L["Unit"].Value} {Model.UnitNumber}";
    ViewData["Title"] = unitTitle;

    var leases = (ViewBag.Leases as List<Lease> ?? new())
        .OrderByDescending(l => l.LeaseStartDate).ThenByDescending(l => l.LeaseId).ToList();
    var maintenance = ViewBag.MaintenanceRequests as List<MaintenanceRequest> ?? new();

    var active = leases.FirstOrDefault(l => l.Status == LeaseStatuses.Active);
    var pending = leases.FirstOrDefault(l => l.Status == LeaseStatuses.Pending);
    var current = active ?? pending;                 // what the "Current tenant" card shows
    var hasLiveLease = current != null;               // gates "New lease"
    // A Vacant unit with a Pending (deposit-awaiting) lease is shown as Reserved.
    var isPendingHold = Model.Status == UnitStatuses.Vacant && active == null && pending != null;
    var displayStatus = isPendingHold ? UnitStatuses.Reserved : Model.Status;

    var lifetimeTenants = leases.Where(l => l.Tenant != null)
        .Select(l => l.Tenant!.TenantId).Distinct().Count();
    var totalMonthsOccupied = leases
        .Where(l => l.LeaseEndDate > l.LeaseStartDate)
        .Sum(l => ((l.TerminationDate ?? l.LeaseEndDate) - l.LeaseStartDate).TotalDays / 30.0);

    var property = Model.Property;
    var propertyName = property?.PropertyName ?? L["Property"].Value;
    var propertyHref = $"/Properties/Details/{Model.PropertyId}";

    string Chip(string status) => status switch
    {
        "Occupied" => "lp-chip-blue", "Vacant" => "lp-chip-green", "Maintenance" => "lp-chip-amber", "Reserved" => "lp-chip-purple", _ => "lp-chip-grey",
    };
    string LeaseChip(string status) => status switch
    {
        LeaseStatuses.Active => "lp-chip-green", LeaseStatuses.Pending => "lp-chip-amber", LeaseStatuses.Renewed => "lp-chip-gold",
        LeaseStatuses.Terminated => "lp-chip-red", LeaseStatuses.Expired => "lp-chip-grey", _ => "lp-chip-grey",
    };
    string MaintChip(string status) => status switch
    {
        "Open" => "lp-chip-amber", "InProgress" => "lp-chip-blue", "In Progress" => "lp-chip-blue", "Assigned" => "lp-chip-blue",
        "Completed" => "lp-chip-green", "Resolved" => "lp-chip-green", "Cancelled" => "lp-chip-grey", _ => "lp-chip-grey",
    };
    static string Initials(Tenant t) =>
        string.Concat(new[] { t.FirstName, t.LastName }.Where(s => !string.IsNullOrEmpty(s)).Select(s => s![0])).ToUpperInvariant();

    var subtitle = string.Join(" · ", new[] {
        property?.PropertyName,
        string.IsNullOrWhiteSpace(Model.UnitType) ? null : L[Model.UnitType].Value,
        string.IsNullOrWhiteSpace(Model.FloorNumber) ? null : $"{L["Floor"].Value} {Model.FloorNumber}",
        string.IsNullOrWhiteSpace(Model.SizeBand) ? null : L[Model.SizeBand].Value,
        L[displayStatus].Value,
    }.Where(s => !string.IsNullOrWhiteSpace(s)));

    var address = property == null ? "" : string.Join(", ", new[] {
        string.IsNullOrWhiteSpace(property.BuildingNumber) ? null : $"{L["Building"].Value} {property.BuildingNumber}",
        string.IsNullOrWhiteSpace(property.Street) ? null : $"{L["Street"].Value} {property.Street}",
        string.IsNullOrWhiteSpace(property.Block) ? null : $"{L["Block"].Value} {property.Block}",
        string.IsNullOrWhiteSpace(property.Area) ? null : property.Area,
        string.IsNullOrWhiteSpace(property.Governorate) ? null : property.Governorate,
    }.Where(s => !string.IsNullOrWhiteSpace(s)));

    var actions =
        "<a class=\"lp-btn\" href=\"/Units/History/" + Model.UnitId + "\"><i class=\"fas fa-clock-rotate-left\"></i> " + L["Full history"].Value + "</a>" +
        (!hasLiveLease
            ? "<a class=\"lp-btn\" href=\"/Leases/Create?unitId=" + Model.UnitId + "\"><i class=\"fas fa-file-signature\"></i> " + L["New lease"].Value + "</a>"
            : "") +
        "<a class=\"lp-btn lp-btn-primary\" href=\"/Units/Edit/" + Model.UnitId + "\"><i class=\"fas fa-pen\"></i> " + L["Edit unit"].Value + "</a>";
}

<div class="lp-page">
    @await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData)
    {
        ["Title"] = unitTitle,
        ["Subtitle"] = subtitle,
        ["Crumbs"] = new (string label, string? href)[]
        {
            (L["Admin"].Value, "/Dashboard"),
            (L["Properties"].Value, "/Properties"),
            (propertyName, propertyHref),
            (unitTitle, null),
        },
        ["ActionsHtml"] = Html.Raw(actions)
    })

    @await Html.PartialAsync("_AlertMessages")
    @Html.AntiForgeryToken()

    @* ── KPI strip ── *@
    <div class="od od-grid-kpi lp-kpi-5">
        <div class="od-card od-kpi-hero">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Status"]</span></div>
            <div class="od-kpi-value"><span class="lp-chip @Chip(displayStatus)" style="font-size:0.8rem">@L[displayStatus]</span></div>
            <div class="od-kpi-sub">
                @if (isPendingHold && current?.Tenant != null) { <span>@L["Pending lease"] · @current.Tenant.FirstName @current.Tenant.LastName</span> }
                else if (current?.Tenant != null) { <span>@current.Tenant.FirstName @current.Tenant.LastName</span> }
                else if (Model.Status == UnitStatuses.Vacant && Model.AvailableFromDate.HasValue) { <span>@L["Available from"] @Model.AvailableFromDate.Value.ToString("dd MMM yyyy", inv)</span> }
                else if (Model.Status == UnitStatuses.Vacant) { <span>@L["Available"]</span> }
                else { <span>@L["No active lease"]</span> }
            </div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Listed rent"]</span></div>
            @if (Model.MonthlyRent > 0)
            {
                <div class="od-kpi-value">@Model.MonthlyRent.ToString("N3", inv) <small>KWD</small></div>
                <div class="od-kpi-sub">@L["per month"]</div>
            }
            else
            {
                <div class="od-kpi-value"><span class="lp-chip lp-chip-amber">@L["No rent set"]</span></div>
                <div class="od-kpi-sub"><a class="lp-link" href="/Units/Edit/@Model.UnitId">@L["Set a listed rent"]</a></div>
            }
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Current rent"]</span></div>
            @if (active != null)
            {
                <div class="od-kpi-value">@active.MonthlyRent.ToString("N3", inv) <small>KWD</small></div>
                <div class="od-kpi-sub">@L["Lease #"]@active.LeaseId · @L["until"] @active.LeaseEndDate.ToString("dd MMM yyyy", inv)</div>
            }
            else
            {
                <div class="od-kpi-value"><span class="lp-amount-muted">—</span></div>
                <div class="od-kpi-sub">@L["No active lease"]</div>
            }
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Months occupied"]</span></div>
            <div class="od-kpi-value">@Math.Round(totalMonthsOccupied, 0)</div>
            <div class="od-kpi-sub">@L["across all leases"]</div>
        </div>
        <a class="od-card od-card-link" href="/Units/History/@Model.UnitId">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Lifetime tenants"]</span></div>
            <div class="od-kpi-value">@lifetimeTenants</div>
            <div class="od-kpi-sub">@L["Total leases"]: @leases.Count</div>
        </a>
    </div>

    <div class="pd-grid">
        <div class="pd-main">

            @* ── Current tenant ── *@
            <section class="lp-table-wrap pd-section">
                <div class="pd-section-head">
                    <h2><i class="fas fa-user"></i> @L["Current tenant"]</h2>
                    @if (current != null)
                    {
                        <span class="lp-chip @LeaseChip(current.Status)">@L[current.Status]</span>
                    }
                </div>
                @if (current?.Tenant != null)
                {
                    var t = current.Tenant;
                    var tInit = Initials(t);
                    var daysLeft = (current.LeaseEndDate.Date - DateTime.Today).Days;
                    <div style="padding:0.9rem 1rem;display:flex;flex-direction:column;gap:0.8rem">
                        <div class="lp-cell-person">
                            <span class="lp-avatar" style="width:44px;height:44px;font-size:0.95rem">@(tInit.Length == 0 ? "T" : tInit)</span>
                            <div>
                                <a class="lp-link lp-primary" style="font-size:1.02rem" href="/Tenants/Details/@t.TenantId">@t.FirstName @t.LastName</a>
                                <span class="lp-sub">
                                    @if (!string.IsNullOrWhiteSpace(t.PACINumber)) { <span class="lp-mono">@L["Civil ID"] @t.PACINumber</span> }
                                    @if (!string.IsNullOrWhiteSpace(t.Phone)) { <span> · <a class="lp-link" href="tel:@t.Phone">@t.Phone</a></span> }
                                    @if (!string.IsNullOrWhiteSpace(t.Email)) { <span> · <a class="lp-link" href="mailto:@t.Email">@t.Email</a></span> }
                                </span>
                            </div>
                        </div>
                        <dl class="pd-dl" style="padding:0;border-top:1px dashed #f1f5f9">
                            <div><dt>@L["Lease"]</dt><dd><a class="lp-link" href="/Leases/Details/@current.LeaseId">@L["Lease #"]@current.LeaseId</a></dd></div>
                            <div><dt>@L["Period"]</dt><dd>@current.LeaseStartDate.ToString("dd MMM yyyy", inv) → @current.LeaseEndDate.ToString("dd MMM yyyy", inv)</dd></div>
                            <div><dt>@L["Rent"]</dt><dd><span class="lp-amount">@current.MonthlyRent.ToString("N3", inv)</span> @L["KWD/mo"]</dd></div>
                            <div><dt>@L["Days remaining"]</dt><dd>
                                @if (daysLeft < 0) { <span class="lp-chip lp-chip-red">@L["past end"]</span> }
                                else if (daysLeft <= 30) { <span class="lp-chip lp-chip-amber">@daysLeft @L["days"]</span> }
                                else { <span class="lp-chip lp-chip-green">@daysLeft @L["days"]</span> }
                            </dd></div>
                        </dl>
                        <div class="lp-row-actions" style="flex-wrap:wrap">
                            <a class="lp-btn lp-btn-primary" href="/Leases/Details/@current.LeaseId"><i class="fas fa-file-contract"></i> @L["Open lease"]</a>
                            <a class="lp-btn" href="/CashPayment/Record?tenantId=@t.TenantId"><i class="fas fa-money-bill"></i> @L["Record cash"]</a>
                            <a class="lp-btn" href="/Invoices?leaseId=@current.LeaseId"><i class="fas fa-file-invoice-dollar"></i> @L["Invoices"]</a>
                        </div>
                    </div>
                }
                else if (Model.Status == UnitStatuses.Vacant)
                {
                    <div class="lp-empty" style="border:0">
                        <i class="fas fa-door-open"></i>
                        <h3>@L["Available"]</h3>
                        @if (Model.AvailableFromDate.HasValue)
                        {
                            <p>@L["Available from"] @Model.AvailableFromDate.Value.ToString("dd MMM yyyy", inv)</p>
                        }
                        <p style="margin-top:0.6rem"><a class="lp-btn lp-btn-primary" href="/Leases/Create?unitId=@Model.UnitId"><i class="fas fa-file-signature"></i> @L["Open new lease"]</a></p>
                    </div>
                }
                else
                {
                    <div class="lp-empty" style="border:0">
                        <i class="fas fa-user-slash"></i>
                        <h3>@L[Model.Status]</h3>
                        <p>@L["No active lease. The unit is currently"] <strong>@L[Model.Status]</strong>.</p>
                        @if (Model.AvailableFromDate.HasValue)
                        {
                            <p>@L["Available from"] @Model.AvailableFromDate.Value.ToString("dd MMM yyyy", inv)</p>
                        }
                    </div>
                }
            </section>

            @* ── Lease history ── *@
            <section class="lp-table-wrap pd-section">
                <div class="pd-section-head">
                    <h2><i class="fas fa-clock-rotate-left"></i> @L["Lease history"] <span class="lp-chip lp-chip-gold">@leases.Count</span></h2>
                    <div class="lp-row-actions">
                        <a class="lp-btn" href="/Units/History/@Model.UnitId"><i class="fas fa-timeline"></i> @L["Full history"]</a>
                    </div>
                </div>
                @if (leases.Count == 0)
                {
                    <div class="lp-empty" style="border:0"><i class="fas fa-file-contract"></i><h3>@L["No leases yet"]</h3><p>@L["This unit has never been leased."]</p></div>
                }
                else
                {
                    <table class="lp-table">
                        <thead>
                            <tr>
                                <th>@L["Tenant"]</th>
                                <th>@L["Period"]</th>
                                <th class="lp-num">@L["Rent (KWD)"]</th>
                                <th>@L["Status"]</th>
                                <th class="lp-right">@L["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in leases)
                            {
                                var endShown = l.TerminationDate ?? l.LeaseEndDate;
                                <tr class="@(l.LeaseId == current?.LeaseId ? "" : (l.Status == LeaseStatuses.Expired || l.Status == LeaseStatuses.Terminated ? "is-muted" : ""))">
                                    <td data-label="@L["Tenant"]">
                                        @if (l.Tenant != null)
                                        {
                                            var li = Initials(l.Tenant);
                                            <div class="lp-cell-person">
                                                <span class="lp-avatar">@(li.Length == 0 ? "T" : li)</span>
                                                <div>
                                                    <a class="lp-link lp-primary lp-trunc" style="max-width:170px" href="/Tenants/Details/@l.Tenant.TenantId">@l.Tenant.FirstName @l.Tenant.LastName</a>
                                                    <span class="lp-sub lp-mono">@l.Tenant.PACINumber</span>
                                                </div>
                                            </div>
                                        }
                                        else { <span class="lp-amount-muted">—</span> }
                                    </td>
                                    <td data-label="@L["Period"]" style="white-space:nowrap;font-size:0.82rem">
                                        <span>@l.LeaseStartDate.ToString("dd MMM yyyy", inv) → @endShown.ToString("dd MMM yyyy", inv)</span>
                                        @if (l.TerminationDate.HasValue) { <span class="lp-sub">@L["Terminated"] · @L["planned end"] @l.LeaseEndDate.ToString("dd MMM yyyy", inv)</span> }
                                    </td>
                                    <td class="lp-num" data-label="@L["Rent (KWD)"]"><span class="lp-amount">@l.MonthlyRent.ToString("N3", inv)</span></td>
                                    <td data-label="@L["Status"]"><span class="lp-chip @LeaseChip(l.Status)">@L[l.Status]</span></td>
                                    <td class="lp-right" data-label="@L["Actions"]">
                                        <a class="lp-btn" style="padding:0.3rem 0.6rem;font-size:0.76rem" href="/Leases/Details/@l.LeaseId"><i class="fas fa-file-contract"></i> @L["Open"]</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>

            @* ── Maintenance ── *@
            <section class="lp-table-wrap pd-section">
                <div class="pd-section-head">
                    <h2><i class="fas fa-screwdriver-wrench"></i> @L["Recent maintenance"] <span class="lp-chip lp-chip-gold">@maintenance.Count</span></h2>
                </div>
                @if (maintenance.Count == 0)
                {
                    <div class="lp-empty" style="border:0"><i class="fas fa-wrench"></i><h3>@L["No maintenance requests"]</h3></div>
                }
                else
                {
                    <table class="lp-table">
                        <thead>
                            <tr>
                                <th>@L["Date"]</th>
                                <th>@L["Request"]</th>
                                <th>@L["Priority"]</th>
                                <th>@L["Status"]</th>
                                <th class="lp-right">@L["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in maintenance)
                            {
                                <tr>
                                    <td data-label="@L["Date"]" style="white-space:nowrap">@m.RequestDate.ToString("dd MMM yyyy", inv)</td>
                                    <td data-label="@L["Request"]">
                                        <span class="lp-primary">@L[m.Category]</span>
                                        @if (!string.IsNullOrWhiteSpace(m.Description)) { <span class="lp-sub lp-trunc" style="max-width:320px">@m.Description</span> }
                                    </td>
                                    <td data-label="@L["Priority"]"><span class="lp-chip @(m.Priority == "Emergency" || m.Priority == "High" ? "lp-chip-red" : m.Priority == "Low" ? "lp-chip-grey" : "lp-chip-amber")">@L[m.Priority]</span></td>
                                    <td data-label="@L["Status"]">
                                        <span class="lp-chip @MaintChip(m.Status)">@L[m.Status]</span>
                                        @if (m.IsOverdue) { <span class="lp-chip lp-chip-red">@L["Overdue"]</span> }
                                    </td>
                                    <td class="lp-right" data-label="@L["Actions"]">
                                        <a class="lp-btn" style="padding:0.3rem 0.6rem;font-size:0.76rem" href="/Maintenance/Details/@m.RequestId"><i class="fas fa-arrow-up-right-from-square"></i> @L["Open"]</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        </div>

        <aside class="pd-side">
            @* ── Specs ── *@
            <div class="pd-card">
                <div class="pd-card-head"><i class="fas fa-cube"></i> @L["Specs"]</div>
                <dl class="pd-dl">
                    <div><dt>@L["Type"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.UnitType) ? "—" : L[Model.UnitType].Value)</dd></div>
                    <div><dt>@L["Size band"]</dt><dd>@(string.IsNullOrEmpty(Model.SizeBand) ? "—" : L[Model.SizeBand].Value)</dd></div>
                    <div><dt>@L["Floor"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.FloorNumber) ? "—" : Model.FloorNumber)</dd></div>
                    <div><dt>@L["Bedrooms"]</dt><dd>@(Model.Bedrooms ?? 0)</dd></div>
                    <div><dt>@L["Bathrooms"]</dt><dd>@(Model.Bathrooms ?? 0)</dd></div>
                    <div><dt>@L["Square feet"]</dt><dd>@(Model.SquareFeet ?? 0)</dd></div>
                    <div><dt>@L["Listed rent"]</dt><dd>@if (Model.MonthlyRent > 0) { <text>KWD @Model.MonthlyRent.ToString("N3", inv)</text> } else { <span class="lp-chip lp-chip-amber">@L["No rent set"]</span> }</dd></div>
                    <div><dt>@L["Status"]</dt><dd><span class="lp-chip @Chip(displayStatus)">@L[displayStatus]</span>@if (isPendingHold) { <span class="lp-sub">@L["Pending lease"] #@pending!.LeaseId</span> }</dd></div>
                    @if (Model.Status != UnitStatuses.Occupied && Model.AvailableFromDate.HasValue)
                    {
                        <div><dt>@L["Available from"]</dt><dd>@Model.AvailableFromDate.Value.ToString("dd MMM yyyy", inv)</dd></div>
                    }
                    <div><dt>@L["Created"]</dt><dd>@Model.CreatedDate.ToString("dd MMM yyyy", inv)</dd></div>
                    <div><dt>@L["Modified"]</dt><dd>@(Model.ModifiedDate?.ToString("dd MMM yyyy", inv) ?? "—")</dd></div>
                </dl>
            </div>

            @* ── Change status (existing inline form; ids/names unchanged, script in @section Scripts) ── *@
            <div class="pd-card">
                <div class="pd-card-head"><i class="fas fa-toggle-on"></i> @L["Change status"]</div>
                @if (Model.Status != UnitStatuses.Occupied)
                {
                    <div class="pd-form">
                        <div>
                            <label for="statusSelect">@L["Hold:"]</label>
                            <select id="statusSelect" data-current="@Model.Status">
                                @foreach (var s in UnitStatuses.All)
                                {
                                    if (s == Model.Status)
                                    {
                                        <option value="@s" selected>@L[s]</option>
                                    }
                                    else
                                    {
                                        <option value="@s">@L[s]</option>
                                    }
                                }
                            </select>
                        </div>
                        <small>@L["Maintenance and Reserved are manual holds. Vacant and Occupied follow the lease and are refused while a lease is active."]</small>
                    </div>
                }
                else
                {
                    <div class="pd-note">@L["Status is managed by the active lease. Terminate or transfer the lease to release the unit."]</div>
                }
            </div>

            @* ── Property ── *@
            <div class="pd-card">
                <div class="pd-card-head"><i class="fas fa-building"></i> @L["Property"]</div>
                <dl class="pd-dl">
                    <div><dt>@L["Name"]</dt><dd><a class="lp-link" href="@propertyHref">@propertyName</a></dd></div>
                    <div><dt>@L["Address"]</dt><dd style="text-align:end">@(!string.IsNullOrWhiteSpace(property?.Address) ? property!.Address : (string.IsNullOrWhiteSpace(address) ? "—" : address))</dd></div>
                    @if (!string.IsNullOrWhiteSpace(property?.Area) || !string.IsNullOrWhiteSpace(property?.Governorate))
                    {
                        <div><dt>@L["Area"]</dt><dd>@(string.Join(", ", new[] { property?.Area, property?.Governorate }.Where(s => !string.IsNullOrWhiteSpace(s))))</dd></div>
                    }
                    <div><dt>@L["PACI Number"]</dt><dd class="lp-mono">@(string.IsNullOrWhiteSpace(property?.PACINumber) ? "—" : property!.PACINumber)</dd></div>
                </dl>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        // Inline status change (Maintenance / Reserved holds). Auto-managed
        // states (Vacant / Occupied) get refused server-side if the unit has
        // an active lease, so the operator can't accidentally hide a tenanted
        // unit.
        const sel = document.getElementById('statusSelect');
        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        const MSG_CONFIRM = @Json.Serialize(L["Change unit status from {0} to {1}?"].Value);
        const MSG_FAILED_STATUS = @Json.Serialize(L["Status change failed ({0})"].Value);
        const MSG_FAILED = @Json.Serialize(L["Status change failed:"].Value);
        if (sel && token) {
            sel.addEventListener('change', async () => {
                const previous = sel.dataset.current;
                const next = sel.value;
                if (previous === next) return;
                if (!confirm(MSG_CONFIRM.replace('{0}', previous).replace('{1}', next))) {
                    sel.value = previous;
                    return;
                }
                sel.disabled = true;
                try {
                    const fd = new FormData();
                    fd.set('id', '@Model.UnitId');
                    fd.set('newStatus', next);
                    fd.set('__RequestVerificationToken', token.value);
                    const res = await fetch('/Units/ChangeStatus', { method: 'POST', body: fd, credentials: 'same-origin' });
                    const json = await res.json();
                    if (!res.ok || !json.success) {
                        alert(json.error ?? MSG_FAILED_STATUS.replace('{0}', res.status));
                        sel.value = previous;
                    } else {
                        sel.dataset.current = next;
                        location.reload();
                    }
                } catch (e) {
                    alert(MSG_FAILED + ' ' + e.message);
                    sel.value = previous;
                } finally {
                    sel.disabled = false;
                }
            });
        }
    </script>
}
