@model List<RentCollection.Core.Entities.Unit>
@using RentCollection.Core.Enums
@using RentCollection.Core.Entities
@{
    ViewData["Title"] = "Units";
    var properties = ViewBag.Properties as dynamic;
    var f = ViewBag.Filter as dynamic;
    string? curStatus = f?.Status;
    string? curUnitType = f?.UnitType;
    int? curPropertyId = f?.PropertyId;
    string? curFloor = f?.Floor;
    string? curSizeBand = f?.SizeBand;
    string? curSearch = f?.Search;

    var distinctFloors = Model
        .Where(u => !string.IsNullOrWhiteSpace(u.FloorNumber))
        .Select(u => u.FloorNumber!)
        .Distinct().OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToList();

    // Natural order for unit numbers ("1", "2", "10", "101", "A101").
    static string NatKey(string s) => System.Text.RegularExpressions.Regex.Replace(s ?? "", @"\d+", m => m.Value.PadLeft(8, '0'));

    var groups = Model
        .GroupBy(u => u.Property)
        .OrderBy(g => g.Key?.PropertyName)
        .ToList();
    var openAll = Model.Count <= 60 || groups.Count == 1;

    string ChipClass(string status) => status switch
    {
        "Occupied" => "lp-chip-blue",
        "Vacant" => "lp-chip-green",
        "Maintenance" => "lp-chip-amber",
        "Reserved" => "lp-chip-purple",
        _ => "lp-chip-grey",
    };
}

<div class="lp-page" data-lp-scope>
    @await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData)
    {
        ["Title"] = L["Units"].Value,
        ["Subtitle"] = string.Format(L["{0} units matching current filters"].Value, Model.Count),
        ["ActionLabel"] = L["Add Unit"].Value,
        ["ActionHref"] = Url.Action("Create", "Units"),
        ["Crumbs"] = new (string label, string? href)[]
        {
            (L["Admin"].Value, "/Dashboard"),
            (L["Units"].Value, null),
        }
    })

    @await Html.PartialAsync("_AlertMessages")
    @Html.AntiForgeryToken()

    @* ── KPI strip (Snapshot) ── *@
    <div class="od od-grid-kpi lp-kpi-5" id="unitStrip" aria-live="polite">
        <div class="od-card od-kpi-hero">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Occupancy"]</span></div>
            <div class="od-kpi-value lp-skel" data-k="occupancyPercent">&nbsp;</div>
            <div class="od-kpi-sub"><span data-k="totalUnits">—</span> @L["units"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Vacant"]</span></div>
            <div class="od-kpi-value lp-skel" data-k="vacant">&nbsp;</div>
            <div class="od-kpi-sub">@L["available now"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Occupied"]</span></div>
            <div class="od-kpi-value lp-skel" data-k="occupied">&nbsp;</div>
            <div class="od-kpi-sub">@L["currently leased"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Maintenance"]</span></div>
            <div class="od-kpi-value lp-skel" data-k="maintenance">&nbsp;</div>
            <div class="od-kpi-sub">@L["under maintenance"]</div>
        </div>
        <div class="od-card">
            <div class="od-kpi-row"><span class="od-kpi-label">@L["Avg rent"]</span></div>
            <div class="od-kpi-value lp-skel" data-k="avgRent">&nbsp;</div>
            <div class="od-kpi-sub">@L["per month, all units"]</div>
        </div>
    </div>

    @* ── Toolbar: server filters (persisted in the URL) + instant search ── *@
    <form method="get" class="lp-toolbar" id="unitFilters">
        <div class="lp-toolbar-row">
            <label class="lp-search">
                <i class="fas fa-search"></i>
                <input type="search" name="search" value="@curSearch" data-lp-search placeholder="@(L["Unit # or property name…"].Value)" />
            </label>
            <select name="propertyId" class="lp-select" onchange="this.form.submit()">
                <option value="">@L["All properties"]</option>
                @if (properties != null)
                {
                    @foreach (var p in properties)
                    {
                        <option value="@p.PropertyId" selected="@(curPropertyId == (int?)p.PropertyId)">@p.PropertyName</option>
                    }
                }
            </select>
            <span class="lp-result-count" data-lp-count data-all="@(L["Showing all {0} units"].Value)" data-some="@(L["Showing {0} of {1} units"].Value)"></span>
            <div class="lp-toolbar-spacer"></div>
            <a class="lp-btn" href="/Units">@L["Clear filters"]</a>
            <a class="lp-btn lp-btn-export" download href="@Url.Action("ExportExcel", new { propertyId = curPropertyId, status = curStatus, unitType = curUnitType, floor = curFloor, sizeBand = curSizeBand, search = curSearch })">
                <i class="fas fa-file-excel"></i> @L["Export"]
            </a>
        </div>

        <div class="lp-toolbar-row">
            <div class="lp-chips">
                <span class="lp-chips-label">@L["Status"]</span>
                @{
                    var statusChips = new (string Label, string? Value)[]
                    {
                        (L["All"].Value, null),
                        (L["Vacant"].Value, UnitStatuses.Vacant),
                        (L["Occupied"].Value, UnitStatuses.Occupied),
                        (L["Maintenance"].Value, UnitStatuses.Maintenance),
                        (L["Reserved"].Value, UnitStatuses.Reserved),
                    };
                }
                @foreach (var c in statusChips)
                {
                    <button type="submit" name="status" value="@(c.Value ?? "")" class="lp-chip-btn @(curStatus == c.Value ? "is-on" : "")">@c.Label</button>
                }
            </div>
            <div class="lp-chips">
                <span class="lp-chips-label">@L["Size"]</span>
                @{
                    var sizeChips = new (string Label, string? Value)[]
                    {
                        (L["All"].Value, null),
                        (L["Studio"].Value, UnitSizeBands.Studio),
                        ("1BHK", UnitSizeBands.OneBhk),
                        ("2BHK", UnitSizeBands.TwoBhk),
                        ("3BHK+", UnitSizeBands.ThreeBhkPlus),
                        (L["Commercial"].Value, UnitSizeBands.Commercial),
                    };
                }
                @foreach (var c in sizeChips)
                {
                    <button type="submit" name="sizeBand" value="@(c.Value ?? "")" class="lp-chip-btn @(curSizeBand == c.Value ? "is-on" : "")">@c.Label</button>
                }
            </div>
        </div>
        <div class="lp-toolbar-row">
            <div class="lp-chips">
                <span class="lp-chips-label">@L["Type"]</span>
                <button type="submit" name="unitType" value="" class="lp-chip-btn @(curUnitType == null ? "is-on" : "")">@L["All"]</button>
                @foreach (var t in UnitTypes.All)
                {
                    <button type="submit" name="unitType" value="@t" class="lp-chip-btn @(curUnitType == t ? "is-on" : "")">@L[t]</button>
                }
            </div>
            @if (distinctFloors.Any())
            {
                <div class="lp-chips">
                    <span class="lp-chips-label">@L["Floor"]</span>
                    <button type="submit" name="floor" value="" class="lp-chip-btn @(curFloor == null ? "is-on" : "")">@L["All"]</button>
                    @foreach (var fl in distinctFloors)
                    {
                        <button type="submit" name="floor" value="@fl" class="lp-chip-btn @(curFloor == fl ? "is-on" : "")">@fl</button>
                    }
                </div>
            }
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="lp-empty">
            <i class="fas fa-th-large"></i>
            <h3>@L["No units match these filters"]</h3>
            <p><a href="/Units">@L["Clear filters"]</a> @L["to see the whole portfolio."]</p>
        </div>
    }

    @* ── Units grouped by property ── *@
    @foreach (var g in groups)
    {
        var prop = g.Key;
        var total = g.Count();
        var occ = g.Count(u => u.Status == UnitStatuses.Occupied);
        var vac = g.Count(u => u.Status == UnitStatuses.Vacant);
        var pct = total == 0 ? 0 : (int)Math.Round(100.0 * occ / total);
        var vacancyCost = g.Where(u => u.Status == UnitStatuses.Vacant).Sum(u => u.MonthlyRent);
        var unpriced = g.Count(u => u.MonthlyRent <= 0);
        var initials = string.Concat((prop?.PropertyName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpperInvariant();

        <details class="lp-group" @(openAll ? "open" : "")>
            <summary>
                <span class="lp-group-mark">@initials</span>
                <div>
                    <div class="lp-group-title">@(prop?.PropertyName ?? L["Unknown property"].Value)</div>
                    <div class="lp-group-meta">
                        <span data-lp-group-count>@total</span> @L["units"]
                        @if (!string.IsNullOrWhiteSpace(prop?.Area) || !string.IsNullOrWhiteSpace(prop?.Governorate))
                        {
                            <text> · @string.Join(", ", new[] { prop?.Area, prop?.Governorate }.Where(s => !string.IsNullOrWhiteSpace(s)))</text>
                        }
                        @if (unpriced > 0)
                        {
                            <text> · </text><span class="lp-chip lp-chip-amber" title="@(L["Units with no monthly rent set"].Value)">@unpriced @L["without rent"]</span>
                        }
                    </div>
                </div>
                <div class="lp-group-stats">
                    <div class="lp-group-stat" style="min-width:160px">
                        <b>@occ / @total <small style="font-weight:500;color:#64748b">(@pct%)</small></b>
                        <span>@L["Occupied"]</span>
                        <div class="lp-bar @(pct == 0 ? "is-zero" : pct < 50 ? "is-low" : "")" style="margin-top:4px"><span style="width:@pct%"></span></div>
                    </div>
                    <div class="lp-group-stat"><b>@vac</b><span>@L["Vacant"]</span></div>
                    <div class="lp-group-stat"><b class="@(vacancyCost > 0 ? "lp-amount-bad" : "")">@vacancyCost.ToString("N3", System.Globalization.CultureInfo.InvariantCulture)</b><span>@L["Vacancy cost / mo"]</span></div>
                    <a class="lp-btn" href="/Properties/Details/@prop?.PropertyId" onclick="event.stopPropagation()"><i class="fas fa-building"></i> @L["Property"]</a>
                    <i class="fas fa-chevron-down lp-group-chevron"></i>
                </div>
            </summary>
            <div class="lp-table-wrap">
                <table class="lp-table">
                    <thead>
                        <tr>
                            <th data-sort="unit">@L["Unit"]</th>
                            <th>@L["Details"]</th>
                            <th class="lp-num" data-sort="rent">@L["Listed rent"]</th>
                            <th data-sort="status">@L["Status"]</th>
                            <th>@L["Tenant / availability"]</th>
                            <th class="lp-right">@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in g.OrderBy(x => NatKey(x.FloorNumber ?? "")).ThenBy(x => NatKey(x.UnitNumber)))
                        {
                            var lease = u.Leases?.OrderBy(l => l.Status == LeaseStatuses.Active ? 0 : 1).FirstOrDefault();
                            var tenant = lease?.Tenant;
                            // A Vacant unit with a Pending (deposit-awaiting) lease is shown as Reserved.
                            var isPendingHold = u.Status == UnitStatuses.Vacant && lease?.Status == LeaseStatuses.Pending;
                            var displayStatus = isPendingHold ? UnitStatuses.Reserved : u.Status;
                            var daysLeft = lease != null ? (lease.LeaseEndDate.Date - DateTime.Today).Days : (int?)null;
                            var specs = new List<string>();
                            if (!string.IsNullOrWhiteSpace(u.UnitType)) specs.Add(L[u.UnitType].Value);
                            if (!string.IsNullOrWhiteSpace(u.SizeBand)) specs.Add(u.SizeBand);
                            if (u.Bedrooms.HasValue) specs.Add($"{u.Bedrooms} {L["bed"].Value}");
                            if (u.SquareFeet.HasValue) specs.Add($"{u.SquareFeet} m²");
                            var search = $"{u.UnitNumber} {prop?.PropertyName} {u.UnitType} {u.FloorNumber} {tenant?.FirstName} {tenant?.LastName} {u.Status}".ToLowerInvariant();

                            <tr data-search="@search" data-sort-unit="@NatKey(u.UnitNumber)" data-sort-rent="@u.MonthlyRent" data-sort-status="@displayStatus">
                                <td data-label="@L["Unit"]">
                                    <a class="lp-link lp-primary" href="/Units/Details/@u.UnitId">@L["Unit"] @u.UnitNumber</a>
                                    @if (!string.IsNullOrWhiteSpace(u.FloorNumber)) { <span class="lp-sub">@L["Floor"] @u.FloorNumber</span> }
                                </td>
                                <td data-label="@L["Details"]"><span class="lp-sub" style="margin:0;font-size:0.8rem;color:#475569">@(specs.Count > 0 ? string.Join(" · ", specs) : "—")</span></td>
                                <td class="lp-num" data-label="@L["Listed rent"]">
                                    @if (u.MonthlyRent > 0) { <span class="lp-amount">@u.MonthlyRent.ToString("N3", System.Globalization.CultureInfo.InvariantCulture)</span><span class="lp-sub">KWD / @L["month"]</span> }
                                    else { <span class="lp-chip lp-chip-amber">@L["No rent set"]</span> }
                                </td>
                                <td data-label="@L["Status"]"><span class="lp-chip @ChipClass(displayStatus)">@L[displayStatus]</span>@if (isPendingHold) { <span class="lp-sub">@L["Pending lease"]</span> }</td>
                                <td data-label="@L["Tenant / availability"]">
                                    @if (tenant != null)
                                    {
                                        <a class="lp-link lp-primary" href="/Tenants/Details/@tenant.TenantId">@tenant.FirstName @tenant.LastName</a>
                                        <span class="lp-sub">
                                            @if (lease!.Status == LeaseStatuses.Pending) { <span class="lp-chip lp-chip-amber">@L["Pending"]</span> <text>@L["activate to occupy"]</text> }
                                            else { <text>@L["Lease ends"] @lease.LeaseEndDate.ToString("dd MMM yyyy")</text> }
                                            @if (lease.Status == LeaseStatuses.Pending) { }
                                            else if (daysLeft < 0) { <span class="lp-chip lp-chip-red">@L["past end"]</span> }
                                            else if (daysLeft <= 30) { <span class="lp-chip lp-chip-amber">@daysLeft @L["days"]</span> }
                                        </span>
                                    }
                                    else if (u.Status == UnitStatuses.Vacant)
                                    {
                                        <span class="lp-amount-good">@L["Available"]</span>
                                        @if (u.AvailableFromDate.HasValue && u.AvailableFromDate.Value.Date > DateTime.Today)
                                        { <span class="lp-sub">@L["from"] @u.AvailableFromDate.Value.ToString("dd MMM yyyy")</span> }
                                        else { <span class="lp-sub">@L["ready to lease"]</span> }
                                    }
                                    else
                                    {
                                        <span class="lp-sub" style="margin:0">—</span>
                                    }
                                </td>
                                <td class="lp-right" data-label="@L["Actions"]">
                                    <div class="lp-row-actions">
                                        @if (u.Status == UnitStatuses.Vacant && tenant == null)
                                        {
                                            <a class="lp-btn lp-btn-primary" style="padding:0.3rem 0.6rem;font-size:0.76rem" href="/Leases/Create?unitId=@u.UnitId"><i class="fas fa-file-signature"></i> @L["Lease"]</a>
                                        }
                                        else if (lease != null)
                                        {
                                            <a class="lp-icon-btn" title="@(L["Lease"].Value)" href="/Leases/Details/@lease.LeaseId"><i class="fas fa-file-contract"></i></a>
                                        }
                                        <a class="lp-icon-btn" title="@(L["View"].Value)" href="/Units/Details/@u.UnitId"><i class="fas fa-eye"></i></a>
                                        <a class="lp-icon-btn" title="@(L["Edit"].Value)" href="/Units/Edit/@u.UnitId"><i class="fas fa-pen"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }

    <div class="lp-empty" data-lp-empty hidden>
        <i class="fas fa-search"></i>
        <h3>@L["No units match your search"]</h3>
    </div>
</div>

@section Scripts {
    <script>
        (async function () {
            const propertyId = new URLSearchParams(location.search).get('propertyId');
            const url = '/Units/Snapshot' + (propertyId ? '?propertyId=' + propertyId : '');
            try {
                const res = await fetch(url, { credentials: 'same-origin' });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const d = await res.json();
                const fmt = {
                    avgRent: v => (v ?? 0).toLocaleString("en-US", { maximumFractionDigits: 3 }) + ' KWD',
                    occupancyPercent: v => (v ?? 0).toLocaleString("en-US", { maximumFractionDigits: 1 }) + '%',
                };
                document.querySelectorAll('#unitStrip [data-k]').forEach(el => {
                    const k = el.dataset.k;
                    if (d[k] === undefined) return;
                    el.classList.remove('lp-skel');
                    el.textContent = (fmt[k] || (v => Math.round(v ?? 0).toLocaleString("en-US")))(d[k]);
                });
            } catch (e) {
                document.querySelectorAll('#unitStrip .lp-skel').forEach(el => { el.classList.remove('lp-skel'); el.textContent = '—'; });
            }
        })();
    </script>
}
