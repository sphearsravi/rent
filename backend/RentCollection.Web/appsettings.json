{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AppVersion": {
    "Android": {
      "MinSupported": "1.0.0",
      "Latest": "1.0.0",
      "StoreUrl": "https://play.google.com/store/apps/details?id=com.viijar.tenant"
    },
    "Ios": {
      "MinSupported": "1.0.0",
      "Latest": "1.0.0",
      "StoreUrl": ""
    }
  },
  "Jwt": {
    "Key": "",
    "Issuer": "RentCollectionAPI",
    "Audience": "RentCollectionClient",
    "// AccessTokenExpirationMinutes": "Sprint 4 A5 — dropped from 1440 (24h) to 60. The Flutter app silently renews on cold start via /tenant/refresh, so users don't notice; a stolen JWT is now usable for at most an hour instead of a day.",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-2.5-flash",
    "Enabled": false,
    "MaxImagePixels": 1024,
    "RateLimitPerMinute": 10,
    "TimeoutSeconds": 15
  },
  "Fcm": {
    "Enabled": false,
    "DryRun": true,
    "ServerKey": "",
    "Endpoint": "https://fcm.googleapis.com/fcm/send"
  },
  "Knet": {
    "TranportalId": "",
    "TranportalPwd": "",
    "TerminalResourceKey": "",
    "PaymentApiUrl": "https://kpaytest.com.kw/kpg/PaymentHTTP.htm?param=paymentInit",
    "PaymentApiUrlProd": "https://www.kpay.com.kw/kpg/PaymentHTTP.htm?param=paymentInit",
    "UseSandbox": true,
    "UseTestMode": false,
    "SuccessUrl": "http://localhost:5032/api/payments/knet/response",
    "ErrorUrl": "http://localhost:5032/api/payments/knet/error"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "RentCollection.Infrastructure.Services.KnetPaymentService": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Branding": {
    "CompanyName": "ALRTAM Company",
    "TagLine": "Real Estate Developer",
    "LogoPath": "img/branding/logo.png",
    "PrimaryHex": "#C9A647",
    "SecondaryHex": "#0B0B0B",
    "ContactAddress": "Kuwait",
    "ContactPhone": "",
    "ContactEmail": "",
    "Website": "",
    "Bank": {
      "Name": "",
      "AccountHolder": "ALRTAM Company",
      "Iban": "",
      "SwiftBic": "",
      "KnetReceiver": "ALRTAM Company"
    },
    "FooterTerms": "Payment due within 5 days of issue. Please include the invoice number with every transfer."
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
