    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Valid Credentials",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"username\": \"{{civilId}}\",\n    \"password\": \"{{tenantPassword}}\"\n  },\n  \"param\": {\n    \"applang\": \"en\",\n    \"apptoken\": \"\",\n    \"deviceinfo\": \"Postman\",\n    \"deviceid\": \"postman-001\",\n    \"appos\": \"web\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login returns 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains token', function() {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.environment.set('jwtToken', json.data.token);",
                  "        pm.expect(json.data.token).to.be.a('string').and.not.empty;",
                  "    }",
                  "    if (json.data && json.data.tenantId) {",
                  "        pm.environment.set('tenantId', json.data.tenantId);",
                  "    }",
                  "});",
                  "",
                  "pm.test('Response contains tenant info', function() {",
                  "    var json = pm.response.json();",
                  "    if (json.data) {",
                  "        pm.expect(json.data).to.have.any.keys('firstName', 'lastName', 'tenantId', 'fullName');",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Invalid Civil ID",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"username\": \"INVALID-ID-99999\",\n    \"password\": \"WrongPassword\"\n  },\n  \"param\": {\n    \"applang\": \"en\",\n    \"apptoken\": \"\",\n    \"deviceinfo\": \"Postman\",\n    \"deviceid\": \"postman-001\",\n    \"appos\": \"web\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid login returns error', function() {",
                  "    var status = pm.response.code;",
                  "    pm.expect([200, 400, 401]).to.include(status);",
                  "});",
                  "",
                  "pm.test('No token in error response', function() {",
                  "    var json = pm.response.json();",
                  "    if (json.data) {",
                  "        pm.expect(json.data.token || '').to.satisfy(function(t) { return !t || t === ''; });",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Wrong Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"username\": \"{{civilId}}\",\n    \"password\": \"WrongPassword123!\"\n  },\n  \"param\": {\n    \"applang\": \"en\",\n    \"apptoken\": \"\",\n    \"deviceinfo\": \"Postman\",\n    \"deviceid\": \"postman-001\",\n    \"appos\": \"web\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Wrong password returns error', function() {",
                  "    var status = pm.response.code;",
                  "    pm.expect([200, 400, 401]).to.include(status);",
                  "});",
                  "",
                  "pm.test('Error message does not reveal user existence', function() {",
                  "    var text = pm.response.text().toLowerCase();",
                  "    pm.expect(text).to.not.include('user found');",
                  "    pm.expect(text).to.not.include('user exists');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
