<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Production default: cleartext traffic is denied. Every request must be
        HTTPS. Protects credentials and JWTs from network sniffing.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        Allow plain HTTP only for dev loopback/RFC1918 addresses. These hosts
        are not reachable from the public internet, so whitelisting them does
        not weaken production security:
          - 10.0.2.2   : Android emulator's alias for the host machine
          - localhost  : on-device loopback
          - 127.0.0.1  : same
        Note: Android's <debug-overrides> element only accepts <trust-anchors>,
        not <domain-config>, so we use a regular domain-config here.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- SmarterASP demo backend is HTTP-only for now. Remove this once the
             site is served over HTTPS. -->
        <domain includeSubdomains="false"><DEMO_HOST></domain>
    </domain-config>
</network-security-config>
