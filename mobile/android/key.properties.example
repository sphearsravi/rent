# Keystore configuration for release signing
# Copy this file to key.properties and fill in your values
# DO NOT commit key.properties to version control!
#
# Generate keystore:
#   keytool -genkey -v -keystore viijar-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias viijar
#
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=viijar
storeFile=viijar-release.jks
